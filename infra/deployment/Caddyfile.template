{
    admin off
    GLOBAL_OPTIONS
    log {
        level ERROR
        format filter {
            wrap json
            fields {
                request delete
                resp_headers delete
                headers delete
                error delete
                err delete
                err_trace delete
                uri delete
                url delete
                upstream delete
                msg replace CADDY_ERROR
            }
        }
    }
}

# Replace both hosts and the loopback port with the reviewed deployment values.
# Every public route, including Session HTTP/WebSocket, passes through access.
ENTRY_ORIGIN, SESSION_ORIGIN {
    TLS_CONFIG
    reverse_proxy ADAPTER_UPSTREAM {
        header_up -Forwarded
        header_up X-Forwarded-For {http.request.remote.host}
    }
}
