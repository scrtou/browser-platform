ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG INPUT_SHA256
COPY artifact.py /usr/local/lib/browser-platform/native_artifact.py
COPY display_config.py /usr/local/lib/browser-platform/display_config.py
COPY launcher.py /usr/local/lib/browser-platform/chromix-launcher.py
RUN python3 -c "import runpy;runpy.run_path('/usr/local/lib/browser-platform/chromix-launcher.py')['verify_fonts']()"
LABEL io.browser-platform.custom-generation="1"

LABEL io.browser-platform.custom-input-sha256="${INPUT_SHA256}"
