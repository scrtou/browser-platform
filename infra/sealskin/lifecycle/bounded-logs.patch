+"""Fixed local Docker retention for all new platform-created containers."""
+from docker.types import LogConfig
+
+
+def bounded_log_config():
+    # Fresh objects: a caller must not mutate defaults for a later generation.
+    return LogConfig(type="json-file", config={"max-size": "10m", "max-file": "3", "compress": "true"})
