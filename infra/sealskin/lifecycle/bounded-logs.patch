@@ -0,0 +1,37 @@
+"""Creation policy, override protection and isolated mutable inputs."""
+from unittest.mock import AsyncMock
+import pytest
+from app.bounded_logs import bounded_log_config
+from app.providers import docker_provider
+from app.launch import launch_application
+from tests.test_network_runtime import managed, launch_args
+from tests.test_profile_runtime import containers, SID, DISPLAY_ENV
+
+EXPECTED = {"Type": "json-file", "Config": {"max-size": "10m", "max-file": "3", "compress": "true"}}
+
+
+def test_policy_cannot_be_mutated_across_creates():
+    first = bounded_log_config()
+    assert first == EXPECTED
+    first["Config"]["max-size"] = "0"
+    assert bounded_log_config() == EXPECTED
+
+
+@pytest.mark.parametrize("override", [{}, {"log_config": {"Type": "none"}}, {"log_config": {"Type": "json-file", "Config": {"max-size": "0"}}}])
+async def test_worker_retention_overrides_application(containers, monkeypatch, override):
+    provider = docker_provider.DockerProvider({"provider_config": {"image": "qa-image", "port": 3000, "docker_overrides": override}})
+    monkeypatch.setattr(provider, "_wait_for_container_ready", AsyncMock(return_value="127.0.0.1"))
+    await provider.launch(SID, DISPLAY_ENV, {})
+    assert containers.run_kwargs["log_config"] == EXPECTED
+
+
+async def test_managed_sidecars_and_probe_get_policy(managed, monkeypatch):
+    seen = {}
+    original = managed.docker.containers.create
+    def create(**kwargs):
+        role = kwargs["labels"]["io.browser-platform.role"]
+        seen[role] = kwargs.get("log_config")
+        return original(**kwargs)
+    monkeypatch.setattr(managed.docker.containers, "create", create)
+    await launch_application(**launch_args(managed))
+    assert seen == {role: EXPECTED for role in ("relay", "guard", "probe")}
