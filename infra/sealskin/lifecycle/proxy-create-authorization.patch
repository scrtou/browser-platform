+
+NEW_GRANT = {"owner": "alice", "profile": "new-browser", "home": "new-home", "app": "new-app"}
+
+
+def authorize(store, refs, grant=NEW_GRANT, digest="a" * 64):
+    store.authorize(grant, refs["username"], refs["password"], digest)
+
+
+def test_create_authorization_is_immutable_idempotent_and_survives_reopen(store):
+    refs = put(store)
+    original = store.revision_path("proxy-a", 1).read_bytes()
+    with pytest.raises(SecretError, match="SECRET_ACCESS_DENIED"):
+        resolve(store, refs, NEW_GRANT)
+    with concurrent.futures.ThreadPoolExecutor(max_workers=4) as executor:
+        list(executor.map(lambda _: authorize(store, refs), range(8)))
+    reopened = FileSecretStore(store.directory, store.key_file)
+    assert resolve(reopened, refs, NEW_GRANT) == resolve(store, refs)
+    assert store.revision_path("proxy-a", 1).read_bytes() == original
+    before = store.authorization_path(NEW_GRANT).read_bytes()
+    authorize(reopened, refs)
+    assert store.authorization_path(NEW_GRANT).read_bytes() == before
+    for path in store.directory.rglob("*"):
+        if path.is_file():
+            assert USER.encode() not in path.read_bytes() and PASSWORD.encode() not in path.read_bytes()
+
+
+@pytest.mark.parametrize("field", list(NEW_GRANT))
+def test_added_grant_is_exact(store, field):
+    refs = put(store)
+    authorize(store, refs)
+    with pytest.raises(SecretError, match="SECRET_ACCESS_DENIED"):
+        resolve(store, refs, {**NEW_GRANT, field: "other"})
+
+
+def test_added_grant_cannot_cross_owner_or_change_retry(store):
+    refs = put(store)
+    with pytest.raises(SecretError, match="SECRET_ACCESS_DENIED"):
+        authorize(store, refs, {**NEW_GRANT, "owner": "mallory"})
+    authorize(store, refs)
+    second = put(store, 2)
+    for changed_refs, grant, digest in [(refs, {**NEW_GRANT, "home": "other"}, "a" * 64), (refs, NEW_GRANT, "b" * 64), (second, NEW_GRANT, "a" * 64)]:
+        with pytest.raises(SecretError, match="SECRET_AUTHORIZATION_CONFLICT"):
+            authorize(store, changed_refs, grant, digest)
+    with pytest.raises(SecretError, match="SECRET_ACCESS_DENIED"):
+        resolve(store, second, NEW_GRANT)
+
+
+def test_added_grant_tampering_and_unsafe_files_fail_closed(store):
+    refs = put(store)
+    authorize(store, refs)
+    path = store.authorization_path(NEW_GRANT)
+    original = path.read_bytes()
+    value = json.loads(original)
+    value["payload"]["grant"]["home"] = "attacker"
+    path.write_text(json.dumps(value))
+    with pytest.raises(SecretError, match="SECRET_AUTHENTICATION_FAILED"):
+        resolve(store, refs, {**NEW_GRANT, "home": "attacker"})
+    path.write_bytes(original)
+    path.chmod(0o644)
+    with pytest.raises(SecretError):
+        resolve(store, refs, NEW_GRANT)
+    path.chmod(0o600)
+    other = path.with_suffix(".copy")
+    path.rename(other); path.symlink_to(other)
+    with pytest.raises(SecretError):
+        resolve(store, refs, NEW_GRANT)
+
+
+def test_added_grants_follow_recovery_lock_and_version_revocation(store):
+    refs = put(store)
+    authorize(store, refs)
+    (store.directory / ".recovery-pending").touch(mode=0o600)
+    with pytest.raises(SecretError, match="SECRET_RECOVERY_LOCKED"):
+        authorize(store, refs)
+    with pytest.raises(SecretError, match="SECRET_RECOVERY_LOCKED"):
+        resolve(store, refs, NEW_GRANT)
+    (store.directory / ".recovery-pending").unlink()
+    store.revoke(refs["password"], "b" * 32)
+    for grant in [GRANT, NEW_GRANT]:
+        with pytest.raises(SecretError, match="SECRET_REVOKED"):
+            resolve(store, refs, grant)
+    with pytest.raises(SecretError, match="SECRET_REVOKED"):
+        authorize(store, refs)
