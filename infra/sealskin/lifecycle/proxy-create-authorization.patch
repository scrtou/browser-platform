+                                    request.password_secret_ref, request.request_sha256)
+    except SecretError as exc:
+        status = 409 if exc.code == "SECRET_AUTHORIZATION_CONFLICT" else 403 if exc.code == "SECRET_ACCESS_DENIED" else _secret_status(exc.code)
