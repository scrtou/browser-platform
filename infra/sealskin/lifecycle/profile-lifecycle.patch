+@pytest.mark.asyncio
+async def test_new_environment_recovery_uses_original_key_and_fresh_nonces(tmp_path, monkeypatch):
+    original = await saved()
+    first = secrets.read(database())
+    await config_store.save_sessions()
+    assert secrets.read(database())["nonce"] != first["nonce"]
+    target = tmp_path / "restored"
+    target.mkdir(mode=0o700)
+    shutil.copy2(database(), target / "sessions.yml")
+    shutil.copytree(secrets.key_path(database()).parent, target / "session-secrets")
+    monkeypatch.setattr(settings, "sessions_db_path", str(target / "sessions.yml"))
+    state.sessions.clear()
+    await config_store.load_sessions()
+    assert state.sessions == original
+    await config_store.save_sessions()
+    assert secrets.decode(secrets.read(database()), database()) == original
