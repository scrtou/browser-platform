+class RuntimeDrift(ValueError):
+    def __init__(self, code, binding=None, containers=None, isolate=False):
+        super().__init__(code)
+        self.code, self.binding, self.containers, self.isolate = code, binding or {}, containers or {}, isolate
+
+
+class ExitHistoryInvalid(ValueError):
+    pass
+
+
+def stable_binding_sha256(binding):
+    # Restarting the same owned containers invalidates fresh evidence, but it
+    # must not turn a changed exit into this generation's first observation.
+    return network.digest({key: value for key, value in binding.items() if not key.endswith("_started_at")})
+
+
+def exit_history(reservation, binding, spec, now):
+    """Read comparison-only history; it never grants access or freshness."""
+    value = reservation.get("coherence_exit_history")
+    if value is None:
+        return None
+    valid = (isinstance(value, dict) and set(value) == {"version", "generation", "binding_sha256", "observation"} and
+             type(value.get("version")) is int and value["version"] == 1 and
+             value.get("generation") == generation(reservation) and
+             value.get("binding_sha256") == stable_binding_sha256(binding))
+    observation = value.get("observation") if valid else None
+    valid = (isinstance(observation, dict) and set(observation) == {"browser_ip", "observed_at", "checked_at", "source", "nonce"} and
+             observation.get("source") == "https://" + spec.observer_domain + ":" + str(spec.observer_port) and
+             isinstance(observation.get("nonce"), str) and re.fullmatch(r"[a-f0-9]{32}", observation["nonce"]) and
+             all(type(observation.get(key)) in {int, float} and math.isfinite(observation[key]) for key in ("checked_at", "observed_at")) and
+             0 < observation["checked_at"] <= now and observation["checked_at"] - 5 <= observation["observed_at"] <= now + 5)
+    try:
+        valid = (valid and isinstance(observation.get("browser_ip"), str) and
+                 str(ipaddress.IPv4Address(observation["browser_ip"])) == observation["browser_ip"] and
+                 ipaddress.IPv4Address(observation["browser_ip"]).is_global)
+    except ValueError:
+        valid = False
+    if not valid:
+        raise ExitHistoryInvalid("COHERENCE_EXIT_HISTORY_INVALID")
+    return copy.deepcopy(observation)
+
+
+def retain_exit(reservation, binding, report):
+    actual = report.get("exit") or {}
+    if not actual:
+        return
+    reservation["coherence_exit_history"] = {
+        "version": 1, "generation": generation(reservation), "binding_sha256": stable_binding_sha256(binding),
+        "observation": {"browser_ip": actual["browser_ip"], "observed_at": actual["observed_at"],
+                        "source": actual["source"], "checked_at": report["checked_at"], "nonce": report["nonce"]}}
+
+
+def directory(reservation):
+    identity = reservation["identity"]
+    return network.runtime_dir() / (identity["home_hash"] + "-" + identity["operation"])
+
+
+def generation(reservation):
+    return network.digest({"identity": reservation["identity"], "policy_sha256": reservation["policy_sha256"]})
+
+
+def result_directory(reservation, role):
+    if role not in {"worker", "guard", "relay"}:
+        raise ValueError("COHERENCE_ROLE_INVALID")
