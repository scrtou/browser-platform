+async def test_healthy_worker_is_observed_without_secrets(containers, display):
+    worker = await session(containers)
+    state.sessions[SID].update(ip="172.18.0.9", port=3000, custom_user="abc", password="display-secret",
+                               access_token="token-secret")
+    result = await observe()
