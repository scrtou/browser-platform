diff --git a/server/app/browser_observe.py b/server/app/browser_observe.py
new file mode 100644
index 0000000..6b8dd6e
--- /dev/null
+++ b/server/app/browser_observe.py
@@ -0,0 +1,348 @@
+"""Fixed Worker-side observer, executed by the owning controller via Docker exec.
+
+Standard library only. Never reads user pages, cookies or input; the only page
+read belongs to the hidden tab this invocation created. No network listener.
+"""
+
+from __future__ import annotations
+
+import fcntl
+import hashlib
+import http.client
+import ipaddress
+import json
+import os
+from pathlib import Path
+import re
+import signal
+import socket
+import ssl
+import struct
+import sys
+import tempfile
+import time
+from urllib.parse import urlencode
+
+MAX_FRAME = 256 * 1024
+
+
+class ObservationError(Exception):
+    pass
+
+
+def json_value(raw):
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            if key in result:
+                raise ObservationError("OBSERVATION_DUPLICATE_FIELD")
+            result[key] = value
+        return result
+    return json.loads(raw, object_pairs_hook=pairs, parse_constant=lambda _: (_ for _ in ()).throw(ValueError()))
+
+
+class Channel:
+    def __init__(self, deadline):
+        self.deadline, self.identifier = deadline, 0
+        self.socket = socket.create_connection(("127.0.0.1", 2828), timeout=2)
+        hello = self.receive()
+        if hello.get("applicationType") != "gecko" or hello.get("marionetteProtocol") != 3:
+            raise ObservationError("BROWSER_CHANNEL_UNSUPPORTED")
+
+    def exact(self, size):
+        result = bytearray()
+        while len(result) < size:
+            remaining = self.deadline - time.monotonic()
+            if remaining <= 0:
+                raise TimeoutError()
+            self.socket.settimeout(remaining)
+            data = self.socket.recv(size - len(result))
+            if not data:
+                raise EOFError()
+            result.extend(data)
+        return bytes(result)
+
+    def receive(self):
+        prefix = bytearray()
+        while True:
+            part = self.exact(1)
+            if part == b":":
+                break
+            if not part.isdigit() or len(prefix) >= 7:
+                raise ObservationError("BROWSER_CHANNEL_INVALID_FRAME")
+            prefix.extend(part)
+        if not prefix or not 0 < int(prefix) <= MAX_FRAME:
+            raise ObservationError("BROWSER_CHANNEL_INVALID_FRAME")
+        return json_value(self.exact(int(prefix)))
+
+    def call(self, command, params=None):
+        self.identifier += 1
+        raw = json.dumps([0, self.identifier, command, params or {}], separators=(",", ":")).encode()
+        self.socket.settimeout(max(.001, self.deadline - time.monotonic()))
+        self.socket.sendall(str(len(raw)).encode() + b":" + raw)
+        result = self.receive()
+        if not isinstance(result, list) or len(result) != 4 or result[:2] != [1, self.identifier]:
+            raise ObservationError("BROWSER_CHANNEL_INVALID_REPLY")
+        if result[2] is not None:
+            # Driver error payloads may contain user prompt text. Never export it.
+            raise ObservationError("BROWSER_COMMAND_UNAVAILABLE")
+        return result[3]
+
+    def execute(self, source, args=None):
+        value = self.call("WebDriver:ExecuteScript", {"script": source, "args": args or [],
+                          "sandbox": None, "newSandbox": True})
+        return value["value"]
+
+
+def private_listener():
+    found = False
+    for name in ("tcp", "tcp6"):
+        for line in Path("/proc/net/" + name).read_text().splitlines()[1:]:
+            fields = line.split()
+            if fields[3] != "0A" or not fields[1].endswith(":0B0C"):
+                continue
+            if fields[1].split(":")[0] not in {"0100007F", "00000000000000000000000001000000"}:
+                raise ObservationError("BROWSER_CHANNEL_EXPOSED")
+            found = True
+    if not found:
+        raise ObservationError("BROWSER_CHANNEL_UNAVAILABLE")
+
+
+def exact(sock, size):
+    raw = b""
+    while len(raw) < size:
+        part = sock.recv(size - len(raw))
+        if not part:
+            raise EOFError()
+        raw += part
+    return raw
+
+
+def preflight(config):
+    """HTTPS from this Worker, through its exact SOCKS5 gateway; no resolver."""
+    domain = config["domain"].encode("ascii")
+    with socket.create_connection((config["relay_ip"], 1080), timeout=3) as raw:
+        raw.settimeout(4)
+        raw.sendall(b"\x05\x01\x00")
+        if exact(raw, 2) != b"\x05\x00":
+            raise ObservationError("PREFLIGHT_RELAY_FAILED")
+        raw.sendall(b"\x05\x01\x00\x03" + bytes([len(domain)]) + domain + struct.pack("!H", config["port"]))
+        head = exact(raw, 4)
+        if head[:3] != b"\x05\x00\x00":
+            raise ObservationError("PREFLIGHT_CONNECT_FAILED")
+        size = {1: 4, 4: 16}.get(head[3])
+        if head[3] == 3:
+            size = exact(raw, 1)[0]
+        if not size:
+            raise ObservationError("PREFLIGHT_RELAY_FAILED")
+        exact(raw, size + 2)
+        context = ssl.create_default_context(cadata=config["ca_pem"] or None)
+        context.minimum_version = ssl.TLSVersion.TLSv1_2
+        with context.wrap_socket(raw, server_hostname=config["domain"]) as tls:
+            query = urlencode({"nonce": config["nonce"], "phase": "preflight"})
+            tls.sendall((f"GET /whoami?{query} HTTP/1.1\r\nHost: {config['domain']}:{config['port']}\r\n"
+                         "Connection: close\r\nCache-Control: no-store\r\n\r\n").encode())
+            response = http.client.HTTPResponse(tls)
+            response.begin()
+            body = response.read(8193)
+            if response.status != 200 or len(body) > 8192:
+                raise ObservationError("PREFLIGHT_RESPONSE_INVALID")
+            return json_value(body)
+
+
+def denied_probes(config):
+    """Report actual attempts; the controller separately checks live nft rules."""
+    results = []
+    targets = [("direct_https", socket.AF_INET, config["ipv4"][0], config["port"]),
+               ("direct_dns_tcp", socket.AF_INET, config["dns_ip"], 53),
+               ("direct_ipv6", socket.AF_INET6, "2606:4700:4700::1111", 443)]
+    for name, family, host, port in targets:
+        with socket.socket(family, socket.SOCK_STREAM) as sock:
+            sock.settimeout(.3)
+            try:
+                code = sock.connect_ex((host, port))
+                escaped = code == 0
+            except OSError as exc:
+                code, escaped = exc.errno, False
+        results.append({"name": name, "connected": escaped, "errno": code})
+    labels = (config["nonce"] + "." + config["domain"]).split(".")
+    transaction = os.urandom(2)
+    query = transaction + b"\x01\x00\x00\x01\x00\x00\x00\x00\x00\x00" + b"".join(
+        bytes([len(label)]) + label.encode() for label in labels) + b"\x00\x00\x01\x00\x01"
+    for name, host, port, body in [("docker_dns", "127.0.0.11", 53, query),
+                                   ("direct_dns_udp", config["dns_ip"], 53, query),
+                                   ("stun_udp", config["ipv4"][0], 3478,
+                                    b"\x00\x01\x00\x00\x21\x12\xa4\x42" + bytes.fromhex(config["nonce"][:24]))]:
+        received, code = False, None
+        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
+            sock.settimeout(.3)
+            try:
+                sock.sendto(body, (host, port))
+                response, _ = sock.recvfrom(4096)
+                received = bool(response)
+            except OSError as exc:
+                code = exc.errno
+        results.append({"name": name, "connected": received, "errno": code})
+    return results
+
+
+def default_routes():
+    ipv4 = [line.split() for line in Path("/proc/net/route").read_text().splitlines()[1:]]
+    ipv6 = [line.split() for line in Path("/proc/net/ipv6_route").read_text().splitlines()]
+    return {"ipv4": any(row[1] == "00000000" and row[7] == "00000000" and int(row[3], 16) & 1 for row in ipv4),
+            "ipv6": any(row[0] == "0" * 32 and row[1] == "00" and int(row[8], 16) & 1
+                        and not int(row[8], 16) & 0x200 for row in ipv6)}
+
+
+def wait_page(channel, url):
+    while time.monotonic() < channel.deadline - 1:
+        # Never read text from an unexpected redirect or browser error page.
+        observed = channel.execute("const url=location.href;return {url,text:url===arguments[0]?(document.body?.textContent||''):''};", [url])
+        if observed["url"] == "about:blank":
+            time.sleep(.1)
+            continue
+        if observed["url"] != url or len(observed["text"]) > 128 * 1024:
+            raise ObservationError("BROWSER_OBSERVATION_SOURCE_INVALID")
+        try:
+            value = json_value(observed["text"])
+            if isinstance(value, dict) and value.get("complete") is True:
+                return value
+        except (ValueError, ObservationError):
+            pass
+        time.sleep(.1)
+    raise TimeoutError()
+
+
+CREATE_TAB = r"""
+const nonce=arguments[0];
+for (const tab of Array.from(gBrowser.tabs)) {
+  if (/^bp-observe-v1:[a-f0-9]{32}$/.test(tab.getAttribute('data-bp-observation')||''))
+    gBrowser.removeTab(tab,{animate:false});
+}
+const tab=gBrowser.addTab('about:blank',{triggeringPrincipal:Services.scriptSecurityManager.getSystemPrincipal(),skipAnimation:true,inBackground:true});
+tab.setAttribute('data-bp-observation','bp-observe-v1:'+nonce);
+gBrowser.hideTab(tab);
+tab.__bpSelected=false;
+tab.__bpListener=()=>{if(gBrowser.selectedTab===tab)tab.__bpSelected=true;};
+gBrowser.tabContainer.addEventListener('TabSelect',tab.__bpListener);
+const {NavigableManager}=ChromeUtils.importESModule('chrome://remote/content/shared/NavigableManager.sys.mjs');
+return {handle:String(NavigableManager.getIdForBrowser(tab.linkedBrowser)),hidden:tab.hidden,selected:gBrowser.selectedTab===tab};
+"""
+
+CLOSE_TAB = r"""
+const wanted='bp-observe-v1:'+arguments[0];
+const tabs=Array.from(gBrowser.tabs).filter(tab=>tab.getAttribute('data-bp-observation')===wanted);
+let selected=false;
+for (const tab of tabs) {
+  selected=selected||tab.__bpSelected||gBrowser.selectedTab===tab;
+  gBrowser.tabContainer.removeEventListener('TabSelect',tab.__bpListener);
+  gBrowser.removeTab(tab,{animate:false});
+}
+return {removed:tabs.length,selected};
+"""
+
+
+def browser_page(config, result):
+    private_listener()
+    channel = None
+    session = False
+    try:
+        channel = Channel(time.monotonic() + 17)
+        channel.call("WebDriver:NewSession", {"capabilities": {"alwaysMatch": {
+            "acceptInsecureCerts": False, "pageLoadStrategy": "eager", "unhandledPromptBehavior": "ignore",
+            "timeouts": {"script": 10000, "pageLoad": 12000, "implicit": 0}}}})
+        session = True
+        channel.call("Marionette:SetContext", {"value": "chrome"})
+        tab = channel.execute(CREATE_TAB, [config["nonce"]])
+        if tab["selected"] or not tab["hidden"]:
+            raise ObservationError("BROWSER_OBSERVATION_FOCUS_CHANGED")
+        channel.call("Marionette:SetContext", {"value": "content"})
+        channel.call("WebDriver:SwitchToWindow", {"handle": tab["handle"], "focus": False})
+        query = urlencode({"nonce": config["nonce"], "voices": config["voices"]})
+        url = f"https://{config['nonce']}.{config['domain']}:{config['port']}/environment-test.html?{query}"
+        channel.call("WebDriver:Navigate", {"url": url})
+        result["page"] = wait_page(channel, url)
+    finally:
+        # Cleanup has its own small budget, including after the total alarm.
+        signal.alarm(3)
+        result["cleanup"] = {"closed": False, "session_released": False}
+        if channel:
+            channel.deadline = time.monotonic() + 2
+            try:
+                if session:
+                    channel.call("Marionette:SetContext", {"value": "chrome"})
+                    cleanup = channel.execute(CLOSE_TAB, [config["nonce"]])
+                    result["cleanup"].update(closed=cleanup["removed"] == 1, selected=cleanup["selected"])
+                    channel.call("WebDriver:DeleteSession")
+                    result["cleanup"]["session_released"] = True
+            except (OSError, EOFError, ValueError, ObservationError):
+                pass
+            channel.socket.close()
+        signal.alarm(0)
+
+
+def run(config):
+    keys = {"version", "nonce", "binding_sha256", "domain", "port", "ipv4", "relay_ip", "dns_ip", "ca_pem",
+            "artifact_sha256", "acceptance_sha256", "voices"}
+    if (set(config) != keys or config["version"] != 1 or
+            not re.fullmatch(r"[a-f0-9]{32}", config["nonce"]) or
+            not re.fullmatch(r"[a-f0-9]{64}", config["binding_sha256"]) or
+            not re.fullmatch(r"[a-z0-9.-]{3,200}", config["domain"]) or
+            type(config["port"]) is not int or not 1 <= config["port"] <= 65535 or
+            type(config["voices"]) is not int or not 0 <= config["voices"] <= 256 or
+            not 1 <= len(config["ipv4"]) <= 8 or len(config["ca_pem"]) > 16384):
+        raise ObservationError("OBSERVER_INPUT_INVALID")
+    for ip in [*config["ipv4"], config["relay_ip"], config["dns_ip"]]:
+        ipaddress.IPv4Address(ip)
+    result = {"version": 1, "nonce": config["nonce"], "binding_sha256": config["binding_sha256"],
+              "started_at": time.time(), "status": "unknown", "code": "OBSERVATION_UNAVAILABLE"}
+    try:
+        for filename, key in (("environment.json", "artifact_sha256"), ("acceptance.json", "acceptance_sha256")):
+            path = Path("/run/browser-platform") / filename
+            raw = path.read_bytes()
+            if len(raw) > 1024 * 1024 or hashlib.sha256(raw).hexdigest() != config[key]:
+                raise ObservationError("WORKER_ARTIFACT_MISMATCH")
+        result["default_routes"] = default_routes()
+        result["native_probes"] = denied_probes(config)
+        result["preflight"] = preflight(config)
+        browser_page(config, result)
+        if not result["cleanup"]["closed"] or not result["cleanup"]["session_released"] or result["cleanup"].get("selected"):
+            raise ObservationError("BROWSER_OBSERVATION_CLEANUP_UNCONFIRMED")
+        result.update(status="pass", code="OBSERVATION_COLLECTED")
+    except ObservationError as exc:
+        result["code"] = str(exc)
+    except (OSError, EOFError, ValueError, KeyError, TypeError, http.client.HTTPException):
+        result["code"] = "OBSERVATION_UNAVAILABLE"
+    result["finished_at"] = time.time()
+    return result
+
+
+def main():
+    def expired(*_):
+        raise TimeoutError()
+    signal.signal(signal.SIGALRM, expired)
+    signal.alarm(25)
+    os.umask(0o077)
+    try:
+        if len(sys.argv) != 2 or len(sys.argv[1]) > 32768:
+            raise ObservationError("OBSERVER_INPUT_INVALID")
+        with open("/tmp/browser-platform-coherence.lock", "a") as lock:
+            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+            result = run(json_value(sys.argv[1]))
+        emit(result)
+    except (OSError, ValueError, ObservationError):
+        emit({"version": 1, "status": "unknown", "code": "OBSERVER_UNAVAILABLE"})
+    finally:
+        signal.alarm(0)
+
+
+def emit(result):
+    fd, temporary = tempfile.mkstemp(prefix=".bp-coherence-", dir="/run/browser-platform-observation")
+    with os.fdopen(fd, "w") as handle:
+        os.fchmod(handle.fileno(), 0o600)
+        json.dump(result, handle, separators=(",", ":"), allow_nan=False)
+    os.replace(temporary, "/run/browser-platform-observation/result.json")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/server/app/coherence_exec.py b/server/app/coherence_exec.py
new file mode 100644
index 0000000..3cce6fb
--- /dev/null
+++ b/server/app/coherence_exec.py
@@ -0,0 +1,85 @@
+"""Bounded, fixed detached commands; no Docker socket is given to Workers."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import os
+from pathlib import Path
+import secrets
+import stat
+import time
+
+from .network_runtime import unique_json
+
+OUTPUT_DIRECTORY = "/run/browser-platform-observation"
+OUTPUT = OUTPUT_DIRECTORY + "/result.json"
+INSPECT = ["python3", "-B", "/usr/local/lib/browser-platform/network-guard.py",
+           "--network-config", "/run/config/network.json", "--inspect", "--inspect-output"]
+
+
+def execute(client, container, command, user, nonce, timeout, result_directory):
+    started = time.monotonic()
+    value = client.api.exec_create(container.id, command, user=user, stdin=False, stdout=False, stderr=False,
+                                   tty=False, privileged=False)
+    client.api.exec_start(value["Id"], detach=True, tty=False)
+    while True:
+        state = client.api.exec_inspect(value["Id"])
+        if not state["Running"]:
+            if state.get("ExitCode") != 0:
+                raise ValueError("COHERENCE_EXEC_FAILED")
+            break
+        if time.monotonic() - started > timeout:
+            raise ValueError("COHERENCE_EXEC_TIMEOUT")
+        time.sleep(.1)
+    return read_result(result_directory, nonce)
+
+
+def read_result(result_directory, nonce):
+    # A dirfd keeps the read in the directory we validated even if the Worker
+    # atomically replaces its output. Neither a symlink nor a device/FIFO may
+    # turn the private result channel into an arbitrary or blocking read.
+    directory_fd = os.open(result_directory, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        info = os.fstat(directory_fd)
+        if stat.S_IMODE(info.st_mode) != 0o700 or info.st_uid != os.geteuid():
+            raise ValueError("COHERENCE_OUTPUT_INVALID")
+        with os.fdopen(os.open("result.json", os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
+                               dir_fd=directory_fd), "rb") as handle:
+            info = os.fstat(handle.fileno())
+            if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600 or
+                    info.st_uid != os.geteuid() or info.st_nlink != 1 or info.st_size > 256 * 1024):
+                raise ValueError("COHERENCE_OUTPUT_INVALID")
+            raw = handle.read(256 * 1024 + 1)
+            if len(raw) > 256 * 1024:
+                raise ValueError("COHERENCE_OUTPUT_TOO_LARGE")
+            result = json.loads(raw, object_pairs_hook=unique_json)
+    finally:
+        os.close(directory_fd)
+    if (not isinstance(result, dict) or type(result.get("version")) is not int or
+            result["version"] != 1 or result.get("nonce") != nonce):
+        raise ValueError("COHERENCE_OUTPUT_BINDING_INVALID")
+    return result
+
+
+async def bounded_execute(client, container, command, user, nonce, timeout, result_directory):
+    task = asyncio.create_task(asyncio.to_thread(execute, client, container, command, user, nonce, timeout, result_directory))
+    try:
+        return await asyncio.shield(task)
+    except asyncio.CancelledError:
+        # Do not release the Home lock while its detached observer still runs.
+        try:
+            await task
+        finally:
+            raise
+
+
+async def inspect_rules(client, container, result_directory):
+    nonce = secrets.token_hex(16)
+    return await bounded_execute(client, container, [*INSPECT, nonce], "0", nonce, 8, result_directory)
+
+
+async def observe_browser(client, container, config, result_directory):
+    script = Path(__file__).with_name("browser_observe.py").read_text()
+    return await bounded_execute(client, container, ["python3", "-c", script, json.dumps(config)],
+                                 "abc", config["nonce"], 30, result_directory)
diff --git a/server/app/coherence_geoip.py b/server/app/coherence_geoip.py
new file mode 100644
index 0000000..080193d
--- /dev/null
+++ b/server/app/coherence_geoip.py
@@ -0,0 +1,67 @@
+"""Versioned DB-IP Lite country inference; no online lookup or guessed location."""
+
+from __future__ import annotations
+
+import bisect
+from array import array
+import csv
+from datetime import datetime, timezone
+import ipaddress
+import re
+import threading
+
+from .coherence_policy import read_asset
+
+_CACHE = {}
+_LOCK = threading.Lock()
+
+
+def country(spec, address: str, now: float) -> dict:
+    result = {"status": "unknown", "code": "GEOIP_UNAVAILABLE", "country": None, "city": None,
+              "source": spec.geoip_source, "version": spec.geoip_version, "sha256": spec.geoip_sha256,
+              "published_at": spec.geoip_published_at, "inferred_at": now,
+              "confidence": "database_country_estimate"}
+    try:
+        if not spec.geoip_file:
+            return result
+        published = datetime.fromisoformat(spec.geoip_published_at.replace("Z", "+00:00"))
+        if published.tzinfo is None:
+            raise ValueError("missing timezone")
+        age = now - published.timestamp()
+        if age < 0 or age > spec.geoip_max_age_days * 86400:
+            result["code"] = "GEOIP_EXPIRED"
+            return result
+        # Revalidate the file on every inference. A cached parsed database must
+        # not hide deletion or revision drift. The country CSV is bounded.
+        raw = read_asset(spec.geoip_file, spec.geoip_sha256, 64 * 1024 * 1024)
+        key = spec.geoip_sha256
+        with _LOCK:
+            parsed = _CACHE.get(key)
+            if parsed is None:
+                starts, ends, countries = array("I"), array("I"), []
+                for row in csv.reader(line.decode("utf-8") for line in raw.splitlines()):
+                    if len(row) != 3 or not re.fullmatch(r"[A-Z]{2}", row[2]):
+                        raise ValueError("invalid country row")
+                    start, end = ipaddress.ip_address(row[0]), ipaddress.ip_address(row[1])
+                    if start.version != end.version or int(start) > int(end):
+                        raise ValueError("invalid address interval")
+                    if start.version != 4:
+                        continue
+                    if ends and int(start) <= ends[-1]:
+                        raise ValueError("overlapping country interval")
+                    starts.append(int(start)); ends.append(int(end)); countries.append(row[2])
+                if not starts:
+                    raise ValueError("no IPv4 intervals")
+                parsed = starts, ends, countries
+                _CACHE.clear()  # One parsed version, with a retained local reference.
+                _CACHE[key] = parsed
+        value = ipaddress.IPv4Address(address)
+        if not value.is_global:
+            raise ValueError("non-public exit")
+        starts, ends, countries = parsed
+        position = bisect.bisect_right(starts, int(value)) - 1
+        if position >= 0 and int(value) <= ends[position] and countries[position] != "ZZ":
+            result.update(status="pass", code="GEOIP_COUNTRY_INFERRED", country=countries[position])
+    except (OSError, ValueError, UnicodeError, csv.Error):
+        pass
+    return result
diff --git a/server/app/coherence_policy.py b/server/app/coherence_policy.py
new file mode 100644
index 0000000..2e2cca1
--- /dev/null
+++ b/server/app/coherence_policy.py
@@ -0,0 +1,106 @@
+"""Operator-owned inputs for current-generation browser observation."""
+
+from __future__ import annotations
+
+import hashlib
+import ipaddress
+import re
+import stat
+from pathlib import Path
+from urllib.parse import urlsplit
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from pydantic import BaseModel, ConfigDict, Field, model_validator
+
+SHA = r"^[a-f0-9]{64}$"
+
+
+class CoherencePolicy(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+
+    mode: str = Field(pattern=r"^(advisory|strict)$")
+    allowed_countries: list[str] = Field(default_factory=list, max_length=64)
+    allowed_timezones: list[str] = Field(default_factory=list, max_length=64)
+    on_exit_change: str = Field(default="recheck", pattern=r"^(recheck|block)$")
+    observer_domain: str = Field(min_length=3, max_length=200)
+    observer_port: int = Field(default=443, ge=1, le=65535)
+    observer_ipv4: list[str] = Field(min_length=1, max_length=8)
+    artifact_file: str
+    artifact_sha256: str = Field(pattern=SHA)
+    acceptance_file: str
+    acceptance_sha256: str = Field(pattern=SHA)
+    geoip_file: str = ""
+    geoip_sha256: str = ""
+    geoip_source: str = ""
+    geoip_version: str = Field(default="", max_length=128)
+    geoip_published_at: str = ""
+    geoip_max_age_days: int = Field(default=62, ge=1, le=93)
+
+    @model_validator(mode="after")
+    def validate_options(self):
+        domain = self.observer_domain
+        if (domain != domain.lower() or "." not in domain or
+                not all(re.fullmatch(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", label) for label in domain.split("."))):
+            raise ValueError("COHERENCE_OBSERVER_INVALID")
+        try:
+            ipaddress.ip_address(domain)
+        except ValueError:
+            pass
+        else:
+            raise ValueError("COHERENCE_OBSERVER_DOMAIN_REQUIRED")
+        if len(set(self.observer_ipv4)) != len(self.observer_ipv4):
+            raise ValueError("COHERENCE_OBSERVER_INVALID")
+        for ip in self.observer_ipv4:
+            value = ipaddress.IPv4Address(ip)
+            if not value.is_global or str(value) != ip:
+                raise ValueError("COHERENCE_OBSERVER_PUBLIC_IPV4_REQUIRED")
+        if (len(set(self.allowed_countries)) != len(self.allowed_countries) or
+                any(not re.fullmatch(r"[A-Z]{2}", country) for country in self.allowed_countries)):
+            raise ValueError("COHERENCE_COUNTRIES_INVALID")
+        if len(set(self.allowed_timezones)) != len(self.allowed_timezones):
+            raise ValueError("COHERENCE_TIMEZONES_INVALID")
+        for zone in self.allowed_timezones:
+            try:
+                ZoneInfo(zone)
+            except (ZoneInfoNotFoundError, ValueError):
+                raise ValueError("COHERENCE_TIMEZONES_INVALID") from None
+        if self.mode == "strict" and not (self.allowed_countries or self.allowed_timezones):
+            raise ValueError("COHERENCE_STRICT_CONSTRAINT_REQUIRED")
+        if bool(self.geoip_file) != bool(self.geoip_sha256) or self.geoip_sha256 and not re.fullmatch(SHA, self.geoip_sha256):
+            raise ValueError("COHERENCE_GEOIP_REVISION_INVALID")
+        if self.geoip_file:
+            source = urlsplit(self.geoip_source)
+            if source.scheme != "https" or not source.hostname or source.username or source.password or source.query or source.fragment:
+                raise ValueError("COHERENCE_GEOIP_SOURCE_INVALID")
+            if not self.geoip_version:
+                raise ValueError("COHERENCE_GEOIP_SOURCE_INVALID")
+        return self
+
+
+def validate_probe_origin(policy):
+    if not policy.coherence:
+        return
+    spec = policy.coherence
+    parsed = urlsplit(policy.probe_url)
+    if (parsed.scheme != "https" or parsed.hostname != spec.observer_domain or
+            (parsed.port or 443) != spec.observer_port or parsed.path != "/health" or
+            parsed.username or parsed.password or parsed.query or parsed.fragment):
+        raise ValueError("COHERENCE_PROBE_ORIGIN_MISMATCH")
+
+
+def read_asset(path: str, expected: str, limit: int = 1024 * 1024) -> bytes:
+    """Only immutable inputs beneath the controller's private assets directory."""
+    from .network_runtime import base_dir
+
+    value = Path(path)
+    root = base_dir() / "coherence-assets"
+    if (not value.is_absolute() or value.parent != root or root.is_symlink() or value.is_symlink() or
+            root.stat().st_mode & 0o077):
+        raise ValueError("COHERENCE_ASSET_INVALID")
+    info = value.stat()
+    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_nlink != 1 or info.st_size > limit:
+        raise ValueError("COHERENCE_ASSET_INVALID")
+    raw = value.read_bytes()
+    if len(raw) > limit or hashlib.sha256(raw).hexdigest() != expected:
+        raise ValueError("COHERENCE_ASSET_REVISION_MISMATCH")
+    return raw
diff --git a/server/app/coherence_report.py b/server/app/coherence_report.py
new file mode 100644
index 0000000..7a1578e
--- /dev/null
+++ b/server/app/coherence_report.py
@@ -0,0 +1,254 @@
+"""Evaluate facts, never an endpoint's self-declared health result."""
+
+from __future__ import annotations
+
+import ipaddress
+import errno
+import math
+import re
+
+from babel.core import get_global, parse_locale
+
+REQUIRED_CHECKS = {"observation", "user_agent", "platform", "oscpu", "cpu", "timezone", "locale", "languages", "intl_locale", "screen", "dpr",
+                   "webgl", "fonts", "canvas", "audio", "voices", "webrtc", "network_path", "dns", "ipv6", "direct_bypass", "exit_observation"}
+
+
+def check(name, status, required, code, message):
+    return {"name": name, "status": status, "required": required, "code": code, "message": message}
+
+
+def canonical_locale(value):
+    """Expand supported BCP 47 tags using the controller's locked CLDR data.
+
+    Page-provided maximize() values are measurements of that browser API, not
+    authoritative normalization. Unsupported extensions stay unknown; script,
+    territory and variant differences cannot be silently discarded.
+    """
+    if not isinstance(value, str) or len(value) > 128 or not re.fullmatch(r"[A-Za-z]{2,8}(?:-[A-Za-z0-9]{2,8})*", value):
+        return None
+    try:
+        language, territory, script, variant = parse_locale(value, sep="-")
+        alias = get_global("language_aliases").get(language)
+        if alias:
+            language, alias_territory, alias_script, _ = parse_locale(alias)
+            territory, script = territory or alias_territory, script or alias_script
+        territories = get_global("territory_aliases").get(territory)
+        if territories:
+            if len(territories) != 1:
+                return None
+            territory = territories[0]
+        script = get_global("script_aliases").get(script, script)
+        likely = get_global("likely_subtags")
+        keys = ["_".join(filter(None, parts)) for parts in
+                ((language, script, territory), (language, script), (language, territory), (language,))]
+        inferred = next((likely[key] for key in keys if key in likely), None)
+        if not inferred or language == "und":
+            return None
+        inferred_language, inferred_territory, inferred_script, _ = parse_locale(inferred)
+        return "-".join(filter(None, (language or inferred_language, script or inferred_script,
+                                      territory or inferred_territory, variant)))
+    except (ValueError, TypeError):
+        return None
+
+
+def overall(checks):
+    if any(value["required"] and value["status"] == "fail" for value in checks):
+        return "unhealthy"
+    if any(value["required"] and value["status"] != "pass" for value in checks):
+        return "unknown"
+    if any(not value["required"] and value["status"] in {"fail", "warn", "unknown"} for value in checks):
+        return "degraded"
+    return "healthy"
+
+
+def finalize(report):
+    report["overall"] = overall(report["checks"])
+    report["allowed"] = report["overall"] in {"healthy", "degraded"}
+    report["code"] = {"healthy": "COHERENCE_OK", "degraded": "COHERENCE_DEGRADED",
+                      "unknown": "COHERENCE_UNKNOWN", "unhealthy": "COHERENCE_FAILED"}[report["overall"]]
+    return report
+
+
+def unavailable(binding, mode, now, code="COHERENCE_UNOBSERVED"):
+    return finalize({"version": 1, "enabled": True, "mode": mode, "binding": binding,
+                     "checked_at": now, "expires_at": now, "nonce": "",
+                     "checks": [check("coherence", "unknown", True, code, "缺少当前代次的完整观测")],
+                     "expected": {}, "observed": {}, "exit": {}})
+
+
+def validate_cached(report, spec, now):
+    """Recompute the decision; a stored allowed flag is not an authorization."""
+    checks = report.get("checks")
+    valid = (isinstance(checks, list) and len(checks) <= 128 and all(
+        isinstance(row, dict) and isinstance(row.get("name"), str) and isinstance(row.get("code"), str) and
+        type(row.get("required")) is bool and row.get("status") in {"pass", "fail", "warn", "unknown", "not_applicable"}
+        for row in checks))
+    if not valid:
+        return unavailable(report.get("binding", {}), spec.mode, now, "COHERENCE_CACHE_INVALID")
+    names = {row["name"] for row in checks}
+    required = {row["name"] for row in checks if row["required"]}
+    mandatory = set(REQUIRED_CHECKS)
+    if spec.mode == "strict":
+        if spec.allowed_countries:
+            mandatory.add("country")
+        if spec.allowed_timezones:
+            mandatory.add("allowed_timezone")
+    valid = (type(report.get("version")) is int and report.get("version") == 1 and report.get("enabled") is True and report.get("mode") == spec.mode and
+             report.get("constraints") == {"allowed_countries": list(spec.allowed_countries), "allowed_timezones": list(spec.allowed_timezones),
+                                          "on_exit_change": spec.on_exit_change} and
+             all(type(report.get(key)) in {int, float} and math.isfinite(report[key]) for key in ("checked_at", "expires_at")) and
+             isinstance(report.get("nonce"), str) and re.fullmatch(r"[a-f0-9]{32}", report["nonce"]) and
+             len(names) == len(checks) and mandatory <= required)
+    if not valid:
+        report["checks"].append(check("cache_integrity", "unknown", True, "COHERENCE_CACHE_INCOMPLETE", "缓存缺少当前能力的完整分项"))
+    if report.get("leak_detected") or report.get("exit_change_blocked") or report.get("paused_for_isolation") or report.get("isolation_pause_failed"):
+        report["checks"].append(check("retained_failure", "fail", True, "COHERENCE_FAILURE_RETAINED", "保留本代次已确认的故障与阻断"))
+    return finalize(report)
+
+
+def valid_whoami(value, nonce, phase, started, now):
+    if (not isinstance(value, dict) or set(value) != {"version", "nonce", "phase", "public_ip", "server_time", "source_kind"} or
+            type(value.get("version")) is not int or value.get("version") != 1 or value.get("nonce") != nonce or value.get("phase") != phase or
+            value.get("source_kind") != "socket" or type(value.get("server_time")) not in {int, float} or
+            not math.isfinite(value["server_time"]) or not started - 5 <= value["server_time"] <= now + 5):
+        return False
+    try:
+        return isinstance(value["public_ip"], str) and str(ipaddress.IPv4Address(value["public_ip"])) == value["public_ip"] and ipaddress.IPv4Address(value["public_ip"]).is_global
+    except ValueError:
+        return False
+
+
+def evaluate(policy, artifact, baseline, binding, raw, facts, geo, nonce, started, now, previous=None, exit_history=None):
+    spec = policy.coherence
+    expected = artifact["spec"]
+    report = {"version": 1, "enabled": True, "mode": spec.mode, "network_mode": policy.mode, "binding": binding, "nonce": nonce,
+              "constraints": {"allowed_countries": list(spec.allowed_countries), "allowed_timezones": list(spec.allowed_timezones),
+                              "on_exit_change": spec.on_exit_change},
+              "checked_at": started, "expires_at": started + 60, "expected": {
+                  key: expected[key] for key in ("id", "revision", "locale", "languages", "timezone", "screen")},
+              "observed": {}, "exit": {}, "checks": [], "network_evidence": facts}
+    checks = report["checks"]
+    raw = raw if isinstance(raw, dict) else {}
+    bound = (raw.get("version") == 1 and raw.get("nonce") == nonce and
+             raw.get("binding_sha256") == facts.get("binding_sha256") and
+             type(raw.get("started_at")) in {int, float} and type(raw.get("finished_at")) in {int, float} and
+             started - 1 <= raw["started_at"] <= raw["finished_at"] <= now + 1 and now < started + 60)
+    checks.append(check("observation", "pass" if bound and raw.get("status") == "pass" else "unknown", True,
+                        "OBSERVATION_BOUND" if bound and raw.get("status") == "pass" else "OBSERVATION_UNAVAILABLE",
+                        "真实页面观测绑定当前采样" if bound else "观测缺失或绑定/时间不符"))
+    page = raw.get("page") if bound else {}
+    page = page if isinstance(page, dict) else {}
+    observed = page.get("observed") or {}
+    if page.get("version") != 1 or page.get("nonce") != nonce or page.get("complete") is not True or page.get("error"):
+        observed = {}
+    if not isinstance(observed, dict):
+        observed = {}
+
+    def equal(name, actual, wanted, code, required=True):
+        status = "unknown" if actual is None else "pass" if actual == wanted and type(actual) == type(wanted) else "fail"
+        checks.append(check(name, status, required, code + ("_OK" if status == "pass" else "_UNOBSERVED" if status == "unknown" else "_MISMATCH"),
+                            "当前页面与冻结测试值一致" if status == "pass" else "当前页面值缺失或与冻结配置不同"))
+
+    for key, name in (("userAgent", "user_agent"), ("platform", "platform"), ("oscpu", "oscpu"),
+                      ("hardwareConcurrency", "cpu"), ("timezone", "timezone"), ("locale", "locale"), ("languages", "languages")):
+        equal(name, observed.get(key), baseline.get(key), "ENVIRONMENT_" + name.upper())
+        if key in observed and observed[key] == baseline.get(key):
+            report["observed"][key] = observed[key]
+        elif key in {"timezone", "locale", "platform"} and isinstance(observed.get(key), str) and re.fullmatch(r"[A-Za-z0-9_ /+-]{1,128}", observed[key]):
+            report["observed"][key] = observed[key]
+    normalized = canonical_locale(observed.get("intlLocale"))
+    frozen_locale = canonical_locale(expected["locale"])
+    locale_status = "unknown" if normalized is None or frozen_locale is None else "pass" if normalized == frozen_locale else "fail"
+    report["locale_evidence"] = {"source": "Unicode CLDR 46 / Babel 2.17.0", "expected": frozen_locale, "intl": normalized}
+    if normalized is not None:
+        report["observed"]["intlLocale"] = observed["intlLocale"]
+    checks.append(check("intl_locale", locale_status, True,
+                        "INTL_LOCALE_OK" if locale_status == "pass" else "INTL_LOCALE_UNOBSERVED" if locale_status == "unknown" else "INTL_LOCALE_MISMATCH",
+                        "Intl 原始标签由控制端 CLDR 数据规范化，与冻结 locale 比较"))
+    screen = observed.get("screen")
+    actual_screen = {k: screen.get(k) for k in ("width", "height")} if isinstance(screen, dict) else None
+    equal("screen", actual_screen, {k: expected["screen"][k] for k in ("width", "height")}, "ENVIRONMENT_SCREEN")
+    # JSON has one numeric type at the interface; bool is not a DPR.
+    dpr = observed.get("deviceScaleFactor")
+    equal("dpr", float(dpr) if type(dpr) in {int, float} else None, float(expected["screen"]["deviceScaleFactor"]), "ENVIRONMENT_DPR")
+    if actual_screen:
+        report["observed"]["screen"] = actual_screen
+    if type(dpr) in {int, float} and math.isfinite(dpr):
+        report["observed"]["deviceScaleFactor"] = dpr
+    for key, name in (("webgl", "webgl"), ("fonts", "fonts"), ("canvasSHA256", "canvas"),
+                      ("audioSHA256", "audio"), ("voices", "voices")):
+        equal(name, observed.get(key), baseline.get(key), "CAPABILITY_" + name.upper())
+    equal("webrtc", observed.get("webrtcType"), "undefined", "WEBRTC_DISABLED")
+    equal("geolocation", observed.get("geolocationType"), "undefined", "GEOLOCATION_DISABLED", False)
+
+    status = facts.get("status", "unknown")
+    if status not in {"pass", "fail", "unknown"}:
+        status = "unknown"
+    checks.append(check("network_path", status, True, facts.get("code", "NETWORK_UNOBSERVED"), "实际命名空间、只读配置和 nft 规则核对"))
+    probes = raw.get("native_probes") if bound else None
+    names = {"direct_https", "direct_dns_tcp", "direct_ipv6", "docker_dns", "direct_dns_udp", "stun_udp"}
+    valid_probes = (isinstance(probes, list) and len(probes) == len(names) and all(isinstance(v, dict) and isinstance(v.get("name"), str) for v in probes) and
+                    {v.get("name") for v in probes} == names and all(type(v.get("connected")) is bool for v in probes))
+    by_name = {v["name"]: v["connected"] for v in probes} if valid_probes else {}
+    before_drop = (facts.get("guard") or {}).get("output_dropped_packets")
+    after_drop = (facts.get("after_guard") or {}).get("output_dropped_packets")
+    routes = raw.get("default_routes") if isinstance(raw.get("default_routes"), dict) else {}
+    # An isolated namespace without a default route rejects public destinations
+    # before nft output. Only that explicit kernel outcome can replace a drop;
+    # a silent UDP socket or a remote connection refusal cannot.
+    route_denied = {value["name"] for value in probes if value["name"] != "docker_dns" and
+                    type(value.get("errno")) is int and value["errno"] == errno.ENETUNREACH and
+                    routes.get("ipv6" if value["name"] == "direct_ipv6" else "ipv4") is False} if valid_probes else set()
+    required_drops = len(names - route_denied)
+    drops_confirmed = (type(before_drop) is int and type(after_drop) is int and after_drop - before_drop >= required_drops)
+    report["network_evidence"]["route_denied_probes"] = sorted(route_denied)
+    report["network_evidence"]["required_drop_delta"] = required_drops
+    leak = any(by_name.values())
+    report["leak_detected"] = leak
+    for name, targets in (("dns", ("docker_dns", "direct_dns_tcp", "direct_dns_udp")),
+                          ("ipv6", ("direct_ipv6",)), ("direct_bypass", ("direct_https", "stun_udp"))):
+        item_status = "fail" if any(by_name.get(key) for key in targets) else "pass" if valid_probes and status == "pass" and drops_confirmed else "unknown"
+        checks.append(check(name, item_status, True, name.upper() + ("_BYPASS_DETECTED" if item_status == "fail" else "_RESTRICTED" if item_status == "pass" else "_UNOBSERVED"),
+                            "拒绝尝试与当前防火墙证据联合判断；DNS 上游语义按冻结策略"))
+
+    pre = raw.get("preflight") if bound else None
+    actual = page.get("whoami") if isinstance(page, dict) else None
+    source_ok = valid_whoami(pre, nonce, "preflight", started, now) and valid_whoami(actual, nonce, "browser", started, now)
+    checks.append(check("exit_observation", "pass" if source_ok else "unknown", True,
+                        "EXIT_SOCKET_OBSERVED" if source_ok else "EXIT_UNOBSERVED", "来自受控 HTTPS 服务的两次实际 socket 源地址"))
+    if source_ok:
+        report["exit"] = {"preflight_ip": pre["public_ip"], "browser_ip": actual["public_ip"],
+                          "observed_at": actual["server_time"], "source": "https://" + spec.observer_domain + ":" + str(spec.observer_port),
+                          "geoip": geo}
+        if policy.mode == "direct":
+            expected_hosts = facts.get("host_ipv4", [])
+            valid_direct = pre["public_ip"] in expected_hosts and actual["public_ip"] in expected_hosts
+            checks.append(check("direct_exit", "pass" if valid_direct else "fail", True,
+                                "DIRECT_EXIT_OK" if valid_direct else "DIRECT_EXIT_MISMATCH", "DIRECT 出口与冻结原生主机地址比较"))
