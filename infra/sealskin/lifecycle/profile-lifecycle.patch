+@pytest.mark.asyncio
+@pytest.mark.parametrize("damage", ["missing_key", "wrong_key", "short_key", "ciphertext", "nonce", "version", "extra",
+                                    "truncated", "missing_database", "database_symlink", "key_symlink", "key_hardlink",
+                                    "key_mode", "directory_mode", "database_fifo"])
+async def test_damage_never_replaces_live_state_or_fabricates_a_key(tmp_path, damage):
+    original = await saved()
+    key = secrets.key_path(database())
+    old_key = key.read_bytes()
+    if damage == "missing_key":
+        key.unlink()
+    elif damage == "wrong_key":
+        key.write_bytes(os.urandom(32))
+    elif damage == "short_key":
+        key.write_bytes(b"short")
+    elif damage == "key_mode":
+        key.chmod(0o644)
+    elif damage == "directory_mode":
+        key.parent.chmod(0o755)
+    elif damage == "key_symlink":
+        target = tmp_path / "original-key"
+        key.rename(target)
+        key.symlink_to(target)
+    elif damage == "key_hardlink":
+        os.link(key, tmp_path / "another-key")
+    elif damage == "database_symlink":
+        target = tmp_path / "original-state"
+        database().rename(target)
+        database().symlink_to(target)
+    elif damage == "database_fifo":
+        database().unlink()
+        os.mkfifo(database())
+    elif damage == "missing_database":
+        database().unlink()
+    elif damage == "truncated":
+        database().write_text("ciphertext: [")
+    else:
+        value = secrets.read(database())
+        if damage == "ciphertext":
+            value["ciphertext"] = "A" + value["ciphertext"][1:] if value["ciphertext"][0] != "A" else "B" + value["ciphertext"][1:]
+        elif damage == "nonce":
+            value["nonce"] = "invalid"
+        elif damage == "version":
+            value["session_state_version"] = True
+        else:
+            value["unknown"] = "refuse"
+        database().write_text(yaml.safe_dump(value))
+    with pytest.raises(secrets.SessionStateUnavailable, match="^SESSION_STATE_UNAVAILABLE$"):
+        await asyncio.wait_for(config_store.load_sessions(), timeout=2)
+    assert state.sessions == original
+    if damage == "missing_key":
+        assert not key.exists()
+    elif damage not in {"wrong_key", "short_key"}:
+        assert key.read_bytes() == old_key
+
