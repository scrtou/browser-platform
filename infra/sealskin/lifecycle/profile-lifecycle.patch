+@pytest.mark.asyncio
+@pytest.mark.parametrize("phase", ["file_fsync", "replace", "directory_fsync"])
+async def test_failed_save_keeps_an_authenticated_old_or_new_snapshot(monkeypatch, phase):
+    original = await saved()
+    state.sessions["session-two"] = {"access_token": "second-synthetic-capability"}
+    desired = copy.deepcopy(state.sessions)
+    real_fsync, real_replace = os.fsync, os.replace
+
+    def fsync(descriptor):
+        directory = stat.S_ISDIR(os.fstat(descriptor).st_mode)
+        if (phase == "file_fsync" and not directory) or (phase == "directory_fsync" and directory):
+            raise OSError("synthetic-sync-failure")
+        return real_fsync(descriptor)
+
+    def replace(*args, **kwargs):
+        if phase == "replace":
+            raise OSError("synthetic-replace-failure")
+        return real_replace(*args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(os, "fsync", fsync)
+        patch.setattr(os, "replace", replace)
+        with pytest.raises(OSError):
+            await config_store.save_sessions()
+    persisted = secrets.decode(secrets.read(database()), database())
+    assert persisted == (desired if phase == "directory_fsync" else original)
+    assert not list(database().parent.glob(".tmp-*.yml"))
+    assert state.sessions == desired
+    await config_store.save_sessions()
+    assert secrets.decode(secrets.read(database()), database()) == desired
+
