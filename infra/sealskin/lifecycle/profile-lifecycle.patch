+    elif fault == "network-ipv6": egress.attrs["EnableIPv6"] = True
+    elif fault == "endpoint-ipv6": guard_links[internal.name]["GlobalIPv6Address"] = "2001:db8::4"
+    elif fault == "foreign-internal": internal.attrs["Containers"]["foreign"] = {"IPv4Address": "172.30.1.99/16"}
+    elif fault == "foreign-egress": egress.attrs["Containers"]["foreign"] = {"IPv4Address": "172.31.0.99/16"}
