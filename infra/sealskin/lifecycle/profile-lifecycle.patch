+"""Cache, access, expiry, ownership and failure preservation at the controller."""
+
+import asyncio
+import copy
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from fastapi import HTTPException
+
+from app import coherence_runtime as runtime, coherence_report as reports, coherence_exec
+from app import network_runtime as network
+from app.state import state
+from tests.test_coherence_report import inputs, evaluate, NOW, NONCE
+
+
+@pytest.fixture
+def generation(tmp_path, monkeypatch):
+    data = inputs()
+    policy = data[0]
+    monkeypatch.setattr(network, "NetworkPolicy", lambda **_: policy)
+    reservation = {"identity":{"scope":"qa","owner":"qa","home":"qa-home","home_hash":"a"*64,"app":"qa-app","profile":"qa","operation":"b"*32},
+                   "policy_id":"qa-r1","policy_sha256":"c"*64,"policy":{"coherence":{"mode":"strict"}},"allocation":{}}
+    binding={"application_id":"qa-app","profile_id":"qa","home_name":"qa-home","operation_id":"b"*32,"session_id":"session-1",
