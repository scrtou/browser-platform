+"""Authenticated, private persistence for Session display capabilities.
+
+The dedicated key is part of the encrypted control-state backup. It is never
+recreated over an encrypted database whose original key is missing.
+"""
+
+from __future__ import annotations
+
+import base64
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import stat
+
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+AAD = b"browser-platform/sealskin-session-state/v1"
+LIMIT = 16 * 1024 * 1024
+
+
+class SessionStateUnavailable(RuntimeError):
+    """A constant error; never include key, ciphertext or decoded contents."""
+
+    def __init__(self):
+        super().__init__("SESSION_STATE_UNAVAILABLE")
+
+
+def key_path(database: str | Path) -> Path:
+    return Path(database).parent / "session-secrets" / "state.key"
+
+
+def _directory(database: str | Path, create: bool = False) -> int:
+    path = key_path(database).parent.absolute()
+    if create:
+        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+        path.mkdir(mode=0o700, exist_ok=True)
+    if path.resolve() != path:
+        raise SessionStateUnavailable()
+    descriptor = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    info = os.fstat(descriptor)
+    if stat.S_IMODE(info.st_mode) != 0o700 or info.st_uid != os.geteuid():
+        os.close(descriptor)
+        raise SessionStateUnavailable()
+    return descriptor
+
+
+def _private_read(directory: int, name: str, size: int) -> bytes:
+    descriptor = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
+    with os.fdopen(descriptor, "rb") as source:
+        info = os.fstat(source.fileno())
+        if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600
+                or info.st_nlink != 1 or info.st_uid != os.geteuid()):
+            raise SessionStateUnavailable()
+        raw = source.read(size + 1)
+    if len(raw) != size:
+        raise SessionStateUnavailable()
+    return raw
+
+
+def _exists(directory: int, name: str) -> bool:
+    try:
+        os.stat(name, dir_fd=directory, follow_symlinks=False)
+        return True
+    except FileNotFoundError:
+        return False
+
+
+def _private_write(directory: int, name: str, raw: bytes) -> None:
+    # The directory lock serializes initializers. A crash leaves either the
+    # old file or a complete new file; it never leaves a truncated active key.
+    temporary = ".tmp-" + os.urandom(16).hex()
+    descriptor = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
+                         0o600, dir_fd=directory)
+    try:
+        with os.fdopen(descriptor, "wb") as output:
+            output.write(raw)
+            output.flush()
+            os.fsync(output.fileno())
+        os.replace(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
+        os.fsync(directory)
+    finally:
+        if _exists(directory, temporary):
+            os.unlink(temporary, dir_fd=directory)
+
+
+def _key(database: str | Path, create: bool, legacy_digest: bytes | None = None) -> bytes:
+    try:
+        directory = _directory(database, create)
+        try:
+            fcntl.flock(directory, fcntl.LOCK_EX)
+            if legacy_digest is not None:
+                if _exists(directory, "migration.pending"):
+                    if _private_read(directory, "migration.pending", 64) != legacy_digest:
+                        raise SessionStateUnavailable()
+                elif _exists(directory, "state.key"):
+                    # A sealed database must not silently downgrade to YAML.
+                    raise SessionStateUnavailable()
+                else:
+                    _private_write(directory, "migration.pending", legacy_digest)
+            if create and not _exists(directory, "state.key"):
+                _private_write(directory, "state.key", os.urandom(32))
+            return _private_read(directory, "state.key", 32)
+        finally:
+            os.close(directory)
+    except (OSError, ValueError):
+        raise SessionStateUnavailable() from None
+
+
+def finish_migration(database: str | Path) -> None:
+    """Commit only after the ciphertext database was durably replaced."""
+    try:
+        directory = _directory(database)
+        try:
+            fcntl.flock(directory, fcntl.LOCK_EX)
+            if _exists(directory, "migration.pending"):
+                _private_read(directory, "migration.pending", 64)
+                os.unlink("migration.pending", dir_fd=directory)
+                os.fsync(directory)
+        finally:
+            os.close(directory)
+    except OSError:
+        raise SessionStateUnavailable() from None
+
+
+def _validate(value):
+    if not isinstance(value, dict) or any(not isinstance(k, str) or not isinstance(v, dict) for k, v in value.items()):
+        raise SessionStateUnavailable()
+    return value
+
+
+def _json(value) -> bytes:
+    raw = json.dumps(_validate(value), sort_keys=True, separators=(",", ":"), allow_nan=False).encode()
+    if len(raw) > LIMIT:
+        raise SessionStateUnavailable()
+    return raw
+
+
+def sealed(value) -> bool:
+    return isinstance(value, dict) and "session_state_version" in value
+
+
+def encode(value, database: str | Path, *, migrate: bool = False):
+    _validate(value)
+    try:
+        raw = _json(value)
+        key = _key(database, create=migrate or not os.path.lexists(database),
+                   legacy_digest=hashlib.sha256(raw).hexdigest().encode() if migrate else None)
+        nonce = os.urandom(12)
+        ciphertext = AESGCM(key).encrypt(nonce, raw, AAD)
+        return {"session_state_version": 1, "algorithm": "AES-256-GCM",
+                "nonce": base64.b64encode(nonce).decode(), "ciphertext": base64.b64encode(ciphertext).decode()}
+    except (TypeError, ValueError, RecursionError):
+        raise SessionStateUnavailable() from None
+
+
+def decode(value, database: str | Path):
+    if not sealed(value):
+        try:
+            raw = _json(value)
+            if os.path.lexists(key_path(database).parent):
+                directory = _directory(database)
+                try:
+                    if _exists(directory, "state.key") or _exists(directory, "migration.pending"):
+                        if _private_read(directory, "migration.pending", 64) != hashlib.sha256(raw).hexdigest().encode():
+                            raise SessionStateUnavailable()
+                finally:
+                    os.close(directory)
+            return value
+        except (OSError, ValueError, TypeError, RecursionError):
+            raise SessionStateUnavailable() from None
+    if set(value) != {"session_state_version", "algorithm", "nonce", "ciphertext"} or type(value["session_state_version"]) is not int or value["session_state_version"] != 1 or value["algorithm"] != "AES-256-GCM":
+        raise SessionStateUnavailable()
+    try:
+        if not isinstance(value["nonce"], str) or not isinstance(value["ciphertext"], str) or len(value["ciphertext"]) > 2 * LIMIT:
+            raise SessionStateUnavailable()
+        nonce = base64.b64decode(value["nonce"], validate=True)
+        ciphertext = base64.b64decode(value["ciphertext"], validate=True)
+        if len(nonce) != 12 or len(ciphertext) > LIMIT + 16:
+            raise SessionStateUnavailable()
+        raw = AESGCM(_key(database, create=False)).decrypt(nonce, ciphertext, AAD)
+        return _validate(json.loads(raw))
+    except SessionStateUnavailable:
+        raise
+    except Exception:
+        raise SessionStateUnavailable() from None
+
+
+def read(database: str | Path):
+    """Read a bounded ordinary file; missing is handled by the caller."""
+    import yaml
+    try:
+        descriptor = os.open(database, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(descriptor, "rb") as source:
+            info = os.fstat(source.fileno())
+            if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_uid != os.geteuid() or info.st_size > 2 * LIMIT:
+                raise SessionStateUnavailable()
+            raw = source.read(2 * LIMIT + 1)
+        if len(raw) > 2 * LIMIT:
+            raise SessionStateUnavailable()
+        value = yaml.safe_load(raw)
+        return {} if value is None else value
+    except SessionStateUnavailable:
+        raise
+    except Exception:
+        raise SessionStateUnavailable() from None
