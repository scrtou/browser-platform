@@ -0,0 +1,250 @@
+"""Persisted Session capabilities must be authenticated ciphertext."""
+
+import asyncio
+import copy
+import os
+from pathlib import Path
+import shutil
+import stat
+
+import pytest
+import yaml
+
+from app import config_store, persistence, session_secrets as secrets
+from app.settings import settings
+from app.state import state
+
+
+@pytest.mark.asyncio
+async def test_session_persistence_contains_no_plaintext_capabilities():
+    secret = "synthetic-r5d-session-capability-5f2f31b8"
+    state.sessions["test-session"] = {"access_token": secret, "password": secret, "username": "owner"}
+    await config_store.save_sessions()
+    assert secret not in Path(settings.sessions_db_path).read_text()
+    state.sessions.clear()
+    await config_store.load_sessions()
+    assert state.sessions["test-session"]["access_token"] == secret
+
+
+def database():
+    return Path(settings.sessions_db_path)
+
+
+def legacy():
+    value = {"session-one": {"access_token": "synthetic-legacy-capability", "password": "synthetic-display-password",
+                              "lifecycle_phase": "stopping", "operation_id": "a" * 32}}
+    database().parent.mkdir(parents=True, exist_ok=True)
+    database().write_text(yaml.safe_dump(value))
+    return value
+
+
+async def saved():
+    state.sessions["session-one"] = {"access_token": "synthetic-encrypted-capability", "lifecycle_phase": "stopping"}
+    await config_store.save_sessions()
+    return copy.deepcopy(state.sessions)
+
+
+@pytest.mark.asyncio
+async def test_legacy_migration_keeps_intent_and_prevents_plaintext_downgrade():
+    original = legacy()
+    plaintext = database().read_bytes()
+    await config_store.load_sessions()
+    assert state.sessions == original
+    assert secrets.sealed(secrets.read(database()))
+    assert b"synthetic-legacy-capability" not in database().read_bytes()
+    assert secrets.key_path(database()).stat().st_mode & 0o777 == 0o600
+    assert secrets.key_path(database()).parent.stat().st_mode & 0o777 == 0o700
+    assert not secrets.key_path(database()).with_name("migration.pending").exists()
+    database().write_bytes(plaintext)
+    with pytest.raises(secrets.SessionStateUnavailable):
+        await config_store.load_sessions()
+    assert state.sessions == original and database().read_bytes() == plaintext
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("phase", ["before_write", "after_write"])
+async def test_migration_interruption_preserves_state_and_can_retry(monkeypatch, phase):
+    original = legacy()
+    plaintext = database().read_bytes()
+    resident = {"unrelated": {"operation_id": "keep-existing"}}
+    state.sessions.update(resident)
+
+    async def unavailable(*args, **kwargs):
+        raise OSError("synthetic-write-failure")
+
+    def fail_commit(*args):
+        raise secrets.SessionStateUnavailable()
+
+    with monkeypatch.context() as patch:
+        if phase == "before_write":
+            patch.setattr(persistence, "write_yaml", unavailable)
+        else:
+            patch.setattr(secrets, "finish_migration", fail_commit)
+        with pytest.raises((OSError, secrets.SessionStateUnavailable)):
+            await config_store.load_sessions()
+    assert state.sessions == resident
+    assert secrets.key_path(database()).with_name("migration.pending").is_file()
+    if phase == "before_write":
+        assert database().read_bytes() == plaintext
+    else:
+        assert secrets.sealed(secrets.read(database()))
+    await config_store.load_sessions()
+    assert state.sessions == {**resident, **original}
+    assert not secrets.key_path(database()).with_name("migration.pending").exists()
+
