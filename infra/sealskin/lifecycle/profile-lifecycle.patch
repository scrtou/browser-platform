+async def session(containers, *, managed=True):
+    worker = Container(containers, labels=labels() if managed else {})
+    containers.values[worker.id] = worker
+    state.sessions[SID] = {
+        "instance_id": INSTANCE, "username": "qa", "provider_app_id": "firefox",
