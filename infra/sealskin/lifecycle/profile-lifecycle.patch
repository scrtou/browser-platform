new file mode 100644
index 0000000..27d2e4b
--- /dev/null
+++ b/server/app/profile_health.py
@@ -0,0 +1,402 @@
+"""Read-only runtime health observations for one persistent Home.
+
+SealSkin keeps Docker ownership. An observation never creates, starts, stops or
+removes containers, never rewrites environment artifacts and never returns
+access tokens, display credentials, environment values or command lines. The
+Adapter binds these facts to its own Profile journal and computes the report.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import logging
+import os
+import socket
+import ssl
+import struct
+import time
+from typing import Any
+from urllib.parse import urlsplit
+from weakref import WeakValueDictionary
+
+import httpx
+from docker.errors import NotFound
+from fastapi import APIRouter, Depends, HTTPException
+
+from . import network_runtime
+from .docker_utils import get_docker_client
+from .profile_runtime import home_path, inspect_home, lifecycle_lock, runtime_identity
+from .security import EncryptedRoute, verify_token
+from .state import state
+
+logger = logging.getLogger(__name__)
+VERSION = 1
+BROWSER_MAIN = {"firefox", "firefox-bin", "firefox-esr", "camoufox", "camoufox-bin",
+                "chromium", "chromium-browser", "chrome", "google-chrome"}
+DISPLAY_SERVER = {"Xvfb", "Xorg", "Xwayland", "labwc", "sway", "weston"}
+STREAMER = {"selkies", "selkies-gstreamer"}
+ENVIRONMENT_KEYS = ("BROWSER_PLATFORM_ENVIRONMENT_ID", "BROWSER_PLATFORM_ARTIFACT_SHA256")
+DISPLAY_TIMEOUT = 2.0
+RELAY_TIMEOUT = 2.0
+MAX_PROCESS_ROWS = 4096
+_LOCKS: WeakValueDictionary[str, asyncio.Lock] = WeakValueDictionary()
+
+
+def health_lock(key: str) -> asyncio.Lock:
+    """Allow one in-flight observation per Home; later callers wait for their own turn."""
+    lock = _LOCKS.get(key)
+    if lock is None:
+        lock = asyncio.Lock()
+        _LOCKS[key] = lock
+    return lock
+
+
+def classify_processes(rows: list[Any]) -> dict[str, Any]:
+    """Summarize `ps -eo pid,args` rows without echoing any command line."""
+    summary: dict[str, Any] = {"total": 0, "browser_main": 0, "browser_child": 0,
+                               "display_server": [], "streamer": 0}
+    for row in rows[:MAX_PROCESS_ROWS]:
+        if not isinstance(row, (list, tuple)) or not row:
+            continue
+        args = str(row[-1]).split()
+        if not args:
+            continue
+        summary["total"] += 1
+        executable = os.path.basename(args[0])
+        if executable in BROWSER_MAIN:
+            child = any(arg == "-contentproc" or arg.startswith("--type=") for arg in args[1:])
+            summary["browser_child" if child else "browser_main"] += 1
+        elif executable in DISPLAY_SERVER:
+            if executable not in summary["display_server"]:
+                summary["display_server"].append(executable)
+        elif executable in STREAMER or any(os.path.basename(arg) in STREAMER for arg in args[1:3]):
+            summary["streamer"] += 1
+    return summary
+
+
+def _caddy_socket_inodes() -> set[int]:
+    inodes: set[int] = set()
+    for entry in os.listdir("/proc"):
+        if not entry.isdigit():
+            continue
+        try:
+            with open(f"/proc/{entry}/comm") as handle:
+                if handle.read().strip() != "caddy":
+                    continue
+            for fd in os.listdir(f"/proc/{entry}/fd"):
+                link = os.readlink(f"/proc/{entry}/fd/{fd}")
+                if link.startswith("socket:["):
+                    inodes.add(int(link[8:-1]))
+        except OSError:
+            continue
+    return inodes
+
+
+def _established_to(ip: str, port: int) -> dict[int, int]:
+    """Map socket inode → 1 for ESTABLISHED TCP connections whose peer is ip:port."""
+    import socket
+    import struct
+    wanted: dict[int, int] = {}
+    for path, family in (("/proc/net/tcp", "v4"), ("/proc/net/tcp6", "v6")):
+        try:
+            with open(path) as handle:
+                lines = handle.read().splitlines()[1:]
+        except OSError:
+            continue
+        for line in lines:
+            fields = line.split()
+            if len(fields) < 10 or fields[3] != "01":
+                continue
+            remote_hex, remote_port = fields[2].split(":")
+            if int(remote_port, 16) != port:
+                continue
+            try:
+                if family == "v4":
+                    remote = socket.inet_ntoa(struct.pack("<I", int(remote_hex, 16)))
+                else:
+                    raw = bytes.fromhex(remote_hex)
+                    words = [raw[i:i + 4][::-1] for i in range(0, 16, 4)]
+                    packed = b"".join(words)
+                    if packed[:12] != b"\x00" * 10 + b"\xff\xff":
+                        continue
+                    remote = socket.inet_ntoa(packed[12:])
+            except (ValueError, OSError):
+                continue
+            if remote == ip:
+                wanted[int(fields[9])] = 1
+    return wanted
+
+
+def display_connections(ip: str, port: int) -> int:
+    """Count authenticated display connections: Caddy-held ESTABLISHED sockets to the Worker.
+
+    Caddy proxies every authenticated Session request (including the Selkies
+    WebSocket) from this container; the API's own health requests use other
+    sockets and are excluded. -1 means the observation was not possible.
+    """
+    try:
+        held = _caddy_socket_inodes()
+        if not held:
+            return -1
+        return len([inode for inode in _established_to(ip, port) if inode in held])
+    except OSError:
+        return -1
+
+
+def worker_attributes(client, instance_id: str) -> dict[str, Any]:
+    """Read one container's state, environment identity and process summary."""
+    container = client.containers.get(instance_id)
+    attrs = container.attrs
+    environment = {}
+    for entry in attrs.get("Config", {}).get("Env") or []:
+        key, _, value = str(entry).partition("=")
+        if key in ENVIRONMENT_KEYS:
+            environment[key] = value
+    result = {"status": attrs.get("State", {}).get("Status", "unknown"),
+              "started_at": attrs.get("State", {}).get("StartedAt", ""),
+              "network_mode": attrs.get("HostConfig", {}).get("NetworkMode", ""),
+              "environment": {"id": environment.get(ENVIRONMENT_KEYS[0], ""),
+                              "artifact_sha256": environment.get(ENVIRONMENT_KEYS[1], "")}}
+    try:
+        top = container.top(ps_args="-eo pid,args")
+        result["processes"] = classify_processes(top.get("Processes") or [])
+    except Exception as exc:  # noqa: BLE001 - a stopped container has no process table
+        logger.info("Process observation unavailable for one Worker (%s).", type(exc).__name__)
+        result["processes"] = {"error": "PROCESSES_UNAVAILABLE"}
+    return result
+
+
+async def observe_display(endpoint: dict[str, Any] | None) -> dict[str, Any]:
+    """Request the Worker's display entry the way the controller proxies it."""
+    if not endpoint or not endpoint.get("ip") or not endpoint.get("port"):
+        return {"status": "unknown", "code": "DISPLAY_NO_RECORD"}
+    headers = {}
+    if endpoint.get("user") and endpoint.get("password"):
+        token = base64.b64encode(f"{endpoint['user']}:{endpoint['password']}".encode()).decode()
+        headers["Authorization"] = "Basic " + token
+    url = f"http://{endpoint['ip']}:{endpoint['port']}/"
+    started = time.monotonic()
+    try:
+        async with httpx.AsyncClient(timeout=DISPLAY_TIMEOUT, follow_redirects=True, headers=headers) as client:
+            response = await client.get(url)
+    except httpx.HTTPError as exc:
+        return {"status": "fail", "code": "DISPLAY_ENDPOINT_UNREACHABLE", "detail": type(exc).__name__,
+                "latency_ms": int((time.monotonic() - started) * 1000)}
+    latency = int((time.monotonic() - started) * 1000)
+    if response.status_code == 200:
+        return {"status": "pass", "code": "DISPLAY_ENDPOINT_OK", "latency_ms": latency}
+    return {"status": "fail", "code": "DISPLAY_ENDPOINT_HTTP_" + str(response.status_code), "latency_ms": latency}
+
+
+def exact(connection, size: int) -> bytes:
+    """Read a complete SOCKS5 field."""
+    data = b""
+    while len(data) < size:
+        chunk = connection.recv(size - len(data))
+        if not chunk:
+            raise OSError("incomplete reply")
+        data += chunk
+    return data
+
+
+def socks_greeting(connection) -> None:
+    connection.sendall(b"\x05\x01\x00")
+    if exact(connection, 2) != b"\x05\x00":
+        raise ConnectionRefusedError("relay handshake rejected")
+
+
+def relay_handshake(relay_ip: str, timeout: float = RELAY_TIMEOUT) -> dict[str, Any]:
+    """Confirm the generation's Relay accepts SOCKS5 clients from the internal network."""
+    started = time.monotonic()
+    try:
+        with socket.create_connection((relay_ip, 1080), timeout=timeout) as connection:
+            socks_greeting(connection)
+    except ConnectionRefusedError:
+        return {"status": "fail", "code": "PROXY_REJECTED", "latency_ms": int((time.monotonic() - started) * 1000)}
+    except OSError:
+        return {"status": "fail", "code": "PROXY_UNREACHABLE", "latency_ms": int((time.monotonic() - started) * 1000)}
+    return {"status": "pass", "code": "PROXY_RELAY_OK", "latency_ms": int((time.monotonic() - started) * 1000)}
+
+
+def upstream_probe(relay_ip: str, policy: network_runtime.NetworkPolicy) -> dict[str, Any]:
+    """Fetch the policy's probe URL through the Relay; distinguish endpoint faults from Relay faults."""
+    parsed = urlsplit(policy.probe_url)
+    host, port = parsed.hostname or "", parsed.port or 443
+    timeout = policy.probe_timeout_seconds
+    started = time.monotonic()
+
+    def finish(status: str, code: str, **extra: Any) -> dict[str, Any]:
+        return {"status": status, "code": code, "latency_ms": int((time.monotonic() - started) * 1000),
+                "measured_at": time.time(), **extra}
+
+    try:
+        if policy.probe_ca_file:
+            network_runtime.secret_source(policy.probe_ca_file, policy.probe_ca_sha256)
+    except HTTPException:
+        return finish("unknown", "PROXY_PROBE_CA_INVALID")
+    try:
+        connection = socket.create_connection((relay_ip, 1080), timeout=timeout)
+    except OSError:
+        return finish("fail", "PROXY_UNREACHABLE")
+    with connection:
+        try:
+            socks_greeting(connection)
+        except ConnectionRefusedError:
+            return finish("fail", "PROXY_REJECTED")
+        except OSError:
+            return finish("fail", "PROXY_UNREACHABLE")
+        try:
+            domain = host.encode("idna")
+            connection.sendall(b"\x05\x01\x00\x03" + bytes([len(domain)]) + domain + struct.pack("!H", port))
+            header = exact(connection, 4)
+            if header[:2] != b"\x05\x00":
+                # The Relay could not reach the upstream or the endpoint; the two are indistinguishable here.
+                return finish("unknown", "PROXY_UPSTREAM_UNKNOWN", reply=header[1])
+            size = {1: 4, 4: 16}.get(header[3])
+            if header[3] == 3:
+                size = exact(connection, 1)[0]
+            if size is None:
+                return finish("unknown", "PROXY_UPSTREAM_UNKNOWN")
+            exact(connection, size + 2)
+        except socket.timeout:
+            return finish("unknown", "PROXY_PROBE_TIMEOUT")
+        except OSError:
+            return finish("unknown", "PROXY_UPSTREAM_UNKNOWN")
+        try:
+            context = ssl.create_default_context(cafile=policy.probe_ca_file or None)
+            with context.wrap_socket(connection, server_hostname=host) as secure:
+                target = (parsed.path or "/") + ("?" + parsed.query if parsed.query else "")
+                authority = host if port == 443 else f"{host}:{port}"
+                secure.sendall((f"GET {target} HTTP/1.1\r\nHost: {authority}\r\n"
+                                "User-Agent: browser-platform-health-probe/1\r\nConnection: close\r\n\r\n").encode("ascii"))
+                response = b""
+                while b"\r\n" not in response and len(response) < 4096:
+                    response += exact(secure, 1)
+                parts = response.split(b" ", 2)
+                http_status = parts[1].decode("ascii", "replace") if len(parts) >= 2 else ""
+        except ssl.SSLError:
+            return finish("fail", "PROXY_TLS_INVALID")
+        except socket.timeout:
+            return finish("unknown", "PROXY_PROBE_TIMEOUT")
+        except OSError:
+            return finish("unknown", "PROXY_PROBE_UNEXPECTED")
+    if http_status == "200":
+        return finish("pass", "PROXY_OK")
+    return finish("unknown", "PROXY_PROBE_UNEXPECTED", http_status=http_status)
+
+
+async def observe_network(username: str, home_name: str, snapshot: dict[str, Any],
+                          workers: list[dict[str, Any]], upstream: bool) -> dict[str, Any] | None:
+    """Describe the managed generation's Relay/Guard from the controller's vantage point."""
+    resources = {item["kind"]: item for item in snapshot["resources"]}
+    if "reservation" not in resources:
+        return None
+    result: dict[str, Any] = {"phase": resources["reservation"]["status"],
+                              "policy_id": resources["reservation"]["policy_id"],
+                              "policy_sha256": resources["reservation"]["policy_sha256"],
+                              "enforcement_version": 0,
+                              "relay": {"container": resources.get("relay", {}).get("status", "missing"),
+                                        "status": "unknown", "code": "PROXY_UNOBSERVED"},
+                              "guard": {"container": resources.get("guard", {}).get("status", "missing")},
+                              "worker_namespace": None, "upstream": None}
+    try:
+        reservation = network_runtime.read_reservation(runtime_identity(username, home_name, "", "", ""))
+    except HTTPException:
+        result["code"] = "NETWORK_RESERVATION_INVALID"
+        return result
+    if not reservation:
+        result["code"] = "NETWORK_RESERVATION_MISSING"
+        return result
+    allocation = reservation.get("allocation") or {}
+    policy = network_runtime.NetworkPolicy(**reservation["policy"])
+    result["mode"] = policy.mode or "proxy_required"
+    if policy.mode == "direct":
+        result["approved_resolver_id"] = policy.approved_resolver_id
+        if allocation:
+            from .network_direct import validate_allocation
+            try:
+                client = await asyncio.to_thread(get_docker_client)
+                await asyncio.to_thread(validate_allocation, client, reservation)
+            except HTTPException as exc:
+                result["code"] = exc.detail
+                return result
+            except Exception:
+                result["code"] = "DIRECT_EVIDENCE_UNAVAILABLE"
+                return result
+    if allocation.get("enforcement_version") == 1:
+        result["enforcement_version"] = 1
+        expected = "container:" + allocation["guard_id"]
+        if workers:
+            result["worker_namespace"] = all(worker.get("network_mode") == expected for worker in workers)
+    relay_ip = allocation.get("relay_ip")
+    if not relay_ip:
+        result["relay"].update(status="unknown", code="PROXY_RELAY_UNALLOCATED")
+        return result
+    if result["relay"]["container"] != "running":
+        result["relay"].update(status="fail", code="PROXY_RELAY_NOT_RUNNING")
+        return result
+    result["relay"].update(await asyncio.to_thread(relay_handshake, relay_ip))
+    if upstream and result["relay"]["status"] == "pass":
+        result["upstream"] = await asyncio.to_thread(upstream_probe, relay_ip, policy)
+    return result
+
+
+async def observe_home(username: str, home_name: str, upstream: bool = False) -> dict[str, Any]:
+    """Snapshot under the Home lock, then observe outside it with bounded timeouts."""
+    path = home_path(username, home_name)
+    async with health_lock("health:" + path):
+        async with lifecycle_lock("home:" + path):
+            snapshot = await inspect_home(username, home_name)
+        endpoints: dict[str, dict[str, Any]] = {}
+        async with state.sessions_lock:
+            for record in snapshot["records"]:
+                data = state.sessions.get(record["session_id"]) or {}
+                for instance in record["instance_ids"]:
+                    endpoints[instance] = {"ip": data.get("ip"), "port": data.get("port"),
+                                           "user": data.get("custom_user"), "password": data.get("password")}
+        try:
+            client = await asyncio.to_thread(get_docker_client)
+        except Exception as exc:  # noqa: BLE001
+            logger.error("Health observation could not reach Docker (%s).", type(exc).__name__)
+            raise HTTPException(503, "Docker observation is unavailable; nothing was changed.") from exc
+        workers = []
+        for worker in snapshot["workers"]:
+            base = {"instance_id": worker["instance_id"], "session_id": worker["session_id"],
+                    "owned": worker["owned"], "recorded": worker["recorded"]}
+            try:
+                observed = await asyncio.to_thread(worker_attributes, client, worker["instance_id"])
+            except NotFound:
+                observed = {"status": "missing", "started_at": "", "network_mode": "",
+                            "environment": {"id": "", "artifact_sha256": ""}, "processes": {"error": "WORKER_MISSING"}}
+            except Exception as exc:  # noqa: BLE001
+                logger.error("Worker observation failed (%s).", type(exc).__name__)
+                observed = {"status": worker["status"], "started_at": "", "network_mode": "",
+                            "environment": {"id": "", "artifact_sha256": ""}, "processes": {"error": "PROCESSES_UNAVAILABLE"}}
+            endpoint = endpoints.get(worker["instance_id"])
+            connections = -1
+            if observed["status"] != "running":
+                display = {"status": "fail", "code": "DISPLAY_WORKER_NOT_RUNNING"}
+            elif not endpoint:
+                display = {"status": "unknown", "code": "DISPLAY_NO_RECORD"}
+            else:
+                display = await observe_display(endpoint)
+                if endpoint.get("ip") and endpoint.get("port"):
+                    connections = await asyncio.to_thread(display_connections, endpoint["ip"], int(endpoint["port"]))
+            workers.append({**base, **observed, "display": display, "display_connections": connections})
+    network = await observe_network(username, home_name, snapshot, workers, upstream)
+    from .coherence_runtime import report_for_home
+    coherence = await report_for_home(username, home_name, snapshot)
+    return {"version": VERSION, "home_name": home_name, "observed_at": time.time(),
+            "runtime": snapshot, "workers": workers, "network": network, "coherence": coherence}
+
+
+router = APIRouter(prefix="/api/profile-runtime", route_class=EncryptedRoute,
+                   dependencies=[Depends(verify_token)])
+
+
+@router.get("/{home_name}/health")
+async def get_profile_health(home_name: str, upstream: bool = False,
+                             user: dict[str, Any] = Depends(verify_token)) -> dict[str, Any]:
+    """Return fresh, token-free runtime observations; nothing is started, stopped or rebuilt."""
+    return await observe_home(user["username"], home_name, upstream)
diff --git a/server/app/profile_resume.py b/server/app/profile_resume.py
new file mode 100644
index 0000000..a2f5f40
--- /dev/null
+++ b/server/app/profile_resume.py
@@ -0,0 +1,362 @@
+"""Ordered resume of one dormant Profile generation after a daemon or host restart.
+
+A generation is dormant when its Session record survived but every owned
+container is stopped. Resume restarts what already exists and never creates a
+Worker: Relay → Guard (rules verified) → controller attachment → one-shot proxy
+and direct-path probe → Worker → display readiness. Any failed step leaves the
+Worker stopped and the reservation intact; nothing is removed.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import logging
+import socket
+import time
+from typing import Any
+
+import httpx
+from docker.errors import APIError, NotFound
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import ValidationError
+
+from . import config_store, network_runtime
+from .docker_utils import get_docker_client
+from .profile_runtime import (StopProfileRequest, home_path, inspect_home, lifecycle_lock,
+                              runtime_identity, validate_stop_inventory)
+from .security import EncryptedRoute, get_decrypted_request_body, verify_token
+from .state import state
+
+logger = logging.getLogger(__name__)
+DORMANT_STATES = {"exited", "created"}
+MANAGED_KINDS = {"reservation", "internal", "egress", "relay", "guard"}
+READY_TIMEOUT_SECONDS = 90
+RELAY_TIMEOUT_SECONDS = 15
+
+
+def reject(code: str, status_code: int = 409):
+    raise HTTPException(status_code, code)
+
+
+def classify(snapshot: dict[str, Any]) -> str:
+    """Return live, dormant, empty or mixed for one Home inventory."""
+    records, workers, resources = snapshot["records"], snapshot["workers"], snapshot["resources"]
+    if not records and not workers and not resources:
+        return "empty"
+    if len(records) != 1 or len(workers) != 1:
+        return "mixed"
+    record, worker = records[0], workers[0]
+    if record["is_collaboration"] or record["phase"] != "running":
+        return "mixed"
+    if not worker["owned"] or not worker["recorded"] or worker["session_id"] != record["session_id"]:
+        return "mixed"
+    kinds = {item["kind"] for item in resources}
+    if "probe" in kinds:
+        return "mixed"
+    if record.get("network_policy_id"):
+        if not MANAGED_KINDS <= kinds:
+            return "mixed"
+        if {item["status"] for item in resources if item["kind"] == "reservation"} - {"running", "worker_starting", "ready"}:
+            return "mixed"
+    elif resources:
+        return "mixed"
+    if worker["status"] == "running":
+        return "live"
+    if worker["status"] in DORMANT_STATES:
+        return "dormant"
+    return "mixed"
+
+
+def display_ready(ip: str, port: int, subfolder: str, user: str, password: str) -> bool:
+    headers = {}
+    if user and password:
+        headers["Authorization"] = "Basic " + base64.b64encode(f"{user}:{password}".encode()).decode()
+    try:
+        response = httpx.get(f"http://{ip}:{port}{subfolder}", timeout=2.0, follow_redirects=True, headers=headers)
+    except httpx.HTTPError:
+        return False
+    return response.status_code == 200
+
+
+def relay_accepts(relay_ip: str) -> bool:
+    try:
+        with socket.create_connection((relay_ip, 1080), timeout=2) as connection:
+            connection.sendall(b"\x05\x01\x00")
+            return connection.recv(2) == b"\x05\x00"
+    except OSError:
+        return False
+
+
+def started_epoch(container) -> int:
+    """Epoch seconds of the container's current start, floored for `docker logs --since`."""
+    value = (container.attrs.get("State") or {}).get("StartedAt") or ""
+    try:
+        from datetime import datetime
+        trimmed = value.rstrip("Z")
+        if "." in trimmed:
+            head, fraction = trimmed.split(".", 1)
+            trimmed = head + "." + fraction[:6]
+        return int(datetime.fromisoformat(trimmed + "+00:00").timestamp())
+    except ValueError:
+        return int(time.time()) - 5
+
+
+async def start_container(client, instance_id: str, code: str):
+    try:
+        container = await asyncio.to_thread(client.containers.get, instance_id)
+        await asyncio.to_thread(container.reload)
+        if container.status != "running":
+            await asyncio.to_thread(container.start)
+        deadline = time.monotonic() + 20
+        while True:
+            await asyncio.to_thread(container.reload)
+            if container.status == "running":
+                return container
+            if time.monotonic() >= deadline or container.status in {"exited", "dead"}:
+                reject(code, 503)
+            await asyncio.sleep(0.2)
+    except NotFound:
+        reject(code + "_MISSING", 409)
+    except APIError as exc:
+        logger.error("Resume could not start a generation container (%s).", type(exc).__name__)
+        reject(code, 503)
+
+
+async def ensure_controller_attached(client, identity, reservation, internal) -> None:
+    """Attach the current controller at the frozen address; never steal a live address."""
+    allocation = reservation["allocation"]
+    controller = await asyncio.to_thread(network_runtime.self_container, client)
+    previous = None
+    if reservation["controller_id"] != controller.id:
+        try:
+            previous = await asyncio.to_thread(client.containers.get, reservation["controller_id"])
+        except NotFound:
+            previous = None
+        if previous and previous.status not in {"exited", "dead"}:
+            reject("NETWORK_PREVIOUS_CONTROLLER_PRESENT")
+    await asyncio.to_thread(internal.reload)
+    for identifier, endpoint in internal.attrs.get("Containers", {}).items():
+        if (endpoint.get("IPv4Address", "").split("/")[0] == allocation["controller_ip"] and
+                identifier not in {controller.id, reservation["controller_id"]}):
+            reject("NETWORK_CONTROL_ADDRESS_OCCUPIED")
+    await asyncio.to_thread(controller.reload)
+    attached = controller.attrs.get("NetworkSettings", {}).get("Networks", {}).get(internal.name)
+    if attached and attached.get("IPAddress") != allocation["controller_ip"]:
+        reject("NETWORK_CONTROL_ADDRESS_CHANGED")
+    if previous and internal.name in previous.attrs.get("NetworkSettings", {}).get("Networks", {}):
+        await asyncio.to_thread(internal.disconnect, previous)
+    if not attached:
+        try:
+            await asyncio.to_thread(internal.connect, controller, ipv4_address=allocation["controller_ip"])
+        except Exception:
+            await asyncio.to_thread(controller.reload)
+            attached = controller.attrs.get("NetworkSettings", {}).get("Networks", {}).get(internal.name, {})
+            if attached.get("IPAddress") != allocation["controller_ip"]:
+                raise
+    await asyncio.to_thread(controller.reload)
+    attached = controller.attrs.get("NetworkSettings", {}).get("Networks", {}).get(internal.name, {})
+    if attached.get("IPAddress") != allocation["controller_ip"]:
+        reject("NETWORK_CONTROL_ATTACHMENT_UNCONFIRMED", 503)
+    if reservation["controller_id"] != controller.id:
+        reservation["controller_id"] = controller.id
+        await asyncio.to_thread(network_runtime.save_reservation, reservation)
+
+
+async def resume_managed(client, identity, snapshot, steps: list[str]) -> dict[str, Any]:
+    """Bring the frozen network up in order and prove it before the Worker starts."""
+    reservation = network_runtime.read_reservation(identity)
+    allocation = (reservation or {}).get("allocation") or {}
+    if not reservation or allocation.get("enforcement_version") != 1:
+        reject("RESUME_RESERVATION_INCOMPLETE")
+    resources = {item["kind"]: item for item in snapshot["resources"]}
+    expected = {kind: allocation[kind + "_id"] for kind in ("internal", "egress", "relay", "guard")}
+    if any(resources[kind]["id"] != expected[kind] for kind in expected):
+        reject("RESUME_ALLOCATION_MISMATCH")
+    policy = network_runtime.NetworkPolicy(**reservation["policy"])
+    if policy.coherence:
+        from .coherence_runtime import validate_gate_mount, write_gate
+        relay = await asyncio.to_thread(client.containers.get, allocation["relay_id"])
+        await asyncio.to_thread(validate_gate_mount, reservation, relay)
+        write_gate(reservation, "probe")
+    if policy.mode == "direct":
+        from .network_direct import validate_allocation
+        await asyncio.to_thread(validate_allocation, client, reservation)
+    else:
+        from .network_dns import validate_allocation
+        await asyncio.to_thread(validate_allocation, client, reservation)
+    if policy.username_secret_ref:
+        from .secret_runtime import materialize
+        materialize(policy, identity)
+    await network_runtime.set_phase(identity, "worker_starting")
+    try:
+        internal = await asyncio.to_thread(client.networks.get, allocation["internal_id"])
+    except NotFound:
+        reject("RESUME_NETWORK_MISSING")
+    relay = await start_container(client, allocation["relay_id"], "RESUME_RELAY_FAILED")
+    await asyncio.to_thread(relay.reload)
+    if relay.attrs["NetworkSettings"]["Networks"].get(internal.name, {}).get("IPAddress") != allocation["relay_ip"]:
+        reject("RESUME_RELAY_ADDRESS_CHANGED", 503)
+    steps.append("relay")
+    guard = await start_container(client, allocation["guard_id"], "RESUME_GUARD_FAILED")
+    await network_runtime.wait_guard(guard, allocation["guard_config_sha256"], since=started_epoch(guard))
+    await asyncio.to_thread(guard.reload)
+    if guard.attrs["NetworkSettings"]["Networks"].get(internal.name, {}).get("IPAddress") != allocation["guard_ip"]:
+        reject("RESUME_GUARD_ADDRESS_CHANGED", 503)
+    steps.append("guard")
+    await ensure_controller_attached(client, identity, reservation, internal)
+    steps.append("controller")
+    deadline = time.monotonic() + RELAY_TIMEOUT_SECONDS
+    while not await asyncio.to_thread(relay_accepts, allocation["relay_ip"]):
+        if time.monotonic() >= deadline:
+            reject("RESUME_RELAY_NOT_ACCEPTING", 503)
+        await asyncio.sleep(0.5)
+    steps.append("relay-accepting")
+    policy = network_runtime.NetworkPolicy(**reservation["policy"])
+    try:
+        await network_runtime.run_probe(client, reservation, policy, allocation)
+    except HTTPException:
+        # The one-shot probe belongs to this resume attempt; remove it so the
+        # generation stays dormant (retryable) instead of mixed.
+        await remove_probe(client, identity)
+        raise
+    steps.append("probe")
+    return allocation
+
+
+async def remove_probe(client, identity) -> None:
+    from .providers.docker_provider import DockerProvider
+
+    name = network_runtime.resource_name(identity, "probe")
+    try:
+        probe = await asyncio.to_thread(client.containers.get, name)
+    except NotFound:
+        return
+    try:
+        await DockerProvider({"provider_config": {}}).stop(probe.id)
+    except Exception as exc:  # noqa: BLE001
+        logger.warning("Resume could not remove its failed probe container (%s).", type(exc).__name__)
+
+
+async def wait_display(ip: str, session: dict[str, Any], session_id: str) -> bool:
+    deadline = time.monotonic() + READY_TIMEOUT_SECONDS
+    port = int(session.get("port") or 0)
+    while time.monotonic() < deadline:
+        if port and await asyncio.to_thread(display_ready, ip, port, f"/{session_id}/",
+                                            session.get("custom_user") or "", session.get("password") or ""):
+            return True
+        await asyncio.sleep(2)
+    return False
+
+
+async def resume_profile_locked(username: str, home_name: str, request: StopProfileRequest) -> dict[str, Any]:
+    from .secret_runtime import credential_guard
+
+    identity = runtime_identity(username, home_name, request.application_id, request.profile_id, request.operation_id)
+    reservation = network_runtime.read_reservation(identity)
+    policy = network_runtime.NetworkPolicy(**reservation["policy"]) if reservation else None
+    async with credential_guard(policy):
+        return await _resume_profile_locked(username, home_name, request)
+
+
+async def _resume_profile_locked(username: str, home_name: str, request: StopProfileRequest) -> dict[str, Any]:
+    from .providers.docker_provider import DockerProvider
+
+    snapshot = await inspect_home(username, home_name)
+    validate_stop_inventory(snapshot, request)
+    kind = classify(snapshot)
+    record, worker = (snapshot["records"] or [None])[0], (snapshot["workers"] or [None])[0]
+    if kind == "live":
+        from .coherence_runtime import access_locked
+        access = await access_locked(username, home_name, request)
+        if not access["allowed"]:
+            reject("COHERENCE_SESSION_NOT_READY", 503)
+        return {"resumed": False, "state": "live", "session_id": record["session_id"], "instance_id": worker["instance_id"], "steps": []}
+    if kind != "dormant":
+        reject("RESUME_NOT_DORMANT")
+    identity = runtime_identity(username, home_name, request.application_id, request.profile_id, request.operation_id)
+    steps: list[str] = []
+    try:
+        client = await asyncio.to_thread(get_docker_client)
+    except Exception as exc:  # noqa: BLE001
+        raise HTTPException(503, "RESUME_DOCKER_UNAVAILABLE") from exc
+    session_id = record["session_id"]
+    session = state.sessions.get(session_id)
+    if session is None:
+        reject("RESUME_SESSION_MISSING")
+    try:
+        container = await asyncio.to_thread(client.containers.get, worker["instance_id"])
+    except NotFound:
+        reject("RESUME_WORKER_MISSING")
+    from .session_runtime import restore_for_container
+    restore_for_container(container, session_id, session)
+    managed = bool(record.get("network_policy_id"))
+    allocation = None
+    if managed:
+        try:
+            allocation = await resume_managed(client, identity, snapshot, steps)
+        except HTTPException:
+            await network_runtime.set_phase(identity, "ready")
+            raise
+    try:
+        container = await asyncio.to_thread(client.containers.get, worker["instance_id"])
+    except NotFound:
+        reject("RESUME_WORKER_MISSING")
+    if managed and container.attrs.get("HostConfig", {}).get("NetworkMode") != "container:" + allocation["guard_id"]:
+        reject("RESUME_NAMESPACE_MISMATCH")
+    await start_container(client, worker["instance_id"], "RESUME_WORKER_FAILED")
+    steps.append("worker")
+    await asyncio.to_thread(container.reload)
+    ip = allocation["guard_ip"] if managed else DockerProvider._get_container_ip(container.attrs)
+    if not ip:
+        reject("RESUME_WORKER_ADDRESS_UNKNOWN", 503)
+    session_id = record["session_id"]
+    async with state.sessions_lock:
+        session = state.sessions.get(session_id)
+    if session is None:
+        reject("RESUME_SESSION_MISSING")
+    if not await wait_display(ip, session, session_id):
+        reject("RESUME_WORKER_NOT_READY", 503)
+    steps.append("display")
+    async with state.sessions_lock:
+        session = state.sessions.get(session_id)
+        if session is None:
+            reject("RESUME_SESSION_MISSING")
+        session["ip"] = ip
+        for entry in (session.get("container_registry") or {}).values():
+            if entry.get("instance_id") == worker["instance_id"]:
+                entry["ip"] = ip
+        session["lifecycle_phase"] = "running"
+    try:
+        await config_store.save_sessions()
+    except Exception as exc:
+        raise HTTPException(503, "RESUME_COMMIT_FAILED") from exc
+    if managed:
+        await network_runtime.set_phase(identity, "running")
+        reservation = network_runtime.read_reservation(identity)
+        if reservation["policy"].get("coherence"):
+            from .coherence_runtime import sample_locked
+            report = await sample_locked(reservation, session_id, force=True)
+            if not report or not report.get("allowed"):
+                reject("COHERENCE_SESSION_NOT_READY", 503)
+            steps.append("coherence")
+    steps.append("committed")
+    return {"resumed": True, "state": "live", "session_id": session_id, "instance_id": worker["instance_id"], "steps": steps}
+
+
+router = APIRouter(prefix="/api/profile-runtime", route_class=EncryptedRoute,
+                   dependencies=[Depends(verify_token)])
+
+
+@router.post("/{home_name}/resume")
+async def resume_profile_runtime(home_name: str,
+                                 decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body),
+                                 user: dict[str, Any] = Depends(verify_token)) -> dict[str, Any]:
+    """Resume the exact dormant generation named by the request; never create or remove."""
+    try:
+        request = StopProfileRequest(**decrypted_body)
+    except ValidationError as exc:
+        raise HTTPException(422, "Invalid Profile resume request.") from exc
+    username = user["username"]
+    async with lifecycle_lock("home:" + home_path(username, home_name)):
+        return await resume_profile_locked(username, home_name, request)
