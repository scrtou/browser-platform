+class Containers:
+    def __init__(self):
+        self.values = {}
+        self.error = None
+        self.before_stop = None
+        self.run_kwargs = None
+
+    def get(self, instance):
+        if self.error:
+            raise self.error
+        if instance not in self.values:
+            raise NotFound("missing")
+        return self.values[instance]
+
+    def list(self, **kwargs):
+        if self.error:
+            raise self.error
+        return list(self.values.values())
+
+    def run(self, **kwargs):
+        self.run_kwargs = kwargs
+        container = Container(self, labels=kwargs.get("labels"))
+        self.values[container.id] = container
+        return container
