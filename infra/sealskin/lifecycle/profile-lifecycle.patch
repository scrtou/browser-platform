+    assert camoufox["browser_main"] == 1 and camoufox["browser_child"] == 1
+    assert health.classify_processes([[], ["x"], "bad", None]) == {"total": 1, "browser_main": 0, "browser_child": 0,
+                                                                  "display_server": [], "streamer": 0}
