+    async def guarded(*args, **kwargs):
+        session_id = signature.bind(*args, **kwargs).arguments["session_id"]
+        async with lifecycle_lock("session:" + session_id):
+            if state.sessions.get(session_id, {}).get("lifecycle_phase") == "stopping":
+                raise HTTPException(409, "Session is stopping.")
+            return await function(*args, **kwargs)
+
+    return guarded
