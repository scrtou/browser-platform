index 0000000..9a3c030
--- /dev/null
+++ b/server/app/launch_journal.py
@@ -0,0 +1,258 @@
+"""Create-before journal for named-Home launches.
+
+A managed generation already has a durable network reservation before any
+Docker create. Plain named-Home launches had nothing: a control-process crash
+between Docker create and `save_sessions` left only a labelled container, and a
+lost launch response with no visible container could never be told apart from
+a create that was still queued. This journal closes both gaps:
+
+* `pending`  — written before the Home lock is taken (Adapter launches only,
+  keyed by operation): the request has arrived and may still create.
+* `creating` — written under the Home lock after the inventory proved the Home
+  empty and before the Worker container is created. Carries the deterministic
+  container name.
+* `failed`   — the launch raised after the journal existed; the container may
+  or may not exist (inventory shows it if it does).
+* `aborted`  — resolved at API startup: `creating` with no container.
+* `orphaned` — resolved at API startup: `creating` with a container but no
+  session record.
+
+The journal is removed only after `save_sessions` committed the record, or by
+an explicit lifecycle stop once the container is confirmed absent. Nothing here
+expires by time.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import re
+import time
+from pathlib import Path
+from typing import Any
+
+from fastapi import HTTPException
+
+from docker.errors import NotFound
+
+from . import network_runtime
+from .docker_utils import get_docker_client
+from .state import state
+
+logger = logging.getLogger(__name__)
+VERSION = 1
+PHASES = {"pending", "creating", "failed", "aborted", "orphaned"}
+NAME = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
+OPERATION = re.compile(r"^[a-f0-9]{32}$")
+SHA = re.compile(r"^[a-f0-9]{64}$")
+
+
+def journal_dir() -> Path:
+    return network_runtime.base_dir() / "profile-launch-runtime"
+
+
+def journal_path(identity: dict[str, str]) -> Path:
+    return journal_dir() / (identity["home_hash"] + ".json")
+
+
+def pending_path(identity: dict[str, str]) -> Path:
+    return journal_dir() / (identity["home_hash"] + "-" + identity["operation"] + ".pending.json")
+
+
+def container_name(identity: dict[str, str]) -> str:
+    return "bp-home-" + identity["home_hash"]
+
+
+def _valid(value: Any, identity: dict[str, str]) -> bool:
+    return (isinstance(value, dict) and value.get("version") == VERSION and value.get("phase") in PHASES and
+            isinstance(value.get("identity"), dict) and
+            all(value["identity"].get(k) == identity[k] for k in ("scope", "owner", "home", "home_hash", "home_source")) and
+            isinstance(value.get("policy_id"), str) and isinstance(value.get("policy_sha256"), str) and
+            (value["policy_id"] == "" or NAME.fullmatch(value["policy_id"])) and
+            (value["policy_sha256"] == "" or SHA.fullmatch(value["policy_sha256"])))
+
+
+def read_journal(identity: dict[str, str]) -> dict[str, Any] | None:
+    """Read this Home's journal; an unreadable journal fails closed."""
+    path = journal_path(identity)
+    if not path.exists():
+        return None
+    try:
+        value = network_runtime.read_json(path)
+    except (OSError, ValueError) as exc:
+        raise HTTPException(503, "LAUNCH_JOURNAL_INVALID") from exc
+    if not _valid(value, identity):
+        raise HTTPException(503, "LAUNCH_JOURNAL_INVALID")
+    return value
+
+
+def read_pending(identity: dict[str, str]) -> list[dict[str, Any]]:
+    """Pending intents for this Home (any operation)."""
+    root = journal_dir()
+    if not root.exists():
+        return []
+    out = []
+    for path in sorted(root.glob(identity["home_hash"] + "-*.pending.json")):
+        try:
+            value = network_runtime.read_json(path)
+        except (OSError, ValueError) as exc:
+            raise HTTPException(503, "LAUNCH_JOURNAL_INVALID") from exc
+        if not _valid(value, identity) or value.get("phase") != "pending":
+            raise HTTPException(503, "LAUNCH_JOURNAL_INVALID")
+        out.append(value)
+    return out
+
+
+def write_pending(identity: dict[str, str], policy: tuple | None) -> None:
+    """Record that an Adapter launch request has arrived, before the Home lock."""
+    if not OPERATION.fullmatch(identity.get("operation") or ""):
+        return
+    policy_id, policy_sha = "", ""
+    if policy:
+        policy_id, policy_sha = policy[0], network_runtime.digest(policy[1].model_dump())
+    value = {"version": VERSION, "phase": "pending", "identity": identity, "policy_id": policy_id,
+             "policy_sha256": policy_sha, "written_at": time.time()}
+    network_runtime.atomic_json(pending_path(identity), value)
+
+
+def clear_pending(identity: dict[str, str]) -> None:
+    if not OPERATION.fullmatch(identity.get("operation") or ""):
+        return
+    path = pending_path(identity)
+    if path.exists():
+        path.unlink()
+        network_runtime.sync_directory(path.parent)
+
+
+def write_creating(identity: dict[str, str], policy: tuple | None) -> None:
+    """Reserve the Home on disk before Docker create; refuse if a journal already exists."""
+    policy_id, policy_sha = "", ""
+    if policy:
+        policy_id, policy_sha = policy[0], network_runtime.digest(policy[1].model_dump())
+    value = {"version": VERSION, "phase": "creating", "identity": identity, "policy_id": policy_id,
+             "policy_sha256": policy_sha, "container_name": container_name(identity), "written_at": time.time()}
+    try:
+        network_runtime.atomic_json(journal_path(identity), value, exclusive=True)
+    except HTTPException as exc:
+        if exc.detail == "NETWORK_HOME_RESERVED":
+            raise HTTPException(409, "LAUNCH_HOME_RESERVED") from exc
+        raise
+
+
+def set_phase(identity: dict[str, str], phase: str, **extra: Any) -> None:
+    value = read_journal(identity)
+    if value is None:
+        return
+    value["phase"] = phase
+    value["updated_at"] = time.time()
+    value.update(extra)
+    network_runtime.atomic_json(journal_path(identity), value)
+
+
+def remove(identity: dict[str, str]) -> None:
+    path = journal_path(identity)
+    if path.exists():
+        path.unlink()
+        network_runtime.sync_directory(path.parent)
+
+
+def summaries(identity: dict[str, str]) -> list[dict[str, Any]]:
+    """Project the journal and pending intents to inventory resources of kind `launch`."""
+    out = []
+    for value in read_pending(identity):
+        out.append(_summary(value, value["identity"].get("operation", "")))
+    value = read_journal(identity)
+    if value:
+        out.append(_summary(value, identity["home_hash"]))
+    return out
+
+
+def _summary(value: dict[str, Any], identifier: str) -> dict[str, Any]:
+    ident = value["identity"]
+    return {"id": identifier, "kind": "launch", "owned": True, "recorded": True, "status": value["phase"],
+            "profile_id": ident.get("profile", ""), "operation_id": ident.get("operation", ""),
+            "app_id": ident.get("app", ""), "policy_id": value["policy_id"], "policy_sha256": value["policy_sha256"]}
+
+
+def validate_for_stop(resources: list[dict[str, Any]], request) -> None:
+    """Refuse a stop while a create may still run; refuse foreign non-terminal journals.
+
+    Terminal journals (failed/aborted/orphaned) of this operation, or of a
+    direct launch that carried no Profile identity, may be cleared by the stop.
+    """
+    for item in resources:
+        if item["kind"] != "launch":
+            continue
+        if item["status"] in {"pending", "creating"}:
+            raise HTTPException(503, "LAUNCH_STILL_CREATING")
+        direct = not item["profile_id"] and not item["operation_id"]
+        if not direct and (item["profile_id"] != request.profile_id or item["operation_id"] != request.operation_id or
+                           item["app_id"] != request.application_id or item["policy_id"] != request.network_policy_id or
+                           item["policy_sha256"] != request.network_policy_sha256):
+            raise HTTPException(409, "LAUNCH_JOURNAL_OWNERSHIP_UNPROVEN")
+
+
+async def clear_after_stop(identity: dict[str, str], request, containers_present: bool) -> None:
+    """Remove terminal journals once every container of the Home is confirmed gone."""
+    if containers_present:
+        raise HTTPException(503, "LAUNCH_STILL_CREATING")
+    value = read_journal(identity)
+    if value is None:
+        return
+    if value["phase"] in {"pending", "creating"}:
+        raise HTTPException(503, "LAUNCH_STILL_CREATING")
+    remove(identity)
+
+
+async def resolve_at_startup() -> list[dict[str, Any]]:
+    """Classify `creating` journals after a control-process restart; never delete a container."""
+    root = journal_dir()
+    if not root.exists():
+        return []
+    results = []
+    try:
+        client = get_docker_client()
+    except Exception as exc:  # noqa: BLE001
+        logger.error("Launch journal recovery could not reach Docker (%s); journals retained.", type(exc).__name__)
+        return [{"result": "retained", "reason": "DOCKER_UNAVAILABLE"}]
+    for path in sorted(root.glob("*.pending.json")):
+        # A restart discards every queued request; a pending intent can never proceed.
+        path.unlink()
+        results.append({"journal": path.name, "result": "pending_discarded"})
+    for path in sorted(root.glob("*.json")):
+        if path.name.endswith(".pending.json"):
+            continue
+        try:
+            value = network_runtime.read_json(path)
+        except (OSError, ValueError):
+            results.append({"journal": path.name, "result": "retained", "reason": "LAUNCH_JOURNAL_INVALID"})
+            continue
+        if value.get("phase") != "creating":
+            results.append({"journal": path.name, "result": value.get("phase")})
+            continue
+        name = value.get("container_name", "")
+        try:
+            container = client.containers.get(name) if name else None
+        except NotFound:
+            container = None
+        except Exception as exc:  # noqa: BLE001
+            results.append({"journal": path.name, "result": "retained", "reason": type(exc).__name__})
+            continue
+        if container is None:
+            value["phase"], value["resolved_at"] = "aborted", time.time()
+            network_runtime.atomic_json(path, value)
+            results.append({"journal": path.name, "result": "aborted"})
+            continue
+        recorded = any(container.id in (data.get("instance_id"), *(e.get("instance_id") for e in (data.get("container_registry") or {}).values()))
+                       for data in state.sessions.values())
+        if recorded:
+            path.unlink()
+            network_runtime.sync_directory(path.parent)
+            results.append({"journal": path.name, "result": "committed"})
+        else:
+            value["phase"], value["resolved_at"] = "orphaned", time.time()
+            network_runtime.atomic_json(path, value)
+            results.append({"journal": path.name, "result": "orphaned"})
+    if root.exists():
+        network_runtime.sync_directory(root)
+    return results
