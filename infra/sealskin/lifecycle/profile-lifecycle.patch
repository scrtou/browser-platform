+async def stop_session_confirmed(session_id: str) -> None:
+    """Persist intent, remove every Docker instance, then commit record deletion."""
+    from . import collaboration
+    from .launch import ephemeral_base
+    from .providers.docker_provider import DockerProvider
+
+    async with lifecycle_lock("session:" + session_id):
+        session = state.sessions.get(session_id)
+        if session is None:
+            return
+        ids = instance_ids(session)
+        session["lifecycle_phase"] = "stopping"
+        try:
+            await config_store.save_sessions()
+        except Exception as exc:
+            raise HTTPException(503, "Stop intent could not be saved; session remains reserved.") from exc
+        try:
+            provider = DockerProvider({"provider_config": {}})
+            for instance_id in ids:
+                await provider.stop(instance_id)
+            if session.get("display_secret_version"):
+                from .session_runtime import clear_unused
+                if not await clear_unused(session_id):
+                    raise HTTPException(503, "SESSION_AUTH_CLEANUP_UNCONFIRMED")
+        except Exception as exc:
+            logger.error("[%s] Stop remains pending (%s).", session_id, type(exc).__name__)
+            raise HTTPException(503, "Container removal was not confirmed; stop can be retried.") from exc
+        async with state.sessions_lock:
+            if state.sessions.get(session_id) is not session:
+                raise HTTPException(409, "Session ownership changed during stop.")
+            del state.sessions[session_id]
+        try:
+            await config_store.save_sessions()
+        except Exception as exc:
+            async with state.sessions_lock:
+                state.sessions.setdefault(session_id, session)
+            raise HTTPException(503, "Containers are gone but stop commit failed; retry is required.") from exc
+        try:
+            await collaboration.notify_session_ended(session_id)
+        except Exception as exc:
+            logger.warning("[%s] Could not broadcast completed stop (%s).", session_id, type(exc).__name__)
+        base = os.path.realpath(ephemeral_base())
+        for key in ("host_mount_path", "shared_files_path"):
+            path = session.get(key)
+            if path and os.path.realpath(path).startswith(base + os.sep):
+                await asyncio.to_thread(shutil.rmtree, path, ignore_errors=True)
