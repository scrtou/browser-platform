+++ b/server/app/secret_runtime.py
@@ -0,0 +1,343 @@
+"""Credential authorization, tmpfs leases and revocation within SealSkin ownership."""
+
+from __future__ import annotations
+
+import asyncio
+from contextlib import asynccontextmanager
+import hashlib
+import json
+import logging
+import os
+from pathlib import Path
+import re
+import shutil
+import time
+from typing import Any
+
+from docker.errors import NotFound
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel, ConfigDict, Field, ValidationError
+
+from . import network_runtime as network
+from .docker_utils import get_docker_client, translate_path_to_host
+from .secret_store import (FileSecretStore, SecretError, canonical, decode, parse_reference,
+                           private_directory, read_private, write_private)
+from .security import EncryptedRoute, get_decrypted_request_body, verify_admin
+from .state import state
+
+logger = logging.getLogger(__name__)
+
+
+def credential_lock():
+    from .profile_runtime import lifecycle_lock
+    return lifecycle_lock("secret-store:operations")
+
+
+def reject(error):
+    code = error.code if isinstance(error, SecretError) else "SECRET_RUNTIME_UNAVAILABLE"
+    status = 403 if code == "SECRET_ACCESS_DENIED" else 409 if code == "SECRET_REVOKED" else 503
+    raise HTTPException(status, code) from None
+
+
+def uses_store(policy):
+    return bool(policy and policy.username_secret_ref)
+
+
+def configuration():
+    try:
+        value = decode(read_private(network.base_dir() / "profile-secret-store.json"))
+        if (not isinstance(value, dict) or set(value) != {"version", "key_file", "runtime_dir"}
+                or type(value["version"]) is not int or value["version"] != 1
+                or any(not isinstance(value[k], str) or not value[k].startswith("/") for k in ("key_file", "runtime_dir"))):
+            raise SecretError("SECRET_CONFIGURATION_INVALID")
+        store_path = network.base_dir() / "proxy-secret-store"
+        key = Path(value["key_file"])
+        if key.is_relative_to(store_path) or key.resolve() != key:
+            raise SecretError("SECRET_KEY_LOCATION_INVALID")
+        return FileSecretStore(store_path, key), Path(value["runtime_dir"])
+    except SecretError as exc:
+        reject(exc)
+
+
+def grant(policy):
+    return {"owner": policy.username, "profile": policy.profile_id, "home": policy.home_name, "app": policy.application_id}
+
+
+def authorize(policy):
+    if not uses_store(policy):
+        return None
+    store, _ = configuration()
+    try:
+        return store.resolve(grant(policy), policy.username_secret_ref, policy.password_secret_ref)
+    except SecretError as exc:
+        reject(exc)
+
+
+@asynccontextmanager
+async def credential_guard(policy):
+    """Hold through create/resume commit; revocation cannot miss an in-flight Relay.
+
+    Callers hold a Home lock first. Revocation never takes Home locks while
+    holding this lock, so a refused browser close cannot deadlock another Home.
+    """
+    if not uses_store(policy):
+        yield
+        return
+    async with credential_lock():
+        runtime_root()
+        authorize(policy)
+        yield
+
+
+def is_tmpfs(path):
+    """Use the kernel's longest matching mount, including bind mounts of tmpfs."""
+    found = None
+    for line in Path("/proc/self/mountinfo").read_text().splitlines():
+        fields = line.split()
+        split = fields.index("-")
+        mount = Path(re.sub(r"\\([0-7]{3})", lambda m: chr(int(m[1], 8)), fields[4]))
+        if path == mount or path.is_relative_to(mount):
+            if found is None or len(mount.parts) > found[0]:
+                found = (len(mount.parts), fields[split + 1])
+    return found is not None and found[1] == "tmpfs"
+
+
+def runtime_root():
+    _, root = configuration()
+    try:
+        private_directory(root)
+        if not is_tmpfs(root):
+            raise SecretError("SECRET_TMPFS_REQUIRED")
+        # The path must also be translatable through an actual controller bind.
+        # Docker will mount only an individual generation below this root.
+        if str(root) not in state.path_prefix_map:
+            raise SecretError("SECRET_RUNTIME_BIND_REQUIRED")
+        translate_path_to_host(str(root))
+        return root
+    except (SecretError, OSError, ValueError) as exc:
+        reject(exc)
+
+
+def lease_id(identity):
+    if any(not re.fullmatch(network.SHA, identity.get(k, "")) for k in ("scope", "home_hash")) or not re.fullmatch(r"[a-f0-9]{32}", identity.get("operation", "")):
+        raise HTTPException(503, "SECRET_GENERATION_INVALID")
+    return network.digest(identity)
+
+
+def generation_directory(identity):
+    return runtime_root() / ("generation-" + lease_id(identity))
+
+
+def materialize(policy, identity):
+    """Only encrypted input and a private tmpfs output may hold credential bytes."""
+    material = authorize(policy)
+    if material is None:
+        return None
+    directory = generation_directory(identity)
+    try:
+        directory.mkdir(mode=0o700, exist_ok=True)
+        private_directory(directory)
+        if set(p.name for p in directory.iterdir()) - {"username", "password", "lease"}:
+            raise SecretError("SECRET_RUNTIME_CONTENTS_INVALID")
+        for field, value in material.items():
+            path = directory / field
+            if os.path.lexists(path) and read_private(path, 4096) != value:
+                raise SecretError("SECRET_RUNTIME_REVISION_MISMATCH")
+            if not path.exists():
+                write_private(path, value)
+        write_private(directory / "lease", b"active:" + lease_id(identity).encode() + b"\n", exclusive=False)
+        return translate_path_to_host(str(directory))
+    except (SecretError, OSError) as exc:
+        reject(exc)
+
+
+def invalidate_lease(identity):
+    directory = generation_directory(identity)
+    if not os.path.lexists(directory):
+        return
+    try:
+        private_directory(directory)
+        write_private(directory / "lease", b"revoked\n", exclusive=False)
+    except (SecretError, OSError) as exc:
+        reject(exc)
+
+
+def clear_material(identity):
+    """Only after the owned Relay is confirmed gone; never claim secure erasure."""
+    directory = generation_directory(identity)
+    if not os.path.lexists(directory):
+        return
+    try:
+        private_directory(directory)
+        if set(p.name for p in directory.iterdir()) - {"username", "password", "lease"}:
+            raise SecretError("SECRET_RUNTIME_CONTENTS_INVALID")
+        for path in directory.iterdir():
+            read_private(path, 4096)
+        shutil.rmtree(directory)
+    except (SecretError, OSError) as exc:
+        reject(exc)
+
+
+async def block_generation(reservation):
+    """The lease cancels active tunnels even when Docker mutation is unavailable."""
+    identity = reservation["identity"]
+    lease_error = None
+    try:
+        invalidate_lease(identity)
+    except HTTPException as exc:
+        lease_error = exc
+    client = await asyncio.to_thread(get_docker_client)
+    try:
+        relay = await asyncio.to_thread(client.containers.get, network.resource_name(identity, "relay"))
+    except NotFound:
+        if lease_error:
+            raise lease_error
+        return
+    labels = relay.attrs.get("Config", {}).get("Labels") or {}
+    if (any(labels.get(k) != v for k, v in network.resource_labels(reservation, "relay").items())
+            or relay.name != network.resource_name(identity, "relay")):
+        raise HTTPException(503, "SECRET_RELAY_OWNERSHIP_UNPROVEN")
+    # Give the independent lease monitor time to close connections. The Docker
+    # stop fallback handles an unhealthy Relay without killing the browser.
+    deadline = time.monotonic() + 2
+    while relay.status == "running" and lease_error is None and time.monotonic() < deadline:
+        await asyncio.sleep(0.1)
+        await asyncio.to_thread(relay.reload)
+    if relay.status not in {"exited", "dead", "created"}:
+        await asyncio.to_thread(relay.stop, timeout=3)
+        await asyncio.to_thread(relay.reload)
+    if relay.status not in {"exited", "dead", "created"}:
+        raise HTTPException(503, "SECRET_EGRESS_BLOCK_UNCONFIRMED")
+    logger.info("EGRESS_BLOCKED profile=%s operation=%s policy_revision=%s", identity["profile"], identity["operation"], reservation["policy_sha256"])
+
+
+async def before_stop(identity):
+    reservation = network.read_reservation(identity)
+    if not reservation or not uses_store(network.NetworkPolicy(**reservation["policy"])):
+        return
+    async with credential_lock():
+        try:
+            await block_generation(reservation)
+        except HTTPException:
+            raise
+        except Exception:
+            raise HTTPException(503, "SECRET_EGRESS_BLOCK_UNCONFIRMED") from None
+
+
+def store_reservations():
+    """Validate every generation identity before deriving paths or Docker names."""
+    from .profile_runtime import runtime_identity
+
+    root = network.runtime_dir()
+    if not root.exists():
+        return []
+    result = []
+    for path in sorted(root.glob("*.json")):
+        stored = network.read_json(path).get("identity", {})
+        try:
+            identity = runtime_identity(stored["owner"], stored["home"], stored["app"], stored["profile"], stored["operation"])
+        except (KeyError, TypeError, ValueError):
+            raise HTTPException(503, "SECRET_RESERVATION_INVALID") from None
+        if identity != stored or path != network.reservation_path(identity):
+            raise HTTPException(503, "SECRET_RESERVATION_INVALID")
+        reservation = network.read_reservation(identity)
+        if uses_store(network.NetworkPolicy(**reservation["policy"])):
+            result.append(reservation)
+    return result
+
+
+async def revoke(reference, operation_id):
+    from .profile_runtime import StopProfileRequest, home_path, lifecycle_lock, stop_profile_locked
+
+    async with credential_lock():
+        store, _ = configuration()
+        try:
+            revoked = store.revoke(reference, operation_id)
+            selected = [r for r in store_reservations() if parse_reference(r["policy"]["username_secret_ref"])[:2]
+                        == (revoked["secret_id"], revoked["secret_version"])]
+        except SecretError as exc:
+            reject(exc)
+        logger.info("SECRET_REVOKED operation=%s secret_id=%s version=%s", operation_id, revoked["secret_id"], revoked["secret_version"])
+        for reservation in selected:
+            try:
+                invalidate_lease(reservation["identity"])
+            except HTTPException:
+                pass  # The verified Docker stop fallback is still attempted.
+        failures = False
+        for reservation in selected:
+            try:
+                await block_generation(reservation)
+            except Exception:
+                # Keep trying every affected Home before returning a retryable
+                # failure; one unavailable Docker object must not hide others.
+                failures = True
+        if failures:
+            raise HTTPException(503, "SECRET_REVOKED_EGRESS_PENDING")
+    # The durable tombstone now rejects new create/resume calls. Home locks can
+    # be acquired after releasing the credential lock, in the usual lock order.
+    incomplete = False
+    for reservation in selected:
+        identity = reservation["identity"]
+        request = StopProfileRequest(profile_id=identity["profile"], operation_id=identity["operation"],
+            application_id=identity["app"], bootstrap_url="secret-revocation", network_policy_id=reservation["policy_id"],
+            network_policy_sha256=reservation["policy_sha256"])
+        try:
+            async with lifecycle_lock("home:" + home_path(identity["owner"], identity["home"])):
+                await stop_profile_locked(identity["owner"], identity["home"], request)
+        except Exception:
+            incomplete = True
+    if incomplete:
+        raise HTTPException(503, "SECRET_REVOKED_CLEANUP_PENDING")
+    return {"revoked": True, "egress_blocked": True, "cleanup_complete": True, "affected_generations": len(selected),
+            "secret_id": revoked["secret_id"], "secret_version": revoked["secret_version"]}
+
+
+async def enforce_authorizations():
+    """Recover a crash after tombstone commit; also close leases for lost keys."""
+    async with credential_lock():
+        for reservation in store_reservations():
+            policy = network.NetworkPolicy(**reservation["policy"])
+            try:
+                authorize(policy)
+                if reservation["phase"] != "stopping":
+                    continue
+            except HTTPException:
+                pass
+            try:
+                await block_generation(reservation)
+            except Exception:
+                logger.warning("SECRET_EGRESS_RECONCILE_PENDING operation=%s", reservation["identity"]["operation"])
+
+
+async def authorization_monitor():
+    while True:
+        try:
+            await enforce_authorizations()
+        except Exception:
+            logger.warning("SECRET_AUTHORIZATION_RECONCILE_PENDING")
+        await asyncio.sleep(2)
+
+
+class RevokeRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+    secret_ref: str = Field(min_length=1, max_length=180)
+    operation_id: str = Field(pattern=r"^[a-f0-9]{32}$")
+
+
+router = APIRouter(prefix="/api/admin/profile-secrets", route_class=EncryptedRoute,
+                   dependencies=[Depends(verify_admin)])
+
+
+@router.post("/revoke")
+async def revoke_secret(decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body)):
+    try:
+        request = RevokeRequest(**decrypted_body)
+        parse_reference(request.secret_ref)
+    except (ValidationError, SecretError):
+        raise HTTPException(422, "SECRET_REVOKE_REQUEST_INVALID") from None
+    try:
+        return await revoke(request.secret_ref, request.operation_id)
+    except HTTPException:
+        raise
+    except Exception:
+        raise HTTPException(503, "SECRET_REVOKE_INCOMPLETE") from None
diff --git a/server/app/secret_store.py b/server/app/secret_store.py
new file mode 100644
index 0000000..8c4d99c
--- /dev/null
+++ b/server/app/secret_store.py
@@ -0,0 +1,350 @@
+"""Versioned, authenticated file storage for one controller's proxy credentials.
+
+This module can also run as an offline import CLI. It never accepts credential
+values on argv and offers no offline revocation command: live revocation must
+also invalidate generation leases through the controller API.
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+from contextlib import contextmanager
+from datetime import datetime, timezone
+import fcntl
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+import sys
+import tempfile
+import uuid
+
+from cryptography.exceptions import InvalidTag
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+
+NAME = r"[A-Za-z0-9_-]{1,128}"
+REFERENCE = re.compile(r"secret://(" + NAME + r")/(username|password)/([1-9][0-9]{0,8})\Z")
+SHA = re.compile(r"[a-f0-9]{64}\Z")
+OPERATION = re.compile(r"[a-f0-9]{32}\Z")
+GRANT_KEYS = {"owner", "profile", "home", "app"}
+MAX_METADATA = 128 * 1024
+
+
+class SecretError(Exception):
+    """Only a stable, non-sensitive code may cross the storage boundary."""
+
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def fail(code):
+    raise SecretError(code)
+
+
+def canonical(value):
+    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True).encode()
+
+
+def unique_json(pairs):
+    result = {}
+    for key, value in pairs:
+        if key in result:
+            fail("SECRET_METADATA_INVALID")
+        result[key] = value
+    return result
+
+
+def decode(raw):
+    try:
+        return json.loads(raw, object_pairs_hook=unique_json)
+    except (ValueError, UnicodeError, TypeError):
+        raise SecretError("SECRET_METADATA_INVALID") from None
+
+
+def private_directory(path):
+    path = Path(path)
+    try:
+        info = path.lstat()
+        if (not path.is_absolute() or path.resolve() != path or not stat.S_ISDIR(info.st_mode)
+                or info.st_uid != os.geteuid() or info.st_mode & 0o077):
+            fail("SECRET_DIRECTORY_UNSAFE")
+    except OSError:
+        raise SecretError("SECRET_DIRECTORY_UNAVAILABLE") from None
+    return path
+
+
+def read_private(path, limit=MAX_METADATA):
+    path = Path(path)
+    private_directory(path.parent)
+    try:
+        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+        with os.fdopen(fd, "rb") as handle:
+            info = os.fstat(handle.fileno())
+            if (not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid()
+                    or info.st_mode & 0o077 or info.st_nlink != 1 or info.st_size > limit):
+                fail("SECRET_FILE_UNSAFE")
+            value = handle.read(limit + 1)
+            if len(value) > limit:
+                fail("SECRET_FILE_UNSAFE")
+            return value
+    except OSError:
+        raise SecretError("SECRET_FILE_UNAVAILABLE") from None
+
+
+def sync_directory(path):
+    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def write_private(path, raw, *, exclusive=True):
+    """No overwrites by default; authenticated versions and tombstones are immutable."""
+    path = Path(path)
+    private_directory(path.parent)
+    fd, name = tempfile.mkstemp(prefix=".secret-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "wb") as handle:
+            os.fchmod(handle.fileno(), 0o600)
+            handle.write(raw)
+            handle.flush()
+            os.fsync(handle.fileno())
+        if exclusive:
+            try:
+                os.link(name, path, follow_symlinks=False)
+            except FileExistsError:
+                raise SecretError("SECRET_VERSION_EXISTS") from None
+        else:
+            os.replace(name, path)
+        sync_directory(path.parent)
+    finally:
+        if os.path.exists(name):
+            os.unlink(name)
+
+
+def parse_reference(reference):
+    match = REFERENCE.fullmatch(reference) if isinstance(reference, str) else None
+    if not match:
+        fail("SECRET_REFERENCE_INVALID")
+    identifier, field, version = match.groups()
+    return identifier, int(version), field
+
+
+def pair_references(username_ref, password_ref):
+    user, password = parse_reference(username_ref), parse_reference(password_ref)
+    if user[:2] != password[:2] or user[2] != "username" or password[2] != "password":
+        fail("SECRET_REFERENCE_PAIR_INVALID")
+    return user[:2]
+
+
+def revision_name(identifier, version):
+    return hashlib.sha256(canonical([identifier, version])).hexdigest()
+
+
+def references(identifier, version):
+    if (not isinstance(identifier, str) or not re.fullmatch(NAME, identifier)
+            or type(version) is not int or not 1 <= version <= 999999999):
+        fail("SECRET_REFERENCE_INVALID")
+    value = {field: f"secret://{identifier}/{field}/{version}" for field in ("username", "password")}
+    pair_references(value["username"], value["password"])
+    return value
+
+
+def validate_grant(value):
+    if not isinstance(value, dict) or set(value) != GRANT_KEYS:
+        fail("SECRET_GRANT_INVALID")
+    if any(not isinstance(value[k], str) or not re.fullmatch(NAME, value[k]) for k in ("owner", "profile", "home")):
+        fail("SECRET_GRANT_INVALID")
+    if not isinstance(value["app"], str) or not 1 <= len(value["app"]) <= 256 or any(ord(c) < 32 for c in value["app"]):
+        fail("SECRET_GRANT_INVALID")
+    return value
+
+
+def credential(value):
+    try:
+        if (not isinstance(value, str) or not 1 <= len(value.encode("utf-8")) <= 4096
+                or any(ord(c) < 32 or ord(c) == 127 for c in value)):
+            fail("SECRET_VALUE_INVALID")
+    except UnicodeError:
+        raise SecretError("SECRET_VALUE_INVALID") from None
+    return value
+
+
+class FileSecretStore:
+    def __init__(self, directory, key_file):
+        self.directory = Path(directory)
+        self.key_file = Path(key_file)
+
+    @classmethod
+    def initialize(cls, directory, key_file):
+        directory, key_file = Path(directory), Path(key_file)
+        private_directory(directory.parent)
+        private_directory(key_file.parent)
+        if key_file.is_relative_to(directory) or directory.exists() or key_file.exists() or key_file.is_symlink():
+            fail("SECRET_INITIALIZATION_CONFLICT")
+        key = AESGCM.generate_key(bit_length=256)
+        write_private(key_file, key)
+        directory.mkdir(mode=0o700)
+        for name in ("versions", "revocations"):
+            (directory / name).mkdir(mode=0o700)
+        write_private(directory / "store.json", canonical({"version": 1, "store_id": uuid.uuid4().hex,
+            "key_sha256": hashlib.sha256(key).hexdigest()}))
+        return cls(directory, key_file)
+
+    @contextmanager
+    def locked(self):
+        private_directory(self.directory)
+        try:
+            fd = os.open(self.directory / ".lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
+            with os.fdopen(fd, "rb") as handle:
+                info = os.fstat(handle.fileno())
+                if not stat.S_ISREG(info.st_mode) or info.st_uid != os.geteuid() or info.st_mode & 0o077 or info.st_nlink != 1:
+                    fail("SECRET_FILE_UNSAFE")
+                fcntl.flock(handle, fcntl.LOCK_EX)
+                try:
+                    yield
+                finally:
+                    fcntl.flock(handle, fcntl.LOCK_UN)
+        except OSError:
+            raise SecretError("SECRET_STORE_UNAVAILABLE") from None
+
+    def metadata(self):
+        value = decode(read_private(self.directory / "store.json"))
+        if (not isinstance(value, dict) or set(value) != {"version", "store_id", "key_sha256"}
+                or type(value["version"]) is not int or value["version"] != 1
+                or not isinstance(value["store_id"], str) or not OPERATION.fullmatch(value["store_id"])
+                or not isinstance(value["key_sha256"], str) or not SHA.fullmatch(value["key_sha256"])):
+            fail("SECRET_METADATA_INVALID")
+        return value
+
+    def key(self, metadata):
+        key = read_private(self.key_file, 32)
+        if len(key) != 32 or hashlib.sha256(key).hexdigest() != metadata["key_sha256"]:
+            fail("SECRET_KEY_MISMATCH")
+        return key
+
+    def revision_path(self, identifier, version):
+        return self.directory / "versions" / (revision_name(identifier, version) + ".json")
+
+    def revocation_path(self, identifier, version):
+        return self.directory / "revocations" / (revision_name(identifier, version) + ".json")
+
+    def require_enabled(self, identifier, version):
+        if os.path.lexists(self.directory / ".recovery-pending"):
+            fail("SECRET_RECOVERY_LOCKED")
+        private_directory(self.directory / "revocations")
+        path = self.revocation_path(identifier, version)
+        # Even an unreadable or damaged tombstone denies resolution.
+        if os.path.lexists(path):
+            fail("SECRET_REVOKED")
+
+    def put(self, identifier, version, grants, username, password):
+        refs = references(identifier, version)
+        if type(version) is not int or not isinstance(grants, list) or not 1 <= len(grants) <= 128:
+            fail("SECRET_GRANT_INVALID")
+        grants = [validate_grant(g) for g in grants]
+        if len({canonical(g) for g in grants}) != len(grants):
+            fail("SECRET_GRANT_INVALID")
+        payload = canonical({"username": credential(username), "password": credential(password)})
+        with self.locked():
+            metadata = self.metadata()
+            key = self.key(metadata)
+            self.require_enabled(identifier, version)
+            header = {"version": 1, "store_id": metadata["store_id"], "secret_id": identifier,
+                      "secret_version": version, "grants": grants,
+                      "created_at": datetime.now(timezone.utc).isoformat()}
+            nonce = os.urandom(12)
+            cipher = AESGCM(key).encrypt(nonce, payload, canonical(header))
+            write_private(self.revision_path(identifier, version), canonical({**header,
+                "nonce": base64.b64encode(nonce).decode(), "ciphertext": base64.b64encode(cipher).decode()}))
+        return refs
+
+    def resolve(self, principal, username_ref, password_ref):
+        identifier, version = pair_references(username_ref, password_ref)
+        validate_grant(principal)
+        with self.locked():
+            metadata = self.metadata()
+            self.require_enabled(identifier, version)
+            entry = decode(read_private(self.revision_path(identifier, version)))
+            fields = {"version", "store_id", "secret_id", "secret_version", "grants", "created_at", "nonce", "ciphertext"}
+            if (not isinstance(entry, dict) or set(entry) != fields or type(entry["version"]) is not int
+                    or entry["version"] != 1 or entry["store_id"] != metadata["store_id"]
+                    or entry["secret_id"] != identifier or type(entry["secret_version"]) is not int
+                    or entry["secret_version"] != version or not isinstance(entry["grants"], list)
+                    or not 1 <= len(entry["grants"]) <= 128
+                    or not isinstance(entry["created_at"], str) or not 1 <= len(entry["created_at"]) <= 64):
+                fail("SECRET_METADATA_INVALID")
+            for grant in entry["grants"]:
+                validate_grant(grant)
+            if principal not in entry["grants"]:
+                fail("SECRET_ACCESS_DENIED")
+            header = {k: v for k, v in entry.items() if k not in {"nonce", "ciphertext"}}
+            try:
+                nonce = base64.b64decode(entry["nonce"], validate=True)
+                ciphertext = base64.b64decode(entry["ciphertext"], validate=True)
+                if len(nonce) != 12:
+                    fail("SECRET_METADATA_INVALID")
+                plain = AESGCM(self.key(metadata)).decrypt(nonce, ciphertext, canonical(header))
+            except (ValueError, TypeError, InvalidTag):
+                raise SecretError("SECRET_AUTHENTICATION_FAILED") from None
+            value = decode(plain)
+            if not isinstance(value, dict) or set(value) != {"username", "password"}:
+                fail("SECRET_VALUE_INVALID")
+            return {k: credential(v).encode("utf-8") for k, v in value.items()}
+
+    def revoke(self, reference, operation_id):
+        """Persist a terminal tombstone. The caller must also block live leases."""
+        identifier, version, _ = parse_reference(reference)
+        if not isinstance(operation_id, str) or not OPERATION.fullmatch(operation_id):
+            fail("SECRET_OPERATION_INVALID")
+        with self.locked():
+            metadata = self.metadata()
+            path = self.revocation_path(identifier, version)
+            if os.path.lexists(path):
+                existing = decode(read_private(path))
+                if (not isinstance(existing, dict) or existing.get("store_id") != metadata["store_id"]
+                        or existing.get("secret_id") != identifier or existing.get("secret_version") != version
+                        or existing.get("revoked") is not True):
+                    fail("SECRET_METADATA_INVALID")
+                return existing
+            value = {"version": 1, "store_id": metadata["store_id"], "secret_id": identifier,
+                     "secret_version": version, "revoked": True, "operation_id": operation_id,
+                     "revoked_at": datetime.now(timezone.utc).isoformat()}
+            write_private(path, canonical(value))
+            return value
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--directory", type=Path, required=True)
+    parser.add_argument("--key-file", type=Path, required=True)
+    commands = parser.add_subparsers(dest="command", required=True)
+    commands.add_parser("init")
+    put = commands.add_parser("put")
+    put.add_argument("--input-file", type=Path, required=True,
+                     help="private JSON containing secret_id, secret_version, grants, username and password")
+    args = parser.parse_args()
+    try:
+        if args.command == "init":
+            FileSecretStore.initialize(args.directory, args.key_file)
+            print(json.dumps({"result": "SECRET_STORE_INITIALIZED"}))
+        else:
+            value = decode(read_private(args.input_file))
+            if not isinstance(value, dict) or set(value) != {"secret_id", "secret_version", "grants", "username", "password"}:
+                fail("SECRET_INPUT_INVALID")
+            store = FileSecretStore(args.directory, args.key_file)
+            refs = store.put(value["secret_id"], value["secret_version"], value["grants"], value["username"], value["password"])
+            print(json.dumps({"result": "SECRET_REVISION_CREATED", "references": refs}))
+    except (SecretError, OSError) as exc:
+        print(exc.code if isinstance(exc, SecretError) else "SECRET_STORE_UNAVAILABLE", file=sys.stderr)
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
