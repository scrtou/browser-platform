@@ -0,0 +1,116 @@
+"""Only trusted source literals cross ordinary log and HTTP error boundaries.
+
+The catalog comes from installed application source, never request contents or
+third-party exception text. Unknown messages are represented by a fixed event.
+It intentionally does not interpolate log arguments or render tracebacks.
+"""
+
+from __future__ import annotations
+
+import ast
+from functools import lru_cache
+from http import HTTPStatus
+import json
+import logging
+from pathlib import Path
+import re
+
+from fastapi.exceptions import RequestValidationError
+from fastapi.responses import JSONResponse
+from starlette.exceptions import HTTPException
+
+_CODE = re.compile(r"[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+")
+_LEVELS = {logging.DEBUG: "DEBUG", logging.INFO: "INFO", logging.WARNING: "WARNING",
+           logging.ERROR: "ERROR", logging.CRITICAL: "CRITICAL"}
+
+
+@lru_cache(maxsize=1)
+def catalog():
+    sources, templates, details, codes = {}, {}, set(), set()
+    root = Path(__file__).resolve().parent
+    for path in sorted(root.rglob("*.py")):
+        sources[str(path)] = path.relative_to(root).as_posix()
+        try:
+            tree = ast.parse(path.read_text())
+        except (OSError, SyntaxError, UnicodeError):
+            continue  # Missing source can suppress diagnostics, never expose them.
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Constant) and type(node.value) is str and len(node.value) < 512:
+                prefix = node.value.split(";", 1)[0]
+                if _CODE.fullmatch(prefix):
+                    codes.add(prefix)
+            if not isinstance(node, ast.Call):
+                continue
+            function = node.func
+            if isinstance(function, ast.Attribute) and function.attr in {"debug", "info", "warning", "error", "critical", "exception"}:
+                if node.args and isinstance(node.args[0], ast.Constant) and type(node.args[0].value) is str:
+                    templates[(str(path), node.lineno)] = node.args[0].value
+            name = function.id if isinstance(function, ast.Name) else getattr(function, "attr", "")
+            if name == "HTTPException":
+                detail = next((kw.value for kw in node.keywords if kw.arg == "detail"), None)
+                if detail is None and len(node.args) > 1:
+                    detail = node.args[1]
+                if isinstance(detail, ast.Constant) and type(detail.value) is str:
+                    details.add(detail.value)
+    return sources, templates, frozenset(details), frozenset(codes)
+
+
+class SafeFormatter(logging.Formatter):
+    def format(self, record):
+        sources, templates, _, codes = catalog()
+        path = record.pathname if type(record.pathname) is str else ""
+        line = record.lineno if type(record.lineno) is int and 0 <= record.lineno < 1000000 else 0
+        component = sources.get(path, "third_party")
+        expected = templates.get((path, line))
+        trusted = type(record.msg) is str and expected is not None and record.msg == expected
+        data = {"level": _LEVELS.get(record.levelno, "ERROR"), "component": component,
+                "event": "APPLICATION_EVENT" if trusted else "UNTRUSTED_LOG_SUPPRESSED"}
+        if path in sources:
+            data["line"] = line
+        if trusted:
+            # The template is useful with its source location. Interpolation
+            # would reintroduce arbitrary exception/request/inspect contents.
+            data["message_template"] = expected
+            if expected in codes:
+                data["event"] = expected
+        if record.exc_info:
+            data["exception"] = "EXCEPTION_RECORDED"
+        # Do not call getMessage(), formatException(), str(args), or a
+        # third-party object's __str__/__repr__. Ignore extra attributes too.
+        return json.dumps(data, ensure_ascii=True, separators=(",", ":"))
+
+
+def safe_detail(status: int, detail) -> str:
+    _, _, details, codes = catalog()
+    if type(detail) is str:
+        if detail in details:
+            return detail
+        code = detail.split(";", 1)[0]
+        if code in codes:
+            return code
+        if detail in {HTTPStatus.NOT_FOUND.phrase, HTTPStatus.METHOD_NOT_ALLOWED.phrase}:
+            return detail
+    return "REQUEST_REJECTED" if status < 500 else "SERVICE_UNAVAILABLE"
+
+
+def error_response(status: int, detail) -> JSONResponse:
+    return JSONResponse(status_code=status, content={"detail": detail},
+                        headers={"Cache-Control": "no-store", "Referrer-Policy": "no-referrer"})
+
+
+def install_handlers(app) -> None:
+    async def http_error(_request, exc):
+        status = exc.status_code if type(exc.status_code) is int and 400 <= exc.status_code <= 599 else 500
+        # Exception headers can contain Cookie, Location or arbitrary detail.
+        return error_response(status, safe_detail(status, exc.detail))
+
+    async def validation_error(_request, _exc):
+        return error_response(422, "REQUEST_VALIDATION_FAILED")
+
+    async def unexpected_error(_request, _exc):
+        logging.getLogger(__name__).error("HTTP_UNEXPECTED_FAILURE", exc_info=True)
+        return error_response(500, "SERVICE_UNAVAILABLE")
+
+    app.add_exception_handler(HTTPException, http_error)
+    app.add_exception_handler(RequestValidationError, validation_error)
+    app.add_exception_handler(Exception, unexpected_error)
