+"""Generation ownership and partial Docker failures must retain the Home."""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import json
+import os
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from docker.errors import APIError, NotFound
+from fastapi import HTTPException
+
+from app import config_store, docker_utils
+from app import network_runtime as network
+from app import profile_runtime as runtime
+from app.launch import ensure_container_for_session, launch_application, stop_session
+from app.models import InstalledApp
+from app.providers import docker_provider
+from app.state import state
+
+OPERATION = "b" * 32
+RELAY_IMAGE = "sha256:" + "c" * 64
+PROBE_IMAGE = "sha256:" + "d" * 64
+WORKER_IMAGE = "sha256:" + "e" * 64
+POLICY_ID = "qa-socks-r1"
+EVIDENCE = {"proxy_tls": True, "direct_ipv4_blocked": True,
+            "direct_ipv6_blocked": True, "local_dns_blocked": True}
+
+
+class FakeNetwork:
+    def __init__(self, docker, name, internal, labels):
+        self.docker, self.name = docker, name
+        self.id = docker.identifier()
+        self.attrs = {"Id": self.id, "Name": name, "Labels": labels, "Driver": "bridge",
+                      "Internal": internal, "EnableIPv6": False,
+                      "IPAM": {"Config": [{"Subnet": "172.28.1.0/24"}]}, "Containers": {}}
+
+    def reload(self):
+        return None
+
+    def connect(self, container, ipv4_address=None):
+        if isinstance(container, str):
+            container = self.docker.containers.get(container)
+        address = ipv4_address or f"172.28.1.{len(self.attrs['Containers']) + 2}"
+        assert not any(value["IPv4Address"].split("/")[0] == address for value in self.attrs["Containers"].values())
+        self.docker.event("connect", container.role)
+        self.attrs["Containers"][container.id] = {"Name": container.name, "IPv4Address": address + "/24"}
+        container.attrs["NetworkSettings"]["Networks"][self.name] = {"IPAddress": address}
+        if self.docker.lost_connect_reply:
+            self.docker.lost_connect_reply = False
+            raise APIError("connect response lost after attachment")
+
+    def disconnect(self, instance):
+        if not isinstance(instance, str):
+            instance = instance.id
+        self.docker.event("disconnect", self.docker.containers.get(instance).role)
+        self.attrs["Containers"].pop(instance, None)
+        container = self.docker.containers.get(instance)
+        container.attrs["NetworkSettings"]["Networks"].pop(self.name, None)
+
+    def remove(self):
+        self.docker.event("remove", self.attrs["Labels"][network.PREFIX + "role"])
+        if self.docker.network_remove_error:
+            raise APIError("network remove failed")
+        assert not self.attrs["Containers"]
+        self.docker.network_values.pop(self.id)
+
+
+class FakeContainer:
+    def __init__(self, docker, kwargs, role="controller"):
+        self.docker, self.kwargs, self.role = docker, kwargs, role
+        self.id = docker.identifier()
+        self.short_id = self.id[:12]
+        self.name = kwargs.get("name", role)
+        self.status = "created"
+        inherited = {network.PREFIX + "network-guard": "1", "image-vendor": "qa"} if role in {"guard", "relay"} else {}
+        self.attrs = {"Id": self.id, "Name": "/" + self.name,
+                      "Config": {"Labels": {**inherited, **kwargs.get("labels", {})}},
+                      "Mounts": [{"Source": source, "Destination": bind["bind"]}
+                                 for source, bind in (kwargs.get("volumes") or {}).items()],
+                      "NetworkSettings": {"Networks": {}}, "State": {"Status": self.status}}
+
+    def reload(self):
+        self.attrs["State"]["Status"] = self.status
+
+    def start(self):
+        self.docker.event("start", self.role)
+        self.status = "running"
+        if self.role == "guard" and self.docker.guard_failure:
+            self.status = "exited"
+        self.reload()
+
+    def wait(self, timeout):
+        self.status = "exited"
+        self.reload()
+        return {"StatusCode": self.docker.probe_status}
+
+    def logs(self, **kwargs):
+        if self.role == "guard":
+            source = next(iter(self.kwargs["volumes"]))
+            return json.dumps({"network_guard_ready": network.digest(json.loads(Path(source).read_text()))}).encode()
+        return json.dumps(self.docker.probe_evidence).encode()
+
+    def stop(self, timeout):
+        self.docker.event("stop", self.role)
+        if self.docker.stop_failure == self.role:
+            raise APIError("injected stop failure")
+        self.status = "exited"
+        self.reload()
+
+    def remove(self):
+        self.docker.event("remove", self.role)
+        for value in self.docker.network_values.values():
+            value.attrs["Containers"].pop(self.id, None)
+        self.docker.container_values.pop(self.id)
+
+
+class FakeDocker:
+    def __init__(self):
+        self.serial, self.events = 100, []
+        self.container_values, self.network_values = {}, {}
+        self.probe_status, self.probe_evidence = 0, EVIDENCE
+        self.stop_failure = self.create_failure = None
+        self.network_remove_error = False
+        self.list_error = False
+        self.guard_failure = False
+        self.lost_connect_reply = False
+        self.containers = SimpleNamespace(get=self.get_container, list=self.list_containers,
+                                          create=self.create_container, run=self.run_container)
+        self.networks = SimpleNamespace(get=self.get_network, list=self.list_networks, create=self.create_network)
+        self.images = SimpleNamespace(get=lambda _: SimpleNamespace(attrs={"Config": {"Labels": {network.PREFIX + "network-guard": "1"}}}))
+        self.api = SimpleNamespace(create_endpoint_config=lambda **kwargs: kwargs)
+        controller = FakeContainer(self, {"volumes": {str(network.base_dir()): {"bind": str(network.base_dir())}}})
+        controller.status = "running"
+        controller.reload()
+        self.controller = controller
+        self.container_values[controller.id] = controller
+
+    def identifier(self):
+        self.serial += 1
+        return f"{self.serial:064x}"
+
+    def event(self, action, role):
+        # Docker allocations and Worker creates can only follow a durable reservation.
+        assert list(network.runtime_dir().glob("*.json"))
+        self.events.append((action, role))
+
+    def get_container(self, identifier):
+        if identifier == os.uname()[1]:
+            return self.controller
+        for container in self.container_values.values():
+            if identifier in {container.id, container.name}:
+                return container
+        raise NotFound("missing")
+
+    def list_containers(self, **kwargs):
+        if self.list_error:
+            raise APIError("inventory unavailable")
+        return list(self.container_values.values())
+
+    def get_network(self, identifier):
+        for value in self.network_values.values():
+            if identifier in {value.id, value.name}:
+                return value
+        raise NotFound("missing")
+
+    def list_networks(self):
+        if self.list_error:
+            raise APIError("network inventory unavailable")
+        return list(self.network_values.values())
+
+    def create_network(self, name, **kwargs):
+        role = kwargs["labels"][network.PREFIX + "role"]
+        self.event("create", role)
+        value = FakeNetwork(self, name, kwargs["internal"], kwargs["labels"])
+        self.network_values[value.id] = value
+        if self.create_failure == role:
+            raise APIError("create response lost after allocation")
+        return value
+
+    def create_container(self, **kwargs):
+        role = kwargs.get("labels", {}).get(network.PREFIX + "role", "worker")
+        self.event("create", role)
+        container = FakeContainer(self, kwargs, role)
+        self.container_values[container.id] = container
+        if kwargs.get("network_mode", "").startswith("container:"):
+            self.get_container(kwargs["network_mode"].split(":", 1)[1])
+            container.attrs["HostConfig"] = {"NetworkMode": kwargs["network_mode"]}
+        else:
+            endpoint = kwargs.get("networking_config", {}).get(kwargs["network"], {})
+            self.get_network(kwargs["network"]).connect(container, ipv4_address=endpoint.get("ipv4_address"))
+        if self.create_failure == role:
+            raise APIError("create response lost after allocation")
+        return container
+
+    def run_container(self, **kwargs):
+        container = self.create_container(**kwargs)
+        container.start()
+        return container
+
+
+@pytest.fixture
