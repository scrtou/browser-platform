+class StopProfileRequest(BaseModel):
+    """Expected launch generation; never a wildcard stop for a Home."""
+
+    profile_id: str = Field(pattern=r"^[A-Za-z0-9_-]{1,128}$")
+    operation_id: str = Field(pattern=r"^[a-f0-9]{32}$")
+    application_id: str = Field(min_length=1, max_length=256)
+    session_id: str = Field(default="", max_length=128)
+    bootstrap_url: str = Field(min_length=1, max_length=4096)
+    network_policy_id: str = Field(default="", pattern=r"^(?:[A-Za-z0-9_-]{1,128})?$")
+    network_policy_sha256: str = Field(default="", pattern=r"^(?:[a-f0-9]{64})?$")
+
+
+def record_matches(record: dict[str, Any], request: StopProfileRequest) -> bool:
+    """Require immutable generation metadata or the exact legacy launch marker."""
+    if (record["is_collaboration"] or record["app_id"] != request.application_id or
+            record.get("network_policy_id", "") != request.network_policy_id or
+            record.get("network_policy_sha256", "") != request.network_policy_sha256):
+        return False
+    if record["profile_id"] or record["operation_id"]:
+        return record["profile_id"] == request.profile_id and record["operation_id"] == request.operation_id
+    context = record.get("launch_context") or {}
+    return bool(request.session_id and record["session_id"] == request.session_id and
+                context.get("type") == "url" and context.get("value") == request.bootstrap_url)
+
+
+def validate_stop_inventory(snapshot: dict[str, Any], request: StopProfileRequest) -> None:
+    """Refuse stale generations, foreign mounts and ambiguous legacy orphans."""
+    records = {r["session_id"]: r for r in snapshot["records"]}
+    launch_journal.validate_for_stop(snapshot["resources"], request)
+    network_runtime.validate_resources([r for r in snapshot["resources"] if r["kind"] != "launch"], request)
+    if any(not record_matches(r, request) for r in records.values()):
+        raise HTTPException(409, "Home belongs to a different or unproven launch operation.")
+    for worker in snapshot["workers"]:
+        if (not worker["owned"] or worker["app_id"] != request.application_id or
+                worker.get("network_policy_id", "") != request.network_policy_id or
+                worker.get("network_policy_sha256", "") != request.network_policy_sha256):
+            raise HTTPException(409, "Container ownership is unproven; no container was stopped.")
+        if worker["profile_id"] or worker["operation_id"]:
+            matches = worker["profile_id"] == request.profile_id and worker["operation_id"] == request.operation_id
+        else:
+            matches = worker["session_id"] in records and record_matches(records[worker["session_id"]], request)
+        if not matches:
+            raise HTTPException(409, "Container belongs to a different launch operation.")
+
+
+async def stop_profile_locked(username: str, home_name: str, request: StopProfileRequest) -> None:
+    """The caller holds the Home lock; network cleanup follows Worker removal."""
+    from .providers.docker_provider import DockerProvider
+
+    snapshot = await inspect_home(username, home_name)
+    validate_stop_inventory(snapshot, request)
+    identity = runtime_identity(username, home_name, request.application_id, request.profile_id, request.operation_id)
+    # This intent survives direct UI stops whose Session record is later removed.
+    await network_runtime.set_phase(identity, "stopping")
+    reservation = network_runtime.read_reservation(identity)
+    if reservation and reservation["policy"].get("coherence"):
+        from .coherence_runtime import write_gate
+        write_gate(reservation, "blocked")
+    from .secret_runtime import before_stop
+    await before_stop(identity)
+    for record in snapshot["records"]:
+        await stop_session_confirmed(record["session_id"])
+    try:
+        if snapshot["workers"]:
+            provider = DockerProvider({"provider_config": {}})
+            for worker in snapshot["workers"]:
+                await provider.stop(worker["instance_id"])
+    except Exception as exc:
+        raise HTTPException(503, "Orphan removal was not confirmed; stop can be retried.") from exc
+    remaining = await inspect_home(username, home_name)
+    if remaining["records"] or remaining["workers"]:
+        raise HTTPException(503, "Home is still reserved; stop was not completed.")
+    try:
+        await network_runtime.remove_after_exit(identity, request)
+    except HTTPException:
+        raise
+    except Exception as exc:
+        raise HTTPException(503, "NETWORK_CLEANUP_INCOMPLETE; reservation retained") from exc
+    await launch_journal.clear_after_stop(identity, request, containers_present=False)
+    remaining = await inspect_home(username, home_name)
+    if remaining["records"] or remaining["workers"] or remaining["resources"]:
+        raise HTTPException(503, "Home resources still exist; stop was not completed.")
+
+
+router = APIRouter(prefix="/api/profile-runtime", route_class=EncryptedRoute,
+                   dependencies=[Depends(verify_token)])
+
+
+@router.get("/{home_name}")
+async def get_profile_runtime(home_name: str, user: dict[str, Any] = Depends(verify_token)) -> dict[str, Any]:
+    """Return a fresh Docker-backed snapshot while holding the Home lock."""
+    async with lifecycle_lock("home:" + home_path(user["username"], home_name)):
+        return await inspect_home(user["username"], home_name)
+
+
+@router.post("/{home_name}/stop", status_code=204)
+async def stop_profile_runtime(home_name: str,
+                               decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body),
+                               user: dict[str, Any] = Depends(verify_token)) -> Response:
+    """Stop one generation, including labeled orphans, and verify an empty Home."""
+    try:
+        request = StopProfileRequest(**decrypted_body)
+    except ValidationError as exc:
+        raise HTTPException(422, "Invalid Profile stop request.") from exc
+    username = user["username"]
+    async with lifecycle_lock("home:" + home_path(username, home_name)):
+        await stop_profile_locked(username, home_name, request)
+        return Response(status_code=204)
