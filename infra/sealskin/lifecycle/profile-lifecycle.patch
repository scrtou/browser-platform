+def write_gate(reservation, mode, expires_at=None):
+    now = time.time()
+    sequence = max(time.time_ns(), reservation.get("coherence_sequence", 0) + 1)
+    path = directory(reservation) / "coherence" / "gate.json"
+    if path.exists():
+        # Interrupted writes may have advanced the gate before the journal.
+        current = network.read_json(path)
+        if current.get("generation") != generation(reservation):
+            raise ValueError("COHERENCE_GATE_BINDING_INVALID")
+        sequence = max(sequence, int(current["sequence"]) + 1)
+    expiry = min(now + 60, expires_at) if expires_at is not None else now + 60
+    if expiry <= now:
+        mode, expiry = "probe", now + 60
+    record = {"version": 1, "generation": generation(reservation), "sequence": sequence, "state": mode,
+              "issued_ms": int(now * 1000), "expires_ms": int(expiry * 1000)}
+    network.atomic_json(path, record)
+    reservation["coherence_sequence"] = sequence
+    network.save_reservation(reservation)
+    return record
+
+
+def prepare_gate(reservation, policy, relay_config, volumes):
+    artifact, _ = assets(policy.coherence)
+    write_gate(reservation, "probe")
+    relay_config.update(coherence_gate_file=GATE_DIRECTORY + "/gate.json", coherence_generation=generation(reservation),
+                        coherence_probe_domain=policy.coherence.observer_domain, coherence_probe_port=policy.coherence.observer_port)
+    volumes[translate_path_to_host(str(directory(reservation) / "coherence"))] = {"bind": GATE_DIRECTORY, "mode": "ro"}
+    volumes.update(result_mount(reservation, "relay"))
+    result_mount(reservation, "worker")
