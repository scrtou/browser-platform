@@ -0,0 +1,80 @@
+"""Exercise the final logging and HTTP exception boundaries with sentinels."""
+
+import io
+import json
+import logging
+
+import pytest
+from fastapi import HTTPException
+from fastapi.testclient import TestClient
+
+from app import logging_config
+from .test_api_smoke import api_client  # noqa: F401 -- shared isolated ASGI fixture
+
+SENTINEL = "synthetic-output-secret-73e7c949"
+
+
+@pytest.fixture
+def safe_logs(monkeypatch):
+    root = logging.getLogger()
+    previous, level = root.handlers[:], root.level
+    library_states = {name: (logger.handlers[:], logger.level, logger.propagate)
+                      for name, logger in logging.Logger.manager.loggerDict.items() if isinstance(logger, logging.Logger)}
+    output = io.StringIO()
+    monkeypatch.setattr(logging_config.sys, "stdout", output)
+    logging_config.setup_logging()
+    try:
+        yield output
+    finally:
+        root.handlers, root.level = previous, level
+        for name, (handlers, old_level, propagate) in library_states.items():
+            logger = logging.getLogger(name)
+            logger.handlers, logger.level, logger.propagate = handlers, old_level, propagate
+
+
+def test_arbitrary_library_messages_tracebacks_and_args_are_not_output(safe_logs):
+    external = logging.getLogger("httpx")
+    external.error("GET https://example.invalid/?access_token=%s", SENTINEL)
+    external.error("unlabelled " + SENTINEL)
+    external.error({"cookie": SENTINEL, "password": SENTINEL})
+    try:
+        raise RuntimeError(SENTINEL)
+    except RuntimeError:
+        logging.getLogger("app.providers.docker_provider").exception("upstream failed: %s", SENTINEL, stack_info=True)
+    raw = safe_logs.getvalue()
+    assert SENTINEL not in raw
+    assert len(raw.splitlines()) >= 4
+    assert all(isinstance(json.loads(line), dict) for line in raw.splitlines())
+
+
+def test_http_validation_error_never_echoes_input(api_client):
+    response = api_client.http.post("/api/handshake/exchange", json={"encrypted_session_key": {"password": SENTINEL}})
+    assert response.status_code == 422
+    assert SENTINEL not in response.text
+    assert response.json()["detail"] == "REQUEST_VALIDATION_FAILED"
+
+
+def test_http_error_sanitizes_arbitrary_detail_and_headers(api_client):
+    from app.api import create_app
+    app = create_app()
+    @app.get("/qa/untrusted-error")
+    async def untrusted():
+        raise HTTPException(503, SENTINEL, headers={"X-Error-Detail": SENTINEL, "Set-Cookie": "test=" + SENTINEL})
+    @app.get("/qa/coded-error")
+    async def coded():
+        raise HTTPException(503, "NETWORK_PROBE_FAILED; " + SENTINEL)
+    @app.get("/qa/unknown-error")
+    async def unknown():
+        raise RuntimeError(SENTINEL)
+    with TestClient(app, raise_server_exceptions=False) as client:
+        for endpoint in ("untrusted-error", "coded-error", "unknown-error"):
+            response = client.get("/qa/" + endpoint)
+            assert response.status_code in {500, 503}
+            assert SENTINEL not in response.text + str(response.headers)
+        assert client.get("/qa/coded-error").json()["detail"] == "NETWORK_PROBE_FAILED"
+
+
+def test_encrypted_authenticated_validation_error_does_not_echo_plaintext(api_client):
+    status, response = api_client.call("POST", "/api/admin/apps/stores", {"name": {"password": SENTINEL}, "url": SENTINEL})
+    assert status == 422
+    assert SENTINEL not in json.dumps(response)
