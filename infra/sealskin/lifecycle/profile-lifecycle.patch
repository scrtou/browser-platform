index 0000000..d2c7f0c
--- /dev/null
+++ b/server/app/network_probe.py
@@ -0,0 +1,90 @@
+"""One-shot readiness evidence, executed in the future Worker's internal network."""
+
+import json
+import socket
+import ssl
+import struct
+import sys
+import time
+from urllib.parse import urlsplit
+
+
+def exact(connection, size):
+    """Read a complete SOCKS5 or HTTP field."""
+    data = b""
+    while len(data) < size:
+        chunk = connection.recv(size - len(data))
+        if not chunk:
+            raise OSError("incomplete reply")
+        data += chunk
+    return data
+
+
+def blocked(family, address):
+    """Return whether one numerical direct TCP destination is unreachable."""
+    with socket.socket(family, socket.SOCK_STREAM) as connection:
+        connection.settimeout(1)
+        return connection.connect_ex(address) != 0
+
+
+def main():
+    """Emit bounded readiness evidence without credentials or response content."""
+    relay, url, timeout, ca_file = sys.argv[1:]
+    timeout = int(timeout)
+    parsed = urlsplit(url)
+    host, port = parsed.hostname, parsed.port or 443
+    # Reaching either numerical address directly is a failed startup gate.
+    ipv4 = blocked(socket.AF_INET, ("1.1.1.1", 443))
+    ipv6 = blocked(socket.AF_INET6, ("2606:4700:4700::1111", 443, 0, 0))
+    try:
+        socket.getaddrinfo(host, port)
+        dns_blocked = False
+    except socket.gaierror:
+        dns_blocked = True
+    connection = None
+    for attempt in range(2):
+        try:
+            connection = socket.create_connection((relay, 1080), timeout=timeout)
+            break
+        except OSError:
+            if attempt:
+                raise
+            time.sleep(0.3)
+    with connection:
+        connection.sendall(b"\x05\x01\x00")
+        if exact(connection, 2) != b"\x05\x00":
+            raise OSError("relay handshake rejected")
+        domain = host.encode("idna")
+        connection.sendall(b"\x05\x01\x00\x03" + bytes([len(domain)]) + domain + struct.pack("!H", port))
+        header = exact(connection, 4)
+        if header[:3] != b"\x05\x00\x00":
+            raise OSError("upstream connection rejected")
+        size = {1: 4, 4: 16}.get(header[3])
+        if header[3] == 3:
+            size = exact(connection, 1)[0]
+        if size is None:
+            raise OSError("invalid bound address")
+        exact(connection, size + 2)
+        context = ssl.create_default_context(cafile=ca_file or None)
+        with context.wrap_socket(connection, server_hostname=host) as secure:
+            target = (parsed.path or "/") + ("?" + parsed.query if parsed.query else "")
+            authority = host if port == 443 else f"{host}:{port}"
+            secure.sendall(f"GET {target} HTTP/1.1\r\nHost: {authority}\r\nUser-Agent: browser-platform-network-probe/1\r\nConnection: close\r\n\r\n".encode("ascii"))
+            response = b""
+            while b"\r\n" not in response and len(response) < 4096:
+                response += exact(secure, 1)
+            parts = response.split(b" ", 2)
+            tls_ok = len(parts) >= 2 and parts[1] == b"200"
+    evidence = {"proxy_tls": tls_ok, "direct_ipv4_blocked": ipv4,
+                "direct_ipv6_blocked": ipv6, "local_dns_blocked": dns_blocked}
+    print(json.dumps(evidence), flush=True)
+    return 0 if all(evidence.values()) else 1
+
+
+if __name__ == "__main__":
+    try:
+        code = main()
+    except Exception:
+        print(json.dumps({"error_code": "NETWORK_PROBE_FAILED"}), flush=True)
+        code = 1
+    sys.exit(code)
