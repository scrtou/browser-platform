+"""Verified Profile lifecycle for the pinned browser-platform integration.
+
+Docker remains owned by SealSkin. Inventory contains no access tokens, browser
+credentials or environment values. An orphan can be stopped only when its
+immutable labels identify this deployment, user, Home and launch operation.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import functools
+import hashlib
+import inspect
+import logging
+import os
+import re
+import shutil
+from typing import Any
+from weakref import WeakValueDictionary
+
+from fastapi import APIRouter, Depends, HTTPException, Response
+from pydantic import BaseModel, Field, ValidationError
+
+from . import config_store, launch_journal, network_runtime
+from .docker_utils import get_docker_client, translate_path_to_host
+from .fsutil import safe_join
+from .security import EncryptedRoute, get_decrypted_request_body, verify_token
+from .settings import settings
+from .state import state
+
+logger = logging.getLogger(__name__)
+PREFIX = "io.browser-platform."
+VERSION = 1
+NAME = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
+OPERATION = re.compile(r"^[a-f0-9]{32}$")
+INSTANCE = re.compile(r"^[a-f0-9]{64}$")
+_LOCKS: WeakValueDictionary[str, asyncio.Lock] = WeakValueDictionary()
+
+
+def lifecycle_lock(key: str) -> asyncio.Lock:
+    """Share a lock while an operation or a waiter still references it."""
+    lock = _LOCKS.get(key)
+    if lock is None:
+        lock = asyncio.Lock()
+        _LOCKS[key] = lock
+    return lock
+
+
+def home_path(username: str, home_name: str) -> str:
+    """Resolve one named persistent Home, refusing symlinks outside storage."""
+    if not NAME.fullmatch(home_name) or home_name.lower() == "cleanroom":
+        raise HTTPException(422, "A named persistent Home is required.")
+    try:
+        user_root = safe_join(settings.storage_path, username)
+        return safe_join(user_root, home_name)
+    except ValueError as exc:
+        raise HTTPException(422, "Invalid Home path.") from exc
+
+
+def scope_id() -> str:
+    """Bind labels to the stable host location of this server's state file."""
+    path = os.path.normpath(translate_path_to_host(settings.sessions_db_path))
+    return hashlib.sha256(path.encode()).hexdigest()
+
+
+def home_source(username: str, home_name: str) -> str:
+    """Return the host-side source expected at the Worker's /config mount."""
+    return os.path.normpath(translate_path_to_host(home_path(username, home_name)))
+
+
+def runtime_identity(username: str, home_name: str, app_id: str,
+                     profile_id: str | None, operation_id: str | None) -> dict[str, str]:
+    """Build reserved launch metadata independently of app Docker overrides."""
+    source = home_source(username, home_name)
+    return {"scope": scope_id(), "owner": username, "home": home_name,
+            "home_source": source, "home_hash": hashlib.sha256(source.encode()).hexdigest(),
+            "app": app_id, "profile": profile_id or "", "operation": operation_id or ""}
+
+
+def instance_ids(data: dict[str, Any]) -> list[str]:
+    """Include the primary instance even when the room registry is incomplete."""
+    ids = {data.get("instance_id")}
+    ids.update(entry.get("instance_id") for entry in (data.get("container_registry") or {}).values())
+    ids.discard(None)
+    ids.discard("")
+    if not ids or any(not isinstance(value, str) or not INSTANCE.fullmatch(value) for value in ids):
+        raise HTTPException(409, "Session instance ownership is incomplete; recovery is required.")
+    return sorted(ids)
+
+
+def record_summary(session_id: str, data: dict[str, Any]) -> dict[str, Any]:
+    """Project a session record to non-secret lifecycle fields."""
+    return {"session_id": session_id, "app_id": data.get("provider_app_id", ""),
+            "profile_id": data.get("profile_id", ""), "operation_id": data.get("operation_id", ""),
+            "network_policy_id": data.get("network_policy_id", ""),
+            "network_policy_sha256": data.get("network_policy_sha256", ""),
+            "instance_ids": instance_ids(data), "phase": data.get("lifecycle_phase", "running"),
+            "launch_context": data.get("launch_context"),
+            "is_collaboration": data.get("is_collaboration", False),
+            "coherence_required": data.get("coherence_required", False)}
+
+
+async def inspect_home(username: str, home_name: str) -> dict[str, Any]:
+    """Inspect both YAML ownership and every container mounting this Home.
+
+    Docker failures are errors, never an empty inventory. Exited and paused
+    containers still reserve a Home until verified removal.
+    """
+    path = home_path(username, home_name)
+    source = home_source(username, home_name)
+    records = []
+    async with state.sessions_lock:
+        for sid, data in state.sessions.items():
+            if data.get("username") == username and data.get("host_mount_path") and os.path.realpath(data["host_mount_path"]) == path:
+                records.append(record_summary(sid, data))
+    by_instance: dict[str, list[dict[str, Any]]] = {}
+    for record in records:
+        for instance_id in record["instance_ids"]:
+            by_instance.setdefault(instance_id, []).append(record)
+    try:
+        client = await asyncio.to_thread(get_docker_client)
+        containers = await asyncio.to_thread(client.containers.list, all=True, ignore_removed=True)
+    except Exception as exc:
+        logger.error("Profile inventory could not query Docker (%s).", type(exc).__name__)
+        raise HTTPException(503, "Docker inventory is unavailable; Home remains reserved.") from exc
+    workers = []
+    for container in containers:
+        attrs = container.attrs
+        mounts = attrs.get("Mounts", [])
+        if not any(m.get("Destination") == settings.container_config_path and
+                   os.path.normpath(m.get("Source", "")) == source for m in mounts):
+            continue
+        labels = attrs.get("Config", {}).get("Labels") or {}
+        policy_id = labels.get(PREFIX + "network-policy", "")
+        policy_sha = labels.get(PREFIX + "network-policy-sha256", "")
+        ownership = by_instance.get(container.id, [])
+        managed = labels.get(PREFIX + "version") == str(VERSION)
+        owned = (managed and labels.get(PREFIX + "scope") == scope_id() and
+                 labels.get(PREFIX + "owner") == username and labels.get(PREFIX + "home") == home_name and
+                 labels.get(PREFIX + "home_hash") == hashlib.sha256(source.encode()).hexdigest())
+        if managed:
+            sid = labels.get(PREFIX + "session", "")
+            app_id = labels.get(PREFIX + "app", "")
+            profile_id = labels.get(PREFIX + "profile", "")
+            operation_id = labels.get(PREFIX + "operation", "")
+            if ownership and (len(ownership) != 1 or ownership[0]["session_id"] != sid):
+                owned = False
+        elif len(ownership) == 1:
+            record = ownership[0]
+            owned = True
+            sid, app_id = record["session_id"], record["app_id"]
+            profile_id, operation_id = record["profile_id"], record["operation_id"]
+            policy_id, policy_sha = record["network_policy_id"], record["network_policy_sha256"]
+            # A policy-managed Worker is never adopted through legacy records.
+            if policy_id or policy_sha:
+                owned = False
+        else:
+            sid = app_id = profile_id = operation_id = ""
+        workers.append({"instance_id": container.id, "session_id": sid, "app_id": app_id,
+                        "profile_id": profile_id, "operation_id": operation_id,
+                        "network_policy_id": policy_id, "network_policy_sha256": policy_sha,
+                        "status": attrs.get("State", {}).get("Status", "unknown"),
+                        "owned": bool(owned), "managed": managed, "recorded": bool(ownership)})
+    identity = runtime_identity(username, home_name, "", "", "")
+    resources = await network_runtime.inventory(identity, containers)
+    resources.extend(launch_journal.summaries(identity))
+    return {"version": VERSION, "home_name": home_name, "records": records, "workers": workers,
+            "network_runtime_version": 1, "network_enforcement_version": 1, "launch_journal_version": 1,
+            "network_upstream_version": 1,
+            "browser_shutdown_version": 1,
+            "session_auth_version": 1,
+            "secret_store_version": 1,
+            "network_direct_version": 1,
+            "network_bootstrap_dns_version": 1,
+            "profile_initial_url_version": 1,
+            "coherence_runtime_version": 1,
+            "resources": resources}
+
+
+def guard_launch(function):
+    """Serialize explicit named-Home launches with stop, including legacy API calls."""
+    signature = inspect.signature(function)
+
+    @functools.wraps(function)
+    async def guarded(*args, **kwargs):
+        values = signature.bind(*args, **kwargs)
+        values.apply_defaults()
+        params = values.arguments
+        profile_id, operation_id = params.get("profile_id"), params.get("operation_id")
+        home_name, username = params.get("home_name"), params["username"]
+        app = state.installed_apps.get(params["application_id"])
+        policy = network_runtime.policy_for_launch(params, app)
+        named = (home_name and home_name.lower() != "cleanroom" and app and
+                 not app.is_meta_app and app.home_directories and
+                 params["effective_settings"].get("persistent_storage") and not params.get("forced_rw_mount"))
+        if profile_id is not None or operation_id is not None:
