+async def network_topology(reservation, client, containers):
+    """Prove the actual generation topology before invoking namespace scripts.
+
+    An inspector correctly refuses unexpected interfaces. That refusal alone
+    cannot contain a Worker with a second public path, so known Docker metadata
+    drift must be a confirmed failure rather than an observation exception.
+    """
+    allocation = reservation["allocation"]
+    actual = {}
+    for kind in ("internal", "egress"):
+        try:
+            resource = await asyncio.to_thread(client.networks.get, allocation[kind + "_id"])
+        except network.NotFound as exc:
+            raise RuntimeDrift("NETWORK_TOPOLOGY_CHANGED", isolate=True) from exc
+        attrs = resource.attrs
+        expected_labels = network.resource_labels(reservation, kind)
+        if (resource.id != allocation[kind + "_id"] or resource.name != network.resource_name(reservation["identity"], kind) or
+                any((attrs.get("Labels") or {}).get(k) != v for k, v in expected_labels.items()) or
+                attrs.get("Driver") != "bridge" or attrs.get("Internal") is not (kind == "internal") or
+                attrs.get("EnableIPv6") is not False):
+            raise RuntimeDrift("NETWORK_TOPOLOGY_CHANGED", isolate=True)
+        actual[kind] = resource
+    internal, egress = actual["internal"], actual["egress"]
+    worker, guard, relay = (containers[role] for role in ("worker", "guard", "relay"))
+    guard_networks = guard.attrs.get("NetworkSettings", {}).get("Networks") or {}
+    relay_networks = relay.attrs.get("NetworkSettings", {}).get("Networks") or {}
+    if (set(guard_networks) != {internal.name} or set(relay_networks) != {internal.name, egress.name} or
+            guard_networks[internal.name].get("NetworkID") != internal.id or
+            relay_networks[internal.name].get("NetworkID") != internal.id or
+            relay_networks[egress.name].get("NetworkID") != egress.id or
+            guard_networks[internal.name].get("IPAddress") != allocation["guard_ip"] or
+            relay_networks[internal.name].get("IPAddress") != allocation["relay_ip"] or
+            any(item.get("GlobalIPv6Address") or item.get("IPv6Gateway") for item in [*guard_networks.values(), *relay_networks.values()]) or
+            any(item.attrs.get("HostConfig", {}).get("Privileged") or
+                item.attrs.get("HostConfig", {}).get("NetworkMode") in {"host", "none"} for item in (guard, relay)) or
+            worker.attrs.get("NetworkSettings", {}).get("Networks")):
+        raise RuntimeDrift("NETWORK_TOPOLOGY_CHANGED", isolate=True)
+    internal_members = internal.attrs.get("Containers") or {}
+    egress_members = egress.attrs.get("Containers") or {}
+    expected_members = {guard.id: allocation["guard_ip"], relay.id: allocation["relay_ip"],
+                        reservation["controller_id"]: allocation["controller_ip"]}
+    if (set(internal_members) != set(expected_members) or set(egress_members) != {relay.id} or
+            any(internal_members[key].get("IPv4Address", "").split("/")[0] != ip for key, ip in expected_members.items())):
+        raise RuntimeDrift("NETWORK_TOPOLOGY_CHANGED", isolate=True)
+    return {"internal_id": internal.id, "egress_id": egress.id, "guard_ip": allocation["guard_ip"],
+            "relay_ip": allocation["relay_ip"], "internal_only_guard": True, "exclusive_generation_networks": True}
+
+
+async def network_facts(reservation, binding, client, containers):
+    allocation = reservation["allocation"]
+    facts = {"binding_sha256": network.digest(binding), "status": "unknown", "code": "NETWORK_UNOBSERVED",
+             "dns_mode": "approved_resolver" if reservation["policy"].get("mode") == "direct" else "upstream",
+             "host_ipv4": allocation.get("host_ipv4", [])}
+    worker, relay, guard = (containers[key] for key in ("worker", "relay", "guard"))
+    for container in (worker, relay, guard):
+        await asyncio.to_thread(container.reload)
+    host = worker.attrs.get("HostConfig", {})
+    if (host.get("NetworkMode") != "container:" + guard.id or host.get("Privileged") or host.get("CapAdd") or
+            not {"NET_ADMIN", "NET_RAW"} <= set(host.get("CapDrop") or [])):
+        facts.update(status="fail", code="NETWORK_NAMESPACE_CHANGED")
+        return facts
+    try:
+        facts["topology"] = await network_topology(reservation, client, containers)
+    except RuntimeDrift as exc:
+        facts.update(status="fail", code=exc.code)
+        return facts
+    policy = network.NetworkPolicy(**reservation["policy"])
+    if policy.mode == "direct":
+        from .network_direct import validate_allocation
+    else:
+        from .network_dns import validate_allocation
+    try:
+        await asyncio.to_thread(validate_allocation, client, reservation)
+    except HTTPException as exc:
+        if exc.detail in {"DIRECT_CONFIG_CHANGED", "DIRECT_CONFIG_MOUNT_CHANGED", "DIRECT_HOST_MOUNT_REQUIRED",
+                          "NETWORK_BOOTSTRAP_CONFIG_CHANGED", "NETWORK_BOOTSTRAP_CONFIG_MOUNT_CHANGED"}:
+            facts.update(status="fail", code=exc.detail)
+            return facts
+        raise
+    for role, item in (("guard", guard), ("relay", relay)):
+        actual = await coherence_exec.inspect_rules(client, item, result_directory(reservation, role))
+        expected_config = allocation["guard_config_sha256" if role == "guard" else "relay_network_sha256"]
+        if actual["config_sha256"] != expected_config or actual["rules_sha256"] != allocation.get(role + "_rules_sha256"):
+            facts.update(status="fail", code="NETWORK_RULES_CHANGED")
+            return facts
+        facts[role] = {key: actual[key] for key in ("config_sha256", "rules_sha256", "output_dropped_packets")}
+    facts.update(status="pass", code="NETWORK_ENFORCEMENT_CURRENT")
+    return facts
+
+
+async def cached_report(reservation, session_id):
+    spec = network.NetworkPolicy(**reservation["policy"]).coherence
+    if not spec:
+        return None
+    now = time.time()
+    try:
+        binding, _, _ = await current_runtime(reservation, session_id)
+        report = copy.deepcopy(reservation.get("coherence_report"))
+        if not report or report.get("binding") != binding:
+            return coherence_report.unavailable(binding, spec.mode, now, "COHERENCE_BINDING_CHANGED")
+        report = coherence_report.validate_cached(report, spec, now)
+        if not report.get("checked_at", 0) <= now < report.get("expires_at", 0) or report["expires_at"] - report["checked_at"] > 60:
+            report["checks"].append(coherence_report.check("freshness", "unknown", True, "COHERENCE_EXPIRED", "观测超过 60 秒有效期"))
+            return coherence_report.finalize(report)
+        gate = network.read_json(directory(reservation) / "coherence/gate.json")
+        if (set(gate) != {"version", "generation", "sequence", "state", "issued_ms", "expires_ms"} or
+                type(gate.get("version")) is not int or gate.get("version") != 1 or type(gate.get("sequence")) is not int or
+                type(gate.get("issued_ms")) is not int or type(gate.get("expires_ms")) is not int or
+                not 0 < gate["expires_ms"] - gate["issued_ms"] <= 60000 or
+                gate.get("generation") != generation(reservation) or gate.get("sequence") != report.get("gate_sequence") or
+                gate.get("state") != "open" or not gate.get("issued_ms", 0) <= int(now * 1000) < gate.get("expires_ms", 0)):
+            report["checks"].append(coherence_report.check("access_gate", "unknown", True, "COHERENCE_GATE_CLOSED", "网站访问门槛未放行"))
+            return coherence_report.finalize(report)
+        return report
+    except RuntimeDrift as exc:
+        report = coherence_report.unavailable(exc.binding, spec.mode, now, exc.code)
+        report["checks"].append(coherence_report.check("runtime_binding", "fail", True, exc.code, "实际资源与当前代次声明不一致"))
+        return coherence_report.finalize(report)
+    except Exception:
+        previous = reservation.get("coherence_report") or {}
+        if previous.get("leak_detected") or previous.get("paused_for_isolation") or previous.get("isolation_pause_failed"):
+            report = copy.deepcopy(previous)
+            report["checks"].append(coherence_report.check("runtime", "unknown", True, "COHERENCE_RUNTIME_UNAVAILABLE", "故障后运行观测不可用，保留已确认的隔离故障"))
+            return coherence_report.finalize(report)
+        return coherence_report.unavailable({}, spec.mode, now, "COHERENCE_RUNTIME_UNAVAILABLE")
+
+
+async def isolate_worker(reservation, containers, report):
+    """A failed pause must not erase the confirmed failure that required it."""
+    try:
+        write_gate(reservation, "blocked")
+    except Exception:
+        report["checks"].append(coherence_report.check("access_gate", "unknown", True, "COHERENCE_GATE_WRITE_FAILED", "访问门槛写入未确认"))
+    worker = containers.get("worker")
+    try:
+        if worker is None:
+            raise ValueError("missing owned worker")
+        await asyncio.to_thread(worker.reload)
+        labels = worker.attrs.get("Config", {}).get("Labels") or {}
+        if (worker.id != report["binding"].get("worker_id") or
+                any(labels.get(network.PREFIX + key) != value for key, value in reservation["identity"].items() if key != "home_source")):
+            raise ValueError("worker ownership changed")
+        if worker.status != "paused":
+            await asyncio.to_thread(worker.pause)
+        await asyncio.to_thread(worker.reload)
+        if worker.status != "paused":
+            raise ValueError("pause unconfirmed")
+        report["paused_for_isolation"] = True
+    except Exception:
+        report["isolation_pause_failed"] = True
+        report["checks"].append(coherence_report.check("isolation_pause", "fail", True, "ISOLATION_PAUSE_UNCONFIRMED", "已确认网络故障；精确实例暂停未确认，需运维处置"))
+    coherence_report.finalize(report)
+
+
+async def sample_locked(reservation, session_id, force=False):
+    """Caller holds the same Home lock used by start/stop/resume. No new Worker."""
+    policy = network.NetworkPolicy(**reservation["policy"])
+    spec = policy.coherence
+    if not spec:
+        return None
+    now = time.time()
+    if now - reservation.get("coherence_attempt_at", 0) < MIN_INTERVAL:
+        return await cached_report(reservation, session_id)
+    if not force:
+        cached = await cached_report(reservation, session_id)
+        if cached and cached.get("allowed"):
+            return cached
+    reservation["coherence_attempt_at"] = now
+    network.save_reservation(reservation)
+    binding, client, containers, report = {}, None, {}, None
+    previous = reservation.get("coherence_report")
+    try:
+        binding, client, containers = await current_runtime(reservation, session_id)
+        history = exit_history(reservation, binding, spec, now)
+        artifact, baseline = await asyncio.to_thread(assets, spec)
+        facts = await network_facts(reservation, binding, client, containers)
+        nonce = secrets.token_hex(16)
+        raw = {}
+        if facts["status"] == "pass":
+            ca_pem = ""
+            if policy.probe_ca_file:
+                network.secret_source(policy.probe_ca_file, policy.probe_ca_sha256)
+                ca_pem = Path(policy.probe_ca_file).read_text()
+            config = {"version": 1, "nonce": nonce, "binding_sha256": network.digest(binding),
+                      "domain": spec.observer_domain, "port": spec.observer_port, "ipv4": spec.observer_ipv4,
+                      "relay_ip": reservation["allocation"]["relay_ip"], "ca_pem": ca_pem,
+                      "dns_ip": policy.approved_resolver_ip or policy.bootstrap_resolver_ip or spec.observer_ipv4[0],
+                      "artifact_sha256": spec.artifact_sha256, "acceptance_sha256": spec.acceptance_sha256,
+                      "voices": len(artifact["resolvedConfig"]["voices"])}
+            raw = await coherence_exec.observe_browser(client, containers["worker"], config, result_directory(reservation, "worker"))
+            after_facts = await network_facts(reservation, binding, client, containers)
+            if after_facts["status"] != "pass":
+                facts = after_facts
+            else:
+                facts["after_guard"] = after_facts.get("guard")
+        finished = time.time()
+        page = raw.get("page") if isinstance(raw, dict) else None
+        who = page.get("whoami") if isinstance(page, dict) else None
+        geo = await asyncio.to_thread(coherence_geoip.country, spec, who["public_ip"], finished) if coherence_report.valid_whoami(who, nonce, "browser", now, finished) else {"status": "unknown"}
+        report = coherence_report.evaluate(policy, artifact, baseline, binding, raw, facts, geo, nonce, now, finished, previous, history)
+        if report.get("leak_detected") or facts["status"] == "fail":
+            # If traffic bypasses the known gateway, closing that gateway alone
+            # is insufficient. Pause this exact Worker, retaining its Home and
+            # memory for operator recovery; never silently resume it.
+            await isolate_worker(reservation, containers, report)
+        else:
+            current, _, _ = await current_runtime(reservation, session_id)
+            if binding != current:
+                report = coherence_report.unavailable(current, spec.mode, time.time(), "COHERENCE_BINDING_CHANGED")
+            else:
+                retain_exit(reservation, binding, report)
+    except ExitHistoryInvalid:
+        report = coherence_report.unavailable(binding, spec.mode, now, "COHERENCE_EXIT_HISTORY_INVALID")
+    except RuntimeDrift as exc:
+        report = coherence_report.unavailable(exc.binding or binding, spec.mode, now, exc.code)
+        report["checks"].append(coherence_report.check("runtime_binding", "fail", True, exc.code, "实际资源与冻结运行声明不一致"))
+        coherence_report.finalize(report)
+        if exc.isolate:
+            await isolate_worker(reservation, exc.containers or containers, report)
+    except Exception:
+        logger.info("Current-generation coherence observation unavailable; gate remains closed.")
+        if report and (report.get("leak_detected") or report.get("overall") == "unhealthy"):
+            report["checks"].append(coherence_report.check("runtime", "unknown", True, "COHERENCE_RUNTIME_UNAVAILABLE", "故障后运行复核失败，原故障保留"))
+            coherence_report.finalize(report)
+        else:
+            report = coherence_report.unavailable(binding, spec.mode, now)
+    retained = False
+    for key in ("exit_change_blocked", "leak_detected", "paused_for_isolation", "isolation_pause_failed"):
+        if (previous or {}).get(key):
+            report[key], retained = True, True
+    if retained:
+        report["checks"].append(coherence_report.check("retained_failure", "fail", True, "COHERENCE_FAILURE_RETAINED",
+                                                       "此代次已确认的故障保持阻断；观测失败不能清除锁定"))
+        coherence_report.finalize(report)
+    # write_gate also persists this reservation. Advance the comparison and
+    # its failure latch atomically: a crash may leave a missing gate sequence
+    # (which cannot permit access), never new history with an old open report.
+    reservation["coherence_report"] = report
+    try:
+        gate = write_gate(reservation, "open" if report.get("allowed") else "blocked", report["expires_at"] if report.get("allowed") else None)
+        report["gate_sequence"] = gate["sequence"]
+        if report.get("allowed") and gate["state"] != "open":
+            report["checks"].append(coherence_report.check("freshness", "unknown", True, "COHERENCE_EXPIRED", "观测在放行前已经过期"))
+            coherence_report.finalize(report)
+    except Exception:
+        report["checks"].append(coherence_report.check("access_gate", "unknown", True, "COHERENCE_GATE_WRITE_FAILED", "访问门槛写入未确认"))
+        coherence_report.finalize(report)
+    reservation["coherence_report"] = report
+    network.save_reservation(reservation)
+    return report
+
+
+async def report_for_home(username, home_name, snapshot):
+    records = snapshot.get("records", [])
+    required = any(record.get("coherence_required") for record in records)
+    try:
+        reservation = network.read_reservation(runtime_identity(username, home_name, "", "", ""))
+        if not reservation or not reservation["policy"].get("coherence"):
+            return coherence_report.unavailable({}, "strict", time.time(), "COHERENCE_RESERVATION_MISSING") if required else None
+        if len(records) != 1:
+            return coherence_report.unavailable({}, reservation["policy"]["coherence"]["mode"], time.time())
+        return await cached_report(reservation, records[0]["session_id"])
+    except Exception:
+        return coherence_report.unavailable({}, "strict", time.time(), "COHERENCE_RESERVATION_UNAVAILABLE")
+
+
+async def access_locked(username, home_name, request, probe=False):
+    snapshot = await inspect_home(username, home_name)
+    validate_stop_inventory(snapshot, request)
+    identity = runtime_identity(username, home_name, request.application_id, request.profile_id, request.operation_id)
+    reservation = network.read_reservation(identity)
+    spec = network.NetworkPolicy(**reservation["policy"]).coherence if reservation else None
+    if not spec:
+        # An old unprotected generation cannot satisfy a newly declared strict
+        # application policy. Ordinary policies remain backward compatible.
+        strict = any(record.get("coherence_required") for record in snapshot["records"]) or any(
+            p.username == username and p.profile_id == request.profile_id and p.coherence and p.coherence.mode == "strict"
+            for p in network.policies().values())
+        return {"version": 1, "enabled": strict, "allowed": not strict, "report": None}
+    if reservation["identity"] != identity or len(snapshot["records"]) != 1 or request.session_id != snapshot["records"][0]["session_id"]:
+        raise HTTPException(409, "COHERENCE_BINDING_CHANGED")
+    report = await sample_locked(reservation, request.session_id, force=probe)
+    return {"version": 1, "enabled": True, "allowed": bool(report and report["allowed"]), "report": report}
+
+
+async def session_gate(session_id, session):
+    if not session.get("network_policy_id") and not session.get("coherence_required"):
+        return
+    identity = runtime_identity(session["username"], session["home_name"], session["provider_app_id"], session.get("profile_id"), session.get("operation_id"))
+    try:
+        reservation = network.read_reservation(identity)
+        if reservation and reservation["policy"].get("coherence"):
+            report = await cached_report(reservation, session_id)
+            if report and report.get("allowed"):
+                return
+        elif not session.get("coherence_required"):
+            return
+    except Exception:
+        pass
+    raise HTTPException(503, "COHERENCE_SESSION_NOT_READY")
+
+
+def sample_due(reservation, now):
+    return bool(reservation and reservation["policy"].get("coherence") and reservation["phase"] == "running" and
+                now - reservation.get("coherence_attempt_at", 0) >= SAMPLE_INTERVAL)
+
+
+async def sample_home(sid, session):
+    try:
+        async with lifecycle_lock("home:" + home_path(session["username"], session["home_name"])):
+            identity = runtime_identity(session["username"], session["home_name"], session["provider_app_id"], session.get("profile_id"), session.get("operation_id"))
+            reservation = network.read_reservation(identity)
+            if sample_due(reservation, time.time()):
+                await sample_locked(reservation, sid, force=True)
+    except Exception:
+        logger.info("Coherence sampling retained one unavailable generation.")
+
+
+async def sampler():
+    """Renew before expiry, without an unbounded queue or overlapping Homes."""
+    active = {}
+    try:
+        while True:
+            await asyncio.sleep(SAMPLE_POLL)
+            active = {key: task for key, task in active.items() if not task.done()}
+            async with state.sessions_lock:
+                sessions = [(sid, dict(value)) for sid, value in state.sessions.items()
+                            if value.get("network_policy_id") and value.get("home_name")]
+            for sid, session in sessions:
+                if len(active) >= MAX_BACKGROUND_SAMPLES:
+                    break
+                key = (session["username"], session["home_name"])
+                if key in active:
+                    continue
+                try:
+                    identity = runtime_identity(session["username"], session["home_name"], session["provider_app_id"], session.get("profile_id"), session.get("operation_id"))
+                    if sample_due(network.read_reservation(identity), time.time()):
+                        active[key] = asyncio.create_task(sample_home(sid, session))
+                except Exception:
+                    logger.info("Coherence sampling retained one unavailable generation.")
+    finally:
+        for task in active.values():
+            task.cancel()
+        await asyncio.gather(*active.values(), return_exceptions=True)
+
+
+router = APIRouter(prefix="/api/profile-runtime", route_class=EncryptedRoute, dependencies=[Depends(verify_token)])
+
+
+@router.post("/{home_name}/coherence/{action}")
+async def coherence_operation(home_name: str, action: str, decrypted_body: dict = Depends(get_decrypted_request_body),
+                              user: dict = Depends(verify_token)):
+    if action not in {"access", "probe"}:
+        raise HTTPException(404, "Unknown coherence operation.")
+    try:
+        request = StopProfileRequest(**decrypted_body)
+    except ValidationError as exc:
+        raise HTTPException(422, "Invalid coherence binding.") from exc
+    async with lifecycle_lock("home:" + home_path(user["username"], home_name)):
+        return await access_locked(user["username"], home_name, request, action == "probe")
