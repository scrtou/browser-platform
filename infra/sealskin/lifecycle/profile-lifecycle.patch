+@pytest.mark.asyncio
+async def test_concurrent_saves_are_complete_and_invalid_content_is_rejected(monkeypatch):
+    await saved()
+    await asyncio.gather(*(config_store.save_sessions() for _ in range(8)))
+    assert secrets.decode(secrets.read(database()), database()) == state.sessions
+    previous = database().read_bytes()
+    state.sessions["invalid"] = {"value": float("nan")}
+    with pytest.raises(secrets.SessionStateUnavailable):
+        await config_store.save_sessions()
+    assert database().read_bytes() == previous
+    state.sessions.pop("invalid")
+    monkeypatch.setattr(secrets, "LIMIT", 16)
+    with pytest.raises(secrets.SessionStateUnavailable):
+        await config_store.save_sessions()
+    assert database().read_bytes() == previous
