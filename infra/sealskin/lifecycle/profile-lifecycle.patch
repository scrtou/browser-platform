+            config.get("coherence_gate_file") != GATE_DIRECTORY + "/gate.json" or
+            config.get("coherence_generation") != generation(reservation) or
+            config.get("coherence_probe_domain") != spec.observer_domain or config.get("coherence_probe_port") != spec.observer_port):
+        raise RuntimeDrift("COHERENCE_GATE_CONFIG_CHANGED", isolate=True)
+
+
+async def current_runtime(reservation, session_id):
+    identity, allocation = reservation["identity"], reservation["allocation"]
+    async with state.sessions_lock:
