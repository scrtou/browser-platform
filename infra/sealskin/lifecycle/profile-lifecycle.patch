+"""New proxy revisions must not change old reservations or widen egress."""
+
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+from pydantic import ValidationError
+
+from app import network_runtime as network
+from app.state import state
+from .test_network_runtime import managed, launch_args, POLICY_ID, RELAY_IMAGE, PROBE_IMAGE
+
+
+LEGACY = dict(username="qa", profile_id="personal", home_name="qa-home", application_id="firefox",
+              relay_image=RELAY_IMAGE, probe_image=PROBE_IMAGE, upstream_host="proxy.test", upstream_port=1080,
+              username_file="", username_sha256="", password_file="", password_sha256="",
+              probe_url="https://probe.test/", probe_ca_file="", probe_ca_sha256="", probe_timeout_seconds=10)
+LEGACY_SHA = "08aaebc573ac1d9b72c0db4948f3362028849b8a15dbc557dabc5e06608d971a"
+
+
+def publish(managed, **options):
+    value = managed.policy.model_dump()
+    value.update(options)
+    managed.policy = network.NetworkPolicy(**value)
+    network.policy_path().write_text(json.dumps({"version": 1, "policies": {POLICY_ID: managed.policy.model_dump()}}))
+    state.installed_apps["firefox"].provider_config.network_policy_sha256 = network.digest(managed.policy.model_dump())
+    return managed.policy
+
+
+def enable_protocol_image(managed):
+    managed.docker.images.get = lambda _: SimpleNamespace(attrs={"Config": {"Labels": {
+        network.PREFIX + "network-guard": "1", network.PREFIX + "proxy-upstreams": "1"}}})
+
+
+def test_legacy_policy_hash_is_byte_compatible():
+    # Captured with the previous lifecycle-v2 model, including its defaults.
+    policy = network.NetworkPolicy(**LEGACY)
+    assert policy.model_dump() == LEGACY
+    assert json.loads(policy.model_dump_json()) == LEGACY
+    assert network.digest(policy.model_dump()) == LEGACY_SHA
+    omitted = {k: v for k, v in LEGACY.items() if v != "" and k != "probe_timeout_seconds"}
+    assert network.digest(network.NetworkPolicy(**omitted).model_dump()) == LEGACY_SHA
+    explicit = network.NetworkPolicy(**LEGACY, upstream_protocol="socks5", upstream_auth="none")
+    assert network.digest(explicit.model_dump()) != LEGACY_SHA
+    assert explicit.model_dump()["upstream_protocol"] == "socks5"
+    assert explicit.model_dump()["upstream_auth"] == "none"
+
+
+@pytest.mark.parametrize("protocol,auth,credentials", [
+    ("socks5", "none", False), ("socks5", "username_password", True),
+    ("http", "none", False), ("http", "basic", True),
+    ("https", "none", False), ("https", "basic", True),
+])
+def test_protocol_auth_matrix(protocol, auth, credentials):
+    value = {**LEGACY, "upstream_protocol": protocol, "upstream_auth": auth}
+    if credentials:
+        value.update(username_file="/fixed/user", username_sha256="a" * 64,
+                     password_file="/fixed/password", password_sha256="b" * 64)
+    assert network.NetworkPolicy(**value).model_dump() == value
+
+
+@pytest.mark.parametrize("options", [
+    {"upstream_protocol": "http"}, {"upstream_auth": "none"},
+    {"upstream_protocol": "http", "upstream_auth": "username_password"},
+    {"upstream_protocol": "socks5", "upstream_auth": "basic"},
+    {"upstream_protocol": "https", "upstream_auth": "ntlm"},
+    {"upstream_protocol": "socks4", "upstream_auth": "none"},
+    {"upstream_protocol": "direct", "upstream_auth": "none"},
+    {"upstream_protocol": "http", "upstream_auth": "basic"},
+    {"upstream_protocol": "socks5", "upstream_auth": "none", "username_file": "/fixed/user"},
+    {"upstream_tls_ca_file": "/fixed/ca.pem", "upstream_tls_ca_sha256": "a" * 64},
+    {"upstream_protocol": "https", "upstream_auth": "none", "upstream_tls_ca_file": "/fixed/ca.pem"},
+    {"upstream_protocol": "https", "upstream_auth": "none", "upstream_tls_skip_verify": True},
+    {"upstream_protocol": "https", "upstream_auth": "none", "upstream_tls_server_name": "different.test"},
+])
+def test_unsupported_or_ignored_options_rejected(options):
+    with pytest.raises(ValidationError):
+        network.NetworkPolicy(**{**LEGACY, **options})
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("protocol,auth", [("socks5", "username_password"), ("http", "basic"), ("https", "basic")])
+async def test_generation_config_and_secret_boundary(managed, protocol, auth):
+    enable_protocol_image(managed)
+    options = dict(upstream_protocol=protocol, upstream_auth=auth)
+    ca = network.base_dir() / "network-secrets" / "upstream-ca.pem"
+    if protocol == "https":
+        ca.write_text("QA CA material")
+        ca.chmod(0o600)
+        options.update(upstream_tls_ca_file=str(ca), upstream_tls_ca_sha256=hashlib.sha256(ca.read_bytes()).hexdigest())
+    policy = publish(managed, **options)
+    assert network.policy_for_launch(launch_args(managed), state.installed_apps["firefox"])[1] == policy
+    await network.prepare(managed.identity, POLICY_ID, policy)
+    reservation = network.read_reservation(managed.identity)
+    relay = next(c for c in managed.docker.container_values.values() if c.role == "relay")
+    config_path = next(source for source, mount in relay.kwargs["volumes"].items() if mount["bind"] == "/run/config/relay.json")
+    config = json.loads(Path(config_path).read_text())
+    assert config["upstream_host"] == reservation["upstream_ipv4"][0] == "203.0.113.9"
+    assert config["upstream_protocol"] == protocol and config["upstream_auth"] == auth
+    assert config["username_file"] == "/run/secrets/username"
+    assert config["password_file"] == "/run/secrets/password"
+    if protocol == "https":
+        assert config["upstream_tls_server_name"] == "qa.example"
+        assert config["upstream_tls_ca_file"] == "/run/secrets/upstream-ca.pem"
+        assert relay.kwargs["volumes"][str(ca)] == {"bind": "/run/secrets/upstream-ca.pem", "mode": "ro"}
+    else:
+        assert "upstream_tls_server_name" not in config and "upstream_tls_ca_file" not in config
+    assert "environment" not in relay.kwargs
+    for resource in managed.docker.container_values.values():
+        if resource.role != "relay":
+            assert not any("/run/secrets/" in mount["bind"] for mount in resource.kwargs.get("volumes", {}).values())
+    assert all(mount["mode"] == "ro" for mount in relay.kwargs["volumes"].values())
+    assert reservation["policy"] == policy.model_dump()
+
+
+@pytest.mark.asyncio
+async def test_protocol_requires_capable_image_before_reservation(managed):
+    policy = publish(managed, upstream_protocol="https", upstream_auth="basic")
+    with pytest.raises(HTTPException, match="NETWORK_UPSTREAM_IMAGE_REQUIRED"):
+        await network.prepare(managed.identity, POLICY_ID, policy)
+    assert not network.read_reservation(managed.identity)
+    assert not managed.docker.events
+
+
+@pytest.mark.asyncio
+async def test_existing_generation_keeps_legacy_policy_and_relay_config(managed):
+    await network.prepare(managed.identity, POLICY_ID, managed.policy)
+    before = network.read_reservation(managed.identity)
+    relay = next(c for c in managed.docker.container_values.values() if c.role == "relay")
+    config_path = next(source for source, mount in relay.kwargs["volumes"].items() if mount["bind"] == "/run/config/relay.json")
+    config_before = Path(config_path).read_bytes()
+    config = json.loads(config_before)
+    assert not any(key in config for key in ("upstream_protocol", "upstream_auth", "upstream_tls_server_name"))
+    publish(managed, upstream_protocol="https", upstream_auth="basic")
+    assert network.read_reservation(managed.identity) == before
+    assert Path(config_path).read_bytes() == config_before
+    with pytest.raises(HTTPException, match="NETWORK_HOME_RESERVED"):
+        await network.prepare(managed.identity, POLICY_ID, managed.policy)
+
+
+@pytest.mark.parametrize("fault", ["digest", "symlink", "wide_permissions"])
+def test_proxy_ca_is_validated_before_allocation(managed, fault):
+    root = network.base_dir() / "network-secrets"
+    ca = root / "upstream-ca.pem"
+    ca.write_text("QA CA material")
+    ca.chmod(0o600)
+    sha = hashlib.sha256(ca.read_bytes()).hexdigest()
+    if fault == "digest":
+        sha = "e" * 64
+    elif fault == "symlink":
+        ca.rename(root / "real-ca.pem")
+        ca.symlink_to(root / "real-ca.pem")
+    else:
+        ca.chmod(0o644)
+    publish(managed, upstream_protocol="https", upstream_auth="basic",
+            upstream_tls_ca_file=str(ca), upstream_tls_ca_sha256=sha)
+    with pytest.raises(HTTPException):
+        network.policy_for_launch(launch_args(managed), state.installed_apps["firefox"])
+    assert not managed.docker.events
