+"""DIRECT uses the existing generation lifecycle without granting Worker egress."""
+
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+from pydantic import ValidationError
+
+from app import network_direct as direct_network
+from app import network_runtime as network
+from app import profile_resume as resume
+from app import profile_runtime as runtime
+from app.launch import launch_application
+from app.state import state
+from tests.test_network_runtime import (POLICY_ID, assert_empty, launch_args, managed, stop, stop_request)
+from tests.test_profile_resume import by_role, dormant, resume_home
+
+FIB = "Main:\n  |-- 127.0.0.1\n     /32 host LOCAL\n  |-- 8.8.8.9\n     /32 host LOCAL\n  |-- 172.17.0.1\n     /32 host LOCAL\n"
+
+
+@pytest.fixture
+def direct(managed, tmp_path, monkeypatch):
+    value = managed.policy.model_dump()
+    for key in list(value):
+        if key.startswith(("upstream_", "username_", "password_")):
+            value.pop(key)
+    value.update(mode="direct", approved_resolver_id="qa-dns", approved_resolver_ip="172.30.9.2")
+    managed.policy = network.NetworkPolicy(**value)
+    network.policy_path().write_text(json.dumps({"version": 1, "policies": {POLICY_ID: managed.policy.model_dump()}}))
+    app = state.installed_apps["firefox"].provider_config
+    app.network_policy_sha256 = network.digest(managed.policy.model_dump())
+    table = tmp_path / "host-fib"
+    table.write_text(FIB)
+    table.chmod(0o444)
+    monkeypatch.setattr(direct_network, "HOST_IPV4_FILE", str(table))
+    managed.host_table = table
+    managed.docker.controller.attrs["Mounts"].append({"Type": "bind", "Source": direct_network.HOST_IPV4_SOURCE,
+                                                     "Destination": str(table), "RW": False})
+    managed.docker.images.get = lambda _: SimpleNamespace(attrs={"Config": {"Labels": {
+        network.PREFIX + "network-guard": "1", network.PREFIX + "direct-egress": "1", network.PREFIX + "session-auth": "1"}}})
+    original = managed.docker.create_container
+
+    def create(**kwargs):
+        container = original(**kwargs)
+        for mount in container.attrs["Mounts"]:
+            mount.update(Type="bind", RW=kwargs["volumes"][mount["Source"]].get("mode") != "ro")
+        return container
+
+    managed.docker.containers.create = create
+
+    def no_system_lookup(_):
+        raise AssertionError("DIRECT attempted upstream/system DNS")
+
+    monkeypatch.setattr(network, "resolve_upstream", no_system_lookup)
+    monkeypatch.setattr(resume, "get_docker_client", lambda: managed.docker)
+    monkeypatch.setattr(resume, "display_ready", lambda *args: True)
+    monkeypatch.setattr(resume, "relay_accepts", lambda ip: True)
+    return managed
+
+
+@pytest.mark.parametrize("override", [
+    {"mode": "auto"}, {"mode": ""}, {"upstream_host": "proxy.invalid"}, {"upstream_port": 443},
+    {"upstream_protocol": "socks5"}, {"username_secret_ref": "secret://x/username/1"},
+    {"password_file": "/private/password"}, {"upstream_tls_ca_sha256": "a" * 64},
+    {"approved_resolver_id": ""}, {"approved_resolver_ip": "dns.invalid"},
+    {"approved_resolver_ip": "127.0.0.1"}, {"approved_resolver_ip": "169.254.169.254"},
+    {"approved_resolver_ip": "::1"}, {"approved_resolver_ip": "224.0.0.1"},
+])
+def test_direct_rejects_implicit_or_mixed_policies(direct, override):
+    with pytest.raises(ValidationError):
+        network.NetworkPolicy(**{**direct.policy.model_dump(), **override})
+
+
+async def test_direct_launch_keeps_worker_restricted_and_host_evidence_exclusive(direct):
+    await launch_application(**launch_args(direct))
+    worker, relay, guard = (by_role(direct, role) for role in ("worker", "relay", "guard"))
+    snapshot = await runtime.inspect_home("qa", "qa-home")
+    assert snapshot["network_direct_version"] == 1
+    assert worker.kwargs["network_mode"] == "container:" + guard.id
+    assert direct_network.HOST_IPV4_SOURCE in relay.kwargs["volumes"]
+    assert relay.kwargs["volumes"][direct_network.HOST_IPV4_SOURCE]["mode"] == "ro"
+    for container in (worker, guard):
+        assert direct_network.HOST_IPV4_SOURCE not in container.kwargs["volumes"]
+        assert "network-secrets" not in json.dumps(container.kwargs)
+    config_path = next(source for source, value in relay.kwargs["volumes"].items() if value["bind"] == "/run/config/relay.json")
+    config = json.loads(Path(config_path).read_text())
+    assert config["mode"] == "direct" and "upstream_host" not in config and "upstream_port" not in config
+    assert config["approved_resolver_ip"] == direct.policy.approved_resolver_ip
+    assert config["host_ipv4_snapshot"] == ["8.8.8.9"]
+    assert not config["username_file"] and not config["password_file"]
+    assert direct.docker.events.index(("remove", "probe")) < direct.docker.events.index(("create", "worker"))
+    await stop(direct)
+    await assert_empty(direct)
+
+
+@pytest.mark.parametrize("fault", ["capability", "host-mount", "writable-mount", "wrong-source", "host-file", "nat-only"])
+async def test_direct_missing_prerequisites_creates_no_resources(direct, fault):
+    mounts = direct.docker.controller.attrs["Mounts"]
+    if fault == "capability":
+        direct.docker.images.get = lambda _: SimpleNamespace(attrs={"Config": {"Labels": {network.PREFIX + "network-guard": "1"}}})
+    elif fault == "host-mount":
+        mounts.pop()
+    elif fault == "writable-mount":
+        mounts[-1]["RW"] = True
+    elif fault == "wrong-source":
+        mounts[-1]["Source"] = "/proc/2/net/fib_trie"
+    elif fault == "host-file":
