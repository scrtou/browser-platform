@@ -0,0 +1,202 @@
+"""Exercise credentials at actual lifecycle boundaries, including concurrent revoke."""
+
+import asyncio
+import json
+from pathlib import Path
+import shutil
+import tempfile
+from types import SimpleNamespace
+
+import pytest
+from fastapi import HTTPException
+
+from app import network_runtime as network, profile_resume, secret_runtime as secrets
+from app.launch import launch_application
+from app.secret_store import FileSecretStore, SecretError
+from app.state import state
+from tests.test_network_runtime import (managed, launch_args, stop_request, stop, assert_empty, POLICY_ID)
+from tests.test_profile_resume import by_role, display, resume_home
+
+USER, PASSWORD = " runtime-user ", " runtime-password-繁體 "
+
+
+def publish(managed, policy):
+    managed.policy = policy
+    network.atomic_json(network.policy_path(), {"version": 1, "policies": {POLICY_ID: policy.model_dump()}})
+    state.installed_apps["firefox"].provider_config.network_policy_sha256 = network.digest(policy.model_dump())
+
+
+@pytest.fixture
+def secured(managed, monkeypatch, tmp_path):
+    network.base_dir().chmod(0o700)
+    keys = tmp_path / "keys"
+    keys.mkdir(mode=0o700)
+    store = FileSecretStore.initialize(network.base_dir() / "proxy-secret-store", keys / "master.key")
+    refs = store.put("qa-proxy", 1, [secrets.grant(managed.policy)], USER, PASSWORD)
+    with tempfile.TemporaryDirectory(prefix="browser-platform-secret-test-", dir="/dev/shm") as name:
+        runtime = Path(name)
+        runtime.chmod(0o700)
+        state.path_prefix_map[str(runtime)] = str(runtime)
+        network.atomic_json(network.base_dir() / "profile-secret-store.json", {
+            "version": 1, "key_file": str(store.key_file), "runtime_dir": str(runtime)})
+        policy = network.NetworkPolicy(**{**managed.policy.model_dump(), "username_file": "", "username_sha256": "",
+            "password_file": "", "password_sha256": "", "username_secret_ref": refs["username"],
+            "password_secret_ref": refs["password"], "upstream_protocol": "http", "upstream_auth": "basic"})
+        publish(managed, policy)
+        labels = {network.PREFIX + field: "1" for field in ("network-guard", "proxy-upstreams", "secret-lease", "session-auth")}
+        managed.docker.images.get = lambda _: SimpleNamespace(attrs={"Config": {"Labels": labels}})
+        monkeypatch.setattr(secrets, "get_docker_client", lambda: managed.docker)
+        yield SimpleNamespace(managed=managed, store=store, refs=refs, root=runtime, labels=labels)
+
+
+async def test_tmpfs_is_exclusive_to_relay_and_stop_blocks_before_browser(secured):
+    managed = secured.managed
+    await launch_application(**launch_args(managed))
+    directory = secrets.generation_directory(managed.identity)
+    assert (directory / "username").read_bytes() == USER.encode()
+    assert (directory / "password").read_bytes() == PASSWORD.encode()
+    relay, worker = by_role(managed, "relay"), by_role(managed, "worker")
+    assert relay.kwargs["volumes"][str(directory)] == {"bind": "/run/secrets", "mode": "ro"}
+    assert str(directory) not in json.dumps(worker.kwargs)
+    assert USER not in json.dumps(relay.kwargs) and PASSWORD not in json.dumps(relay.kwargs)
+    reservation = network.read_reservation(managed.identity)
+    assert PASSWORD not in json.dumps(reservation)
+    assert reservation["policy"]["username_secret_ref"] == secured.refs["username"]
+    assert reservation["policy"]["username_file"] == ""
+    await stop(managed)
+    assert managed.docker.events.index(("stop", "relay")) < managed.docker.events.index(("stop", "worker"))
+    assert not directory.exists()
+    await assert_empty(managed)
+
+
+async def test_close_failure_retains_worker_and_occupancy_with_egress_blocked(secured):
+    managed = secured.managed
+    await launch_application(**launch_args(managed))
+    managed.docker.stop_failure = "worker"
+    with pytest.raises(HTTPException):
+        await stop(managed)
+    assert by_role(managed, "worker").status == "running"
+    assert by_role(managed, "relay").status == "exited"
+    assert network.read_reservation(managed.identity)["phase"] == "stopping"
+    assert (secrets.generation_directory(managed.identity) / "lease").read_bytes() == b"revoked\n"
+    managed.docker.stop_failure = None
+    await stop(managed)
+    await assert_empty(managed)
+
+
+async def test_revocation_survives_failed_cleanup_and_retries(secured):
+    managed = secured.managed
+    await launch_application(**launch_args(managed))
+    managed.docker.stop_failure = "worker"
+    with pytest.raises(HTTPException, match="SECRET_REVOKED_CLEANUP_PENDING"):
+        await secrets.revoke(secured.refs["password"], "a" * 32)
+    assert by_role(managed, "relay").status == "exited"
+    with pytest.raises(SecretError, match="SECRET_REVOKED"):
+        secured.store.resolve(secrets.grant(managed.policy), secured.refs["username"], secured.refs["password"])
+    managed.docker.stop_failure = None
+    result = await secrets.revoke(secured.refs["username"], "a" * 32)
+    assert result["egress_blocked"] and result["cleanup_complete"]
+    await assert_empty(managed)
+    with pytest.raises(HTTPException, match="SECRET_REVOKED"):
+        await launch_application(**launch_args(managed))
+
+
+async def test_new_version_does_not_hot_change_an_existing_generation(secured):
+    managed = secured.managed
+    await launch_application(**launch_args(managed))
+    before = network.read_reservation(managed.identity)
+    refs = secured.store.put("qa-proxy", 2, [secrets.grant(managed.policy)], USER, "new password")
+    assert network.read_reservation(managed.identity) == before
+    assert (secrets.generation_directory(managed.identity) / "password").read_bytes() == PASSWORD.encode()
+    await stop(managed)
+    publish(managed, network.NetworkPolicy(**{**managed.policy.model_dump(), "username_secret_ref": refs["username"],
+                                             "password_secret_ref": refs["password"]}))
+    await launch_application(**launch_args(managed))
+    assert (secrets.generation_directory(managed.identity) / "password").read_bytes() == b"new password"
+    await stop(managed)
+
+
+async def test_authorization_denial_never_creates_any_network_or_worker(secured):
+    managed = secured.managed
+    refs = secured.store.put("forbidden", 1, [{**secrets.grant(managed.policy), "profile": "other"}], USER, PASSWORD)
+    publish(managed, network.NetworkPolicy(**{**managed.policy.model_dump(), "username_secret_ref": refs["username"],
+                                             "password_secret_ref": refs["password"]}))
+    with pytest.raises(HTTPException, match="SECRET_ACCESS_DENIED"):
+        await launch_application(**launch_args(managed))
+    assert managed.docker.events == []
+
+
+async def test_unleased_image_and_disk_staging_are_refused(secured, monkeypatch):
+    managed = secured.managed
+    secured.labels.pop(network.PREFIX + "secret-lease")
+    with pytest.raises(HTTPException, match="NETWORK_SECRET_LEASE_IMAGE_REQUIRED"):
+        await launch_application(**launch_args(managed))
+    assert not any(action == "create" for action, _ in managed.docker.events)
+    await stop(managed)
+    secured.labels[network.PREFIX + "secret-lease"] = "1"
+    monkeypatch.setattr(secrets, "is_tmpfs", lambda _: False)
+    with pytest.raises(HTTPException, match="SECRET_TMPFS_REQUIRED"):
+        await launch_application(**launch_args(managed))
+    assert not any(action == "create" for action, _ in managed.docker.events)
+    await stop(managed)
+
+
+async def test_resume_rematerializes_before_relay_start_and_denies_revoked_key(secured, display):
+    managed = secured.managed
+    await launch_application(**launch_args(managed))
+    for role in ("worker", "relay", "guard"):
+        by_role(managed, role).status = "exited"
+        by_role(managed, role).reload()
+    directory = secrets.generation_directory(managed.identity)
+    shutil.rmtree(directory)
+    relay = by_role(managed, "relay")
+    start = relay.start
+    def checked_start():
+        assert (directory / "password").read_bytes() == PASSWORD.encode()
+        start()
+    relay.start = checked_start
+    result = await resume_home(managed)
+    assert result["resumed"] and result["steps"][0] == "relay"
+    for role in ("worker", "relay", "guard"):
+        by_role(managed, role).status = "exited"
+        by_role(managed, role).reload()
+    secured.store.revoke(secured.refs["password"], "a" * 32)
+    managed.docker.events.clear()
+    with pytest.raises(HTTPException, match="SECRET_REVOKED"):
+        await resume_home(managed)
+    assert not any(action == "start" for action, _ in managed.docker.events)
+    await secrets.enforce_authorizations()
+    assert (directory / "lease").read_bytes() == b"revoked\n"
+    await stop(managed)
+
+
+async def test_lost_key_stops_active_relay_without_deleting_browser(secured):
+    managed = secured.managed
+    await launch_application(**launch_args(managed))
+    secured.store.key_file.unlink()
+    await secrets.enforce_authorizations()
+    assert by_role(managed, "relay").status == "exited"
+    assert by_role(managed, "worker").status == "running"
+    await stop(managed)
+    await assert_empty(managed)
+
+
+async def test_revocation_cannot_miss_a_concurrent_launch(secured, monkeypatch):
+    managed = secured.managed
+    reached, proceed = asyncio.Event(), asyncio.Event()
+    original = network.run_probe
+    async def delayed(*args):
+        reached.set()
+        await proceed.wait()
+        await original(*args)
+    monkeypatch.setattr(network, "run_probe", delayed)
+    launching = asyncio.create_task(launch_application(**launch_args(managed)))
+    await asyncio.wait_for(reached.wait(), 3)
+    revoking = asyncio.create_task(secrets.revoke(secured.refs["password"], "a" * 32))
+    await asyncio.sleep(0)
+    assert not revoking.done()
+    proceed.set()
+    await asyncio.wait_for(launching, 3)
+    result = await asyncio.wait_for(revoking, 5)
+    assert result["cleanup_complete"]
+    await assert_empty(managed)
