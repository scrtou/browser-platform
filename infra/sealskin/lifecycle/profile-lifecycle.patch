+"""Verified Profile lifecycle for the pinned browser-platform integration.
+
+Docker remains owned by SealSkin. Inventory contains no access tokens, browser
+credentials or environment values. An orphan can be stopped only when its
+immutable labels identify this deployment, user, Home and launch operation.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import functools
+import hashlib
+import inspect
+import logging
+import os
+import re
+import shutil
+from typing import Any
+from weakref import WeakValueDictionary
+
+from fastapi import APIRouter, Depends, HTTPException, Response
+from pydantic import BaseModel, Field, ValidationError
+
+from . import config_store, network_runtime
+from .docker_utils import get_docker_client, translate_path_to_host
+from .fsutil import safe_join
+from .security import EncryptedRoute, get_decrypted_request_body, verify_token
+from .settings import settings
+from .state import state
+
+logger = logging.getLogger(__name__)
+PREFIX = "io.browser-platform."
+VERSION = 1
+NAME = re.compile(r"^[A-Za-z0-9_-]{1,128}$")
+OPERATION = re.compile(r"^[a-f0-9]{32}$")
+INSTANCE = re.compile(r"^[a-f0-9]{64}$")
+_LOCKS: WeakValueDictionary[str, asyncio.Lock] = WeakValueDictionary()
+
+
+def lifecycle_lock(key: str) -> asyncio.Lock:
+    """Share a lock while an operation or a waiter still references it."""
+    lock = _LOCKS.get(key)
+    if lock is None:
+        lock = asyncio.Lock()
+        _LOCKS[key] = lock
+    return lock
+
+
+def home_path(username: str, home_name: str) -> str:
+    """Resolve one named persistent Home, refusing symlinks outside storage."""
+    if not NAME.fullmatch(home_name) or home_name.lower() == "cleanroom":
+        raise HTTPException(422, "A named persistent Home is required.")
+    try:
+        user_root = safe_join(settings.storage_path, username)
+        return safe_join(user_root, home_name)
+    except ValueError as exc:
+        raise HTTPException(422, "Invalid Home path.") from exc
+
+
+def scope_id() -> str:
+    """Bind labels to the stable host location of this server's state file."""
+    path = os.path.normpath(translate_path_to_host(settings.sessions_db_path))
+    return hashlib.sha256(path.encode()).hexdigest()
+
+
+def home_source(username: str, home_name: str) -> str:
+    """Return the host-side source expected at the Worker's /config mount."""
+    return os.path.normpath(translate_path_to_host(home_path(username, home_name)))
+
+
+def runtime_identity(username: str, home_name: str, app_id: str,
+                     profile_id: str | None, operation_id: str | None) -> dict[str, str]:
+    """Build reserved launch metadata independently of app Docker overrides."""
+    source = home_source(username, home_name)
+    return {"scope": scope_id(), "owner": username, "home": home_name,
+            "home_source": source, "home_hash": hashlib.sha256(source.encode()).hexdigest(),
+            "app": app_id, "profile": profile_id or "", "operation": operation_id or ""}
+
+
+def instance_ids(data: dict[str, Any]) -> list[str]:
+    """Include the primary instance even when the room registry is incomplete."""
+    ids = {data.get("instance_id")}
+    ids.update(entry.get("instance_id") for entry in (data.get("container_registry") or {}).values())
+    ids.discard(None)
+    ids.discard("")
+    if not ids or any(not isinstance(value, str) or not INSTANCE.fullmatch(value) for value in ids):
+        raise HTTPException(409, "Session instance ownership is incomplete; recovery is required.")
+    return sorted(ids)
+
+
+def record_summary(session_id: str, data: dict[str, Any]) -> dict[str, Any]:
+    """Project a session record to non-secret lifecycle fields."""
+    return {"session_id": session_id, "app_id": data.get("provider_app_id", ""),
+            "profile_id": data.get("profile_id", ""), "operation_id": data.get("operation_id", ""),
+            "network_policy_id": data.get("network_policy_id", ""),
+            "network_policy_sha256": data.get("network_policy_sha256", ""),
+            "instance_ids": instance_ids(data), "phase": data.get("lifecycle_phase", "running"),
+            "launch_context": data.get("launch_context"),
+            "is_collaboration": data.get("is_collaboration", False)}
+
+
+async def inspect_home(username: str, home_name: str) -> dict[str, Any]:
+    """Inspect both YAML ownership and every container mounting this Home.
+
+    Docker failures are errors, never an empty inventory. Exited and paused
+    containers still reserve a Home until verified removal.
+    """
+    path = home_path(username, home_name)
+    source = home_source(username, home_name)
+    records = []
+    async with state.sessions_lock:
+        for sid, data in state.sessions.items():
+            if data.get("username") == username and data.get("host_mount_path") and os.path.realpath(data["host_mount_path"]) == path:
+                records.append(record_summary(sid, data))
+    by_instance: dict[str, list[dict[str, Any]]] = {}
+    for record in records:
+        for instance_id in record["instance_ids"]:
+            by_instance.setdefault(instance_id, []).append(record)
+    try:
+        client = await asyncio.to_thread(get_docker_client)
+        containers = await asyncio.to_thread(client.containers.list, all=True, ignore_removed=True)
+    except Exception as exc:
+        logger.error("Profile inventory could not query Docker (%s).", type(exc).__name__)
+        raise HTTPException(503, "Docker inventory is unavailable; Home remains reserved.") from exc
+    workers = []
+    for container in containers:
+        attrs = container.attrs
+        mounts = attrs.get("Mounts", [])
+        if not any(m.get("Destination") == settings.container_config_path and
+                   os.path.normpath(m.get("Source", "")) == source for m in mounts):
+            continue
+        labels = attrs.get("Config", {}).get("Labels") or {}
+        policy_id = labels.get(PREFIX + "network-policy", "")
+        policy_sha = labels.get(PREFIX + "network-policy-sha256", "")
+        ownership = by_instance.get(container.id, [])
+        managed = labels.get(PREFIX + "version") == str(VERSION)
+        owned = (managed and labels.get(PREFIX + "scope") == scope_id() and
+                 labels.get(PREFIX + "owner") == username and labels.get(PREFIX + "home") == home_name and
+                 labels.get(PREFIX + "home_hash") == hashlib.sha256(source.encode()).hexdigest())
+        if managed:
+            sid = labels.get(PREFIX + "session", "")
+            app_id = labels.get(PREFIX + "app", "")
+            profile_id = labels.get(PREFIX + "profile", "")
+            operation_id = labels.get(PREFIX + "operation", "")
+            if ownership and (len(ownership) != 1 or ownership[0]["session_id"] != sid):
+                owned = False
+        elif len(ownership) == 1:
+            record = ownership[0]
+            owned = True
+            sid, app_id = record["session_id"], record["app_id"]
+            profile_id, operation_id = record["profile_id"], record["operation_id"]
+            policy_id, policy_sha = record["network_policy_id"], record["network_policy_sha256"]
+            # A policy-managed Worker is never adopted through legacy records.
+            if policy_id or policy_sha:
+                owned = False
+        else:
+            sid = app_id = profile_id = operation_id = ""
+        workers.append({"instance_id": container.id, "session_id": sid, "app_id": app_id,
+                        "profile_id": profile_id, "operation_id": operation_id,
+                        "network_policy_id": policy_id, "network_policy_sha256": policy_sha,
+                        "status": attrs.get("State", {}).get("Status", "unknown"),
+                        "owned": bool(owned), "managed": managed, "recorded": bool(ownership)})
+    identity = runtime_identity(username, home_name, "", "", "")
+    resources = await network_runtime.inventory(identity, containers)
+    return {"version": VERSION, "home_name": home_name, "records": records, "workers": workers,
+            "network_runtime_version": 1, "network_enforcement_version": 1, "resources": resources}
+
+
+def guard_launch(function):
+    """Serialize explicit named-Home launches with stop, including legacy API calls."""
+    signature = inspect.signature(function)
+
+    @functools.wraps(function)
+    async def guarded(*args, **kwargs):
+        values = signature.bind(*args, **kwargs)
+        values.apply_defaults()
+        params = values.arguments
+        profile_id, operation_id = params.get("profile_id"), params.get("operation_id")
+        home_name, username = params.get("home_name"), params["username"]
+        app = state.installed_apps.get(params["application_id"])
+        policy = network_runtime.policy_for_launch(params, app)
+        named = (home_name and home_name.lower() != "cleanroom" and app and
+                 not app.is_meta_app and app.home_directories and
+                 params["effective_settings"].get("persistent_storage") and not params.get("forced_rw_mount"))
+        if profile_id is not None or operation_id is not None:
+            if (not isinstance(profile_id, str) or not NAME.fullmatch(profile_id) or
+                    not isinstance(operation_id, str) or not OPERATION.fullmatch(operation_id) or
+                    not named or params.get("launch_in_room_mode")):
+                raise HTTPException(422, "Profile launches require one named Home and a valid operation; rooms are unsupported.")
+        if not named:
+            if policy:
+                raise HTTPException(422, "Network policies require a named persistent Home.")
+            return await function(*args, **kwargs)
+        async with lifecycle_lock("home:" + home_path(username, home_name)):
+            snapshot = await inspect_home(username, home_name)
+            if snapshot["records"] or snapshot["workers"] or snapshot["resources"]:
+                raise HTTPException(409, "Home is reserved by an existing session, container or network allocation.")
+            if policy:
+                params["_network_policy"] = policy
+            return await function(*values.args, **values.kwargs)
+
+    return guarded
+
+
+def guard_session(function):
+    """Serialize room registry changes with full-session stop."""
+    signature = inspect.signature(function)
+
+    @functools.wraps(function)
+    async def guarded(*args, **kwargs):
+        session_id = signature.bind(*args, **kwargs).arguments["session_id"]
+        async with lifecycle_lock("session:" + session_id):
+            if state.sessions.get(session_id, {}).get("lifecycle_phase") == "stopping":
+                raise HTTPException(409, "Session is stopping.")
+            return await function(*args, **kwargs)
+
+    return guarded
+
+
+async def stop_session_confirmed(session_id: str) -> None:
+    """Persist intent, remove every Docker instance, then commit record deletion."""
+    from . import collaboration
+    from .launch import ephemeral_base
+    from .providers.docker_provider import DockerProvider
+
+    async with lifecycle_lock("session:" + session_id):
+        session = state.sessions.get(session_id)
+        if session is None:
+            return
+        ids = instance_ids(session)
+        session["lifecycle_phase"] = "stopping"
+        try:
+            await config_store.save_sessions()
+        except Exception as exc:
+            raise HTTPException(503, "Stop intent could not be saved; session remains reserved.") from exc
+        try:
+            provider = DockerProvider({"provider_config": {}})
+            for instance_id in ids:
+                await provider.stop(instance_id)
+        except Exception as exc:
+            logger.error("[%s] Stop remains pending (%s).", session_id, type(exc).__name__)
+            raise HTTPException(503, "Container removal was not confirmed; stop can be retried.") from exc
+        async with state.sessions_lock:
+            if state.sessions.get(session_id) is not session:
+                raise HTTPException(409, "Session ownership changed during stop.")
+            del state.sessions[session_id]
+        try:
+            await config_store.save_sessions()
+        except Exception as exc:
+            async with state.sessions_lock:
+                state.sessions.setdefault(session_id, session)
+            raise HTTPException(503, "Containers are gone but stop commit failed; retry is required.") from exc
+        try:
+            await collaboration.notify_session_ended(session_id)
+        except Exception as exc:
+            logger.warning("[%s] Could not broadcast completed stop (%s).", session_id, type(exc).__name__)
+        base = os.path.realpath(ephemeral_base())
+        for key in ("host_mount_path", "shared_files_path"):
+            path = session.get(key)
+            if path and os.path.realpath(path).startswith(base + os.sep):
+                await asyncio.to_thread(shutil.rmtree, path, ignore_errors=True)
+
+
+class StopProfileRequest(BaseModel):
+    """Expected launch generation; never a wildcard stop for a Home."""
+
+    profile_id: str = Field(pattern=r"^[A-Za-z0-9_-]{1,128}$")
+    operation_id: str = Field(pattern=r"^[a-f0-9]{32}$")
+    application_id: str = Field(min_length=1, max_length=256)
+    session_id: str = Field(default="", max_length=128)
+    bootstrap_url: str = Field(min_length=1, max_length=4096)
+    network_policy_id: str = Field(default="", pattern=r"^(?:[A-Za-z0-9_-]{1,128})?$")
+    network_policy_sha256: str = Field(default="", pattern=r"^(?:[a-f0-9]{64})?$")
+
+
+def record_matches(record: dict[str, Any], request: StopProfileRequest) -> bool:
+    """Require immutable generation metadata or the exact legacy launch marker."""
+    if (record["is_collaboration"] or record["app_id"] != request.application_id or
+            record.get("network_policy_id", "") != request.network_policy_id or
+            record.get("network_policy_sha256", "") != request.network_policy_sha256):
+        return False
+    if record["profile_id"] or record["operation_id"]:
+        return record["profile_id"] == request.profile_id and record["operation_id"] == request.operation_id
+    context = record.get("launch_context") or {}
+    return bool(request.session_id and record["session_id"] == request.session_id and
+                context.get("type") == "url" and context.get("value") == request.bootstrap_url)
+
+
+def validate_stop_inventory(snapshot: dict[str, Any], request: StopProfileRequest) -> None:
+    """Refuse stale generations, foreign mounts and ambiguous legacy orphans."""
+    records = {r["session_id"]: r for r in snapshot["records"]}
+    network_runtime.validate_resources(snapshot["resources"], request)
+    if any(not record_matches(r, request) for r in records.values()):
+        raise HTTPException(409, "Home belongs to a different or unproven launch operation.")
+    for worker in snapshot["workers"]:
+        if (not worker["owned"] or worker["app_id"] != request.application_id or
+                worker.get("network_policy_id", "") != request.network_policy_id or
+                worker.get("network_policy_sha256", "") != request.network_policy_sha256):
+            raise HTTPException(409, "Container ownership is unproven; no container was stopped.")
+        if worker["profile_id"] or worker["operation_id"]:
+            matches = worker["profile_id"] == request.profile_id and worker["operation_id"] == request.operation_id
+        else:
+            matches = worker["session_id"] in records and record_matches(records[worker["session_id"]], request)
+        if not matches:
+            raise HTTPException(409, "Container belongs to a different launch operation.")
+
+
+async def stop_profile_locked(username: str, home_name: str, request: StopProfileRequest) -> None:
+    """The caller holds the Home lock; network cleanup follows Worker removal."""
+    from .providers.docker_provider import DockerProvider
+
+    snapshot = await inspect_home(username, home_name)
+    validate_stop_inventory(snapshot, request)
+    identity = runtime_identity(username, home_name, request.application_id, request.profile_id, request.operation_id)
+    # This intent survives direct UI stops whose Session record is later removed.
+    await network_runtime.set_phase(identity, "stopping")
+    for record in snapshot["records"]:
+        await stop_session_confirmed(record["session_id"])
+    try:
+        if snapshot["workers"]:
+            provider = DockerProvider({"provider_config": {}})
+            for worker in snapshot["workers"]:
+                await provider.stop(worker["instance_id"])
+    except Exception as exc:
+        raise HTTPException(503, "Orphan removal was not confirmed; stop can be retried.") from exc
+    remaining = await inspect_home(username, home_name)
+    if remaining["records"] or remaining["workers"]:
+        raise HTTPException(503, "Home is still reserved; stop was not completed.")
+    try:
+        await network_runtime.remove_after_exit(identity, request)
+    except HTTPException:
+        raise
+    except Exception as exc:
+        raise HTTPException(503, "NETWORK_CLEANUP_INCOMPLETE; reservation retained") from exc
+    remaining = await inspect_home(username, home_name)
+    if remaining["records"] or remaining["workers"] or remaining["resources"]:
+        raise HTTPException(503, "Home resources still exist; stop was not completed.")
+
+
+router = APIRouter(prefix="/api/profile-runtime", route_class=EncryptedRoute,
+                   dependencies=[Depends(verify_token)])
+
+
+@router.get("/{home_name}")
+async def get_profile_runtime(home_name: str, user: dict[str, Any] = Depends(verify_token)) -> dict[str, Any]:
+    """Return a fresh Docker-backed snapshot while holding the Home lock."""
+    async with lifecycle_lock("home:" + home_path(user["username"], home_name)):
+        return await inspect_home(user["username"], home_name)
+
+
+@router.post("/{home_name}/stop", status_code=204)
+async def stop_profile_runtime(home_name: str,
+                               decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body),
+                               user: dict[str, Any] = Depends(verify_token)) -> Response:
+    """Stop one generation, including labeled orphans, and verify an empty Home."""
+    try:
+        request = StopProfileRequest(**decrypted_body)
+    except ValidationError as exc:
+        raise HTTPException(422, "Invalid Profile stop request.") from exc
+    username = user["username"]
+    async with lifecycle_lock("home:" + home_path(username, home_name)):
+        await stop_profile_locked(username, home_name, request)
+        return Response(status_code=204)
