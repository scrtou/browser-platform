index 0000000..2d78656
--- /dev/null
+++ b/server/app/network_direct.py
@@ -0,0 +1,94 @@
+"""DIRECT host-address evidence, with no host-network or firewall privileges."""
+
+from __future__ import annotations
+
+import ipaddress
+import os
+import stat
+from pathlib import Path
+
+from fastapi import HTTPException
+
+HOST_IPV4_SOURCE = "/proc/1/net/fib_trie"
+HOST_IPV4_FILE = "/run/browser-platform-host/ipv4-fib-trie"
+
+
+def reject(code="DIRECT_HOST_EVIDENCE_UNAVAILABLE"):
+    raise HTTPException(503, code)
+
+
+def parse_host_ipv4(raw: str) -> list[str]:
+    addresses = set()
+    previous = None
+    loopback = table = False
+    try:
+        for line in raw.splitlines():
+            line = line.strip()
+            if line in {"Main:", "Local:"}:
+                table, previous = True, None
+            if line.startswith("|-- "):
+                previous = ipaddress.IPv4Address(line[4:].strip())
+            elif line == "/32 host LOCAL":
+                if not table or previous is None:
+                    reject()
+                loopback |= previous.is_loopback
+                if previous.is_global and not previous.is_multicast:
+                    addresses.add(str(previous))
+    except (ValueError, TypeError):
+        reject()
+    # NAT-only hosts need a separate external-address authority. This version
+    # requires at least one native public host address and never guesses one.
+    if not loopback or not 1 <= len(addresses) <= 64:
+        reject()
+    return sorted(addresses)
+
+
+def host_ipv4(controller) -> list[str]:
+    matches = [m for m in controller.attrs.get("Mounts", []) if m.get("Destination") == HOST_IPV4_FILE]
+    if (len(matches) != 1 or matches[0].get("Type") != "bind" or
+            matches[0].get("Source") != HOST_IPV4_SOURCE or matches[0].get("RW") is not False):
+        reject("DIRECT_HOST_MOUNT_REQUIRED")
+    path = Path(HOST_IPV4_FILE)
+    try:
+        before = path.lstat()
+        if not stat.S_ISREG(before.st_mode) or before.st_mode & 0o022:
+            reject()
+        with path.open("rb") as handle:
+            actual = os.fstat(handle.fileno())
+            if (before.st_dev, before.st_ino) != (actual.st_dev, actual.st_ino):
+                reject()
+            raw = handle.read(1024 * 1024 + 1)
+        if len(raw) > 1024 * 1024:
+            reject()
+        return parse_host_ipv4(raw.decode("ascii"))
+    except (OSError, UnicodeError, ValueError):
+        reject()
+
+
+def validate_allocation(client, reservation, relay=None, controller=None):
+    """Check frozen config and host evidence before reconnecting or resuming."""
+    from . import network_runtime as network
+
+    policy = network.NetworkPolicy(**reservation["policy"])
+    if policy.mode != "direct":
+        return
+    allocation = reservation.get("allocation") or {}
+    controller = controller or network.self_container(client)
+    if allocation.get("mode") != "direct" or host_ipv4(controller) != allocation.get("host_ipv4"):
+        reject("DIRECT_HOST_EVIDENCE_CHANGED")
+    identity = reservation["identity"]
+    directory = network.runtime_dir() / (identity["home_hash"] + "-" + identity["operation"])
+    relay = relay or client.containers.get(allocation["relay_id"])
+    for filename, key in (("relay.json", "relay_config_sha256"), ("relay-network.json", "relay_network_sha256")):
+        path = directory / filename
+        if network.digest(network.read_json(path)) != allocation.get(key):
+            reject("DIRECT_CONFIG_CHANGED")
+        destination = "/run/config/relay.json" if filename == "relay.json" else "/run/config/network.json"
+        mounts = [m for m in relay.attrs.get("Mounts", []) if m.get("Destination") == destination]
+        if (len(mounts) != 1 or mounts[0].get("Source") != network.translate_path_to_host(str(path)) or
+                mounts[0].get("RW") is not False or mounts[0].get("Type") != "bind"):
+            reject("DIRECT_CONFIG_MOUNT_CHANGED")
+    mounts = [m for m in relay.attrs.get("Mounts", []) if m.get("Destination") == HOST_IPV4_FILE]
+    if (len(mounts) != 1 or mounts[0].get("Source") != HOST_IPV4_SOURCE or mounts[0].get("Type") != "bind" or
+            mounts[0].get("RW") is not False):
+        reject("DIRECT_HOST_MOUNT_REQUIRED")
diff --git a/server/app/network_dns.py b/server/app/network_dns.py
new file mode 100644
index 0000000..0f2030b
--- /dev/null
+++ b/server/app/network_dns.py
@@ -0,0 +1,301 @@
+"""Bounded bootstrap DNS to one approved numeric resolver, never the OS resolver.
+
+Only the controller resolves proxy endpoints. The complete validated IPv4 set
+and TTL observation belong to one generation; expiry does not authorize a
+running Relay to switch endpoints or release a Home.
+"""
+
+from __future__ import annotations
+
+import ipaddress
+import math
+import re
+import time
+
+import dns.exception
+import dns.flags
+import dns.message
+import dns.opcode
+import dns.query
+import dns.rcode
+import dns.rdataclass
+import dns.rdatatype
+
+DNS_PORT = 53
+TIMEOUT_SECONDS = 5.0
+MAX_CNAME = 8
+MAX_ADDRESSES = 64
+MAX_RECORDS = 128
+LABEL = re.compile(r"[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?", re.I)
+
+
+class BootstrapDNSError(ValueError):
+    """Stable, non-sensitive diagnostics; never include a packet or hostname."""
+
+    def __init__(self, code):
+        super().__init__(code)
+        self.code = code
+
+
+def fail(code="NETWORK_BOOTSTRAP_DNS_INVALID"):
+    raise BootstrapDNSError(code)
+
+
+def hostname(value):
+    if not isinstance(value, str) or not value.isascii():
+        fail("NETWORK_UPSTREAM_HOST_INVALID")
+    name = value[:-1] if value.endswith(".") else value
+    if not 1 <= len(name) <= 253 or not all(LABEL.fullmatch(part) for part in name.split(".")):
+        fail("NETWORK_UPSTREAM_HOST_INVALID")
+    return name.lower() + "."
+
+
+def numeric_endpoint(value):
+    try:
+        address = ipaddress.ip_address(value)
+    except ValueError:
+        if not isinstance(value, str) or ":" in value or re.fullmatch(r"[0-9.]+", value):
+            fail("NETWORK_UPSTREAM_ADDRESS_INVALID")
+        return None
+    if address.version != 4 or str(address) != value:
+        fail("NETWORK_UPSTREAM_ADDRESS_INVALID")
+    return validate_addresses([value])[0]
+
+
+def validate_addresses(values):
+    if not isinstance(values, list) or not 1 <= len(values) <= MAX_ADDRESSES:
+        fail("NETWORK_UPSTREAM_ADDRESS_INVALID")
+    result = []
+    for value in values:
+        try:
+            address = ipaddress.IPv4Address(value)
+        except (ValueError, TypeError):
+            fail("NETWORK_UPSTREAM_ADDRESS_INVALID")
+        # Proxy infrastructure may intentionally be private. This preserves
+        # the proxy endpoint contract, distinct from the DIRECT website ACL.
+        if (str(address) != value or address.is_loopback or address.is_unspecified or address.is_multicast):
+            fail("NETWORK_UPSTREAM_ADDRESS_INVALID")
+        if value not in result:
+            result.append(value)
+    return result
+
+
+def remaining(deadline):
+    value = deadline - time.monotonic()
+    if value <= 0:
+        fail("NETWORK_BOOTSTRAP_DNS_TIMEOUT")
+    return value
+
+
+def header(response, query, truncated=False):
+    # dnspython also validates ID/question and the UDP source. Check explicitly
+    # before accepting a truncated response as authority to attempt TCP.
+    if (not query.is_response(response) or response.id != query.id or
+            not response.flags & dns.flags.QR or response.opcode() != dns.opcode.QUERY or
+            response.flags & 0x40 or len(response.question) != 1 or
+            response.question != query.question or
+            bool(response.flags & dns.flags.TC) != truncated):
+        fail()
+    if response.rcode() != dns.rcode.NOERROR:
+        code = {dns.rcode.NXDOMAIN: "NXDOMAIN", dns.rcode.SERVFAIL: "SERVFAIL",
+                dns.rcode.REFUSED: "REFUSED"}.get(response.rcode(), "RCODE")
+        fail("NETWORK_BOOTSTRAP_DNS_" + code)
+
+
+def exchange(name, resolver_ip, deadline):
+    query = dns.message.make_query(name, dns.rdatatype.A, use_edns=False)
+    transports = ["udp"]
+    try:
+        try:
+            response = dns.query.udp(query, resolver_ip, port=DNS_PORT, timeout=remaining(deadline),
+                                     one_rr_per_rrset=True, raise_on_truncation=True,
+                                     ignore_unexpected=False, ignore_errors=False, ignore_trailing=False)
+        except dns.message.Truncated as exc:
+            header(exc.message(), query, truncated=True)
+            transports.append("tcp")
+            response = dns.query.tcp(query, resolver_ip, port=DNS_PORT, timeout=remaining(deadline),
+                                     one_rr_per_rrset=True, ignore_trailing=False)
+        header(response, query)
+        remaining(deadline)
+        if sum(len(rrset) for section in (response.answer, response.authority, response.additional)
+               for rrset in section) > MAX_RECORDS:
+            fail()
+        return response, {"name": name, "transports": transports, "received_at": time.time()}
+    except BootstrapDNSError:
+        raise
+    except dns.exception.Timeout:
+        fail("NETWORK_BOOTSTRAP_DNS_TIMEOUT")
+    except (dns.exception.DNSException, ValueError):
+        fail()
+    except OSError:
+        fail("NETWORK_BOOTSTRAP_DNS_UNAVAILABLE")
+
+
+def answer_records(response, received_at, query_index):
+    records = []
+    for rrset in response.answer:
+        if (rrset.rdclass != dns.rdataclass.IN or rrset.rdtype not in (dns.rdatatype.A, dns.rdatatype.CNAME) or
+                not len(rrset) or not 0 <= rrset.ttl <= 2147483647):
+            fail()
+        owner = hostname(rrset.name.to_text())
+        for record in rrset:
+            value = (record.address if rrset.rdtype == dns.rdatatype.A else hostname(record.target.to_text()))
+            records.append({"name": owner, "type": dns.rdatatype.to_text(rrset.rdtype), "value": value,
+                            "ttl_seconds": rrset.ttl, "received_at": received_at, "query_index": query_index})
+    if not records or len(records) > MAX_RECORDS:
+        fail("NETWORK_BOOTSTRAP_DNS_NO_IPV4")
+    return records
+
+
+def follow(records, current, seen):
+    """Consume one complete answer; reject branches, loops and unrelated RRs."""
+    owners = {record["name"] for record in records}
+    consumed = set()
+    while current in owners:
+        consumed.add(current)
+        cnames = [r for r in records if r["name"] == current and r["type"] == "CNAME"]
+        addresses = [r["value"] for r in records if r["name"] == current and r["type"] == "A"]
+        if cnames:
+            targets = {record["value"] for record in cnames}
+            if addresses or len(targets) != 1 or len(seen) > MAX_CNAME:
+                fail()
+            current = next(iter(targets))
+            if current in seen:
+                fail()
+            seen.add(current)
+        elif addresses:
+            if owners != consumed:
+                fail()
+            return current, validate_addresses(addresses)
+        else:
+            fail()
+    if not consumed or owners != consumed:
+        fail()
+    return current, None
+
+
+def observation(host, source, addresses, *, resolver=None, records=None, queries=None, canonical_name=None):
+    values = validate_addresses(addresses)
+    records, queries = records or [], queries or []
+    return {"version": 1, "source": source, "hostname": host, "resolver": resolver,
+            "addresses": values, "selected_ipv4": values[0], "canonical_name": canonical_name,
+            "observed_at": time.time(), "queries": queries, "answer_records": records,
+            "ttl_seconds": min((r["ttl_seconds"] for r in records), default=None),
+            "expires_at": min((r["received_at"] + r["ttl_seconds"] for r in records), default=None)}
+
+
+def resolve_approved(policy):
+    """Resolve a validated policy, bounded across UDP/TCP and all aliases."""
+    literal = numeric_endpoint(policy.upstream_host)
+    if literal:
+        return observation(policy.upstream_host, "numeric", [literal])
+    current = hostname(policy.upstream_host)
+    seen, records, queries = {current}, [], []
+    deadline = time.monotonic() + TIMEOUT_SECONDS
+    for index in range(MAX_CNAME + 1):
+        response, query = exchange(current, policy.bootstrap_resolver_ip, deadline)
+        answer = answer_records(response, query["received_at"], index)
+        current, addresses = follow(answer, current, seen)
+        records.extend(answer)
+        queries.append(query)
+        if len(records) > MAX_RECORDS:
+            fail()
+        if addresses:
+            remaining(deadline)
+            return observation(policy.upstream_host, "approved_resolver", addresses,
+                               resolver={"id": policy.bootstrap_resolver_id,
+                                         "ip": policy.bootstrap_resolver_ip, "port": 53},
+                               canonical_name=current, records=records, queries=queries)
+    fail()
+
+
+def binding(identity, policy_sha256):
+    return {"home_hash": identity["home_hash"], "operation_id": identity["operation"],
+            "policy_sha256": policy_sha256}
+
+
+def timestamp(value):
+    return type(value) in (int, float) and math.isfinite(value) and value > 0
+
+
+def validate_observation(value, policy, identity, policy_sha256):
+    """Verify durable evidence without a network call or an expiry decision."""
+    expected = {"version", "source", "hostname", "resolver", "addresses", "selected_ipv4", "canonical_name",
+                "observed_at", "queries", "answer_records", "ttl_seconds", "expires_at", "binding"}
+    if (not isinstance(value, dict) or set(value) != expected or type(value["version"]) is not int or
+            value["version"] != 1 or value["binding"] != binding(identity, policy_sha256) or
+            value["hostname"] != policy.upstream_host or not timestamp(value["observed_at"]) or
+            validate_addresses(value["addresses"]) != value["addresses"] or
+            value["selected_ipv4"] != value["addresses"][0]):
+        fail()
+    literal = numeric_endpoint(policy.upstream_host)
+    source = "numeric" if literal else "approved_resolver" if policy.bootstrap_resolver_id else "legacy_system"
+    if value["source"] != source:
+        fail()
+    if source != "approved_resolver":
+        if (value["resolver"] is not None or value["canonical_name"] is not None or value["queries"] != [] or
+                value["answer_records"] != [] or value["ttl_seconds"] is not None or value["expires_at"] is not None or
+                literal and value["addresses"] != [literal]):
+            fail()
+        return
+    if (value["resolver"] != {"id": policy.bootstrap_resolver_id, "ip": policy.bootstrap_resolver_ip, "port": 53} or
+            not isinstance(value["queries"], list) or not 1 <= len(value["queries"]) <= MAX_CNAME + 1 or
+            not isinstance(value["answer_records"], list) or not 1 <= len(value["answer_records"]) <= MAX_RECORDS):
+        fail()
+    current = hostname(policy.upstream_host)
+    seen, consumed, addresses, previous_time = {current}, [], None, 0
+    for index, query in enumerate(value["queries"]):
+        if (not isinstance(query, dict) or set(query) != {"name", "transports", "received_at"} or
+                addresses is not None or query["name"] != current or
+                query["transports"] not in (["udp"], ["udp", "tcp"]) or
+                not timestamp(query["received_at"]) or
+                not previous_time <= query["received_at"] <= value["observed_at"]):
+            fail()
+        previous_time = query["received_at"]
+        records = []
+        for record in value["answer_records"]:
+            if (not isinstance(record, dict) or
+                    set(record) != {"name", "type", "value", "ttl_seconds", "received_at", "query_index"} or
+                    type(record["query_index"]) is not int or not 0 <= record["query_index"] < len(value["queries"]) or
+                    not timestamp(record["received_at"]) or type(record["ttl_seconds"]) is not int or
+                    not 0 <= record["ttl_seconds"] <= 2147483647 or hostname(record["name"]) != record["name"] or
+                    record["type"] not in {"A", "CNAME"}):
+                fail()
+            if record["type"] == "CNAME" and hostname(record["value"]) != record["value"]:
+                fail()
+            if record["query_index"] == index:
+                if record["received_at"] != query["received_at"]:
+                    fail()
+                records.append(record)
+        current, addresses = follow(records, current, seen)
+        consumed.extend(records)
+    if (consumed != value["answer_records"] or addresses != value["addresses"] or
+            current != value["canonical_name"] or type(value["ttl_seconds"]) is not int or
+            value["ttl_seconds"] != min(record["ttl_seconds"] for record in consumed) or
+            value["expires_at"] != min(record["received_at"] + record["ttl_seconds"] for record in consumed)):
+        fail()
+
+
+def validate_allocation(client, reservation, relay=None):
+    """New proxy allocations bind DNS evidence and the frozen Relay/ACL files."""
+    from . import network_runtime as network
+
+    if reservation.get("bootstrap_dns_version") != 1:
+        return  # Retained pre-R5C2 generations have no invented DNS evidence.
+    allocation = reservation["allocation"]
+    identity = reservation["identity"]
+    directory = network.runtime_dir() / (identity["home_hash"] + "-" + identity["operation"])
+    relay = relay or client.containers.get(allocation["relay_id"])
+    for filename, key, endpoint in (("relay.json", "relay_config_sha256", "upstream_host"),
+                                    ("relay-network.json", "relay_network_sha256", "upstream_ip")):
+        path = directory / filename
+        config = network.read_json(path)
+        if (network.digest(config) != allocation.get(key) or
+                config.get(endpoint) != reservation["bootstrap_dns"]["selected_ipv4"] or
+                config.get("upstream_port") != reservation["policy"]["upstream_port"]):
+            network.reject("NETWORK_BOOTSTRAP_CONFIG_CHANGED", 503)
+        destination = "/run/config/relay.json" if filename == "relay.json" else "/run/config/network.json"
+        mounts = [m for m in relay.attrs.get("Mounts", []) if m.get("Destination") == destination]
+        if (len(mounts) != 1 or mounts[0].get("Source") != network.translate_path_to_host(str(path)) or
+                mounts[0].get("RW") is not False or mounts[0].get("Type") != "bind"):
+            network.reject("NETWORK_BOOTSTRAP_CONFIG_MOUNT_CHANGED", 503)
