+    ["30", FIREFOX + " https://adapter.example/bootstrap/personal/" + "b" * 32],
+    ["31", FIREFOX + " -contentproc -ipcHandle 0 -signalPipe 1"],
+    ["32", FIREFOX + " -contentproc -isForBrowser -prefsHandle 0:1"],
+    ["40", "Xvfb :1 -screen 0 1920x1080x24"],
