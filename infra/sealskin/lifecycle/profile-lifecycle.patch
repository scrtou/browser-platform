+async def test_stop_waits_for_inflight_launch(containers):
+    state.installed_apps["firefox"] = SimpleNamespace(is_meta_app=False, home_directories=True)
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    @runtime.guard_launch
+    async def launch(application_id, username, effective_settings, home_name, profile_id, operation_id):
+        entered.set()
+        await release.wait()
+        await session(containers)
+
+    start = asyncio.create_task(launch("firefox", "qa", {"persistent_storage": True}, "test-home", "personal", OPERATION))
+    await entered.wait()
+    stop = asyncio.create_task(stop_home())
+    await asyncio.sleep(0)
+    assert not stop.done()
+    release.set()
+    await start
+    await stop
+    assert not containers.values and not state.sessions
