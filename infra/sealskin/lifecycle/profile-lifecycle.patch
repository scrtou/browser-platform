+def successful_sampling(g, monkeypatch):
+    """Drive the actual sampler/evaluator with controlled network observations."""
+    clock, address, dropped = [NOW + 4], ["8.8.8.8"], [3]
+    g.policy.mode = "proxy_required"
+    g.policy.probe_ca_file = ""
+    g.policy.approved_resolver_ip = g.policy.bootstrap_resolver_ip = ""
+    g.policy.coherence.allowed_countries = ["JP", "HK"]
+    g.reservation["allocation"]["relay_ip"] = "172.30.1.2"
+    g.data[1]["resolvedConfig"] = {"voices": []}
+    g.current.return_value = (g.binding, None, {"worker": None})
+    g.reservation.pop("coherence_report", None)
+    monkeypatch.setattr(runtime.time, "time", lambda: clock[0])
+    monkeypatch.setattr(runtime.secrets, "token_hex", lambda _: NONCE)
+    monkeypatch.setattr(runtime, "assets", lambda _: (g.data[1], g.data[2]))
+    def facts(*args):
+        value = copy.deepcopy(g.data[5])
+        value["guard"]["output_dropped_packets"] = dropped[0]
+        return value
+    monkeypatch.setattr(runtime, "network_facts", AsyncMock(side_effect=facts))
+    monkeypatch.setattr(runtime.coherence_geoip, "country", lambda spec, ip, now: {
+        "status": "pass", "country": "JP" if ip == "8.8.8.8" else "HK", "city": None, "source": "synthetic-test-fixture"})
+    async def observe(*args):
+        dropped[0] += 5
+        raw = copy.deepcopy(g.data[4])
+        raw.update(started_at=clock[0], finished_at=clock[0])
+        for who in (raw["preflight"], raw["page"]["whoami"]):
+            who.update(public_ip=address[0], server_time=clock[0])
+        return raw
+    observer = AsyncMock(side_effect=observe)
+    monkeypatch.setattr(coherence_exec, "observe_browser", observer)
+    return clock, address, observer
+
