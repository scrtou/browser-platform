+class Container:
+    def __init__(self, collection, instance=INSTANCE, status="running", labels=None):
+        self.collection, self.id = collection, instance
+        self.short_id, self.status = instance[:12], status
+        self.labels = labels or {}
+        self.source = runtime.home_source("qa", "test-home")
+        self.stop_error = self.remove_error = None
+        self.false_stop = False
+        self.stop_calls = self.remove_calls = self.unpause_calls = 0
+
+    @property
+    def attrs(self):
+        return {"State": {"Status": self.status},
+                "Config": {"Labels": self.labels, "Env": ["PASSWORD=not-for-inventory"]},
+                "Mounts": [{"Source": self.source, "Destination": settings.container_config_path}]}
+
+    def stop(self, timeout):
+        self.stop_calls += 1
+        if self.collection.before_stop:
+            self.collection.before_stop()
+        if self.stop_error:
+            raise self.stop_error
+        if not self.false_stop:
+            self.status = "exited"
+
+    def unpause(self):
+        self.unpause_calls += 1
+        self.status = "running"
+
+    def remove(self):
+        self.remove_calls += 1
+        if self.remove_error:
+            raise self.remove_error
+        self.collection.values.pop(self.id, None)
+
+
+class Containers:
+    def __init__(self):
+        self.values = {}
+        self.error = None
+        self.before_stop = None
+        self.run_kwargs = None
+
+    def get(self, instance):
+        if self.error:
+            raise self.error
+        if instance not in self.values:
+            raise NotFound("missing")
+        return self.values[instance]
+
+    def list(self, **kwargs):
+        if self.error:
+            raise self.error
+        return list(self.values.values())
+
+    def run(self, **kwargs):
+        self.run_kwargs = kwargs
+        container = Container(self, labels=kwargs.get("labels"))
+        self.values[container.id] = container
+        return container
+
