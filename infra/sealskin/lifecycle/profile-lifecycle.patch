+
+    monkeypatch.setattr(socket, "getaddrinfo", no_system)
+    try:
+        yield fixture
+    finally:
+        for server in (udp, tcp):
+            server.shutdown()
+            server.server_close()
+        for thread in threads:
+            thread.join(1)
