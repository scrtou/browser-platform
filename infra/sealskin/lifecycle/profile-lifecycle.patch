+"""Create-before journal, Home delete protection and display-connection observation."""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from docker.errors import DockerException
+from fastapi import HTTPException
+
+from app import config_store, launch_journal, network_runtime
+from app import profile_health as health
+from app import profile_runtime as runtime
+from app.launch import launch_application
+from app.routers import homedirs
+from app.state import state
+from tests.test_network_runtime import (  # noqa: F401 - fixtures are discovered by name
+    OPERATION,
+    launch_args,
+    managed,
+    stop,
+)
+from tests.test_profile_runtime import Container, Containers, SID, session
+
+PLAIN_OPERATION = "e" * 32
+
+
+@pytest.fixture
+def plain(monkeypatch):
+    """A plain named-Home app (no network policy) with a fake Docker client."""
+    collection = Containers()
+    client = SimpleNamespace(containers=collection, images=SimpleNamespace(get=lambda _: object()),
+                             networks=SimpleNamespace(list=lambda: []))
+    from app import docker_utils
+    from app.providers import docker_provider
+    for module in [docker_utils, runtime, network_runtime, docker_provider, launch_journal]:
+        monkeypatch.setattr(module, "get_docker_client", lambda: client)
+    from pathlib import Path
+    Path(runtime.home_path("qa", "test-home")).mkdir(parents=True)
+    state.installed_apps["firefox"] = SimpleNamespace(is_meta_app=False, home_directories=True, provider_config=SimpleNamespace(network_policy_id="", network_policy_sha256=""))
+    return collection
+
+
+def identity():
+    return runtime.runtime_identity("qa", "test-home", "firefox", "personal", PLAIN_OPERATION)
+
+
+def journal_phase():
+    value = launch_journal.read_journal(identity())
+    return value["phase"] if value else None
+
+
+async def test_journal_exists_before_create_and_is_removed_after_commit(plain):
+    seen = {}
+
+    @runtime.guard_launch
+    async def launch(application_id, username, effective_settings, home_name, profile_id, operation_id):
+        seen["phase_at_create"] = journal_phase()
+        seen["pending_at_create"] = len(launch_journal.read_pending(identity()))
+        snapshot = await runtime.inspect_home(username, home_name)
+        seen["inventory_at_create"] = [r["kind"] + ":" + r["status"] for r in snapshot["resources"]]
+        await session(plain)
+        return "launched"
+
+    result = await launch("firefox", "qa", {"persistent_storage": True}, "test-home", "personal", PLAIN_OPERATION)
+    assert result == "launched"
+    assert seen == {"phase_at_create": "creating", "pending_at_create": 0, "inventory_at_create": ["launch:creating"]}
+    assert journal_phase() is None and not launch_journal.read_pending(identity())
+    snapshot = await runtime.inspect_home("qa", "test-home")
+    assert [r["kind"] for r in snapshot["resources"]] == [] and snapshot["launch_journal_version"] == 1
+    assert snapshot["browser_shutdown_version"] == 1 and snapshot["session_auth_version"] == 1
+
+
+async def test_failed_launch_keeps_a_failed_journal_that_reserves_the_home_until_explicit_stop(plain):
+    @runtime.guard_launch
+    async def launch(application_id, username, effective_settings, home_name, profile_id, operation_id):
+        raise HTTPException(504, "Container failed to become ready in time.")
+
+    with pytest.raises(HTTPException):
+        await launch("firefox", "qa", {"persistent_storage": True}, "test-home", "personal", PLAIN_OPERATION)
+    assert journal_phase() == "failed"
+    snapshot = await runtime.inspect_home("qa", "test-home")
+    assert [(r["kind"], r["status"], r["operation_id"]) for r in snapshot["resources"]] == [("launch", "failed", PLAIN_OPERATION)]
+    with pytest.raises(HTTPException) as error:
+        await launch("firefox", "qa", {"persistent_storage": True}, "test-home", "personal", "f" * 32)
+    assert error.value.status_code == 409
+    request = {"profile_id": "personal", "operation_id": PLAIN_OPERATION, "application_id": "firefox", "session_id": "",
+               "bootstrap_url": "https://adapter.example/bootstrap/personal/" + PLAIN_OPERATION}
+    with pytest.raises(HTTPException) as error:
+        await runtime.stop_profile_runtime("test-home", {**request, "operation_id": "f" * 32}, {"username": "qa"})
+    assert error.value.status_code == 409
+    assert (await runtime.stop_profile_runtime("test-home", request, {"username": "qa"})).status_code == 204
+    assert journal_phase() is None
+    snapshot = await runtime.inspect_home("qa", "test-home")
+    assert snapshot["resources"] == []
+
+
+async def test_pending_intent_is_visible_while_waiting_for_the_home_lock(plain):
+    entered, release = asyncio.Event(), asyncio.Event()
+
+    @runtime.guard_launch
+    async def launch(application_id, username, effective_settings, home_name, profile_id, operation_id):
+        entered.set()
+        await release.wait()
+        await session(plain)
+        return "launched"
+
+    first = asyncio.create_task(launch("firefox", "qa", {"persistent_storage": True}, "test-home", "personal", PLAIN_OPERATION))
+    await entered.wait()
+    other = "f" * 32
+    second = asyncio.create_task(launch("firefox", "qa", {"persistent_storage": True}, "test-home", "personal", other))
+    await asyncio.sleep(0.05)
+    pending = launch_journal.read_pending(runtime.runtime_identity("qa", "test-home", "firefox", "personal", other))
+    assert [p["identity"]["operation"] for p in pending] == [other]
+    release.set()
+    assert await first == "launched"
+    with pytest.raises(HTTPException) as error:
+        await second
+    assert error.value.status_code == 409
+    assert not launch_journal.read_pending(runtime.runtime_identity("qa", "test-home", "firefox", "personal", other))
+
+
+async def test_startup_resolves_creating_journals_without_touching_containers(plain, monkeypatch):
+    ident = identity()
+    # aborted: creating, no container
+    launch_journal.write_creating(ident, None)
+    results = await launch_journal.resolve_at_startup()
+    assert [r["result"] for r in results] == ["aborted"] and journal_phase() == "aborted"
+    launch_journal.remove(ident)
+    # orphaned: creating + container with the deterministic name but no record
+    launch_journal.write_creating(ident, None)
+    worker = Container(plain, labels={})
+    worker.name = launch_journal.container_name(ident)
+    plain.values[worker.id] = worker
+    original_get = plain.get
+    plain.get = lambda key: worker if key == worker.name else original_get(key)
+    results = await launch_journal.resolve_at_startup()
+    assert [r["result"] for r in results] == ["orphaned"] and journal_phase() == "orphaned"
+    assert worker.stop_calls == worker.remove_calls == 0 and worker.id in plain.values
+    # committed: record exists for that container → journal removed
+    launch_journal.set_phase(ident, "creating")
+    state.sessions[SID] = {"instance_id": worker.id, "username": "qa", "provider_app_id": "firefox",
+                           "host_mount_path": runtime.home_path("qa", "test-home"), "container_registry": {}}
+    results = await launch_journal.resolve_at_startup()
+    assert [r["result"] for r in results] == ["committed"] and journal_phase() is None
+    # pending intents never survive a restart
+    launch_journal.write_pending(ident, None)
+    results = await launch_journal.resolve_at_startup()
+    assert [r["result"] for r in results] == ["pending_discarded"] and not launch_journal.read_pending(ident)
+
+
+async def test_managed_launch_journal_is_ordered_before_docker_and_gone_after_commit(managed):
+    ident = managed.identity
+    original_create = managed.docker.create_container
+    phases = []
+
+    def create(**kwargs):
+        value = launch_journal.read_journal(ident)
+        phases.append((kwargs.get("labels", {}).get(network_runtime.PREFIX + "role", "worker"), value and value["phase"]))
+        return original_create(**kwargs)
+
+    managed.docker.containers.create = create
+    managed.docker.containers.run = lambda **kwargs: (lambda c: (c.start(), c)[1])(create(**kwargs))
+    await launch_application(**launch_args(managed))
+    assert phases and all(phase == "creating" for _, phase in phases), phases
+    assert launch_journal.read_journal(ident) is None
+    await stop(managed)
+
+
+async def test_home_delete_refused_while_reserved_and_allowed_when_empty(plain, monkeypatch):
+    from pathlib import Path
+    home = Path(runtime.home_path("qa", "test-home"))
+    (home / "keep.txt").write_text("data")
+    user = {"username": "qa", "effective_settings": {"persistent_storage": True}}
+    worker = await session(plain)
+    with pytest.raises(HTTPException) as error:
+        await homedirs.delete_my_home_dir("test-home", user)
+    assert error.value.status_code == 409 and error.value.detail == "HOME_RESERVED" and home.exists()
+    state.sessions.clear()
+    with pytest.raises(HTTPException) as error:
+        await homedirs.delete_my_home_dir("test-home", user)
+    assert error.value.status_code == 409 and home.exists(), "an unrecorded container mounting the Home must still block deletion"
+    plain.values.clear()
+    launch_journal.write_creating(identity(), None)
+    with pytest.raises(HTTPException) as error:
+        await homedirs.delete_my_home_dir("test-home", user)
+    assert error.value.status_code == 409 and home.exists(), "a launch journal must block deletion"
+    launch_journal.remove(identity())
+    plain.error = DockerException("daemon down")
+    with pytest.raises(HTTPException) as error:
+        await homedirs.delete_my_home_dir("test-home", user)
+    assert error.value.status_code == 503 and home.exists(), "unavailable inventory must refuse deletion"
+    plain.error = None
+    response = await homedirs.delete_my_home_dir("test-home", user)
+    assert response.status_code == 204 and not home.exists()
+
+
+def test_display_connection_parsing_and_attribution(monkeypatch):
+    lines = "  sl  local_address rem_address   st tx_queue rx_queue tr tm->when retrnsmt   uid  timeout inode\n"
+    # remote 172.18.0.4:3000 established (inode 11), same remote but LISTEN (inode 12), other port (inode 13)
+    lines += "   0: 0200A8C0:E1A4 040012AC:0BB8 01 00000000:00000000 00:00000000 00000000  1000        0 11 1 0\n"
+    lines += "   1: 0200A8C0:E1A5 040012AC:0BB8 0A 00000000:00000000 00:00000000 00000000  1000        0 12 1 0\n"
+    lines += "   2: 0200A8C0:E1A6 040012AC:1F40 01 00000000:00000000 00:00000000 00000000  1000        0 13 1 0\n"
+    import builtins, io
+    real_open = builtins.open
+
+    def fake_open(path, *args, **kwargs):
+        if path == "/proc/net/tcp":
+            return io.StringIO(lines)
+        if path == "/proc/net/tcp6":
+            raise OSError("no ipv6")
+        return real_open(path, *args, **kwargs)
+
+    monkeypatch.setattr(builtins, "open", fake_open)
+    assert health._established_to("172.18.0.4", 3000) == {11: 1}
+    monkeypatch.setattr(health, "_caddy_socket_inodes", lambda: {11, 99})
+    assert health.display_connections("172.18.0.4", 3000) == 1
+    monkeypatch.setattr(health, "_caddy_socket_inodes", lambda: {99})
+    assert health.display_connections("172.18.0.4", 3000) == 0
+    monkeypatch.setattr(health, "_caddy_socket_inodes", lambda: set())
+    assert health.display_connections("172.18.0.4", 3000) == -1
+
+
+async def test_health_reports_display_connections_per_worker(plain, monkeypatch):
+    monkeypatch.setattr(health, "get_docker_client", lambda: SimpleNamespace(containers=plain, images=SimpleNamespace(get=lambda _: object()), networks=SimpleNamespace(list=lambda: [])))
+    monkeypatch.setattr(Container, "top", lambda self, ps_args=None: {"Titles": ["PID", "COMMAND"], "Processes": []}, raising=False)
+    monkeypatch.setattr(health, "observe_display", AsyncMock(return_value={"status": "pass", "code": "DISPLAY_ENDPOINT_OK", "latency_ms": 1}))
+    monkeypatch.setattr(health, "display_connections", lambda ip, port: 2)
+    await session(plain)
+    state.sessions[SID].update(ip="172.18.0.9", port=3000, custom_user="abc", password="x")
+    result = await health.get_profile_health("test-home", False, {"username": "qa"})
+    assert result["workers"][0]["display_connections"] == 2
+    state.sessions[SID].pop("ip")
+    result = await health.get_profile_health("test-home", False, {"username": "qa"})
+    assert result["workers"][0]["display_connections"] == -1
