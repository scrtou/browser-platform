@@ -0,0 +1,176 @@
+"""Synthetic rule cases; public/browser provenance is tested separately in QA."""
+
+import copy
+from types import SimpleNamespace
+
+import pytest
+
+from app.coherence_policy import CoherencePolicy
+from app import coherence_report as reports
+
+
+NOW = 1800000000.0
+NONCE = "a" * 32
+
+
+def inputs():
+    spec = CoherencePolicy(mode="strict", allowed_countries=["US"], allowed_timezones=["America/New_York"],
+                           observer_domain="observe.example.org", observer_ipv4=["8.8.8.8"],
+                           artifact_file="/private/environment.json", artifact_sha256="a"*64,
+                           acceptance_file="/private/acceptance.json", acceptance_sha256="b"*64)
+    policy = SimpleNamespace(mode="direct", coherence=spec)
+    artifact = {"spec":{"id":"qa-synthetic-r1", "revision":1, "locale":"en-US", "languages":["en-US"],
+                        "timezone":"America/New_York", "screen":{"width":1920,"height":1080,"deviceScaleFactor":1},
+                        "requiredCapabilities":["frozen-device-config"]}}
+    baseline = {"userAgent":"SyntheticFirefox", "platform":"Linux x86_64", "oscpu":"Linux x86_64", "hardwareConcurrency":4,
+                "timezone":"America/New_York", "locale":"en-US", "languages":["en-US"],
+                "webgl":{"vendor":"Synthetic"}, "fonts":{"sans":123}, "canvasSHA256":"a"*64, "audioSHA256":"b"*64, "voices":[]}
+    page = {"version":1,"nonce":NONCE,"complete":True,"observed":{**copy.deepcopy(baseline),
+            "intlLocale":"en-US", "normalizedIntlLocale":"en-Latn-US", "normalizedLocale":"en-Latn-US", "screen":{"width":1920,"height":1080},
+            "deviceScaleFactor":1, "webrtcType":"undefined", "geolocationType":"undefined"}}
+    who = {"version":1,"nonce":NONCE,"public_ip":"8.8.8.8","server_time":NOW+2,"source_kind":"socket"}
+    page["whoami"]={**who,"phase":"browser"}
+    raw = {"version":1,"nonce":NONCE,"binding_sha256":"c"*64,"started_at":NOW,"finished_at":NOW+3,"status":"pass", "page":page,
+           "preflight":{**who,"phase":"preflight"},"default_routes":{"ipv4":True,"ipv6":False},"native_probes":[{"name":name,"connected":False,"errno":101 if name=="direct_ipv6" else None} for name in
+              ("direct_https","direct_dns_tcp","direct_ipv6","docker_dns","direct_dns_udp","stun_udp")]}
+    facts={"binding_sha256":"c"*64,"status":"pass","code":"NETWORK_ENFORCEMENT_CURRENT","host_ipv4":["8.8.8.8"],
+           "guard":{"output_dropped_packets":3},"after_guard":{"output_dropped_packets":8}}
+    geo={"status":"pass","country":"US","city":None,"source":"synthetic-test-fixture"}
+    return policy,artifact,baseline,{"profile_id":"qa","session_id":"qa-session"},raw,facts,geo
+
+
+def evaluate(data, previous=None, now=NOW+4, exit_history=None):
+    return reports.evaluate(*data, NONCE, NOW, now, previous, exit_history)
+
+
+def rows(report):
+    return {item["name"]:item for item in report["checks"]}
+
+
+def test_us_allowed_timezone_fixed_language_and_unknown_city():
+    report=evaluate(inputs())
+    assert report["allowed"] and report["overall"]=="degraded"
+    assert rows(report)["country"]["status"]=="pass" and rows(report)["city"]["status"]=="unknown"
+    assert rows(report)["dns"]["status"]=="pass"
+
+
+def test_healthy_aggregation_requires_all_optional_items_accounted_for():
+    data=inputs();data[6]["city"]="Synthetic test city"
+    report=evaluate(data)
+    assert report["overall"]=="healthy" and report["allowed"]
+
+
+@pytest.mark.parametrize("expected,actual,status", [
+    ("en-US", "en", "pass"), ("en-US", "EN-us", "pass"),
+    ("zh-TW", "zh-Hant-TW", "pass"), ("zh-Hant-TW", "zh-TW", "pass"),
+    ("he-IL", "iw", "pass"), ("sr-Latn-RS", "sr-Latn", "pass"),
+    ("en-US", "en-GB", "fail"), ("en-US", "en-US-posix", "fail"),
+    ("zh-Hans-CN", "zh-Hant-CN", "fail"), ("en-Latn-US", "en-Cyrl-US", "fail"),
+    ("zh-TW", "zh", "fail"), ("sr-Cyrl-RS", "sr-Latn-RS", "fail"),
+    ("en-US", "ja", "fail"), ("en-US", None, "unknown"),
+    ("en-US", "en_US", "unknown"), ("en-US", "xx", "unknown"),
+    ("en-US", "en-US-u-ca-japanese", "unknown"), ("en-US", 3, "unknown"),
+])
+def test_intl_locale_compares_frozen_tag_with_locked_cldr(expected, actual, status):
+    data = inputs()
+    data[1]["spec"]["locale"] = expected
+    observed = data[4]["page"]["observed"]
+    observed["intlLocale"] = actual
+    # Even identical forged normalization fields cannot override the raw tag.
+    observed["normalizedIntlLocale"] = observed["normalizedLocale"] = "page-claims-equality"
+    report = evaluate(data)
+    assert rows(report)["intl_locale"]["status"] == status
+    if status != "pass":
+        assert not report["allowed"]
+
+
+@pytest.mark.parametrize("fault", [None, "route_exists", "missing_errno", "refused", "missing_route", "missing_drop"])
+def test_route_denials_need_current_kernel_and_firewall_evidence(fault):
+    data = inputs()
+    raw, facts = data[4], data[5]
+    raw["default_routes"] = {"ipv4": False, "ipv6": False}
+    for probe in raw["native_probes"]:
+        probe["errno"] = 101 if probe["name"] != "docker_dns" else None
+    facts["after_guard"]["output_dropped_packets"] = facts["guard"]["output_dropped_packets"] + 1
+    if fault == "route_exists": raw["default_routes"]["ipv4"] = True
+    elif fault == "missing_errno": raw["native_probes"][0].pop("errno")
+    elif fault == "refused": raw["native_probes"][0]["errno"] = 111
+    elif fault == "missing_route": raw.pop("default_routes")
+    elif fault == "missing_drop": facts["after_guard"]["output_dropped_packets"] -= 1
+    report = evaluate(data)
+    assert report["allowed"] is (fault is None)
+    if fault is None:
+        assert len(report["network_evidence"]["route_denied_probes"]) == 5
+        assert report["network_evidence"]["required_drop_delta"] == 1
+
+
+def test_jp_with_explicit_timezone_constraint_fails_without_rewriting_environment():
+    data=inputs();data[0].coherence.allowed_countries=["JP"];data[0].coherence.allowed_timezones=["Asia/Tokyo"]
+    data[6]["country"]="JP"
+    before=copy.deepcopy(data[1:3])
+    report=evaluate(data)
+    assert report["overall"]=="unhealthy" and report["code"]=="COHERENCE_FAILED" and not report["allowed"]
+    assert rows(report)["allowed_timezone"]["status"]=="fail" and data[1:3]==before
+
+
+def test_en_us_on_jp_is_allowed_when_language_is_not_constrained_by_country():
+    data=inputs();data[0].coherence.allowed_countries=["JP"];data[0].coherence.allowed_timezones=[]
+    data[6]["country"]="JP"
+    assert evaluate(data)["allowed"]
+
+
+@pytest.mark.parametrize("change",["expired","geoip","nonce","source","phase","timestamp","nonpublic","raw-shape","page-shape","page-incomplete","missing-probe","missing-drops"])
+def test_missing_or_untrusted_required_evidence_cannot_open(change):
+    data=inputs();raw=data[4];now=NOW+4
+    if change=="expired": now=NOW+60
+    elif change=="geoip": data[6]["status"]="unknown"
+    elif change=="nonce": raw["nonce"]="b"*32
+    elif change=="source": raw["page"]["whoami"]["source_kind"]="x-forwarded-for"
+    elif change=="phase": raw["page"]["whoami"]["phase"]="preflight"
+    elif change=="timestamp": raw["page"]["whoami"]["server_time"]=NOW-20
+    elif change=="nonpublic": raw["page"]["whoami"]["public_ip"]="127.0.0.1"
+    elif change=="raw-shape": data=(*data[:4],[],*data[5:])
+    elif change=="page-shape": raw["page"]=["healthy"]
+    elif change=="page-incomplete": raw["page"]["complete"]=False
+    elif change=="missing-probe": raw["native_probes"].pop()
+    elif change=="missing-drops": data[5].pop("after_guard")
+    report=evaluate(data,now=now)
+    assert report["overall"]=="unknown" and not report["allowed"]
+
+
+@pytest.mark.parametrize("change",["timezone","locale","dns","webrtc","namespace","direct-exit"])
+def test_confirmed_environment_or_network_failure_is_unhealthy(change):
+    data=inputs();raw=data[4]
+    if change in {"timezone","locale"}: raw["page"]["observed"][change]="wrong"
+    elif change=="dns": raw["native_probes"][3]["connected"]=True
+    elif change=="webrtc": raw["page"]["observed"]["webrtcType"]="function"
+    elif change=="namespace": data[5]["status"]="fail"
+    elif change=="direct-exit": raw["page"]["whoami"]["public_ip"]="1.1.1.1"
+    report=evaluate(data)
+    assert report["overall"]=="unhealthy" and not report["allowed"]
+
+
+def test_advisory_region_mismatch_is_a_warning_but_page_mismatch_still_fails():
+    data=inputs();data[0].coherence.mode="advisory";data[6]["country"]="JP"
+    report=evaluate(data)
+    assert report["allowed"] and rows(report)["country"]["status"]=="warn"
+    data[4]["page"]["observed"]["timezone"]="Asia/Tokyo"
+    assert evaluate(data)["overall"]=="unhealthy"
+
+
+def test_exit_change_is_per_profile_and_block_is_latched_until_new_generation():
+    data=inputs();data[0].mode="proxy";data[0].coherence.on_exit_change="block"
+    history={"browser_ip":"1.1.1.1"}
+    first=evaluate(data,exit_history=history)
+    assert first["exit_change_blocked"] and not first["allowed"]
+    same=evaluate(data,first)
+    assert same["exit_change_blocked"] and not same["allowed"]
+    assert evaluate(data)["allowed"]
+    data[0].coherence.on_exit_change="recheck"
+    report=evaluate(data,exit_history=history)
+    assert report["allowed"] and rows(report)["exit_stability"]["status"]=="warn"
+
+
+def test_public_health_claim_does_not_replace_observations():
+    data=inputs();data[4].clear();data[4].update(healthy=True,overall="healthy",allowed=True)
+    assert not evaluate(data)["allowed"]
