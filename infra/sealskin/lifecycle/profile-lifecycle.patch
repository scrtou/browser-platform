+            "coherence_artifact_sha256": policy.coherence.artifact_sha256,
+            "coherence_acceptance_sha256": policy.coherence.acceptance_sha256,
+            "coherence_environment_id": artifact["spec"]["id"], "coherence_worker_image": artifact["runtimeImageDigest"],
+            "coherence_result_root": str(directory(reservation) / "observations")}
+
+
+def validate_gate_mount(reservation, relay):
+    expected = translate_path_to_host(str(directory(reservation) / "coherence"))
+    mounts = [m for m in relay.attrs.get("Mounts", []) if m.get("Destination") == GATE_DIRECTORY]
+    if (len(mounts) != 1 or mounts[0].get("Source") != expected or mounts[0].get("Type") != "bind" or mounts[0].get("RW") is not False):
