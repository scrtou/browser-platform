+                relay_config["upstream_tls_ca_file"] = "/run/config/upstream-ca.pem" if material_source else "/run/secrets/upstream-ca.pem"
+        config = directory / "relay.json"
+        volumes = {}
+        coherence_allocation = {}
+        if policy.coherence:
+            from .coherence_runtime import prepare_gate
+            coherence_allocation = await asyncio.to_thread(prepare_gate, reservation, policy, relay_config, volumes)
+        await asyncio.to_thread(atomic_json, config, relay_config)
+        volumes[translate_path_to_host(str(config))] = {"bind": "/run/config/relay.json", "mode": "ro"}
+        if material_source:
