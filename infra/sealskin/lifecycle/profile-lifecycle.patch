+    return SimpleNamespace(docker=docker, policy=policy, home=home,
+                           identity=runtime.runtime_identity("qa", "qa-home", "firefox", "personal", OPERATION))
+
+
+def launch_args(managed, **overrides):
+    args = dict(application_id="firefox", username="qa", effective_settings={"persistent_storage": True},
+                home_name="qa-home", env_vars={"SEALSKIN_URL": "https://adapter.example/bootstrap/personal/" + OPERATION},
+                language=None, selected_gpu=None, wayland_mode=False, profile_id="personal", operation_id=OPERATION,
+                network_policy_id=POLICY_ID, network_policy_sha256=network.digest(managed.policy.model_dump()))
+    return {**args, **overrides}
+
+
+def stop_request(managed, **overrides):
+    return {"profile_id": "personal", "operation_id": OPERATION, "application_id": "firefox",
+            "bootstrap_url": "https://adapter.example/bootstrap/personal/" + OPERATION,
+            "network_policy_id": POLICY_ID, "network_policy_sha256": network.digest(managed.policy.model_dump()), **overrides}
+
