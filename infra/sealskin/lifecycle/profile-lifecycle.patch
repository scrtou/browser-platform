+def test_upstream_probe_codes_follow_the_relay_and_endpoint_boundary(monkeypatch):
+    policy = network_runtime.NetworkPolicy(username="qa", profile_id="p", home_name="h", application_id="a",
+                                           relay_image="sha256:" + "c" * 64, probe_image="sha256:" + "d" * 64,
