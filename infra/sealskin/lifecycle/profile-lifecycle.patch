new file mode 100644
index 0000000..d2c7f0c
--- /dev/null
+++ b/server/app/network_probe.py
@@ -0,0 +1,90 @@
+"""One-shot readiness evidence, executed in the future Worker's internal network."""
+
+import json
+import socket
+import ssl
+import struct
+import sys
+import time
+from urllib.parse import urlsplit
+
+
+def exact(connection, size):
+    """Read a complete SOCKS5 or HTTP field."""
+    data = b""
+    while len(data) < size:
+        chunk = connection.recv(size - len(data))
+        if not chunk:
+            raise OSError("incomplete reply")
+        data += chunk
+    return data
+
+
+def blocked(family, address):
+    """Return whether one numerical direct TCP destination is unreachable."""
+    with socket.socket(family, socket.SOCK_STREAM) as connection:
+        connection.settimeout(1)
+        return connection.connect_ex(address) != 0
+
+
+def main():
+    """Emit bounded readiness evidence without credentials or response content."""
+    relay, url, timeout, ca_file = sys.argv[1:]
+    timeout = int(timeout)
+    parsed = urlsplit(url)
+    host, port = parsed.hostname, parsed.port or 443
+    # Reaching either numerical address directly is a failed startup gate.
+    ipv4 = blocked(socket.AF_INET, ("1.1.1.1", 443))
+    ipv6 = blocked(socket.AF_INET6, ("2606:4700:4700::1111", 443, 0, 0))
+    try:
+        socket.getaddrinfo(host, port)
+        dns_blocked = False
+    except socket.gaierror:
+        dns_blocked = True
+    connection = None
+    for attempt in range(2):
+        try:
+            connection = socket.create_connection((relay, 1080), timeout=timeout)
+            break
+        except OSError:
+            if attempt:
+                raise
+            time.sleep(0.3)
+    with connection:
+        connection.sendall(b"\x05\x01\x00")
+        if exact(connection, 2) != b"\x05\x00":
+            raise OSError("relay handshake rejected")
+        domain = host.encode("idna")
+        connection.sendall(b"\x05\x01\x00\x03" + bytes([len(domain)]) + domain + struct.pack("!H", port))
+        header = exact(connection, 4)
+        if header[:3] != b"\x05\x00\x00":
+            raise OSError("upstream connection rejected")
+        size = {1: 4, 4: 16}.get(header[3])
+        if header[3] == 3:
+            size = exact(connection, 1)[0]
+        if size is None:
+            raise OSError("invalid bound address")
+        exact(connection, size + 2)
+        context = ssl.create_default_context(cafile=ca_file or None)
+        with context.wrap_socket(connection, server_hostname=host) as secure:
+            target = (parsed.path or "/") + ("?" + parsed.query if parsed.query else "")
+            authority = host if port == 443 else f"{host}:{port}"
+            secure.sendall(f"GET {target} HTTP/1.1\r\nHost: {authority}\r\nUser-Agent: browser-platform-network-probe/1\r\nConnection: close\r\n\r\n".encode("ascii"))
+            response = b""
+            while b"\r\n" not in response and len(response) < 4096:
+                response += exact(secure, 1)
+            parts = response.split(b" ", 2)
+            tls_ok = len(parts) >= 2 and parts[1] == b"200"
+    evidence = {"proxy_tls": tls_ok, "direct_ipv4_blocked": ipv4,
+                "direct_ipv6_blocked": ipv6, "local_dns_blocked": dns_blocked}
+    print(json.dumps(evidence), flush=True)
+    return 0 if all(evidence.values()) else 1
+
+
+if __name__ == "__main__":
+    try:
+        code = main()
+    except Exception:
+        print(json.dumps({"error_code": "NETWORK_PROBE_FAILED"}), flush=True)
+        code = 1
+    sys.exit(code)
diff --git a/server/app/network_runtime.py b/server/app/network_runtime.py
new file mode 100644
index 0000000..eeafe3e
--- /dev/null
+++ b/server/app/network_runtime.py
@@ -0,0 +1,779 @@
+"""Generation-bound Relay and Docker networks, owned exclusively by SealSkin.
+
+Every allocation starts with a durable reservation. Failed or interrupted
+allocations keep that reservation until Worker removal and resource cleanup
+have both been verified. Administrative policies contain immutable references;
+ordinary launch requests cannot supply images, credentials, or probe targets.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import ipaddress
+import json
+import logging
+import os
+import re
+import socket
+import stat
+import tempfile
+import time
+from pathlib import Path
+from typing import Any
+from urllib.parse import urlsplit
+
+from docker.errors import NotFound
+from fastapi import HTTPException
+from pydantic import BaseModel, ConfigDict, Field, ValidationError
+
+from .docker_utils import get_docker_client, translate_path_to_host
+from .settings import settings
+
+PREFIX = "io.browser-platform."
+NAME = r"^[A-Za-z0-9_-]{1,128}$"
+SHA = r"^[a-f0-9]{64}$"
+KINDS = {"internal", "egress", "relay", "guard", "probe"}
+logger = logging.getLogger(__name__)
+
+
+class NetworkPolicy(BaseModel):
+    """One operator-approved, immutable SOCKS5 policy revision."""
+
+    model_config = ConfigDict(extra="forbid", strict=True)
+    username: str = Field(pattern=NAME)
+    profile_id: str = Field(pattern=NAME)
+    home_name: str = Field(pattern=NAME)
+    application_id: str = Field(min_length=1, max_length=256)
+    relay_image: str = Field(pattern=r"^sha256:[a-f0-9]{64}$")
+    probe_image: str = Field(pattern=r"^sha256:[a-f0-9]{64}$")
+    upstream_host: str = Field(min_length=1, max_length=253)
+    upstream_port: int = Field(ge=1, le=65535)
+    username_file: str = ""
+    username_sha256: str = ""
+    password_file: str = ""
+    password_sha256: str = ""
+    probe_url: str = Field(min_length=1, max_length=2048)
+    probe_ca_file: str = ""
+    probe_ca_sha256: str = ""
+    probe_timeout_seconds: int = Field(default=10, ge=1, le=20)
+
+
+def base_dir() -> Path:
+    """Use SealSkin's persistent metadata directory, outside browser Homes."""
+    return Path(settings.sessions_db_path).parent
+
+
+def policy_path() -> Path:
+    """Locate the operator-owned policy registry."""
+    return base_dir() / "profile-network-policies.json"
+
+
+def runtime_dir() -> Path:
+    """Locate durable reservations and generated Relay configuration."""
+    return base_dir() / "profile-network-runtime"
+
+
+def digest(value: Any) -> str:
+    """Hash a canonical JSON representation with all policy defaults resolved."""
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def reject(code: str, status_code: int = 409):
+    """Return a stable diagnostic without paths, credentials or Docker bodies."""
+    raise HTTPException(status_code, code)
+
+
+def unique_json(pairs):
+    """Reject ambiguous duplicate metadata fields."""
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError("Duplicate JSON key")
+        value[key] = item
+    return value
+
+
+def read_json(path: Path):
+    """Read bounded, private, regular metadata files."""
+    if path.is_symlink() or not stat.S_ISREG(path.stat().st_mode) or path.stat().st_mode & 0o077:
+        reject("NETWORK_METADATA_PERMISSIONS", 503)
+    raw = path.read_bytes()
+    if len(raw) > 1024 * 1024:
+        reject("NETWORK_METADATA_TOO_LARGE", 503)
+    return json.loads(raw, object_pairs_hook=unique_json)
+
+
+def secret_source(path: str, expected: str) -> str:
+    """Check a fixed file revision, without copying it to Worker storage."""
+    source = Path(path)
+    root = base_dir() / "network-secrets"
+    if (not re.fullmatch(SHA, expected) or not source.is_absolute() or source.is_symlink() or root.is_symlink() or
+            source.parent != root or source.name in {".", ".."}):
+        reject("NETWORK_SECRET_REFERENCE_INVALID", 422)
+    try:
+        info = source.stat()
+        if (not stat.S_ISDIR(root.stat().st_mode) or root.stat().st_mode & 0o077 or
+                not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_nlink != 1):
+            reject("NETWORK_SECRET_PERMISSIONS", 422)
+        if hashlib.sha256(source.read_bytes()).hexdigest() != expected:
+            reject("NETWORK_SECRET_REVISION_MISMATCH", 422)
+    except OSError as exc:
+        raise HTTPException(503, "NETWORK_SECRET_UNAVAILABLE") from exc
+    return translate_path_to_host(str(source))
+
+
+def policies() -> dict[str, NetworkPolicy]:
+    """Validate the complete registry; malformed metadata fails closed."""
+    if not policy_path().exists():
+        return {}
+    try:
+        raw = read_json(policy_path())
+        if set(raw) != {"version", "policies"} or raw["version"] != 1 or not isinstance(raw["policies"], dict):
+            reject("NETWORK_POLICY_REGISTRY_INVALID", 503)
+        result = {}
+        for key, value in raw["policies"].items():
+            if not re.fullmatch(NAME, key):
+                reject("NETWORK_POLICY_ID_INVALID", 503)
+            result[key] = NetworkPolicy(**value)
+        return result
+    except (OSError, ValueError, ValidationError, TypeError) as exc:
+        raise HTTPException(503, "NETWORK_POLICY_REGISTRY_INVALID") from exc
+
+
+def policy_for_launch(params: dict[str, Any], app=None) -> tuple[str, NetworkPolicy] | None:
+    """Protect configured applications even if a caller omits the policy ref."""
+    registry = policies()
+    policy_id = params.get("network_policy_id")
+    revision = params.get("network_policy_sha256")
+    config = getattr(app, "provider_config", None)
+    required_id = getattr(config, "network_policy_id", "")
+    required_sha = getattr(config, "network_policy_sha256", "")
+    protected = any(p.username == params["username"] and p.application_id == params["application_id"]
+                    for p in registry.values())
+    if not policy_id and not revision and not protected and not required_id and not required_sha:
+        return None
+    if not required_id or not required_sha or (policy_id, revision) != (required_id, required_sha):
+        reject("NETWORK_POLICY_APPLICATION_REF_MISMATCH", 422)
+    policy = registry.get(policy_id or "")
+    if not policy or not revision or digest(policy.model_dump()) != revision:
+        reject("NETWORK_POLICY_REFERENCE_MISMATCH", 422)
+    expected = (policy.username, policy.profile_id, policy.home_name, policy.application_id)
+    actual = tuple(params.get(key) for key in ("username", "profile_id", "home_name", "application_id"))
+    if actual != expected or not re.fullmatch(r"[a-f0-9]{32}", params.get("operation_id") or ""):
+        reject("NETWORK_POLICY_OWNERSHIP_MISMATCH", 422)
+    if params.get("launch_in_room_mode") or params.get("forced_rw_mount"):
+        reject("NETWORK_POLICY_REQUIRES_EXCLUSIVE_HOME", 422)
+    parsed = urlsplit(policy.probe_url)
+    try:
+        valid_port = parsed.port is None or 1 <= parsed.port <= 65535
+    except ValueError:
+        valid_port = False
+    if (parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.fragment or
+            not valid_port or not policy.probe_url.isascii() or
+            any(ord(c) <= 32 or ord(c) == 127 for c in policy.probe_url) or
+            not re.fullmatch(r"[A-Za-z0-9.-]+", parsed.hostname)):
+        reject("NETWORK_PROBE_TARGET_INVALID", 422)
+    if (not re.fullmatch(r"[A-Za-z0-9.:-]+", policy.upstream_host) or
+            bool(policy.username_file) != bool(policy.password_file)):
+        reject("NETWORK_UPSTREAM_INVALID", 422)
+    for kind in ("username", "password", "probe_ca"):
+        path, expected_sha = getattr(policy, kind + "_file"), getattr(policy, kind + "_sha256")
+        if path or expected_sha:
+            secret_source(path, expected_sha)
+    return policy_id, policy
+
+
+def reservation_path(identity: dict[str, str]) -> Path:
+    """Map one exact host Home source to its reservation file."""
+    return runtime_dir() / (identity["home_hash"] + ".json")
+
+
+def read_reservation(identity: dict[str, str]) -> dict[str, Any] | None:
+    """Verify the journal's identity and policy snapshot before using it."""
+    path = reservation_path(identity)
+    if not path.exists():
+        return None
+    try:
+        value = read_json(path)
+        if (value.get("version") != 1 or value.get("identity", {}).get("home_hash") != identity["home_hash"] or
+                any(value["identity"].get(k) != identity[k] for k in ("scope", "owner", "home", "home_source")) or
+                value.get("phase") not in {"preparing", "ready", "worker_starting", "running", "stopping"} or
+                not re.fullmatch(NAME, value.get("policy_id", "")) or
+                not re.fullmatch(SHA, value.get("policy_sha256", "")) or
+                not re.fullmatch(SHA, value.get("controller_id", "")) or
+                not re.fullmatch(r"[a-f0-9]{32}", value["identity"].get("operation", ""))):
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        policy = NetworkPolicy(**value["policy"])
+        if (digest(policy.model_dump()) != value["policy_sha256"] or
+                (policy.username, policy.profile_id, policy.home_name, policy.application_id) !=
+                tuple(value["identity"].get(k) for k in ("owner", "profile", "home", "app"))):
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        allocation = value.get("allocation")
+        if allocation and (any(not re.fullmatch(SHA, allocation.get(k, "")) for k in ("internal_id", "egress_id", "relay_id")) or
+                           allocation.get("internal_name") != resource_name(value["identity"], "internal") or
+                           allocation.get("policy_id") != value["policy_id"] or
+                           allocation.get("policy_sha256") != value["policy_sha256"]):
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        if allocation and allocation.get("enforcement_version") == 1:
+            if (not re.fullmatch(SHA, allocation.get("guard_id", "")) or
+                    not re.fullmatch(SHA, allocation.get("guard_config_sha256", ""))):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+            for key in ("guard_ip", "controller_ip", "relay_ip"):
+                if ipaddress.ip_address(allocation[key]).version != 4:
+                    reject("NETWORK_RESERVATION_INVALID", 503)
+        return value
+    except (OSError, ValueError, TypeError, KeyError) as exc:
+        raise HTTPException(503, "NETWORK_RESERVATION_INVALID") from exc
+
+
+def atomic_json(path: Path, value, exclusive=False) -> None:
+    """Durably write private JSON, optionally refusing an existing reservation."""
+    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    if path.parent.is_symlink() or path.parent.stat().st_mode & 0o077:
+        reject("NETWORK_METADATA_PERMISSIONS", 503)
+    fd, temporary = tempfile.mkstemp(prefix=".network-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w") as handle:
+            os.fchmod(handle.fileno(), 0o600)
+            json.dump(value, handle, sort_keys=True)
+            handle.flush()
+            os.fsync(handle.fileno())
+        if exclusive:
+            try:
+                os.link(temporary, path)
+            except FileExistsError as exc:
+                raise HTTPException(409, "NETWORK_HOME_RESERVED") from exc
+        else:
+            os.replace(temporary, path)
+        sync_directory(path.parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def save_reservation(value: dict[str, Any], exclusive=False) -> None:
+    """Commit reservation state before the next external side effect."""
+    atomic_json(reservation_path(value["identity"]), value, exclusive)
+
+
+def sync_directory(path: Path):
+    """Make metadata renames and removals durable."""
+    fd = os.open(path, os.O_DIRECTORY | os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def resource_name(identity: dict[str, str], kind: str) -> str:
+    """Make interrupted creates discoverable without a successful API reply."""
+    key = {k: identity[k] for k in ("scope", "owner", "home_hash", "operation")}
+    return "bp-" + kind + "-" + digest(key)[:40]
+
+
+def resource_labels(reservation: dict[str, Any], kind: str) -> dict[str, str]:
+    """Attach immutable generation and policy ownership to Docker resources."""
+    labels = {PREFIX + key: value for key, value in reservation["identity"].items() if key != "home_source"}
+    labels.update({PREFIX + "network-version": "1", PREFIX + "role": kind,
+                   PREFIX + "network-policy": reservation["policy_id"],
+                   PREFIX + "network-policy-sha256": reservation["policy_sha256"]})
+    return labels
+
+
+def resource_summary(identifier, kind, labels, identity, status, recorded=False):
+    """Project Docker metadata to the non-secret runtime protocol."""
+    owned = (labels.get(PREFIX + "network-version") == "1" and
+             all(labels.get(PREFIX + key) == identity[key] for key in ("scope", "owner", "home", "home_hash")) and
+             labels.get(PREFIX + "role") == kind and
+             bool(re.fullmatch(NAME, labels.get(PREFIX + "profile", ""))) and
+             bool(re.fullmatch(r"[a-f0-9]{32}", labels.get(PREFIX + "operation", ""))) and
+             bool(re.fullmatch(NAME, labels.get(PREFIX + "network-policy", ""))) and
+             bool(re.fullmatch(SHA, labels.get(PREFIX + "network-policy-sha256", ""))))
+    return {"id": identifier, "kind": kind, "owned": owned, "recorded": recorded, "status": status,
+            "profile_id": labels.get(PREFIX + "profile", ""), "operation_id": labels.get(PREFIX + "operation", ""),
+            "app_id": labels.get(PREFIX + "app", ""), "policy_id": labels.get(PREFIX + "network-policy", ""),
+            "policy_sha256": labels.get(PREFIX + "network-policy-sha256", "")}
+
+
+async def inventory(identity: dict[str, str], containers=None) -> list[dict[str, Any]]:
+    """Include reservations, exited containers and both networks; never guess absence."""
+    reservation = read_reservation(identity)
+    try:
+        client = await asyncio.to_thread(get_docker_client)
+        if containers is None:
+            containers = await asyncio.to_thread(client.containers.list, all=True, ignore_removed=True)
+        networks = await asyncio.to_thread(client.networks.list)
+    except Exception as exc:
+        raise HTTPException(503, "NETWORK_INVENTORY_UNAVAILABLE") from exc
+    expected = {resource_name(reservation["identity"], k): k for k in KINDS} if reservation else {}
+    result = []
+    if reservation:
+        result.append(resource_summary(identity["home_hash"], "reservation", {
+            **resource_labels(reservation, "reservation")}, identity, reservation["phase"], True))
+    for obj in [*networks, *containers]:
+        attrs = obj.attrs
+        is_container = "Config" in attrs
+        labels = (attrs.get("Config", {}).get("Labels") if is_container else attrs.get("Labels")) or {}
+        name = attrs.get("Name", getattr(obj, "name", "")).lstrip("/")
+        related = all(labels.get(PREFIX + k) == identity[k] for k in ("scope", "owner", "home_hash"))
+        kind = expected.get(name) or labels.get(PREFIX + "role")
+        if kind not in KINDS or (not related and name not in expected):
+            continue
+        state = attrs.get("State", {}).get("Status", "unknown") if is_container else "present"
+        summary = resource_summary(obj.id, kind, labels, identity, state, name in expected)
+        if kind in {"internal", "egress"} and (is_container or attrs.get("Driver") != "bridge" or
+                bool(attrs.get("Internal")) != (kind == "internal") or attrs.get("EnableIPv6")):
+            summary["owned"] = False
+        if kind in {"relay", "guard", "probe"} and not is_container:
+            summary["owned"] = False
+        result.append(summary)
+    return result
+
+
+def validate_resources(resources, request) -> None:
+    """Validate every resource before permitting any generation cleanup."""
+    for item in resources:
+        if (not item["owned"] or item["profile_id"] != request.profile_id or
+                item["operation_id"] != request.operation_id or item["app_id"] != request.application_id or
+                item["policy_id"] != request.network_policy_id or
+                item["policy_sha256"] != request.network_policy_sha256):
+            reject("NETWORK_RESOURCE_OWNERSHIP_UNPROVEN")
+
+
+async def set_phase(identity, phase):
+    """Persist an existing allocation's phase without changing its owner."""
+    reservation = read_reservation(identity)
+    if reservation:
+        if any(reservation["identity"][k] != identity[k] for k in ("operation", "profile", "app")):
+            reject("NETWORK_GENERATION_CHANGED")
+        reservation["phase"] = phase
+        await asyncio.to_thread(save_reservation, reservation)
+
+
+def self_container(client):
+    """Self lookup must never choose another deployment by partial name."""
+    container = client.containers.get(os.uname()[1])
+    config_source = os.path.normpath(translate_path_to_host(str(base_dir())))
+    mounts = container.attrs.get("Mounts", [])
+    if not any(config_source == m.get("Source") or config_source.startswith(m.get("Source", "") + "/") for m in mounts if m.get("Source")):
+        reject("NETWORK_CONTROL_OWNER_UNPROVEN", 503)
+    return container
+
+
+async def get_or_create_network(client, reservation, kind):
+    """Create only an exact generation network, refusing name collisions."""
+    name = resource_name(reservation["identity"], kind)
+    labels = resource_labels(reservation, kind)
+    try:
+        network = await asyncio.to_thread(client.networks.get, name)
+    except NotFound:
+        network = await asyncio.to_thread(client.networks.create, name, driver="bridge", internal=kind == "internal",
+                                         enable_ipv6=False, check_duplicate=True, labels=labels)
+    await asyncio.to_thread(network.reload)
+    if (network.attrs.get("Labels") != labels or network.attrs.get("Driver") != "bridge" or
+            bool(network.attrs.get("Internal")) != (kind == "internal") or network.attrs.get("EnableIPv6")):
+        reject("NETWORK_NAME_COLLISION")
+    return network
+
+
+def resolve_upstream(policy):
+    """Resolve the operator endpoint once, outside every Worker namespace.
+
+    The selected numeric address is frozen for this generation. The Relay has
+    no DNS access and cannot silently follow a changed hostname while active.
+    Website names remain SOCKS5 domain requests resolved by the upstream proxy.
+    """
+    values = socket.getaddrinfo(policy.upstream_host, policy.upstream_port,
+                               family=socket.AF_INET, type=socket.SOCK_STREAM)
+    addresses = list(dict.fromkeys(item[4][0] for item in values))
+    if not addresses or any(ipaddress.ip_address(value).is_loopback or
+                            ipaddress.ip_address(value).is_unspecified or
+                            ipaddress.ip_address(value).is_multicast for value in addresses):
+        reject("NETWORK_UPSTREAM_ADDRESS_INVALID", 422)
+    return addresses
+
+
+async def wait_guard(guard, expected):
+    """Do not share this namespace until initialization and privilege drop pass."""
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        await asyncio.to_thread(guard.reload)
+        if guard.status != "running":
+            reject("NETWORK_GUARD_NOT_READY", 503)
+        raw = await asyncio.to_thread(guard.logs, stdout=True, stderr=False, tail=1)
+        try:
+            if json.loads(raw) == {"network_guard_ready": expected}:
+                return
+        except (ValueError, TypeError):
+            pass
+        await asyncio.sleep(0.1)
+    reject("NETWORK_GUARD_NOT_READY", 503)
+
+
+async def prepare(identity: dict[str, str], policy_id: str, policy: NetworkPolicy, display_port=3000) -> dict[str, Any]:
+    """Reserve first, construct isolated resources, then probe from the Worker network."""
+    if read_reservation(identity) or await inventory(identity):
+        reject("NETWORK_HOME_RESERVED")
+    client = await asyncio.to_thread(get_docker_client)
+    try:
+        image = await asyncio.to_thread(client.images.get, policy.relay_image)
+        await asyncio.to_thread(client.images.get, policy.probe_image)
+    except NotFound as exc:
+        raise HTTPException(422, "NETWORK_IMAGE_UNAVAILABLE") from exc
+    if (image.attrs.get("Config", {}).get("Labels") or {}).get(PREFIX + "network-guard") != "1":
+        reject("NETWORK_ENFORCEMENT_IMAGE_REQUIRED", 422)
+    if type(display_port) is not int or not 1 <= display_port <= 65535:
+        reject("NETWORK_DISPLAY_PORT_INVALID", 422)
+    controller = await asyncio.to_thread(self_container, client)
+    reservation = {"version": 1, "identity": identity, "policy_id": policy_id,
+                   "policy_sha256": digest(policy.model_dump()), "policy": policy.model_dump(),
+                   "phase": "preparing", "controller_id": controller.id}
+    await asyncio.to_thread(save_reservation, reservation, True)
+    try:
+        addresses = await asyncio.to_thread(resolve_upstream, policy)
+        reservation["upstream_ipv4"] = addresses
+        await asyncio.to_thread(save_reservation, reservation)
+        internal = await get_or_create_network(client, reservation, "internal")
+        egress = await get_or_create_network(client, reservation, "egress")
+        subnet = internal.attrs["IPAM"]["Config"][0]["Subnet"]
+        subnet_value = ipaddress.ip_network(subnet)
+        if subnet_value.version != 4 or not 16 <= subnet_value.prefixlen <= 29:
+            reject("NETWORK_IPV4_REQUIRED", 503)
+        # Each generation owns an empty bridge. Explicit addresses keep Relay
+        # restarts and controller replacement consistent with the frozen ACL.
+        relay_address, controller_address, guard_address = (
+            str(subnet_value.network_address + offset) for offset in (2, 3, 4)
+        )
+        directory = runtime_dir() / (identity["home_hash"] + "-" + identity["operation"])
+        directory.mkdir(mode=0o700, exist_ok=True)
+        relay_config = {"listen_address": "0.0.0.0:1080", "upstream_host": addresses[0],
+                        "upstream_port": policy.upstream_port, "client_cidrs": [subnet],
+                        "dial_timeout_seconds": policy.probe_timeout_seconds, "idle_timeout_seconds": 300,
+                        "username_file": "/run/secrets/username" if policy.username_file else "",
+                        "password_file": "/run/secrets/password" if policy.password_file else ""}
+        config = directory / "relay.json"
+        await asyncio.to_thread(atomic_json, config, relay_config)
+        volumes = {translate_path_to_host(str(config)): {"bind": "/run/config/relay.json", "mode": "ro"}}
+        relay_network = {"version": 1, "role": "relay", "uid": settings.puid, "gid": settings.pgid,
+                         "internal_cidr": subnet, "upstream_ip": addresses[0], "upstream_port": policy.upstream_port}
+        relay_network_path = directory / "relay-network.json"
+        await asyncio.to_thread(atomic_json, relay_network_path, relay_network)
+        volumes[translate_path_to_host(str(relay_network_path))] = {"bind": "/run/config/network.json", "mode": "ro"}
+        for kind in ("username", "password"):
+            if getattr(policy, kind + "_file"):
+                source = secret_source(getattr(policy, kind + "_file"), getattr(policy, kind + "_sha256"))
+                volumes[source] = {"bind": "/run/secrets/" + kind, "mode": "ro"}
+        relay = await asyncio.to_thread(client.containers.create, image=policy.relay_image,
+                                       name=resource_name(identity, "relay"),
+                                       command=["--network-config", "/run/config/network.json", "--relay-config", "/run/config/relay.json"],
+                                       labels=resource_labels(reservation, "relay"), network=internal.name,
+                                       networking_config={internal.name: client.api.create_endpoint_config(
+                                           aliases=["profile-relay"], ipv4_address=relay_address)},
+                                       volumes=volumes, user="0:0", read_only=True,
+                                       cap_drop=["ALL"], cap_add=["NET_ADMIN", "SETUID", "SETGID", "SETPCAP", "DAC_READ_SEARCH"],
+                                       security_opt=["no-new-privileges:true"], dns=["127.0.0.1"],
+                                       mem_limit="64m", nano_cpus=500000000, pids_limit=64, restart_policy={"Name": "no"})
+        await asyncio.to_thread(egress.connect, relay)
+        await asyncio.to_thread(relay.start)
+        await asyncio.to_thread(relay.reload)
+        relay_ip = relay.attrs["NetworkSettings"]["Networks"][internal.name]["IPAddress"]
+        if relay_ip != relay_address:
+            reject("NETWORK_RELAY_ADDRESS_UNKNOWN", 503)
+        await asyncio.to_thread(internal.connect, controller, ipv4_address=controller_address)
+        await asyncio.to_thread(controller.reload)
+        controller_ip = controller.attrs["NetworkSettings"]["Networks"][internal.name]["IPAddress"]
+        if controller_ip != controller_address:
+            reject("NETWORK_CONTROL_ADDRESS_UNKNOWN", 503)
+        guard_config = {"version": 1, "role": "worker", "uid": settings.puid, "gid": settings.pgid,
+                        "internal_cidr": subnet, "relay_ip": relay_ip, "controller_ip": controller_ip,
+                        "display_port": display_port}
+        guard_path = directory / "worker-network.json"
+        await asyncio.to_thread(atomic_json, guard_path, guard_config)
+        guard = await asyncio.to_thread(client.containers.create, image=policy.relay_image,
+                                       name=resource_name(identity, "guard"),
+                                       command=["--network-config", "/run/config/network.json"],
+                                       labels=resource_labels(reservation, "guard"), network=internal.name,
+                                       networking_config={internal.name: client.api.create_endpoint_config(ipv4_address=guard_address)},
+                                       volumes={translate_path_to_host(str(guard_path)): {"bind": "/run/config/network.json", "mode": "ro"}},
+                                       user="0:0", read_only=True, cap_drop=["ALL"],
+                                       cap_add=["NET_ADMIN", "SETUID", "SETGID", "SETPCAP", "DAC_READ_SEARCH"],
+                                       security_opt=["no-new-privileges:true"], dns=["127.0.0.1"],
+                                       dns_opt=["timeout:1", "attempts:1"], extra_hosts={"profile-relay": relay_ip},
+                                       mem_limit="64m", nano_cpus=500000000, pids_limit=32, restart_policy={"Name": "no"})
+        await asyncio.to_thread(guard.start)
+        await wait_guard(guard, digest(guard_config))
+        guard_ip = guard.attrs["NetworkSettings"]["Networks"][internal.name]["IPAddress"]
+        if guard_ip != guard_address:
+            reject("NETWORK_GUARD_ADDRESS_UNKNOWN", 503)
+        allocation = {"internal_id": internal.id, "internal_name": internal.name, "egress_id": egress.id,
+                      "relay_id": relay.id, "relay_ip": relay_ip, "policy_id": policy_id,
+                      "policy_sha256": reservation["policy_sha256"], "enforcement_version": 1,
+                      "guard_id": guard.id, "guard_ip": guard_ip, "controller_ip": controller_ip,
+                      "guard_config_sha256": digest(guard_config)}
+        reservation["allocation"] = allocation
+        await asyncio.to_thread(save_reservation, reservation)
+        await run_probe(client, reservation, policy, allocation)
+        reservation["phase"], reservation["ready_at"] = "ready", time.time()
+        await asyncio.to_thread(save_reservation, reservation)
+        return allocation
+    except HTTPException:
+        raise
+    except Exception as exc:
+        raise HTTPException(503, "NETWORK_PREPARE_INCOMPLETE; reservation retained") from exc
+
+
+async def restore_controller_attachment(identity):
+    """Reconnect only a fully verified live generation, without touching Workers.
+
+    The frozen guard admits display requests from one controller address. A new
+    controller may reclaim that address only after the former controller stops.
+    Partial, legacy and stopped generations retain their journal for reconcile.
+    """
+    from .profile_runtime import StopProfileRequest, inspect_home, validate_stop_inventory
+
+    reservation = read_reservation(identity)
+    allocation = reservation.get("allocation") if reservation else None
+    if (not allocation or allocation.get("enforcement_version") != 1 or
+            reservation["phase"] not in {"ready", "worker_starting", "running"}):
+        return "retained"
+    snapshot = await inspect_home(identity["owner"], identity["home"])
+    request = StopProfileRequest(profile_id=identity["profile"], operation_id=identity["operation"],
+                                 application_id=identity["app"], bootstrap_url="network-controller-recovery",
+                                 network_policy_id=reservation["policy_id"],
+                                 network_policy_sha256=reservation["policy_sha256"])
+    validate_stop_inventory(snapshot, request)
+    if not snapshot["workers"]:
+        return "retained"
+    if len(snapshot["workers"]) != 1 or snapshot["workers"][0]["status"] != "running":
+        reject("NETWORK_RECOVERY_WORKER_NOT_RUNNING")
+    expected = {"reservation": identity["home_hash"], **{
+        kind: allocation[kind + "_id"] for kind in ("internal", "egress", "relay", "guard")
+    }}
+    if (len(snapshot["resources"]) != len(expected) or
+            any(expected.get(item["kind"]) != item["id"] for item in snapshot["resources"])):
+        reject("NETWORK_RECOVERY_RESOURCES_INCOMPLETE")
+    client = await asyncio.to_thread(get_docker_client)
+    controller = await asyncio.to_thread(self_container, client)
+    previous = None
+    if reservation["controller_id"] != controller.id:
+        try:
+            previous = await asyncio.to_thread(client.containers.get, reservation["controller_id"])
+        except NotFound:
+            pass
+        if previous and previous.status not in {"exited", "dead"}:
+            reject("NETWORK_PREVIOUS_CONTROLLER_PRESENT")
+    internal = await asyncio.to_thread(client.networks.get, allocation["internal_id"])
+    egress = await asyncio.to_thread(client.networks.get, allocation["egress_id"])
+    guard = await asyncio.to_thread(client.containers.get, allocation["guard_id"])
+    relay = await asyncio.to_thread(client.containers.get, allocation["relay_id"])
+    worker = await asyncio.to_thread(client.containers.get, snapshot["workers"][0]["instance_id"])
+    for kind, resource in (("internal", internal), ("egress", egress), ("relay", relay), ("guard", guard)):
+        labels = resource.attrs.get("Config", {}).get("Labels") if kind in {"relay", "guard"} else resource.attrs.get("Labels")
+        if (any((labels or {}).get(key) != value for key, value in resource_labels(reservation, kind).items()) or
+                resource.name != resource_name(identity, kind)):
+            reject("NETWORK_RESOURCE_OWNERSHIP_UNPROVEN")
+    if worker.attrs.get("HostConfig", {}).get("NetworkMode") != "container:" + guard.id:
+        reject("NETWORK_RECOVERY_NAMESPACE_CHANGED")
+    if guard.status != "running":
+        reject("NETWORK_GUARD_NOT_READY", 503)
+    guard_networks = guard.attrs.get("NetworkSettings", {}).get("Networks", {})
+    relay_networks = relay.attrs.get("NetworkSettings", {}).get("Networks", {})
+    if (set(guard_networks) != {internal.name} or
+            guard_networks[internal.name].get("IPAddress") != allocation["guard_ip"] or
+            set(relay_networks) != {internal.name, egress.name} or
+            relay.status == "running" and relay_networks[internal.name].get("IPAddress") != allocation["relay_ip"]):
+        reject("NETWORK_RECOVERY_TOPOLOGY_CHANGED")
+    guard_path = runtime_dir() / (identity["home_hash"] + "-" + identity["operation"]) / "worker-network.json"
+    guard_config = read_json(guard_path)
+    if (digest(guard_config) != allocation["guard_config_sha256"] or
+            guard_config.get("controller_ip") != allocation["controller_ip"] or
+            guard_config.get("relay_ip") != allocation["relay_ip"] or
+            guard_config.get("internal_cidr") != internal.attrs["IPAM"]["Config"][0]["Subnet"] or
+            not any(m.get("Source") == translate_path_to_host(str(guard_path)) and
+                    m.get("Destination") == "/run/config/network.json" for m in guard.attrs.get("Mounts", []))):
+        reject("NETWORK_RECOVERY_GUARD_CHANGED")
+    allowed = {guard.id, relay.id, controller.id, reservation["controller_id"]}
+    if (set(internal.attrs.get("Containers", {})) - allowed or
+            set(egress.attrs.get("Containers", {})) - {relay.id}):
+        reject("NETWORK_HAS_FOREIGN_ENDPOINTS")
+    for identifier, endpoint in internal.attrs.get("Containers", {}).items():
+        if (endpoint.get("IPv4Address", "").split("/")[0] == allocation["controller_ip"] and
+                identifier not in {controller.id, reservation["controller_id"]}):
+            reject("NETWORK_CONTROL_ADDRESS_OCCUPIED")
+    attached = controller.attrs.get("NetworkSettings", {}).get("Networks", {}).get(internal.name)
+    if attached and attached.get("IPAddress") != allocation["controller_ip"]:
+        reject("NETWORK_CONTROL_ADDRESS_CHANGED")
+    # All ownership, topology and ACL checks precede the first mutation.
+    if previous and internal.name in previous.attrs.get("NetworkSettings", {}).get("Networks", {}):
+        await asyncio.to_thread(internal.disconnect, previous)
+    if not attached:
+        try:
+            await asyncio.to_thread(internal.connect, controller, ipv4_address=allocation["controller_ip"])
+        except Exception:
+            # A lost connect reply can still have attached the exact endpoint.
+            await asyncio.to_thread(controller.reload)
+            attached = controller.attrs.get("NetworkSettings", {}).get("Networks", {}).get(internal.name, {})
+            if attached.get("IPAddress") != allocation["controller_ip"]:
+                raise
+    await asyncio.to_thread(controller.reload)
+    await asyncio.to_thread(internal.reload)
+    endpoint = internal.attrs.get("Containers", {}).get(controller.id, {})
+    attached = controller.attrs.get("NetworkSettings", {}).get("Networks", {}).get(internal.name, {})
+    if (attached.get("IPAddress") != allocation["controller_ip"] or
+            endpoint.get("IPv4Address", "").split("/")[0] != allocation["controller_ip"]):
+        reject("NETWORK_CONTROL_ATTACHMENT_UNCONFIRMED", 503)
+    reservation["controller_id"] = controller.id
+    await asyncio.to_thread(save_reservation, reservation)
+    return "attached"
+
+
+async def restore_controller_networks():
+    """Isolate each startup recovery failure; never discard a reservation."""
+    from .profile_runtime import home_path, lifecycle_lock, runtime_identity
+
+    root = runtime_dir()
+    if not root.exists():
+        return []
+    results = []
+    try:
+        if root.is_symlink() or root.stat().st_mode & 0o077:
+            reject("NETWORK_METADATA_PERMISSIONS", 503)
+        paths = sorted(root.glob("*.json"))
+    except Exception as exc:
+        logger.error("Network controller recovery could not read its journal (%s).", type(exc).__name__)
+        return [{"result": "failed", "reason": "NETWORK_METADATA_UNAVAILABLE"}]
+    for path in paths:
+        try:
+            if not re.fullmatch(SHA, path.stem):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+            stored = read_json(path)["identity"]
+            if any(not isinstance(stored.get(k), str) or not re.fullmatch(NAME, stored[k]) for k in ("owner", "home", "profile")):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+            identity = runtime_identity(stored["owner"], stored["home"], stored["app"], stored["profile"], stored["operation"])
+            if identity != stored or path != reservation_path(identity):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+            async with lifecycle_lock("home:" + home_path(identity["owner"], identity["home"])):
+                result = await restore_controller_attachment(identity)
+            results.append({"home_hash": path.stem, "result": result})
+        except Exception as exc:
+            reason = exc.detail if isinstance(exc, HTTPException) and str(exc.detail).startswith("NETWORK_") else type(exc).__name__
+            logger.warning("Network controller recovery retained one journal (%s).", reason)
+            results.append({"home_hash": path.stem, "result": "failed", "reason": reason})
+    return results
+
+
+async def run_probe(client, reservation, policy, allocation):
+    """Require verified TLS through Relay and blocked direct paths before launch."""
+    from .providers.docker_provider import DockerProvider
+
+    script = Path(__file__).with_name("network_probe.py").read_text()
+    volumes = {}
+    if policy.probe_ca_file:
+        volumes[secret_source(policy.probe_ca_file, policy.probe_ca_sha256)] = {"bind": "/run/probe-ca.pem", "mode": "ro"}
+    probe = await asyncio.to_thread(client.containers.create, image=policy.probe_image,
+                                   name=resource_name(reservation["identity"], "probe"),
+                                   entrypoint=["python3", "-c", script], command=[allocation["relay_ip"], policy.probe_url,
+                                   str(policy.probe_timeout_seconds), "/run/probe-ca.pem" if volumes else ""],
+                                   labels=resource_labels(reservation, "probe"),
+                                   network_mode="container:" + allocation["guard_id"], volumes=volumes,
+                                   user=f"{settings.puid}:{settings.pgid}", read_only=True, cap_drop=["ALL"],
+                                   security_opt=["no-new-privileges:true"], mem_limit="128m", nano_cpus=500000000,
+                                   pids_limit=32, restart_policy={"Name": "no"})
+    await asyncio.to_thread(probe.start)
+    result = await asyncio.to_thread(probe.wait, timeout=policy.probe_timeout_seconds * 2 + 10)
+    raw = await asyncio.to_thread(probe.logs, stdout=True, stderr=False, tail=1)
+    try:
+        evidence = json.loads(raw)
+    except (ValueError, TypeError) as exc:
+        raise HTTPException(503, "NETWORK_PROBE_INVALID") from exc
+    if result.get("StatusCode") != 0 or evidence != {"proxy_tls": True, "direct_ipv4_blocked": True,
+                                                  "direct_ipv6_blocked": True, "local_dns_blocked": True}:
+        reject("NETWORK_PROBE_FAILED", 503)
+    await DockerProvider({"provider_config": {}}).stop(probe.id)
+
+
+async def remove_after_exit(identity, request):
+    """Called under the Home lock, after independent absence of all Home workers."""
+    from .profile_runtime import inspect_home
+    from .providers.docker_provider import DockerProvider
+
+    snapshot = await inspect_home(identity["owner"], identity["home"])
+    if snapshot["records"] or snapshot["workers"]:
+        reject("NETWORK_WORKER_EXIT_UNCONFIRMED", 503)
+    resources = snapshot["resources"]
+    validate_resources(resources, request)
+    if not resources:
+        return
+    await set_phase(identity, "stopping")
+    client = await asyncio.to_thread(get_docker_client)
+    reservation = read_reservation(identity)
+    controller = await asyncio.to_thread(self_container, client)
+    if reservation and reservation["controller_id"] != controller.id:
+        try:
+            previous = await asyncio.to_thread(client.containers.get, reservation["controller_id"])
+        except NotFound:
+            previous = None
+        if previous and previous.status not in {"exited", "dead"}:
+            reject("NETWORK_PREVIOUS_CONTROLLER_PRESENT")
+    allowed = {r["id"] for r in resources if r["kind"] in {"relay", "guard", "probe"}}
+    allowed.add(controller.id)
+    if reservation:
+        allowed.add(reservation["controller_id"])
+    networks = []
+    for item in resources:
+        if item["kind"] not in {"internal", "egress"}:
+            continue
+        try:
+            network = await asyncio.to_thread(client.networks.get, item["id"])
+        except NotFound:
+            continue
+        # A foreign attachment must not lose its connectivity during cleanup.
+        if set(network.attrs.get("Containers", {})) - allowed:
+            reject("NETWORK_HAS_FOREIGN_ENDPOINTS")
+        networks.append(network)
+    provider = DockerProvider({"provider_config": {}})
+    for item in resources:
+        if item["kind"] in {"probe", "guard", "relay"}:
+            await provider.stop(item["id"])
+    for network in networks:
+        try:
+            await asyncio.to_thread(network.reload)
+            endpoints = network.attrs.get("Containers", {})
+            for controller_id in {controller.id, reservation["controller_id"] if reservation else controller.id}:
+                if controller_id in endpoints:
+                    await asyncio.to_thread(network.disconnect, controller_id)
+            await asyncio.to_thread(network.remove)
+            try:
+                await asyncio.to_thread(client.networks.get, network.id)
+            except NotFound:
+                continue
+            reject("NETWORK_REMOVAL_UNCONFIRMED", 503)
+        except NotFound:
+            pass
+    remaining = await inventory(identity)
+    if any(item["kind"] != "reservation" for item in remaining):
+        reject("NETWORK_RESOURCES_STILL_PRESENT", 503)
+    directory = runtime_dir() / (identity["home_hash"] + "-" + identity["operation"])
+    if directory.exists():
+        import shutil
+        await asyncio.to_thread(shutil.rmtree, directory)
+    path = reservation_path(identity)
+    if path.exists():
+        path.unlink()
+        sync_directory(path.parent)
+
+
+def enforce_worker_network(run_kwargs, allocation):
+    """Share the pre-filtered namespace; Worker never receives firewall authority."""
+    if (run_kwargs.get("network_mode") or run_kwargs.get("privileged") or run_kwargs.get("ports") or
+            run_kwargs.get("publish_all_ports") or run_kwargs.get("cap_add") or run_kwargs.get("pid_mode") == "host" or
+            run_kwargs.get("ipc_mode") == "host" or run_kwargs.get("volumes_from") or run_kwargs.get("links")):
+        reject("NETWORK_WORKER_OVERRIDE_FORBIDDEN", 422)
+    if allocation.get("enforcement_version") != 1 or not re.fullmatch(SHA, allocation.get("guard_id", "")):
+        reject("NETWORK_GUARD_ALLOCATION_REQUIRED", 422)
+    for key in ("network", "networking_config", "dns", "dns_opt", "dns_search", "extra_hosts"):
+        run_kwargs.pop(key, None)
+    run_kwargs["network_mode"] = "container:" + allocation["guard_id"]
+    run_kwargs["cap_drop"] = sorted(set(run_kwargs.get("cap_drop") or []) | {"NET_ADMIN", "NET_RAW"})
+    run_kwargs["security_opt"] = sorted(set(run_kwargs.get("security_opt") or []) | {"no-new-privileges:true"})
