+"""Verify final Docker exposure, recovery ownership and fail-closed cleanup."""
+
+import copy
+import json
+import os
+from pathlib import Path
+import shutil
+from types import SimpleNamespace
+from unittest.mock import Mock
+import uuid
+
+import pytest
+from fastapi import HTTPException
+
+from app import session_runtime as runtime
+from app.state import state
+
+
+async def test_private_display_header_authenticates_only_its_matching_session():
+    from starlette.requests import Request
+    from app.routers.internal import resolve_session
+    sid, other = str(uuid.uuid4()), str(uuid.uuid4())
+    state.sessions[sid] = {"access_token": "private-session-capability", "ip": "127.0.0.1", "port": 3000}
+    state.sessions[other] = {"access_token": "different-session-capability", "ip": "127.0.0.2", "port": 3000}
+    request = Request({"type": "http", "headers": [(b"x-browser-platform-session-access", b"private-session-capability")],
+                       "query_string": b"", "method": "GET", "path": "/internal/resolve_session/" + sid})
+    result = await resolve_session(sid, request)
+    assert result.status_code == 200 and result.headers["X-Upstream-Host"] == "127.0.0.1:3000"
+    with pytest.raises(HTTPException) as rejected:
+        await resolve_session(other, request)
+    assert rejected.value.status_code == 403
+
+
+async def test_private_display_header_cannot_bypass_a_missing_coherence_gate():
+    from starlette.requests import Request
+    from app.routers.internal import resolve_session
+    sid = str(uuid.uuid4())
+    state.sessions[sid] = {"access_token": "private-session-capability", "ip": "127.0.0.1", "port": 3000,
+        "username": "qa", "home_name": "private-qa", "provider_app_id": "qa-app", "profile_id": "personal",
+        "operation_id": "a" * 32, "network_policy_id": "missing-qa-policy", "coherence_required": True}
+    request = Request({"type": "http", "headers": [(b"x-browser-platform-session-access", b"private-session-capability")],
+                       "query_string": b"", "method": "GET", "path": "/internal/resolve_session/" + sid})
+    with pytest.raises(HTTPException, match="COHERENCE_SESSION_NOT_READY") as rejected:
+        await resolve_session(sid, request)
+    assert rejected.value.status_code == 503
+
+
+@pytest.fixture
+def material(display_runtime):
+    sid, user, password = (str(uuid.uuid4()) for _ in range(3))
+    master = "collaboration-test-" + "a" * 32
+    env = {"SUBFOLDER": f"/{sid}/", "CUSTOM_USER": user, "PASSWORD": password, "SELKIES_MASTER_TOKEN": master}
+    return SimpleNamespace(sid=sid, user=user, password=password, master=master, env=env,
+                           directory=display_runtime / runtime.session_name(sid))
+
+
+def test_final_docker_payload_contains_no_display_credentials(material):
+    kwargs = {"environment": material.env, "labels": {}, "volumes": {"/home": {"bind": "/config"}}}
+    runtime.protect_launch(kwargs, material.sid, material.env, {runtime.LABEL: "1"})
+    raw = json.dumps(kwargs)
+    assert all(value not in raw for value in (material.user, material.password, material.master))
+    assert not (set(kwargs["environment"]) & runtime.SECRET_ENV)
+    assert kwargs["volumes"][str(material.directory)] == {"bind": runtime.TARGET, "mode": "ro"}
+    assert all(material.password.encode() not in p.read_bytes() for p in material.directory.iterdir())
+    assert all(p.stat().st_mode & 0o077 == 0 for p in material.directory.iterdir())
+    assert material.env["PASSWORD"] == material.password  # readiness keeps its private in-memory copy
+
+
+@pytest.mark.parametrize("override", [
+    {"environment": {}}, {"entrypoint": "/bin/sh"}, {"command": "echo"},
+    {"volumes": {"/foreign": {"bind": "/run"}}},
+    {"mounts": [{"Target": runtime.TARGET + "/master-token"}]},
+    {"tmpfs": {runtime.WORKER_TMPFS: "rw"}},
+])
+def test_override_rejected_before_materialization(material, override):
+    kwargs = {"environment": material.env, **override}
+    with pytest.raises(HTTPException):
+        runtime.protect_launch(kwargs, material.sid, material.env, {runtime.LABEL: "1"})
+    assert not material.directory.exists()
+
+
+def test_unreviewed_image_cannot_receive_secret_environment(material):
+    with pytest.raises(HTTPException, match="SESSION_AUTH_IMAGE_REQUIRED"):
+        runtime.protect_launch({"environment": material.env}, material.sid, material.env, {})
+    assert not material.directory.exists()
+
+
+def test_undeclared_runtime_bind_refused(material):
+    state.path_prefix_map.clear()
+    with pytest.raises(HTTPException, match="SESSION_AUTH_TMPFS_BIND_REQUIRED"):
+        runtime.materialize(material.sid, material.user, material.password)
+
+
+@pytest.mark.parametrize("fault", ["symlink", "fifo", "hardlink", "public", "wrong-password", "wrong-session"])
+def test_tampered_or_cross_session_material_is_not_replaced(material, tmp_path, fault):
+    runtime.materialize(material.sid, material.user, material.password, material.master)
+    target = material.directory / "basic.htpasswd"
+    if fault == "symlink":
+        target.unlink(); target.symlink_to(tmp_path / "foreign")
+    elif fault == "fifo":
+        target.unlink(); os.mkfifo(target, 0o600)
+    elif fault == "hardlink":
+        os.link(target, tmp_path / "foreign")
+    elif fault == "public":
+        target.chmod(0o644)
+    elif fault == "wrong-password":
+        target.write_bytes(runtime.verifier(material.user, str(uuid.uuid4())))
+    else:
+        (material.directory / "binding.json").write_text(json.dumps({"version": 1, "uid": os.geteuid(), "session_id": str(uuid.uuid4())}))
+    before = target.lstat()
+    with pytest.raises(HTTPException):
+        runtime.materialize(material.sid, material.user, material.password, material.master)
+    assert target.lstat() == before
+
+
+def container(material, **overrides):
+    attrs = {"Config": {"Labels": {runtime.LABEL: "1", runtime.SESSION_LABEL: material.sid}, "Env": []},
+             "Mounts": [{"Source": str(material.directory), "Destination": runtime.TARGET, "RW": False}]}
+    attrs.update(overrides)
+    return SimpleNamespace(attrs=attrs, reload=lambda: None)
+
+
+def snapshot(material):
+    return {"display_secret_version": 1, "custom_user": material.user, "password": material.password, "master_token": material.master}
+
+
+def test_recovery_reconstructs_tmpfs_from_the_sealed_logical_snapshot(material):
+    runtime.materialize(material.sid, material.user, material.password, material.master)
+    shutil.rmtree(material.directory)
+    runtime.restore_for_container(container(material), material.sid, snapshot(material))
+    assert runtime.verify_verifier((material.directory / "basic.htpasswd").read_bytes(), material.user, material.password)
+    assert (material.directory / "master-token").read_text() == material.master
+    broken = container(material)
+    broken.attrs["Mounts"][0]["Source"] = "/different/session"
+    with pytest.raises(HTTPException, match="SESSION_AUTH_CONTAINER_MOUNT_INVALID"):
+        runtime.restore_for_container(broken, material.sid, snapshot(material))
+
+
+async def test_cleanup_requires_fresh_proof_that_all_mounts_are_gone(material, monkeypatch):
+    runtime.materialize(material.sid, material.user, material.password, material.master)
+    owner = container(material)
+    collection = [owner]
+    client = SimpleNamespace(containers=SimpleNamespace(list=lambda **_: collection))
+    monkeypatch.setattr(runtime, "get_docker_client", lambda: client)
+    await runtime.clear_unused(material.sid)
+    assert material.directory.exists()
+    # Even an unlabelled surviving container's mount prevents deletion.
+    owner.attrs["Config"]["Labels"] = {}
+    await runtime.clear_unused(material.sid)
+    assert material.directory.exists()
+    client.containers.list = Mock(side_effect=RuntimeError("unavailable"))
+    with pytest.raises(HTTPException, match="SESSION_AUTH_CLEANUP_UNCONFIRMED"):
+        await runtime.clear_unused(material.sid)
+    assert material.directory.exists()
+    client.containers.list = lambda **_: []
+    await runtime.clear_unused(material.sid)
+    assert not material.directory.exists()
+
+
+async def test_startup_restores_active_material_and_collects_only_unmounted_orphans(material, monkeypatch):
+    active = snapshot(material)
+    state.sessions[material.sid] = copy.deepcopy(active)
+    orphan = str(uuid.uuid4())
+    runtime.materialize(orphan, str(uuid.uuid4()), str(uuid.uuid4()))
+    monkeypatch.setattr(runtime, "get_docker_client", lambda: SimpleNamespace(containers=SimpleNamespace(
+        list=lambda **_: [container(material)])))
+    await runtime.restore_at_startup()
+    assert material.directory.is_dir()
+    assert not (runtime.ROOT / runtime.session_name(orphan)).exists()
+    assert state.sessions[material.sid] == active
