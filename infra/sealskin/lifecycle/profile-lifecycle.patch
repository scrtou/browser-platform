+    sources = {bind["bind"]: Path(source) for source, bind in relay.kwargs["volumes"].items()}
+    config = json.loads(sources["/run/config/relay.json"].read_text())
+    firewall = json.loads(sources["/run/config/network.json"].read_text())
+    assert config["upstream_host"] == firewall["upstream_ip"] == "203.0.113.9"
+    assert reservation["policy"]["upstream_host"] == "qa.example"
+    await stop(managed)
+
+
+async def test_failed_endpoint_resolution_retains_reservation_without_docker_resources(managed, monkeypatch):
+    def failed(_):
+        raise OSError("resolver unavailable")
+    monkeypatch.setattr(network, "resolve_upstream", failed)
+    with pytest.raises(HTTPException, match="NETWORK_PREPARE_INCOMPLETE"):
+        await launch_application(**launch_args(managed))
+    assert managed.docker.events == []
+    assert network.read_reservation(managed.identity)
+    await stop(managed)
+    await assert_empty(managed)
+
+
+def replace_controller(managed, previous_state="removed"):
+    docker = managed.docker
+    previous = docker.controller
+    if previous_state == "removed":
+        previous.remove()
+    else:
+        previous.status = previous_state
+        previous.reload()
+    current = FakeContainer(docker, {"volumes": {str(network.base_dir()): {"bind": str(network.base_dir())}}})
+    current.status = "running"
+    current.reload()
+    docker.controller = current
+    docker.container_values[current.id] = current
+    return previous, current
+
+
+@pytest.mark.parametrize("previous_state", ["removed", "exited"])
+async def test_controller_replacement_reclaims_frozen_address_without_worker_restart(managed, previous_state):
+    await launch_application(**launch_args(managed))
+    before = network.read_reservation(managed.identity)
+    worker = next(value for value in managed.docker.container_values.values() if value.role == "worker")
+    previous, current = replace_controller(managed, previous_state)
+    events = len(managed.docker.events)
+    results = await network.restore_controller_networks()
+    assert results == [{"home_hash": managed.identity["home_hash"], "result": "attached"}]
+    restored = network.read_reservation(managed.identity)
+    assert restored["controller_id"] == current.id
+    assert restored["allocation"] == before["allocation"]
+    internal = managed.docker.get_network(before["allocation"]["internal_id"])
+    assert previous.id not in internal.attrs["Containers"]
+    assert current.attrs["NetworkSettings"]["Networks"][internal.name]["IPAddress"] == before["allocation"]["controller_ip"]
+    assert all(role == "controller" and action in {"connect", "disconnect"} for action, role in managed.docker.events[events:])
+    assert managed.docker.get_container(worker.id) is worker and worker.status == "running"
+    repeated = len(managed.docker.events)
+    assert (await network.restore_controller_networks())[0]["result"] == "attached"
+    assert len(managed.docker.events) == repeated
+
+
+async def test_controller_recovery_refuses_an_active_previous_controller(managed):
+    await launch_application(**launch_args(managed))
+    previous, _ = replace_controller(managed, "running")
+    before = list(managed.docker.events)
+    results = await network.restore_controller_networks()
+    assert results[0]["reason"] == "NETWORK_PREVIOUS_CONTROLLER_PRESENT"
+    assert managed.docker.events == before
+    assert network.read_reservation(managed.identity)["controller_id"] == previous.id
+
+
+async def test_controller_recovery_does_not_disconnect_a_foreign_or_occupied_endpoint(managed):
+    await launch_application(**launch_args(managed))
+    previous, _ = replace_controller(managed, "exited")
+    value = network.read_reservation(managed.identity)
+    internal = managed.docker.get_network(value["allocation"]["internal_id"])
+    internal.attrs["Containers"]["f" * 64] = {"Name": "foreign", "IPv4Address": value["allocation"]["controller_ip"] + "/24"}
+    before = list(managed.docker.events)
+    results = await network.restore_controller_networks()
+    assert results[0]["reason"] == "NETWORK_HAS_FOREIGN_ENDPOINTS"
+    assert managed.docker.events == before
+    assert previous.id in internal.attrs["Containers"]
+
+
+async def test_controller_recovery_verifies_attachment_after_lost_connect_reply(managed):
+    await launch_application(**launch_args(managed))
+    _, current = replace_controller(managed)
+    managed.docker.lost_connect_reply = True
+    results = await network.restore_controller_networks()
+    assert results[0]["result"] == "attached"
+    assert network.read_reservation(managed.identity)["controller_id"] == current.id
+
+
+@pytest.mark.parametrize("corruption", ["scope", "policy", "guard_config", "worker_namespace", "relay_address"])
+async def test_controller_recovery_rejects_changed_ownership_or_topology_before_mutation(managed, corruption):
+    await launch_application(**launch_args(managed))
+    replace_controller(managed)
+    value = network.read_reservation(managed.identity)
+    if corruption == "scope":
+        value["identity"]["scope"] = "f" * 64
+        network.save_reservation(value)
+    elif corruption == "policy":
+        value["policy"]["upstream_host"] = "foreign.invalid"
+        network.save_reservation(value)
+    elif corruption == "guard_config":
+        path = network.runtime_dir() / (managed.identity["home_hash"] + "-" + OPERATION) / "worker-network.json"
+        content = json.loads(path.read_text())
+        content["controller_ip"] = "172.28.1.20"
+        network.atomic_json(path, content)
+    elif corruption == "worker_namespace":
+        worker = next(c for c in managed.docker.container_values.values() if c.role == "worker")
+        worker.attrs["HostConfig"]["NetworkMode"] = "bridge"
+    else:
+        relay = managed.docker.get_container(value["allocation"]["relay_id"])
+        relay.attrs["NetworkSettings"]["Networks"][value["allocation"]["internal_name"]]["IPAddress"] = "172.28.1.20"
+    before = list(managed.docker.events)
+    results = await network.restore_controller_networks()
+    assert results[0]["result"] == "failed"
+    assert managed.docker.events == before
+
+
+async def test_one_corrupted_journal_does_not_block_other_controller_recovery(managed):
+    await launch_application(**launch_args(managed))
+    replace_controller(managed)
+    invalid = network.runtime_dir() / ("f" * 64 + ".json")
+    network.atomic_json(invalid, {"identity": {"owner": "foreign"}})
+    results = await network.restore_controller_networks()
+    assert sorted(value["result"] for value in results) == ["attached", "failed"]
+    assert invalid.exists()
+
+
+async def test_controller_recovery_retains_a_stopped_guard_without_restarting_it(managed):
+    await launch_application(**launch_args(managed))
+    replace_controller(managed)
+    value = network.read_reservation(managed.identity)
+    managed.docker.get_container(value["allocation"]["guard_id"]).stop(timeout=2)
+    before = list(managed.docker.events)
+    assert (await network.restore_controller_networks())[0]["reason"] == "NETWORK_GUARD_NOT_READY"
+    assert managed.docker.events == before
+
+
+@pytest.mark.parametrize("missing", [RELAY_IMAGE, PROBE_IMAGE])
+async def test_missing_image_never_creates_a_reservation(managed, missing):
+    original = managed.docker.images.get
+    def get(identifier):
+        if identifier == missing:
+            raise NotFound("image unavailable")
+        return original(identifier)
+    managed.docker.images.get = get
+    with pytest.raises(HTTPException, match="NETWORK_IMAGE_UNAVAILABLE"):
+        await launch_application(**launch_args(managed))
+    assert not managed.docker.events
+    assert not network.read_reservation(managed.identity)
