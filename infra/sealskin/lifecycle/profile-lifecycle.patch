+def answer(query, records=()):
+    result = dns.message.make_response(query)
+    for name, ttl, kind, *values in records:
+        result.answer.append(dns.rrset.from_text(name, ttl, "IN", kind, *values))
+    return result
+
+
+def a_answer(query, ip="192.0.2.10", ttl=30):
+    return answer(query, [(query.question[0].name.to_text(), ttl, "A", ip)])
+
