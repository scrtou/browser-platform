+                session.get("provider_app_id") != identity["app"] or
+                session.get("network_policy_id") != reservation["policy_id"] or session.get("network_policy_sha256") != reservation["policy_sha256"] or
+                session.get("lifecycle_phase", "running") != "running"):
+            raise ValueError("COHERENCE_SESSION_CHANGED")
+        worker_id = session["instance_id"]
+    client = await asyncio.to_thread(get_docker_client)
+    containers = {}
+    for role, identifier in (("worker", worker_id), ("relay", allocation["relay_id"]), ("guard", allocation["guard_id"])):
+        item = await asyncio.to_thread(client.containers.get, identifier)
+        if item.status != "running" or not item.attrs.get("State", {}).get("StartedAt"):
+            raise ValueError("COHERENCE_RUNTIME_UNAVAILABLE")
+        labels = item.attrs.get("Config", {}).get("Labels") or {}
+        if any(labels.get(network.PREFIX + key) != value for key, value in identity.items() if key != "home_source"):
+            raise RuntimeDrift("COHERENCE_OWNERSHIP_CHANGED")
+        if labels.get(network.PREFIX + "network-policy-sha256") != reservation["policy_sha256"]:
+            raise RuntimeDrift("COHERENCE_POLICY_CHANGED")
+        containers[role] = item
+        outputs = [m for m in item.attrs.get("Mounts", []) if m.get("Destination") == coherence_exec.OUTPUT_DIRECTORY]
+        if (len(outputs) != 1 or outputs[0].get("Source") != translate_path_to_host(str(result_directory(reservation, role))) or
+                outputs[0].get("Type") != "bind" or outputs[0].get("RW") is not True):
