@@ -0,0 +1,67 @@
+"""Private observer output must be current, bounded and safe to read."""
+
+import json
+import os
+
+import pytest
+
+from app.coherence_exec import read_result
+
+NONCE = "e" * 32
+
+
+@pytest.fixture
+def output(tmp_path):
+    directory = tmp_path / "worker"
+    directory.mkdir(mode=0o700)
+    path = directory / "result.json"
+    path.write_text(json.dumps({"version": 1, "nonce": NONCE, "page": {"ok": True}}))
+    path.chmod(0o600)
+    return directory, path
+
+
+def test_current_private_atomic_output_is_readable(output):
+    directory, _ = output
+    assert read_result(directory, NONCE)["page"] == {"ok": True}
+
+
+@pytest.mark.parametrize("fault", ["file_symlink", "directory_symlink", "fifo", "directory", "hardlink",
+                                  "file_permissions", "directory_permissions", "executable", "too_large",
+                                  "missing", "json_duplicate", "json_invalid", "json_array", "version", "nonce"])
+def test_unsafe_or_stale_result_is_rejected(output, tmp_path, fault):
+    directory, path = output
+    if fault in {"file_symlink", "fifo", "directory", "missing"}:
+        path.unlink()
+    if fault == "file_symlink":
+        target = tmp_path / "other.json"
+        target.write_text(json.dumps({"version": 1, "nonce": NONCE}))
+        target.chmod(0o600)
+        path.symlink_to(target)
+    elif fault == "directory_symlink":
+        target = tmp_path / "link"
+        target.symlink_to(directory, target_is_directory=True)
+        directory = target
+    elif fault == "fifo": os.mkfifo(path, 0o600)
+    elif fault == "directory": path.mkdir(mode=0o700)
+    elif fault == "hardlink": os.link(path, tmp_path / "second-link")
+    elif fault == "file_permissions": path.chmod(0o644)
+    elif fault == "directory_permissions": directory.chmod(0o755)
+    elif fault == "executable": path.chmod(0o700)
+    elif fault == "too_large": path.write_bytes(b" " * (256 * 1024 + 1))
+    elif fault == "json_duplicate": path.write_text('{"version":1,"nonce":"bad","nonce":"' + NONCE + '"}')
+    elif fault == "json_invalid": path.write_text("{")
+    elif fault == "json_array": path.write_text("[]")
+    elif fault == "version": path.write_text(json.dumps({"version": True, "nonce": NONCE}))
+    elif fault == "nonce": path.write_text(json.dumps({"version": 1, "nonce": "f" * 32}))
+    with pytest.raises((OSError, ValueError)):
+        read_result(directory, NONCE)
+
+
+def test_other_role_result_cannot_satisfy_this_observation(output, tmp_path):
+    _, path = output
+    guard = tmp_path / "guard"
+    guard.mkdir(mode=0o700)
+    (guard / "result.json").write_bytes(path.read_bytes())
+    (guard / "result.json").chmod(0o600)
+    with pytest.raises(ValueError, match="BINDING"):
+        read_result(guard, "a" * 32)
