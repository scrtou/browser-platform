+++ b/server/tests/test_secret_store.py
@@ -0,0 +1,164 @@
+"""Encrypted credentials stay immutable, precisely authorized and fail closed."""
+
+import concurrent.futures
+import json
+import os
+from pathlib import Path
+
+import pytest
+
+from app.secret_store import FileSecretStore, SecretError, pair_references, read_private
+
+GRANT = {"owner": "alice", "profile": "personal", "home": "home-A", "app": "browser-A"}
+USER, PASSWORD = " proxy user ", " 密码 secret sentinel "
+
+
+@pytest.fixture
+def store(tmp_path):
+    keys = tmp_path / "keys"
+    keys.mkdir(mode=0o700)
+    return FileSecretStore.initialize(tmp_path / "store", keys / "master.key")
+
+
+def put(store, version=1):
+    return store.put("proxy-a", version, [GRANT], USER, PASSWORD + str(version))
+
+
+def resolve(store, refs, grant=GRANT):
+    return store.resolve(grant, refs["username"], refs["password"])
+
+
+def test_roundtrip_is_encrypted_immutable_and_preserves_bytes(store):
+    first = put(store)
+    original = store.revision_path("proxy-a", 1).read_bytes()
+    assert resolve(store, first) == {"username": USER.encode(), "password": (PASSWORD + "1").encode()}
+    second = put(store, 2)
+    assert resolve(store, second)["password"] == (PASSWORD + "2").encode()
+    assert resolve(store, first)["password"] == (PASSWORD + "1").encode()
+    with pytest.raises(SecretError, match="SECRET_VERSION_EXISTS"):
+        put(store)
+    assert store.revision_path("proxy-a", 1).read_bytes() == original
+    for path in store.directory.rglob("*"):
+        if path.is_file():
+            assert USER.encode() not in path.read_bytes() and PASSWORD.encode() not in path.read_bytes()
+            assert path.stat().st_mode & 0o077 == 0
+
+
+@pytest.mark.parametrize("field", list(GRANT))
+def test_every_identity_dimension_is_required(store, field):
+    refs = put(store)
+    with pytest.raises(SecretError, match="SECRET_ACCESS_DENIED"):
+        resolve(store, refs, {**GRANT, field: "other"})
+
+
+@pytest.mark.parametrize("reference", ["../password", "https://keys.invalid/x", "secret://a/password/1?token=x",
+    "secret://a/../1", "secret://a/password/0", "secret://a/password/01", "secret://a/password/1#x",
+    "secret://a%2fb/password/1", "secret://a/password/1\n"])
+def test_reference_is_never_an_arbitrary_path_or_url(reference):
+    with pytest.raises(SecretError):
+        pair_references("secret://a/username/1", reference)
+
+
+def test_mixed_versions_and_fields_are_rejected(store):
+    refs = put(store)
+    with pytest.raises(SecretError, match="SECRET_REFERENCE_PAIR_INVALID"):
+        store.resolve(GRANT, refs["username"], "secret://proxy-a/password/2")
+    with pytest.raises(SecretError):
+        store.resolve(GRANT, refs["password"], refs["username"])
+
+
+@pytest.mark.parametrize("change", ["ciphertext", "grant", "version", "store"])
+def test_ciphertext_and_authorization_metadata_are_authenticated(store, change):
+    refs = put(store)
+    path = store.revision_path("proxy-a", 1)
+    entry = json.loads(path.read_text())
+    grant = GRANT
+    if change == "ciphertext":
+        entry["ciphertext"] = ("A" if entry["ciphertext"][0] != "A" else "B") + entry["ciphertext"][1:]
+    elif change == "grant":
+        grant = {**GRANT, "owner": "attacker"}
+        entry["grants"] = [grant]
+    elif change == "version":
+        entry["secret_version"] = 2
+    else:
+        entry["store_id"] = "a" * 32
+    path.write_text(json.dumps(entry))
+    with pytest.raises(SecretError):
+        resolve(store, refs, grant)
+
+
+def test_revocation_is_terminal_idempotent_and_does_not_need_decryption_key(store):
+    refs = put(store)
+    other = put(store, 2)
+    key = store.key_file.read_bytes()
+    store.key_file.unlink()
+    first = store.revoke(refs["password"], "a" * 32)
+    assert store.revoke(refs["username"], "b" * 32) == first
+    store.key_file.write_bytes(key)
+    store.key_file.chmod(0o600)
+    with pytest.raises(SecretError, match="SECRET_REVOKED"):
+        resolve(store, refs)
+    with pytest.raises(SecretError, match="SECRET_REVOKED"):
+        put(store)
+    assert resolve(store, other)["password"] == (PASSWORD + "2").encode()
+
+
+def test_missing_and_wrong_keys_never_return_default_material(store):
+    refs = put(store)
+    store.key_file.write_bytes(os.urandom(32))
+    with pytest.raises(SecretError, match="SECRET_KEY_MISMATCH"):
+        resolve(store, refs)
+    store.key_file.unlink()
+    with pytest.raises(SecretError, match="SECRET_FILE_UNAVAILABLE"):
+        resolve(store, refs)
+
+
+def test_restored_store_stays_locked_until_revocation_reconciliation(store):
+    refs = put(store)
+    (store.directory / ".recovery-pending").write_bytes(b"pending\n")
+    with pytest.raises(SecretError, match="SECRET_RECOVERY_LOCKED"):
+        resolve(store, refs)
+    with pytest.raises(SecretError, match="SECRET_RECOVERY_LOCKED"):
+        put(store, 2)
+
+
+@pytest.mark.parametrize("kind", ["permissions", "symlink", "hardlink", "oversize", "fifo", "missing"])
+def test_unsafe_credential_files_fail_without_blocking(store, kind):
+    refs = put(store)
+    path = store.revision_path("proxy-a", 1)
+    if kind == "permissions":
+        path.chmod(0o644)
+    elif kind in {"symlink", "hardlink"}:
+        source = path.with_suffix(".copy")
+        path.rename(source)
+        if kind == "symlink":
+            path.symlink_to(source)
+        else:
+            os.link(source, path)
+    elif kind == "oversize":
+        path.write_bytes(b"x" * (128 * 1024 + 1))
+    else:
+        path.unlink()
+        if kind == "fifo":
+            os.mkfifo(path, 0o600)
+    with pytest.raises(SecretError):
+        resolve(store, refs)
+
+
+def test_two_importers_cannot_replace_the_same_version(store):
+    def attempt():
+        try:
+            return put(store)
+        except SecretError as exc:
+            return exc.code
+    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as pool:
+        outcomes = list(pool.map(lambda _: attempt(), range(2)))
+    assert len([o for o in outcomes if isinstance(o, dict)]) == 1
+    assert "SECRET_VERSION_EXISTS" in outcomes
+
+
+@pytest.mark.parametrize("bad", ["", "one\ntwo", "one\x00two", "x" * 4097, "\ud800"])
+def test_invalid_credential_values_are_not_persisted(store, bad):
+    with pytest.raises(SecretError, match="SECRET_VALUE_INVALID"):
+        store.put("proxy-a", 1, [GRANT], USER, bad)
+    assert not list((store.directory / "versions").iterdir())
