+"""The encrypted administration boundary gates revocation before any mutation."""
+
+from unittest.mock import AsyncMock
+
+from cryptography.hazmat.primitives import serialization
+
+from app import secret_runtime, user_manager
+from tests.test_api_smoke import api_client, Client, _pem_pair
+
+BODY = {"secret_ref": "secret://proxy-a/password/1", "operation_id": "a" * 32}
+
+
+def test_only_authenticated_admin_can_revoke(api_client, monkeypatch):
+    mutation = AsyncMock(return_value={"revoked": True, "egress_blocked": True, "cleanup_complete": True})
+    monkeypatch.setattr(secret_runtime, "revoke", mutation)
+    status, _ = api_client.call("POST", "/api/admin/profile-secrets/revoke", BODY)
+    assert status == 200
+    mutation.assert_awaited_once_with(BODY["secret_ref"], BODY["operation_id"])
+    mutation.reset_mock()
+    _, private, public = _pem_pair()
+    monkeypatch.setitem(user_manager.USER_DATA, "guest", {"username": "guest", "public_key": public,
+                        "is_admin": False, "settings": {"active": True}})
+    server_public = api_client.server_pub.public_bytes(serialization.Encoding.PEM, serialization.PublicFormat.SubjectPublicKeyInfo).decode()
+    guest = Client(api_client.http, server_public, "guest", private)
+    guest.handshake()
+    status, _ = guest.call("POST", "/api/admin/profile-secrets/revoke", BODY)
+    assert status == 403
+    mutation.assert_not_awaited()
+    status, _ = api_client.call("POST", "/api/admin/profile-secrets/revoke", {**BODY, "secret_ref": "../../secret"})
+    assert status == 422
+    mutation.assert_not_awaited()
+
+
+def test_revocation_backend_errors_are_redacted(api_client, monkeypatch):
+    mutation = AsyncMock(side_effect=RuntimeError("private-password-sentinel"))
+    monkeypatch.setattr(secret_runtime, "revoke", mutation)
+    status, data = api_client.call("POST", "/api/admin/profile-secrets/revoke", BODY)
+    assert status == 503 and data == {"detail": "SECRET_REVOKE_INCOMPLETE"}
