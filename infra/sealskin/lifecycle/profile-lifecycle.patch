+    state.sessions["session-one"] = {"access_token": "synthetic-capability"}
+    real_replace = os.replace
+    def replace(source, destination, *args, **kwargs):
+        if destination == "state.key":
+            raise OSError("synthetic-key-commit-failure")
+        return real_replace(source, destination, *args, **kwargs)
+    with monkeypatch.context() as patch:
+        patch.setattr(os, "replace", replace)
+        with pytest.raises(secrets.SessionStateUnavailable):
+            await config_store.save_sessions()
+    assert not secrets.key_path(database()).exists() and not database().exists()
+    assert not list(secrets.key_path(database()).parent.glob(".tmp-*"))
+    await config_store.save_sessions()
+    assert secrets.decode(secrets.read(database()), database()) == state.sessions
