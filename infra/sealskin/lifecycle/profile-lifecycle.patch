@@ -0,0 +1,40 @@
+"""Navigation timing cannot admit blank, redirected or partial reports."""
+
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from app import browser_observe as observer
+
+URL = "https://" + "a" * 32 + ".observe.example.org:18443/environment-test.html?nonce=" + "a" * 32
+
+
+def channel(monkeypatch, replies):
+    clock = [0.0]
+    monkeypatch.setattr(observer.time, "monotonic", lambda: clock[0])
+    monkeypatch.setattr(observer.time, "sleep", lambda value: clock.__setitem__(0, clock[0] + value))
+    calls = []
+    def execute(source, args):
+        calls.append(args)
+        return replies.pop(0) if len(replies) > 1 else replies[0]
+    return SimpleNamespace(deadline=2, execute=execute), calls
+
+
+def test_initial_blank_and_incomplete_page_wait_for_the_exact_source(monkeypatch):
+    expected = {"version": 1, "complete": True, "nonce": "a" * 32}
+    value, calls = channel(monkeypatch, [{"url": "about:blank", "text": ""}, {"url": URL, "text": ""},
+                                        {"url": URL, "text": json.dumps(expected)}])
+    assert observer.wait_page(value, URL) == expected
+    assert calls == [[URL]] * 3
+
+
+@pytest.mark.parametrize("fault", ["redirect", "blank", "partial", "large"])
+def test_other_source_and_unfinished_navigation_never_supply_results(monkeypatch, fault):
+    item = {"url": URL, "text": '{"complete":false}'}
+    if fault == "redirect": item["url"] = URL.replace("observe", "other")
+    elif fault == "blank": item["url"] = "about:blank"
+    elif fault == "large": item["text"] = "x" * (128 * 1024 + 1)
+    value, _ = channel(monkeypatch, [item])
+    with pytest.raises((observer.ObservationError, TimeoutError)):
+        observer.wait_page(value, URL)
