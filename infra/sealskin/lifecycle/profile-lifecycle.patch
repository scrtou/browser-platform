+
+async def test_display_failures_keep_stable_codes(monkeypatch):
+    class Response:
+        def __init__(self, status_code):
+            self.status_code = status_code
+
+    class Client:
+        status = 200
+
+        def __init__(self, **kwargs):
+            self.headers = kwargs.get("headers")
+
+        async def __aenter__(self):
+            return self
+
+        async def __aexit__(self, *args):
+            return False
+
+        async def get(self, url):
+            assert url == "http://172.18.0.9:3000/"
+            assert self.headers["Authorization"].startswith("Basic ")
+            if Client.status is None:
+                raise health.httpx.ConnectError("refused")
+            return Response(Client.status)
+
+    monkeypatch.setattr(health.httpx, "AsyncClient", Client)
+    endpoint = {"ip": "172.18.0.9", "port": 3000, "user": "abc", "password": "x"}
+    assert (await health.observe_display(endpoint))["code"] == "DISPLAY_ENDPOINT_OK"
+    Client.status = 502
+    assert (await health.observe_display(endpoint)) == {"status": "fail", "code": "DISPLAY_ENDPOINT_HTTP_502", "latency_ms": 0}
+    Client.status = None
+    failed = await health.observe_display(endpoint)
+    assert failed["status"] == "fail" and failed["code"] == "DISPLAY_ENDPOINT_UNREACHABLE"
+    assert await health.observe_display(None) == {"status": "unknown", "code": "DISPLAY_NO_RECORD"}
