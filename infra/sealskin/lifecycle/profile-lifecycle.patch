@@ -0,0 +1,178 @@
+"""Dormant generations resume in order; nothing is created and failures keep the reservation."""
+
+from __future__ import annotations
+
+import json
+from types import SimpleNamespace
+from unittest.mock import AsyncMock
+
+import pytest
+from fastapi import HTTPException
+
+from app import network_runtime
+from app import profile_resume as resume
+from app import profile_runtime as runtime
+from app.launch import launch_application
+from app.state import state
+from tests.test_network_runtime import (  # noqa: F401 - fixtures are discovered by name
+    OPERATION,
+    POLICY_ID,
+    launch_args,
+    managed,
+    stop_request,
+)
+from tests.test_profile_runtime import Containers, SID, session
+
+
+def by_role(managed, role):
+    return next(c for c in managed.docker.container_values.values() if c.role == role)
+
+
+async def dormant(managed):
+    """Launch, then stop every container in place as a daemon restart would."""
+    await launch_application(**launch_args(managed))
+    for role in ("worker", "relay", "guard"):
+        container = by_role(managed, role)
+        container.status = "exited"
+        container.reload()
+    managed.docker.events.clear()
+    return by_role(managed, "worker")
+
+
+async def resume_home(managed, **overrides):
+    return await resume.resume_profile_runtime("qa-home", stop_request(managed, **overrides), {"username": "qa"})
+
+
+@pytest.fixture
+def display(managed, monkeypatch):
+    monkeypatch.setattr(resume, "get_docker_client", lambda: managed.docker)
+    monkeypatch.setattr(resume, "display_ready", lambda *args: True)
+    monkeypatch.setattr(resume, "relay_accepts", lambda ip: True)
+
+
+def test_classify_distinguishes_live_dormant_empty_and_mixed():
+    record = {"session_id": SID, "phase": "running", "is_collaboration": False, "network_policy_id": ""}
+    worker = {"session_id": SID, "owned": True, "recorded": True, "status": "exited"}
+    assert resume.classify({"records": [], "workers": [], "resources": []}) == "empty"
+    assert resume.classify({"records": [record], "workers": [worker], "resources": []}) == "dormant"
+    assert resume.classify({"records": [record], "workers": [{**worker, "status": "running"}], "resources": []}) == "live"
+    assert resume.classify({"records": [record], "workers": [{**worker, "recorded": False}], "resources": []}) == "mixed"
+    assert resume.classify({"records": [{**record, "phase": "stopping"}], "workers": [worker], "resources": []}) == "mixed"
+    assert resume.classify({"records": [record], "workers": [worker], "resources": [{"kind": "relay", "status": "exited"}]}) == "mixed"
+    managed_record = {**record, "network_policy_id": POLICY_ID}
