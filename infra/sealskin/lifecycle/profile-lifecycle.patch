@@ -0,0 +1,1040 @@
+"""Generation-bound Relay and Docker networks, owned exclusively by SealSkin.
+
+Every allocation starts with a durable reservation. Failed or interrupted
+allocations keep that reservation until Worker removal and resource cleanup
+have both been verified. Administrative policies contain immutable references;
+ordinary launch requests cannot supply images, credentials, or probe targets.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import ipaddress
+import json
+import logging
+import os
+import re
+import socket
+import stat
+import tempfile
+import time
+from pathlib import Path
+from typing import Any
+from urllib.parse import urlsplit
+
+from docker.errors import NotFound
+from fastapi import HTTPException
+from pydantic import BaseModel, ConfigDict, Field, ValidationError, model_serializer, model_validator
+
+from .docker_utils import get_docker_client, translate_path_to_host
+from .settings import settings
+from .coherence_policy import CoherencePolicy, validate_probe_origin
+
+PREFIX = "io.browser-platform."
+NAME = r"^[A-Za-z0-9_-]{1,128}$"
+SHA = r"^[a-f0-9]{64}$"
+KINDS = {"internal", "egress", "relay", "guard", "probe"}
+logger = logging.getLogger(__name__)
+
+
+class NetworkPolicy(BaseModel):
+    """One operator-approved, immutable proxy or controlled DIRECT revision."""
+
+    model_config = ConfigDict(extra="forbid", strict=True)
+    username: str = Field(pattern=NAME)
+    profile_id: str = Field(pattern=NAME)
+    home_name: str = Field(pattern=NAME)
+    application_id: str = Field(min_length=1, max_length=256)
+    mode: str = Field(default="", pattern=r"^(|proxy_required|direct)$")
+    approved_resolver_id: str = Field(default="", pattern=r"^(|[a-z0-9][a-z0-9-]{0,62})$")
+    approved_resolver_ip: str = ""
+    bootstrap_resolver_id: str = Field(default="", pattern=r"^(|[a-z0-9][a-z0-9-]{0,62})$")
+    bootstrap_resolver_ip: str = ""
+    relay_image: str = Field(pattern=r"^sha256:[a-f0-9]{64}$")
+    probe_image: str = Field(pattern=r"^sha256:[a-f0-9]{64}$")
+    upstream_host: str = Field(default="", max_length=253)
+    upstream_port: int = Field(default=0, ge=0, le=65535)
+    upstream_protocol: str = Field(default="", pattern=r"^(|socks5|http|https)$")
+    upstream_auth: str = Field(default="", pattern=r"^(|none|username_password|basic)$")
+    upstream_tls_ca_file: str = ""
+    upstream_tls_ca_sha256: str = ""
+    username_file: str = ""
+    username_sha256: str = ""
+    password_file: str = ""
+    password_sha256: str = ""
+    username_secret_ref: str = ""
+    password_secret_ref: str = ""
+    probe_url: str = Field(min_length=1, max_length=2048)
+    probe_ca_file: str = ""
+    probe_ca_sha256: str = ""
+    probe_timeout_seconds: int = Field(default=10, ge=1, le=20)
+    coherence: CoherencePolicy | None = None
+
+    @model_validator(mode="after")
+    def validate_upstream_options(self):
+        from .secret_store import SecretError, pair_references
+
+        validate_probe_origin(self)
+
+        if self.mode == "direct":
+            if any(getattr(self, field) for field in (
+                    "upstream_host", "upstream_port", "upstream_protocol", "upstream_auth", "upstream_tls_ca_file",
+                    "upstream_tls_ca_sha256", "username_file", "username_sha256", "password_file", "password_sha256",
+                    "username_secret_ref", "password_secret_ref", "bootstrap_resolver_id", "bootstrap_resolver_ip")):
+                raise ValueError("DIRECT_UPSTREAM_FORBIDDEN")
+            try:
+                address = ipaddress.IPv4Address(self.approved_resolver_ip)
+            except ValueError:
+                raise ValueError("DIRECT_APPROVED_RESOLVER_REQUIRED") from None
+            if (not self.approved_resolver_id or address.is_loopback or address.is_unspecified or
+                    address.is_multicast or address.is_reserved or address.is_link_local or
+                    str(address) != self.approved_resolver_ip):
+                raise ValueError("DIRECT_APPROVED_RESOLVER_REQUIRED")
+            return self
+        if not self.upstream_host or not self.upstream_port or self.approved_resolver_id or self.approved_resolver_ip:
+            raise ValueError("NETWORK_UPSTREAM_INVALID")
+        if self.bootstrap_resolver_id or self.bootstrap_resolver_ip:
+            try:
+                address = ipaddress.IPv4Address(self.bootstrap_resolver_ip)
+            except ValueError:
+                raise ValueError("NETWORK_BOOTSTRAP_RESOLVER_INVALID") from None
+            if (not self.bootstrap_resolver_id or str(address) != self.bootstrap_resolver_ip or
+                    address.is_loopback or address.is_unspecified or address.is_multicast or
+                    address.is_reserved or address.is_link_local):
+                raise ValueError("NETWORK_BOOTSTRAP_RESOLVER_INVALID")
+        has_refs = bool(self.username_secret_ref or self.password_secret_ref)
+        if has_refs:
+            if any((self.username_file, self.username_sha256, self.password_file, self.password_sha256)):
+                raise ValueError("SECRET_REFERENCE_AND_FILE_MIXED")
+            try:
+                pair_references(self.username_secret_ref, self.password_secret_ref)
+            except SecretError as exc:
+                raise ValueError(exc.code) from None
+            if not self.upstream_protocol or not self.upstream_auth:
+                raise ValueError("SECRET_EXPLICIT_AUTH_REQUIRED")
+        has_credentials = bool(self.username_file or has_refs)
+        explicit = bool(self.upstream_protocol or self.upstream_auth)
+        if explicit:
+            allowed = {"socks5": {"none", "username_password"}, "http": {"none", "basic"},
+                       "https": {"none", "basic"}}
+            if (self.upstream_auth not in allowed.get(self.upstream_protocol, set()) or
+                    (self.upstream_auth == "none") != (not has_credentials) or
+                    bool(self.username_file) != bool(self.password_file)):
+                raise ValueError("UNSUPPORTED_PROXY_AUTH")
+        if (bool(self.upstream_tls_ca_file) != bool(self.upstream_tls_ca_sha256) or
+                self.upstream_tls_ca_file and self.upstream_protocol != "https"):
+            raise ValueError("NETWORK_UPSTREAM_TLS_INVALID")
+        return self
+
+    @model_serializer(mode="wrap")
+    def compatible_snapshot(self, handler):
+        """Preserve every legacy canonical byte while binding new options.
+
+        Do not use exclude_defaults: original defaults are part of the signed
+        revision. Only absent extension fields may be omitted from the snapshot.
+        All existing model_dump callers, reservations and preparers share this
+        serialization so old policy references continue to verify unchanged.
+        """
+        value = handler(self)
+        if value.get("coherence") is None:
+            value.pop("coherence", None)
+        for name in ("upstream_protocol", "upstream_auth", "upstream_tls_ca_file", "upstream_tls_ca_sha256",
+                     "username_secret_ref", "password_secret_ref", "mode", "approved_resolver_id", "approved_resolver_ip",
+                     "bootstrap_resolver_id", "bootstrap_resolver_ip"):
+            if value.get(name) == "":
+                value.pop(name)
+        return value
+
+
+def base_dir() -> Path:
+    """Use SealSkin's persistent metadata directory, outside browser Homes."""
+    return Path(settings.sessions_db_path).parent
+
+
+def policy_path() -> Path:
+    """Locate the operator-owned policy registry."""
+    return base_dir() / "profile-network-policies.json"
+
+
+def runtime_dir() -> Path:
+    """Locate durable reservations and generated Relay configuration."""
+    return base_dir() / "profile-network-runtime"
+
+
+def digest(value: Any) -> str:
+    """Hash a canonical JSON representation with all policy defaults resolved."""
+    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
+
+
+def reject(code: str, status_code: int = 409):
+    """Return a stable diagnostic without paths, credentials or Docker bodies."""
+    raise HTTPException(status_code, code)
+
+
+def unique_json(pairs):
+    """Reject ambiguous duplicate metadata fields."""
+    value = {}
+    for key, item in pairs:
+        if key in value:
+            raise ValueError("Duplicate JSON key")
+        value[key] = item
+    return value
+
+
+def read_json(path: Path):
+    """Read bounded, private, regular metadata files."""
+    if path.is_symlink() or not stat.S_ISREG(path.stat().st_mode) or path.stat().st_mode & 0o077:
+        reject("NETWORK_METADATA_PERMISSIONS", 503)
+    raw = path.read_bytes()
+    if len(raw) > 1024 * 1024:
+        reject("NETWORK_METADATA_TOO_LARGE", 503)
+    return json.loads(raw, object_pairs_hook=unique_json)
+
+
+def secret_source(path: str, expected: str) -> str:
+    """Check a fixed file revision, without copying it to Worker storage."""
+    source = Path(path)
+    root = base_dir() / "network-secrets"
+    if (not re.fullmatch(SHA, expected) or not source.is_absolute() or source.is_symlink() or root.is_symlink() or
+            source.parent != root or source.name in {".", ".."}):
+        reject("NETWORK_SECRET_REFERENCE_INVALID", 422)
+    try:
+        info = source.stat()
+        if (not stat.S_ISDIR(root.stat().st_mode) or root.stat().st_mode & 0o077 or
+                not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_nlink != 1):
+            reject("NETWORK_SECRET_PERMISSIONS", 422)
+        if hashlib.sha256(source.read_bytes()).hexdigest() != expected:
+            reject("NETWORK_SECRET_REVISION_MISMATCH", 422)
+    except OSError as exc:
+        raise HTTPException(503, "NETWORK_SECRET_UNAVAILABLE") from exc
+    return translate_path_to_host(str(source))
+
+
+def policies() -> dict[str, NetworkPolicy]:
+    """Validate the complete registry; malformed metadata fails closed."""
+    if not policy_path().exists():
+        return {}
+    try:
+        raw = read_json(policy_path())
+        if set(raw) != {"version", "policies"} or raw["version"] != 1 or not isinstance(raw["policies"], dict):
+            reject("NETWORK_POLICY_REGISTRY_INVALID", 503)
+        result = {}
+        for key, value in raw["policies"].items():
+            if not re.fullmatch(NAME, key):
+                reject("NETWORK_POLICY_ID_INVALID", 503)
+            result[key] = NetworkPolicy(**value)
+        return result
+    except (OSError, ValueError, ValidationError, TypeError) as exc:
+        raise HTTPException(503, "NETWORK_POLICY_REGISTRY_INVALID") from exc
+
+
+def policy_for_launch(params: dict[str, Any], app=None) -> tuple[str, NetworkPolicy] | None:
+    """Protect configured applications even if a caller omits the policy ref."""
+    registry = policies()
+    policy_id = params.get("network_policy_id")
+    revision = params.get("network_policy_sha256")
+    config = getattr(app, "provider_config", None)
+    required_id = getattr(config, "network_policy_id", "")
+    required_sha = getattr(config, "network_policy_sha256", "")
+    protected = any(p.username == params["username"] and p.application_id == params["application_id"]
+                    for p in registry.values())
+    if not policy_id and not revision and not protected and not required_id and not required_sha:
+        return None
+    if not required_id or not required_sha or (policy_id, revision) != (required_id, required_sha):
+        reject("NETWORK_POLICY_APPLICATION_REF_MISMATCH", 422)
+    policy = registry.get(policy_id or "")
+    if not policy or not revision or digest(policy.model_dump()) != revision:
+        reject("NETWORK_POLICY_REFERENCE_MISMATCH", 422)
+    expected = (policy.username, policy.profile_id, policy.home_name, policy.application_id)
+    actual = tuple(params.get(key) for key in ("username", "profile_id", "home_name", "application_id"))
+    if actual != expected or not re.fullmatch(r"[a-f0-9]{32}", params.get("operation_id") or ""):
+        reject("NETWORK_POLICY_OWNERSHIP_MISMATCH", 422)
+    if params.get("launch_in_room_mode") or params.get("forced_rw_mount"):
+        reject("NETWORK_POLICY_REQUIRES_EXCLUSIVE_HOME", 422)
+    parsed = urlsplit(policy.probe_url)
+    try:
+        valid_port = parsed.port is None or 1 <= parsed.port <= 65535
+    except ValueError:
+        valid_port = False
+    if (parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password or parsed.fragment or
+            not valid_port or not policy.probe_url.isascii() or
+            any(ord(c) <= 32 or ord(c) == 127 for c in policy.probe_url) or
+            not re.fullmatch(r"[A-Za-z0-9.-]+", parsed.hostname)):
+        reject("NETWORK_PROBE_TARGET_INVALID", 422)
+    if policy.mode != "direct" and (not re.fullmatch(r"[A-Za-z0-9.:-]+", policy.upstream_host) or
+                                   bool(policy.username_file) != bool(policy.password_file)):
+        reject("NETWORK_UPSTREAM_INVALID", 422)
+    for kind in ("username", "password", "probe_ca", "upstream_tls_ca"):
+        path, expected_sha = getattr(policy, kind + "_file"), getattr(policy, kind + "_sha256")
+        if path or expected_sha:
+            secret_source(path, expected_sha)
+    if policy.username_secret_ref:
+        from .secret_runtime import authorize
+        authorize(policy)
+    return policy_id, policy
+
+
+def reservation_path(identity: dict[str, str]) -> Path:
+    """Map one exact host Home source to its reservation file."""
+    return runtime_dir() / (identity["home_hash"] + ".json")
+
+
+def read_reservation(identity: dict[str, str]) -> dict[str, Any] | None:
+    """Verify the journal's identity and policy snapshot before using it."""
+    path = reservation_path(identity)
+    if not path.exists():
+        return None
+    try:
+        value = read_json(path)
+        if (value.get("version") != 1 or value.get("identity", {}).get("home_hash") != identity["home_hash"] or
+                any(value["identity"].get(k) != identity[k] for k in ("scope", "owner", "home", "home_source")) or
+                value.get("phase") not in {"preparing", "ready", "worker_starting", "running", "stopping"} or
+                not re.fullmatch(NAME, value.get("policy_id", "")) or
+                not re.fullmatch(SHA, value.get("policy_sha256", "")) or
+                not re.fullmatch(SHA, value.get("controller_id", "")) or
+                not re.fullmatch(r"[a-f0-9]{32}", value["identity"].get("operation", ""))):
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        policy = NetworkPolicy(**value["policy"])
+        if (digest(policy.model_dump()) != value["policy_sha256"] or
+                (policy.username, policy.profile_id, policy.home_name, policy.application_id) !=
+                tuple(value["identity"].get(k) for k in ("owner", "profile", "home", "app"))):
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        allocation = value.get("allocation")
+        if allocation and (any(not re.fullmatch(SHA, allocation.get(k, "")) for k in ("internal_id", "egress_id", "relay_id")) or
+                           allocation.get("internal_name") != resource_name(value["identity"], "internal") or
+                           allocation.get("policy_id") != value["policy_id"] or
+                           allocation.get("policy_sha256") != value["policy_sha256"]):
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        if allocation and allocation.get("enforcement_version") == 1:
+            if (not re.fullmatch(SHA, allocation.get("guard_id", "")) or
+                    not re.fullmatch(SHA, allocation.get("guard_config_sha256", ""))):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+            for key in ("guard_ip", "controller_ip", "relay_ip"):
+                if ipaddress.ip_address(allocation[key]).version != 4:
+                    reject("NETWORK_RESERVATION_INVALID", 503)
+        if allocation and policy.mode == "direct":
+            hosts = allocation.get("host_ipv4")
+            if (allocation.get("mode") != "direct" or not isinstance(hosts, list) or not 1 <= len(hosts) <= 64 or
+                    hosts != value.get("host_ipv4") or sorted(set(hosts)) != hosts or
+                    any(not ipaddress.IPv4Address(host).is_global for host in hosts) or
+                    any(not re.fullmatch(SHA, allocation.get(key, ""))
+                        for key in ("relay_config_sha256", "relay_network_sha256"))):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+        if "bootstrap_dns_version" in value or policy.bootstrap_resolver_id:
+            if (type(value.get("bootstrap_dns_version")) is not int or value["bootstrap_dns_version"] != 1 or
+                    policy.mode == "direct"):
+                reject("NETWORK_RESERVATION_INVALID", 503)
+            if "upstream_ipv4" in value or allocation:
+                from .network_dns import validate_observation
+                validate_observation(value.get("bootstrap_dns"), policy, value["identity"], value["policy_sha256"])
+                if value["upstream_ipv4"] != value["bootstrap_dns"]["addresses"]:
+                    reject("NETWORK_RESERVATION_INVALID", 503)
+                if allocation and (allocation.get("bootstrap_dns_sha256") != digest(value["bootstrap_dns"]) or
+                                   any(not re.fullmatch(SHA, allocation.get(key, ""))
+                                       for key in ("relay_config_sha256", "relay_network_sha256"))):
+                    reject("NETWORK_RESERVATION_INVALID", 503)
+            elif "bootstrap_dns" in value:
+                reject("NETWORK_RESERVATION_INVALID", 503)
+        elif "bootstrap_dns" in value or allocation and "bootstrap_dns_sha256" in allocation:
+            reject("NETWORK_RESERVATION_INVALID", 503)
+        if allocation and policy.coherence:
+            from .coherence_runtime import generation, directory as coherence_directory
+            if (allocation.get("coherence_version") != 1 or allocation.get("coherence_generation") != generation(value) or
+                    allocation.get("coherence_artifact_sha256") != policy.coherence.artifact_sha256 or
+                    allocation.get("coherence_acceptance_sha256") != policy.coherence.acceptance_sha256 or
+                    allocation.get("coherence_result_root") != str(coherence_directory(value) / "observations") or
+                    any(not re.fullmatch(SHA, allocation.get(key, "")) for key in ("guard_rules_sha256", "relay_rules_sha256"))):
+                reject("COHERENCE_RESERVATION_INVALID", 503)
+        return value
+    except (OSError, ValueError, TypeError, KeyError) as exc:
+        raise HTTPException(503, "NETWORK_RESERVATION_INVALID") from exc
+
+
+def atomic_json(path: Path, value, exclusive=False) -> None:
+    """Durably write private JSON, optionally refusing an existing reservation."""
+    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
+    if path.parent.is_symlink() or path.parent.stat().st_mode & 0o077:
+        reject("NETWORK_METADATA_PERMISSIONS", 503)
+    fd, temporary = tempfile.mkstemp(prefix=".network-", dir=path.parent)
+    try:
+        with os.fdopen(fd, "w") as handle:
+            os.fchmod(handle.fileno(), 0o600)
+            json.dump(value, handle, sort_keys=True)
+            handle.flush()
+            os.fsync(handle.fileno())
+        if exclusive:
+            try:
+                os.link(temporary, path)
+            except FileExistsError as exc:
+                raise HTTPException(409, "NETWORK_HOME_RESERVED") from exc
+        else:
+            os.replace(temporary, path)
+        sync_directory(path.parent)
+    finally:
+        if os.path.exists(temporary):
+            os.unlink(temporary)
+
+
+def save_reservation(value: dict[str, Any], exclusive=False) -> None:
+    """Commit reservation state before the next external side effect."""
+    atomic_json(reservation_path(value["identity"]), value, exclusive)
+
+
+def sync_directory(path: Path):
+    """Make metadata renames and removals durable."""
+    fd = os.open(path, os.O_DIRECTORY | os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def resource_name(identity: dict[str, str], kind: str) -> str:
+    """Make interrupted creates discoverable without a successful API reply."""
+    key = {k: identity[k] for k in ("scope", "owner", "home_hash", "operation")}
+    return "bp-" + kind + "-" + digest(key)[:40]
+
+
+def resource_labels(reservation: dict[str, Any], kind: str) -> dict[str, str]:
+    """Attach immutable generation and policy ownership to Docker resources."""
+    labels = {PREFIX + key: value for key, value in reservation["identity"].items() if key != "home_source"}
+    labels.update({PREFIX + "network-version": "1", PREFIX + "role": kind,
+                   PREFIX + "network-policy": reservation["policy_id"],
+                   PREFIX + "network-policy-sha256": reservation["policy_sha256"]})
+    return labels
+
+
+def resource_summary(identifier, kind, labels, identity, status, recorded=False):
+    """Project Docker metadata to the non-secret runtime protocol."""
+    owned = (labels.get(PREFIX + "network-version") == "1" and
+             all(labels.get(PREFIX + key) == identity[key] for key in ("scope", "owner", "home", "home_hash")) and
+             labels.get(PREFIX + "role") == kind and
+             bool(re.fullmatch(NAME, labels.get(PREFIX + "profile", ""))) and
+             bool(re.fullmatch(r"[a-f0-9]{32}", labels.get(PREFIX + "operation", ""))) and
+             bool(re.fullmatch(NAME, labels.get(PREFIX + "network-policy", ""))) and
+             bool(re.fullmatch(SHA, labels.get(PREFIX + "network-policy-sha256", ""))))
+    return {"id": identifier, "kind": kind, "owned": owned, "recorded": recorded, "status": status,
+            "profile_id": labels.get(PREFIX + "profile", ""), "operation_id": labels.get(PREFIX + "operation", ""),
+            "app_id": labels.get(PREFIX + "app", ""), "policy_id": labels.get(PREFIX + "network-policy", ""),
+            "policy_sha256": labels.get(PREFIX + "network-policy-sha256", "")}
+
+
+async def inventory(identity: dict[str, str], containers=None) -> list[dict[str, Any]]:
+    """Include reservations, exited containers and both networks; never guess absence."""
+    reservation = read_reservation(identity)
+    try:
+        client = await asyncio.to_thread(get_docker_client)
+        if containers is None:
+            containers = await asyncio.to_thread(client.containers.list, all=True, ignore_removed=True)
+        networks = await asyncio.to_thread(client.networks.list)
+    except Exception as exc:
+        raise HTTPException(503, "NETWORK_INVENTORY_UNAVAILABLE") from exc
+    expected = {resource_name(reservation["identity"], k): k for k in KINDS} if reservation else {}
+    result = []
+    if reservation:
+        result.append(resource_summary(identity["home_hash"], "reservation", {
+            **resource_labels(reservation, "reservation")}, identity, reservation["phase"], True))
+    for obj in [*networks, *containers]:
+        attrs = obj.attrs
+        is_container = "Config" in attrs
+        labels = (attrs.get("Config", {}).get("Labels") if is_container else attrs.get("Labels")) or {}
+        name = attrs.get("Name", getattr(obj, "name", "")).lstrip("/")
+        related = all(labels.get(PREFIX + k) == identity[k] for k in ("scope", "owner", "home_hash"))
+        kind = expected.get(name) or labels.get(PREFIX + "role")
+        if kind not in KINDS or (not related and name not in expected):
+            continue
+        state = attrs.get("State", {}).get("Status", "unknown") if is_container else "present"
+        summary = resource_summary(obj.id, kind, labels, identity, state, name in expected)
+        if kind in {"internal", "egress"} and (is_container or attrs.get("Driver") != "bridge" or
+                bool(attrs.get("Internal")) != (kind == "internal") or attrs.get("EnableIPv6")):
+            summary["owned"] = False
+        if kind in {"relay", "guard", "probe"} and not is_container:
+            summary["owned"] = False
+        result.append(summary)
+    return result
+
+
+def validate_resources(resources, request) -> None:
+    """Validate every resource before permitting any generation cleanup."""
+    for item in resources:
+        if (not item["owned"] or item["profile_id"] != request.profile_id or
+                item["operation_id"] != request.operation_id or item["app_id"] != request.application_id or
+                item["policy_id"] != request.network_policy_id or
+                item["policy_sha256"] != request.network_policy_sha256):
+            reject("NETWORK_RESOURCE_OWNERSHIP_UNPROVEN")
+
+
+async def set_phase(identity, phase):
+    """Persist an existing allocation's phase without changing its owner."""
+    reservation = read_reservation(identity)
+    if reservation:
+        if any(reservation["identity"][k] != identity[k] for k in ("operation", "profile", "app")):
+            reject("NETWORK_GENERATION_CHANGED")
+        reservation["phase"] = phase
+        await asyncio.to_thread(save_reservation, reservation)
+
+
+def self_container(client):
+    """Self lookup must never choose another deployment by partial name."""
+    container = client.containers.get(os.uname()[1])
+    config_source = os.path.normpath(translate_path_to_host(str(base_dir())))
+    mounts = container.attrs.get("Mounts", [])
+    if not any(config_source == m.get("Source") or config_source.startswith(m.get("Source", "") + "/") for m in mounts if m.get("Source")):
+        reject("NETWORK_CONTROL_OWNER_UNPROVEN", 503)
+    return container
+
+
+async def get_or_create_network(client, reservation, kind):
+    """Create only an exact generation network, refusing name collisions."""
+    name = resource_name(reservation["identity"], kind)
+    labels = resource_labels(reservation, kind)
+    try:
+        network = await asyncio.to_thread(client.networks.get, name)
+    except NotFound:
+        network = await asyncio.to_thread(client.networks.create, name, driver="bridge", internal=kind == "internal",
+                                         enable_ipv6=False, check_duplicate=True, labels=labels)
+    await asyncio.to_thread(network.reload)
+    if (network.attrs.get("Labels") != labels or network.attrs.get("Driver") != "bridge" or
+            bool(network.attrs.get("Internal")) != (kind == "internal") or network.attrs.get("EnableIPv6")):
+        reject("NETWORK_NAME_COLLISION")
+    return network
+
+
+def resolve_upstream(policy):
+    """Resolve the operator endpoint once, outside every Worker namespace.
+
+    The selected numeric address is frozen for this generation. The Relay has
+    no DNS access and cannot silently follow a changed hostname while active.
+    Website names remain domain requests/CONNECT authorities resolved upstream.
+    """
+    from .network_dns import numeric_endpoint
+    literal = numeric_endpoint(policy.upstream_host)
+    if literal:
+        return [literal]
+    values = socket.getaddrinfo(policy.upstream_host, policy.upstream_port,
+                               family=socket.AF_INET, type=socket.SOCK_STREAM)
+    addresses = list(dict.fromkeys(item[4][0] for item in values))
+    if not addresses or any(ipaddress.ip_address(value).is_loopback or
+                            ipaddress.ip_address(value).is_unspecified or
+                            ipaddress.ip_address(value).is_multicast for value in addresses):
+        reject("NETWORK_UPSTREAM_ADDRESS_INVALID", 422)
+    return addresses
+
+
+def resolve_bootstrap(policy, identity, policy_sha256):
+    """Explicit approved DNS, numeric bypass, or clearly identified legacy DNS."""
+    from . import network_dns
+
+    literal = network_dns.numeric_endpoint(policy.upstream_host)
+    if literal:
+        value = network_dns.observation(policy.upstream_host, "numeric", [literal])
+    elif policy.bootstrap_resolver_id:
+        value = network_dns.resolve_approved(policy)
+    else:
+        value = network_dns.observation(policy.upstream_host, "legacy_system", resolve_upstream(policy))
+    value["binding"] = network_dns.binding(identity, policy_sha256)
+    network_dns.validate_observation(value, policy, identity, policy_sha256)
+    return value
+
+
+async def wait_guard(guard, expected, since=None):
+    """Do not share this namespace until initialization and privilege drop pass.
+
+    `since` (epoch seconds) restricts the log read to the current container
+    start, so a restarted Guard is not trusted on the ready line it printed
+    before it was stopped.
+    """
+    deadline = time.monotonic() + 10
+    while time.monotonic() < deadline:
+        await asyncio.to_thread(guard.reload)
+        if guard.status != "running":
+            reject("NETWORK_GUARD_NOT_READY", 503)
+        options = {"stdout": True, "stderr": False, "tail": 1}
+        if since is not None:
+            options["since"] = since
+        raw = await asyncio.to_thread(guard.logs, **options)
+        try:
+            if json.loads(raw) == {"network_guard_ready": expected}:
+                return
+        except (ValueError, TypeError):
+            pass
+        await asyncio.sleep(0.1)
+    reject("NETWORK_GUARD_NOT_READY", 503)
+
+
+async def prepare(identity: dict[str, str], policy_id: str, policy: NetworkPolicy, display_port=3000) -> dict[str, Any]:
+    """Reserve first, construct isolated resources, then probe from the Worker network."""
+    if read_reservation(identity) or await inventory(identity):
+        reject("NETWORK_HOME_RESERVED")
+    client = await asyncio.to_thread(get_docker_client)
+    try:
+        image = await asyncio.to_thread(client.images.get, policy.relay_image)
+        await asyncio.to_thread(client.images.get, policy.probe_image)
+    except NotFound as exc:
+        raise HTTPException(422, "NETWORK_IMAGE_UNAVAILABLE") from exc
+    if (image.attrs.get("Config", {}).get("Labels") or {}).get(PREFIX + "network-guard") != "1":
+        reject("NETWORK_ENFORCEMENT_IMAGE_REQUIRED", 422)
+    if ((policy.upstream_protocol or policy.upstream_auth) and
+            (image.attrs.get("Config", {}).get("Labels") or {}).get(PREFIX + "proxy-upstreams") != "1"):
+        reject("NETWORK_UPSTREAM_IMAGE_REQUIRED", 422)
+    if (policy.username_secret_ref and
+            (image.attrs.get("Config", {}).get("Labels") or {}).get(PREFIX + "secret-lease") != "1"):
+        reject("NETWORK_SECRET_LEASE_IMAGE_REQUIRED", 422)
+    if (policy.mode == "direct" and
