+@pytest.fixture
+def wire(monkeypatch):
+    fixture = SimpleNamespace(reply=lambda query, transport: a_answer(query), events=[])
+
+    def respond(data, transport):
+        query = dns.message.from_wire(data)
+        fixture.events.append((query.question[0].name.to_text(), transport))
+        value = fixture.reply(query, transport)
+        return value.to_wire(want_shuffle=False) if isinstance(value, dns.message.Message) else value
+
+    class UDP(socketserver.BaseRequestHandler):
+        def handle(self):
+            data, connection = self.request
+            result = respond(data, "udp")
+            if result is not None:
+                connection.sendto(result, self.client_address)
+
+    class TCP(socketserver.BaseRequestHandler):
+        def read(self, size):
+            value = b""
+            while len(value) < size:
+                part = self.request.recv(size - len(value))
+                if not part:
+                    raise OSError("closed")
+                value += part
+            return value
+
+        def handle(self):
+            try:
+                self.request.settimeout(1)
+                result = respond(self.read(struct.unpack("!H", self.read(2))[0]), "tcp")
+                if result is not None:
+                    self.request.sendall(struct.pack("!H", len(result)) + result)
+            except OSError:
+                pass
+
+    class UDPServer(socketserver.ThreadingUDPServer):
+        daemon_threads = True
+
+    class TCPServer(socketserver.ThreadingTCPServer):
+        daemon_threads = True
+
+    udp = UDPServer(("127.0.0.1", 0), UDP)
+    tcp = TCPServer(udp.server_address, TCP)
+    threads = [threading.Thread(target=server.serve_forever, kwargs={"poll_interval": 0.02}, daemon=True)
+               for server in (udp, tcp)]
+    for thread in threads:
+        thread.start()
+    monkeypatch.setattr(dns_bootstrap, "DNS_PORT", udp.server_address[1])
+    monkeypatch.setattr(dns_bootstrap, "TIMEOUT_SECONDS", 0.6)
