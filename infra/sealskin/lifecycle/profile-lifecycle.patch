+"""Worker display authentication without Docker password environments.
+
+Only salted verifiers and an optional collaboration token cross a private
+tmpfs bind. The sealed Session snapshot remains the recovery authority.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import hmac
+import os
+from pathlib import Path
+import re
+import shutil
+import uuid
+
+from fastapi import HTTPException
+
+from .docker_utils import get_docker_client, translate_path_to_host
+from .secret_store import canonical, private_directory, read_private, write_private
+from .settings import settings
+from .state import state
+
+ROOT = Path("/run/browser-platform-session-secrets")
+TARGET = "/run/browser-platform-session-input"
+WORKER_TMPFS = "/run/browser-platform-display"
+LABEL = "io.browser-platform.session-auth"
+SESSION_LABEL = "io.browser-platform.session"
+FILES = {"binding.json", "basic.htpasswd", "master-token"}
+SECRET_ENV = {"CUSTOM_USER", "PASSWORD", "SELKIES_MASTER_TOKEN"}
+
+
+def reject(code="SESSION_AUTH_MATERIAL_INVALID"):
+    raise HTTPException(503, code)
+
+
+def session_name(session_id):
+    try:
+        if not isinstance(session_id, str) or str(uuid.UUID(session_id)) != session_id:
+            raise ValueError
+    except (ValueError, TypeError, AttributeError):
+        reject("SESSION_AUTH_BINDING_INVALID")
+    return "session-" + session_id
+
+
+def runtime_root():
+    from .secret_runtime import is_tmpfs
+
+    try:
+        private_directory(ROOT)
+        if (not is_tmpfs(ROOT) or str(ROOT) not in state.path_prefix_map
+                or os.geteuid() != settings.puid):
+            reject("SESSION_AUTH_TMPFS_BIND_REQUIRED")
+        translate_path_to_host(str(ROOT))
+        return ROOT
+    except HTTPException:
+        raise
+    except Exception:
+        reject("SESSION_AUTH_RUNTIME_UNAVAILABLE")
+
+
+def credentials(user, password, master):
+    try:
+        if str(uuid.UUID(user)) != user or str(uuid.UUID(password)) != password:
+            raise ValueError
+        if master and (not isinstance(master, str) or not re.fullmatch(r"[A-Za-z0-9_-]{32,128}", master)):
+            raise ValueError
+    except (ValueError, TypeError, AttributeError):
+        reject("SESSION_AUTH_CREDENTIALS_INVALID")
+    return user, password, master or ""
+
+
+def verifier(user, password):
+    # RFC 2307 SSHA is supported by nginx. This password is a random UUIDv4,
+    # not a human password; the verifier cannot be used as a Basic credential.
+    salt = os.urandom(16)
+    value = hashlib.sha1(password.encode() + salt).digest() + salt
+    return user.encode() + b":{SSHA}" + base64.b64encode(value) + b"\n"
+
+
+def verify_verifier(raw, user, password):
+    prefix = user.encode() + b":{SSHA}"
+    if not raw.startswith(prefix) or not raw.endswith(b"\n"):
+        return False
+    try:
+        value = base64.b64decode(raw[len(prefix):-1], validate=True)
+    except ValueError:
+        return False
+    return len(value) == 36 and hmac.compare_digest(value[:20], hashlib.sha1(password.encode() + value[20:]).digest())
+
+
+def materialize(session_id, user, password, master=None):
+    name = session_name(session_id)
+    user, password, master = credentials(user, password, master)
+    try:
+        directory = runtime_root() / name
+        directory.mkdir(mode=0o700, exist_ok=True)
+        private_directory(directory)
+        if set(p.name for p in directory.iterdir()) - FILES:
+            reject()
+        values = {"binding.json": canonical({"version": 1, "session_id": session_id, "uid": settings.puid}),
+                  "master-token": master.encode()}
+        for name, raw in values.items():
+            path = directory / name
+            if os.path.lexists(path):
+                if not hmac.compare_digest(read_private(path, 1024), raw):
+                    reject()
+            else:
+                write_private(path, raw)
+        path = directory / "basic.htpasswd"
+        if os.path.lexists(path):
+            if not verify_verifier(read_private(path, 1024), user, password):
+                reject()
+        else:
+            write_private(path, verifier(user, password))
+        return translate_path_to_host(str(directory))
+    except HTTPException:
+        raise
+    except Exception:
+        reject()
+
+
+def protect_launch(kwargs, session_id, expected_env, image_labels):
+    """Validate the final Docker request after every operator override."""
+    if image_labels.get(LABEL) != "1":
+        raise HTTPException(422, "SESSION_AUTH_IMAGE_REQUIRED")
+    environment = kwargs.get("environment")
+    if (not isinstance(environment, dict) or any(environment.get(k) != expected_env.get(k) for k in SECRET_ENV)
+            or environment.get("SUBFOLDER") != f"/{session_id}/"
+            or any(k.startswith("FILE__") for k in environment)
+            or any(kwargs.get(k) for k in ("entrypoint", "command", "user", "volumes_from", "privileged"))
+            or environment.get("DEV_MODE")):
+        raise HTTPException(422, "SESSION_AUTH_OVERRIDE_FORBIDDEN")
+    volumes = dict(kwargs.get("volumes") or {})
+    targets = []
+    for value in volumes.values():
+        if not isinstance(value, dict):
+            raise HTTPException(422, "SESSION_AUTH_MOUNT_INVALID")
+        targets.append(value.get("bind", ""))
+    targets.extend((v.get("Target") or v.get("target") or "") for v in kwargs.get("mounts") or [])
+    tmpfs = dict(kwargs.get("tmpfs") or {})
+    targets.extend(tmpfs)
+    for target in targets:
+        target = target.rstrip("/")
+        if not target or any(target == p or p.startswith(target + "/") or target.startswith(p + "/")
+                             for p in (TARGET, WORKER_TMPFS)):
+            raise HTTPException(422, "SESSION_AUTH_MOUNT_SHADOWED")
+    source = materialize(session_id, expected_env.get("CUSTOM_USER"), expected_env.get("PASSWORD"),
+                         expected_env.get("SELKIES_MASTER_TOKEN"))
+    volumes[source] = {"bind": TARGET, "mode": "ro"}
+    tmpfs[WORKER_TMPFS] = "rw,nosuid,nodev,noexec,size=1m,mode=0755"
+    kwargs["volumes"], kwargs["tmpfs"] = volumes, tmpfs
+    kwargs["environment"] = {k: v for k, v in environment.items() if k not in SECRET_ENV}
+    kwargs["labels"] = dict(kwargs.get("labels") or {}, **{LABEL: "1", SESSION_LABEL: session_id})
+
+
+def validate_container(container, session_id, source):
+    attrs = container.attrs
+    labels = attrs.get("Config", {}).get("Labels") or {}
+    if labels.get(LABEL) != "1" or labels.get(SESSION_LABEL) != session_id:
+        reject("SESSION_AUTH_CONTAINER_BINDING_INVALID")
+    if any(v.split("=", 1)[0] in SECRET_ENV or v.startswith("FILE__") for v in attrs.get("Config", {}).get("Env") or []):
+        reject("SESSION_AUTH_CONTAINER_ENV_INVALID")
+    mounts = [m for m in attrs.get("Mounts", []) if m.get("Destination") == TARGET]
+    if len(mounts) != 1 or mounts[0].get("Source") != source or mounts[0].get("RW") is not False:
+        reject("SESSION_AUTH_CONTAINER_MOUNT_INVALID")
+
+
+def restore_for_container(container, session_id, session):
+    version = session.get("display_secret_version")
+    label = (container.attrs.get("Config", {}).get("Labels") or {}).get(LABEL)
+    if not version and not label:
+        return  # Existing legacy Workers keep their documented old boundary.
+    if version != 1 or label != "1":
+        reject("SESSION_AUTH_VERSION_MISMATCH")
+    source = materialize(session_id, session.get("custom_user"), session.get("password"), session.get("master_token"))
+    validate_container(container, session_id, source)
+
+
+async def clear_unused(session_id):
+    name = session_name(session_id)
+    if not os.path.lexists(ROOT / name):
+        return True
+    try:
+        directory = runtime_root() / name
+        private_directory(directory)
+        source = translate_path_to_host(str(directory))
+        client = await asyncio.to_thread(get_docker_client)
+        containers = await asyncio.to_thread(client.containers.list, all=True)
+        for container in containers:
+            await asyncio.to_thread(container.reload)
+            labels = container.attrs.get("Config", {}).get("Labels") or {}
+            if labels.get(SESSION_LABEL) == session_id or any(m.get("Source") == source for m in container.attrs.get("Mounts", [])):
+                return False
+        if set(p.name for p in directory.iterdir()) - FILES:
+            reject()
+        for path in directory.iterdir():
+            read_private(path, 1024)
+        await asyncio.to_thread(shutil.rmtree, directory)
+        return True
+    except HTTPException:
+        raise
+    except Exception:
+        reject("SESSION_AUTH_CLEANUP_UNCONFIRMED")
+
+
+async def restore_at_startup():
+    sealed = [(sid, value) for sid, value in state.sessions.items() if value.get("display_secret_version")]
+    if not sealed and not os.path.lexists(ROOT):
+        return
+    runtime_root()
+    client = await asyncio.to_thread(get_docker_client)
+    containers = await asyncio.to_thread(client.containers.list, all=True)
+    for sid, session in sealed:
+        if session.get("display_secret_version") != 1:
+            reject("SESSION_AUTH_VERSION_MISMATCH")
+        materialize(sid, session.get("custom_user"), session.get("password"), session.get("master_token"))
+        for container in containers:
+            await asyncio.to_thread(container.reload)
+            if (container.attrs.get("Config", {}).get("Labels") or {}).get(SESSION_LABEL) == sid:
+                restore_for_container(container, sid, session)
+    # At startup no concurrent launch can be between material creation and
+    # Docker acknowledgement. A retained Docker mount always prevents GC.
+    for directory in ROOT.iterdir():
+        if directory.name.startswith("session-"):
+            sid = directory.name[len("session-"):]
+            session_name(sid)
+            if sid not in state.sessions:
+                await clear_unused(sid)
