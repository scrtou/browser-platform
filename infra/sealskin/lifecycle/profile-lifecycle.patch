+
+
+def result_mount(reservation, role):
+    path = result_directory(reservation, role)
+    path.parent.mkdir(mode=0o700, exist_ok=True)
+    path.mkdir(mode=0o700, exist_ok=True)
+    return {translate_path_to_host(str(path)): {"bind": coherence_exec.OUTPUT_DIRECTORY, "mode": "rw"}}
+
+
+def assets(spec):
+    artifact = json.loads(read_asset(spec.artifact_file, spec.artifact_sha256), object_pairs_hook=network.unique_json)
+    accepted = json.loads(read_asset(spec.acceptance_file, spec.acceptance_sha256), object_pairs_hook=network.unique_json)
+    if (artifact.get("schemaVersion") != "browser-platform/camoufox-environment/v1" or
+            accepted.get("schemaVersion") != "browser-platform/camoufox-acceptance/v1" or
+            accepted.get("status") != "pass" or accepted.get("phase") != "all" or
+            accepted.get("artifactSHA256") != spec.artifact_sha256 or
+            accepted.get("artifactId") != artifact.get("id") or
+            accepted.get("runtimeImageDigest") != artifact.get("runtimeImageDigest") or
+            not accepted.get("results", {}).get("homeReplay", {}).get("observationsStable")):
+        raise ValueError("COHERENCE_ASSET_BINDING_INVALID")
+    results = accepted["results"]
+    homes = results["homeReplay"]
+    repeats = homes.get("recreationsPerHome")
+    observations = homes.get("observations")
+    if (results.get("artifactTests") != "pass" or not ACCEPTANCE_REJECTIONS <= set(results.get("entrypointRejections", {})) or
+            homes.get("homes") != 2 or type(repeats) is not int or not 10 <= repeats <= 1000 or
+            homes.get("storageRestored") is not True or homes.get("observationsStable") is not True or
+            homes.get("offlineBackupRestore") != "pass" or homes.get("differences") != [] or
+            not isinstance(observations, list) or len(observations) != 2 * (repeats + 1)):
+        raise ValueError("COHERENCE_ACCEPTANCE_INCOMPLETE")
+    baseline = observations[0]["observed"]
+    if ({(item.get("role"), item.get("iteration")) for item in observations} !=
+            {(role, iteration) for role in ("A", "B") for iteration in range(repeats + 1)} or
+            any(item.get("observed") != baseline or item.get("artifactSHA256") != spec.artifact_sha256 or
+                item.get("navigation") != "pass" for item in [*observations, homes.get("restoredObservation", {})])):
+        raise ValueError("COHERENCE_ACCEPTANCE_INCOMPLETE")
+    if (not isinstance(baseline, dict) or
+            "frozen-device-config" not in artifact.get("spec", {}).get("requiredCapabilities", []) or
+            any(key not in baseline for key in ("userAgent", "platform", "oscpu", "hardwareConcurrency", "timezone", "locale",
+                                                 "languages", "webgl", "fonts", "canvasSHA256", "audioSHA256", "voices"))):
+        raise ValueError("COHERENCE_CAPABILITIES_UNSUPPORTED")
+    return artifact, baseline
