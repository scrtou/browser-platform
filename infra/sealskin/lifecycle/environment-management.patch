+++ b/server/tests/test_home_archive.py
@@ -0,0 +1,27 @@
+"""Controller-owned Home archive lifecycle."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from app import profile_runtime as runtime
+from app.routers import homedirs
+from tests.test_launch_journal import plain  # noqa: F401 - fixture is discovered by name
+
+
+async def test_archive_moves_unused_home_and_is_idempotent(plain):
+    home = Path(runtime.home_path("qa", "test-home"))
+    (home / "profile-data").write_text("retained")
+    user = {"username": "qa", "effective_settings": {"persistent_storage": True}}
+    body = {"archive_name": "archive-browser-1", "profile_id": "browser-1", "profile_revision": 2,
+            "application_id": "app-browser-1", "environment_artifact_id": "artifact-1", "actor": "admin"}
+
+    assert await homedirs.archive_my_home_dir("test-home", body, user) == {
+        "status": "archived", "archive_name": "archive-browser-1", "home_name": "test-home"}
+    archived = Path(homedirs._archive_root("qa")) / "archive-browser-1"
+    assert not home.exists() and (archived / "profile-data").read_text() == "retained"
+    manifest = json.loads((archived / homedirs._ARCHIVE_MANIFEST).read_text())
+    assert manifest["profile_id"] == "browser-1" and manifest["profile_revision"] == 2
+    assert await homedirs.archive_my_home_dir("test-home", body, user) == {
+        "status": "archived", "archive_name": "archive-browser-1", "home_name": "test-home"}
