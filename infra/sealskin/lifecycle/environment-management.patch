+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.socks, "socks5", "username_password", refs))
+    assert status == 200 and result == {"status": "failed", "code": "PROXY_AUTH_REJECTED", "upstream_ip": "127.0.0.1"}
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.http, "http", "basic", refs))
+    assert status == 200 and result["code"] == "PROXY_AUTH_REJECTED"
+    other = {**refs, "grant": {**GRANT, "profile": "browser-b"}}
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.socks, "socks5", "username_password", refs, **other))
+    assert status == 403 and result == {"detail": "SECRET_ACCESS_DENIED"}
+    assert not any("wrong password" in str(item) for item in proxies.seen)
+
+
+def test_probe_http_and_https_connect(api_client, secured, proxies):
+    refs = _import(api_client)
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.http, "http", "basic", refs))
+    assert status == 200 and result["status"] == "passed", result
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe",
+                                     _probe_body(proxies, proxies.https, "https", "basic", refs, upstream_tls_ca_pem=proxies.ca_pem))
+    assert status == 200 and result["status"] == "passed", result
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.https, "https", "basic", refs))
+    assert status == 200 and result == {"status": "failed", "code": "PROXY_TLS_FAILED", "upstream_ip": "127.0.0.1"}
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.http, "http", "basic", refs, probe_ca_pem=""))
+    assert status == 200 and result["code"] == "PROBE_TLS_FAILED"
+    status, result = api_client.call("POST", "/api/admin/environment-management/proxy-probe", _probe_body(proxies, proxies.http, "http", "none"))
+    assert status == 200 and result["code"] == "PROXY_AUTH_REJECTED"
+
+
+def test_probe_request_validation(api_client, secured, proxies):
+    refs = _import(api_client)
+    for body in (_probe_body(proxies, proxies.socks, "socks5", "basic", refs), _probe_body(proxies, proxies.socks, "socks5", "none", refs),
+                 _probe_body(proxies, proxies.socks, "socks5", "username_password"), _probe_body(proxies, proxies.http, "http", "basic", refs, upstream_tls_ca_pem=proxies.ca_pem),
+                 {**_probe_body(proxies, proxies.socks, "socks5", "username_password", refs), "grant": None},
+                 _probe_body(proxies, proxies.socks, "socks5", "username_password", refs, probe_url="http://probe.test/")):
+        status, data = api_client.call("POST", "/api/admin/environment-management/proxy-probe", body)
+        assert status in (200, 422), (body, data)
+        if status == 200:
+            assert data["status"] == "failed" and data["code"] == "PROBE_URL_INVALID"
+        else:
+            assert data == {"detail": "PROXY_PROBE_REQUEST_INVALID"}
+
+
+def test_upstream_addresses_must_be_public_ipv4(monkeypatch):
+    for value in ("127.0.0.1", "10.0.0.1", "192.168.1.1", "169.254.169.254", "100.64.0.1", "0.0.0.0", "224.0.0.1", "::1", "localhost", "metadata.internal", "proxy.local"):
+        with pytest.raises(proxy_probe.ProbeError):
+            proxy_probe.public_ipv4(value, 1080)
+    assert proxy_probe.public_ipv4("1.1.1.1", 1080) == "1.1.1.1"
+    monkeypatch.setattr(socket, "getaddrinfo", lambda *args, **kwargs: [(None, None, None, None, ("10.1.2.3", 1080)), (None, None, None, None, ("8.8.8.8", 1080))])
+    with pytest.raises(proxy_probe.ProbeError, match="NETWORK_UPSTREAM_ADDRESS_INVALID"):
+        proxy_probe.public_ipv4("proxy.example", 1080)
+    monkeypatch.setattr(socket, "getaddrinfo", lambda *args, **kwargs: [(None, None, None, None, ("8.8.8.8", 1080)), (None, None, None, None, ("8.8.4.4", 1080))])
+    assert proxy_probe.public_ipv4("proxy.example", 1080) == "8.8.8.8"
+
+
+async def test_probe_endpoint_rejects_private_upstream(api_client, secured):
+    body = {"upstream_host": "10.0.0.1", "upstream_port": 1080, "upstream_protocol": "socks5", "upstream_auth": "none", "probe_url": "https://probe.test/"}
+    status, data = api_client.call("POST", "/api/admin/environment-management/proxy-probe", body)
+    assert status == 422 and data == {"detail": "NETWORK_UPSTREAM_ADDRESS_INVALID"}
