+class Fixture:
+    """A local TLS target plus SOCKS5 / HTTP CONNECT / HTTPS CONNECT proxies."""
+
+    def __init__(self, tmp_path):
+        self.tmp_path = tmp_path
+        ca_key, ca_cert = _cert("draft-test-ca", ca=True)
+        self.ca_pem = _pem(ca_cert)
+        target_key, target_cert = _cert("probe.test", ca_key, ca_cert.subject)
+        proxy_key, proxy_cert = _cert("proxy.test", ca_key, ca_cert.subject)
+        self.target_context = _server_context(target_key, target_cert, tmp_path, "target")
+        self.proxy_context = _server_context(proxy_key, proxy_cert, tmp_path, "proxy")
+        self.seen = []
+        self.target = self._listen(self._serve_target)
+        self.socks = self._listen(self._serve_socks)
+        self.http = self._listen(self._serve_http)
+        self.https = self._listen(lambda connection: self._serve_http(self.proxy_context.wrap_socket(connection, server_side=True)))
+
+    def _listen(self, handler):
+        listener = socket.socket()
+        listener.bind(("127.0.0.1", 0))
+        listener.listen(8)
+
+        def loop():
+            while True:
+                try:
+                    connection, _ = listener.accept()
+                except OSError:
+                    return
+                threading.Thread(target=self._guard, args=(handler, connection), daemon=True).start()
+
+        threading.Thread(target=loop, daemon=True).start()
+        return listener
+
+    @staticmethod
+    def _guard(handler, connection):
+        try:
+            handler(connection)
+        except Exception:
+            pass
+        finally:
+            try:
+                connection.close()
+            except OSError:
+                pass
+
+    def _serve_target(self, connection):
+        with self.target_context.wrap_socket(connection, server_side=True) as secure:
+            request = b""
+            while b"\r\n\r\n" not in request:
+                request += secure.recv(1024)
+            self.seen.append(("target", request.split(b"\r\n")[0].decode()))
+            secure.sendall(b"HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n")
+
+    def _tunnel(self, connection):
+        upstream = socket.create_connection(("127.0.0.1", self.target.getsockname()[1]), timeout=5)
+        _pump(connection, upstream)
+
+    def _serve_socks(self, connection):
+        connection.settimeout(5)
+        header = _exact(connection, 2)
+        methods = _exact(connection, header[1])
+        if b"\x02" not in methods:
+            connection.sendall(b"\x05\xff")
+            return
+        connection.sendall(b"\x05\x02")
+        _exact(connection, 1)
+        user = _exact(connection, _exact(connection, 1)[0]).decode()
+        password = _exact(connection, _exact(connection, 1)[0]).decode()
+        self.seen.append(("socks-auth", user))
+        if (user, password) != (USER, PASSWORD):
+            connection.sendall(b"\x01\x01")
+            return
+        connection.sendall(b"\x01\x00")
+        request = _exact(connection, 4)
+        assert request[:4] == b"\x05\x01\x00\x03"
+        host = _exact(connection, _exact(connection, 1)[0]).decode()
+        port = struct.unpack("!H", _exact(connection, 2))[0]
+        self.seen.append(("socks-connect", host, port))
+        connection.sendall(b"\x05\x00\x00\x01" + socket.inet_aton("127.0.0.1") + struct.pack("!H", 0))
+        self._tunnel(connection)
+
+    def _serve_http(self, connection):
+        connection.settimeout(5)
+        request = b""
+        while b"\r\n\r\n" not in request:
+            request += connection.recv(1024)
+        head = request.decode().split("\r\n")
+        self.seen.append(("http", head[0]))
+        headers = {line.split(":", 1)[0].lower(): line.split(":", 1)[1].strip() for line in head[1:] if ":" in line}
+        expected = "Basic " + base64.b64encode(f"{USER}:{PASSWORD}".encode()).decode()
+        if headers.get("proxy-authorization") != expected:
+            connection.sendall(b"HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"draft\"\r\nContent-Length: 0\r\n\r\n")
+            return
+        assert head[0].startswith("CONNECT probe.test:")
+        connection.sendall(b"HTTP/1.1 200 Connection Established\r\n\r\n")
+        self._tunnel(connection)
+
+    def port(self, listener):
+        return listener.getsockname()[1]
+
+    def close(self):
+        for listener in (self.target, self.socks, self.http, self.https):
+            listener.close()
+
