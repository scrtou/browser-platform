+++ b/server/app/environment_management.py
@@ -0,0 +1,256 @@
+"""Administrator-only management surface for proxy drafts.
+
+Three encrypted endpoints let the Adapter's separate administrator identity
+import proxy credentials into the controller-owned Secret Store, run a
+bounded proxy-draft probe, and append an immutable network policy revision.
+Every response carries references, digests and stable codes only. Docker
+lifecycle ownership, launch gating and the Guard-namespace launch probe are
+unchanged.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import hashlib
+import logging
+import os
+import re
+import stat
+from typing import Any
+
+from fastapi import APIRouter, Depends, HTTPException
+from pydantic import BaseModel, ConfigDict, Field, ValidationError
+
+from . import network_runtime as network
+from . import proxy_probe
+from . import secret_runtime
+from .secret_store import SecretError, pair_references
+from .security import EncryptedRoute, get_decrypted_request_body, verify_admin
+
+logger = logging.getLogger("sealskin.environment-management")
+
+router = APIRouter(prefix="/api/admin/environment-management", route_class=EncryptedRoute,
+                   dependencies=[Depends(verify_admin)])
+
+_REGISTRY_LOCK = "network-policies:registry"
+NAME = network.NAME
+
+
+class Grant(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+    owner: str = Field(pattern=NAME)
+    profile: str = Field(pattern=NAME)
+    home: str = Field(pattern=NAME)
+    app: str = Field(min_length=1, max_length=256)
+
+
+class SecretImportRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+    secret_id: str = Field(pattern=NAME)
+    secret_version: int = Field(ge=1, le=999999999)
+    grants: list[Grant] = Field(min_length=1, max_length=128)
+    username: str = Field(min_length=1, max_length=4096)
+    password: str = Field(min_length=1, max_length=4096)
+
+
+class ProbeRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+    upstream_host: str = Field(min_length=1, max_length=253)
+    upstream_port: int = Field(ge=1, le=65535)
+    upstream_protocol: str = Field(pattern=r"^(socks5|http|https)$")
+    upstream_auth: str = Field(pattern=r"^(none|username_password|basic)$")
+    username_secret_ref: str = Field(default="", max_length=180)
+    password_secret_ref: str = Field(default="", max_length=180)
+    grant: Grant | None = None
+    upstream_tls_ca_pem: str = Field(default="", max_length=16384)
+    probe_url: str = Field(min_length=1, max_length=2048)
+    probe_ca_pem: str = Field(default="", max_length=16384)
+    probe_timeout_seconds: int = Field(default=10, ge=1, le=20)
+
+
+class PolicyAppendRequest(BaseModel):
+    model_config = ConfigDict(extra="forbid", strict=True)
+    policy_id: str = Field(pattern=NAME)
+    policy: dict[str, Any]
+    upstream_tls_ca_pem: str = Field(default="", max_length=16384)
+
+
+def _secret_status(code: str) -> int:
+    if code == "SECRET_VERSION_EXISTS":
+        return 409
+    if code.endswith("_INVALID"):
+        return 422
+    return 503
+
+
+def _auth_matches(protocol: str, auth: str, has_credentials: bool) -> bool:
+    allowed = {"socks5": {"none", "username_password"}, "http": {"none", "basic"}, "https": {"none", "basic"}}
+    return auth in allowed[protocol] and (auth == "none") == (not has_credentials)
+
+
+@router.post("/proxy-secrets", status_code=201)
+async def import_proxy_secret(decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body)):
+    """Store one credential version; only the two references come back."""
+    try:
+        request = SecretImportRequest(**decrypted_body)
+    except ValidationError:
+        raise HTTPException(422, "SECRET_IMPORT_REQUEST_INVALID") from None
+    store, _ = secret_runtime.configuration()
+    grants = [grant.model_dump() for grant in request.grants]
+    try:
+        async with secret_runtime.credential_lock():
+            refs = await asyncio.to_thread(store.put, request.secret_id, request.secret_version, grants,
+                                           request.username, request.password)
+    except SecretError as exc:
+        raise HTTPException(_secret_status(exc.code), exc.code) from None
+    except Exception:
+        raise HTTPException(503, "SECRET_IMPORT_FAILED") from None
+    logger.info("PROXY_SECRET_IMPORTED secret_id=%s version=%s grants=%d", request.secret_id, request.secret_version, len(grants))
+    return {"username_secret_ref": refs["username"], "password_secret_ref": refs["password"]}
+
+
+@router.post("/proxy-probe")
+async def probe_proxy_draft(decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body)):
+    """Verify one draft against a frozen public upstream address."""
+    try:
+        request = ProbeRequest(**decrypted_body)
+    except ValidationError:
+        raise HTTPException(422, "PROXY_PROBE_REQUEST_INVALID") from None
+    has_refs = bool(request.username_secret_ref or request.password_secret_ref)
+    if (not _auth_matches(request.upstream_protocol, request.upstream_auth, has_refs) or
+            (has_refs and request.grant is None) or
+            (request.upstream_tls_ca_pem and request.upstream_protocol != "https")):
+        raise HTTPException(422, "PROXY_PROBE_REQUEST_INVALID")
+    spec: dict[str, Any] = {
+        "upstream_host": request.upstream_host, "upstream_port": request.upstream_port,
+        "upstream_protocol": request.upstream_protocol, "upstream_auth": request.upstream_auth,
+        "upstream_tls_ca_pem": request.upstream_tls_ca_pem, "probe_url": request.probe_url,
+        "probe_ca_pem": request.probe_ca_pem, "timeout_seconds": request.probe_timeout_seconds,
+    }
+    if has_refs:
+        try:
+            pair_references(request.username_secret_ref, request.password_secret_ref)
+        except SecretError as exc:
+            raise HTTPException(422, exc.code) from None
+        store, _ = secret_runtime.configuration()
+        try:
+            resolved = await asyncio.to_thread(store.resolve, request.grant.model_dump(),
+                                               request.username_secret_ref, request.password_secret_ref)
+            spec["username"] = resolved["username"].decode("utf-8")
+            spec["password"] = resolved["password"].decode("utf-8")
+        except SecretError as exc:
+            secret_runtime.reject(exc)
+        except UnicodeError:
+            raise HTTPException(422, "SECRET_VALUE_INVALID") from None
+    try:
+        spec["upstream_ip"] = await asyncio.to_thread(proxy_probe.public_ipv4, request.upstream_host, request.upstream_port)
+    except proxy_probe.ProbeError as exc:
+        raise HTTPException(422, exc.code) from None
+    try:
+        result = await asyncio.wait_for(asyncio.to_thread(proxy_probe.run, spec), timeout=request.probe_timeout_seconds * 3 + 5)
+    except proxy_probe.ProbeError as exc:
+        result = {"status": "failed", "code": exc.code, "upstream_ip": spec["upstream_ip"]}
+    except asyncio.TimeoutError:
+        result = {"status": "failed", "code": "PROXY_PROBE_TIMEOUT", "upstream_ip": spec["upstream_ip"]}
+    except Exception:
+        result = {"status": "failed", "code": "PROXY_PROBE_FAILED", "upstream_ip": spec["upstream_ip"]}
+    finally:
+        spec.pop("username", None)
+        spec.pop("password", None)
+    logger.info("PROXY_DRAFT_PROBE host=%s protocol=%s auth=%s status=%s code=%s", request.upstream_host,
+                request.upstream_protocol, request.upstream_auth, result["status"], result["code"])
+    return result
+
+
+def _secrets_root():
+    root = network.base_dir() / "network-secrets"
+    if root.is_symlink():
+        network.reject("NETWORK_SECRET_PERMISSIONS", 503)
+    if not root.exists():
+        root.mkdir(mode=0o700)
+    return root
+
+
+def _write_ca(policy_id: str, pem: str) -> tuple[str, str]:
+    """Persist an upstream CA once, exclusively, as a private regular file."""
+    if "-----BEGIN CERTIFICATE-----" not in pem or "PRIVATE KEY" in pem:
+        network.reject("NETWORK_UPSTREAM_TLS_INVALID", 422)
+    raw = pem.encode("utf-8")
+    digest = hashlib.sha256(raw).hexdigest()
+    root = _secrets_root()
+    path = root / f"{policy_id}-upstream-ca.pem"
+    if path.is_symlink():
+        network.reject("NETWORK_SECRET_PERMISSIONS", 422)
+    if path.exists():
+        info = path.stat()
+        if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or hashlib.sha256(path.read_bytes()).hexdigest() != digest:
+            network.reject("NETWORK_UPSTREAM_TLS_INVALID", 409)
+        return str(path), digest
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    try:
+        with os.fdopen(fd, "wb") as handle:
+            handle.write(raw)
+            handle.flush()
+            os.fsync(handle.fileno())
+    except OSError:
+        raise HTTPException(503, "NETWORK_SECRET_UNAVAILABLE") from None
+    return str(path), digest
+
+
+def _registry() -> dict[str, Any]:
+    path = network.policy_path()
+    if not path.exists():
+        return {"version": 1, "policies": {}}
+    try:
+        raw = network.read_json(path)
+    except (OSError, ValueError):
+        network.reject("NETWORK_POLICY_REGISTRY_INVALID", 503)
+    if not isinstance(raw, dict) or set(raw) != {"version", "policies"} or raw["version"] != 1 or not isinstance(raw["policies"], dict):
+        network.reject("NETWORK_POLICY_REGISTRY_INVALID", 503)
+    return raw
+
+
+@router.post("/network-policies", status_code=201)
+async def append_network_policy(decrypted_body: dict[str, Any] = Depends(get_decrypted_request_body)):
+    """Append one immutable revision; identical retries return the same digest."""
+    from .profile_runtime import lifecycle_lock
+
+    try:
+        request = PolicyAppendRequest(**decrypted_body)
+    except ValidationError:
+        raise HTTPException(422, "NETWORK_POLICY_INVALID") from None
+    policy = dict(request.policy)
+    if policy.get("mode") not in ("proxy_required", "direct"):
+        raise HTTPException(422, "NETWORK_POLICY_INVALID")
+    async with lifecycle_lock(_REGISTRY_LOCK):
+        if request.upstream_tls_ca_pem:
+            if policy.get("upstream_protocol") != "https" or policy.get("upstream_tls_ca_file") or policy.get("upstream_tls_ca_sha256"):
+                raise HTTPException(422, "NETWORK_POLICY_INVALID")
+            policy["upstream_tls_ca_file"], policy["upstream_tls_ca_sha256"] = _write_ca(request.policy_id, request.upstream_tls_ca_pem)
+        try:
+            model = network.NetworkPolicy(**policy)
+        except (ValidationError, TypeError, ValueError):
+            raise HTTPException(422, "NETWORK_POLICY_INVALID") from None
+        snapshot = model.model_dump()
+        digest = network.digest(snapshot)
+        registry = _registry()
+        existing = registry["policies"].get(request.policy_id)
+        if existing is not None:
+            try:
+                if network.digest(network.NetworkPolicy(**existing).model_dump()) == digest:
+                    return {"policy_id": request.policy_id, "policy_sha256": digest, "created": False}
+            except (ValidationError, TypeError, ValueError):
+                network.reject("NETWORK_POLICY_REGISTRY_INVALID", 503)
+            raise HTTPException(409, "NETWORK_POLICY_EXISTS")
+        for key in registry["policies"]:
+            if not re.fullmatch(network.NAME, key):
+                network.reject("NETWORK_POLICY_REGISTRY_INVALID", 503)
+        registry["policies"][request.policy_id] = snapshot
+        try:
+            network.atomic_json(network.policy_path(), registry)
+        except HTTPException:
+            raise
+        except OSError:
+            raise HTTPException(503, "NETWORK_POLICY_REGISTRY_UNAVAILABLE") from None
+    logger.info("NETWORK_POLICY_APPENDED policy_id=%s policy_sha256=%s mode=%s", request.policy_id, digest, model.mode)
+    return {"policy_id": request.policy_id, "policy_sha256": digest, "created": True}
