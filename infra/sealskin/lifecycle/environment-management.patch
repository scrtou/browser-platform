+    store = FileSecretStore.initialize(base / "proxy-secret-store", keys / "master.key")
+    network.atomic_json(base / "profile-secret-store.json", {"version": 1, "key_file": str(store.key_file), "runtime_dir": str(tmp_path / "runtime")})
