+++ b/server/app/proxy_probe.py
@@ -0,0 +1,250 @@
+"""Bounded proxy-draft readiness check run from the controller process.
+
+The check freezes one public IPv4 address for the operator-supplied upstream,
+performs the selected SOCKS5 / HTTP CONNECT / HTTPS CONNECT handshake with the
+resolved credentials, then verifies TLS to the approved probe URL through the
+tunnel. It reports stable codes only: no credentials, response bodies or
+proxy banners cross the boundary. It does not replace the Guard-namespace
+probe that gates every managed launch.
+"""
+
+from __future__ import annotations
+
+import base64
+import ipaddress
+import socket
+import ssl
+import struct
+import time
+from urllib.parse import urlsplit
+
+MAX_HEADER = 8192
+
+
+class ProbeError(Exception):
+    """Only a stable, non-sensitive code may leave the probe."""
+
+    def __init__(self, code):
+        self.code = code
+        super().__init__(code)
+
+
+def _global_ipv4(value):
+    try:
+        address = ipaddress.IPv4Address(value)
+    except ValueError:
+        raise ProbeError("NETWORK_UPSTREAM_ADDRESS_INVALID") from None
+    if (str(address) != value or not address.is_global or address.is_multicast or address.is_reserved or
+            address.is_loopback or address.is_link_local or address.is_private or address.is_unspecified):
+        raise ProbeError("NETWORK_UPSTREAM_ADDRESS_INVALID")
+    return str(address)
+
+
+def public_ipv4(host, port):
+    """Resolve the upstream once and require every answer to be public IPv4."""
+    if not isinstance(host, str) or not 1 <= len(host) <= 253 or ":" in host or "/" in host or host != host.strip():
+        raise ProbeError("NETWORK_UPSTREAM_ADDRESS_INVALID")
+    try:
+        ipaddress.ip_address(host)
+        literal = True
+    except ValueError:
+        literal = False
+    if literal:
+        return _global_ipv4(host)
+    lowered = host.lower()
+    if lowered == "localhost" or lowered.endswith(".localhost") or lowered.endswith(".internal") or lowered.endswith(".local"):
+        raise ProbeError("NETWORK_UPSTREAM_ADDRESS_INVALID")
+    try:
+        values = socket.getaddrinfo(host, port, family=socket.AF_INET, type=socket.SOCK_STREAM)
+    except (socket.gaierror, UnicodeError, OSError):
+        raise ProbeError("NETWORK_UPSTREAM_UNRESOLVED") from None
+    addresses = list(dict.fromkeys(item[4][0] for item in values))
+    if not addresses:
+        raise ProbeError("NETWORK_UPSTREAM_UNRESOLVED")
+    return [_global_ipv4(value) for value in addresses][0]
+
+
+def _exact(connection, size):
+    data = b""
+    while len(data) < size:
+        chunk = connection.recv(size - len(data))
+        if not chunk:
+            raise ProbeError("PROXY_PROTOCOL_ERROR")
+        data += chunk
+    return data
+
+
+def _status_line(connection):
+    """Read HTTP headers up to a bound and return the status code."""
+    data = b""
+    while b"\r\n\r\n" not in data:
+        if len(data) > MAX_HEADER:
+            raise ProbeError("PROXY_PROTOCOL_ERROR")
+        chunk = connection.recv(1024)
+        if not chunk:
+            raise ProbeError("PROXY_PROTOCOL_ERROR")
+        data += chunk
+    parts = data.split(b"\r\n", 1)[0].split(b" ", 2)
+    if len(parts) < 2 or not parts[0].startswith(b"HTTP/1.") or not parts[1].isdigit():
+        raise ProbeError("PROXY_PROTOCOL_ERROR")
+    return int(parts[1])
+
+
+def _socks5(connection, host, port, username, password):
+    methods = b"\x02" if username is not None else b"\x00"
+    connection.sendall(b"\x05\x01" + methods)
+    reply = _exact(connection, 2)
+    if reply[0] != 5 or reply[1:] != methods:
+        raise ProbeError("PROXY_AUTH_REJECTED" if reply[1] == 0xFF else "PROXY_PROTOCOL_ERROR")
+    if username is not None:
+        user, secret = username.encode("utf-8"), password.encode("utf-8")
+        if not 1 <= len(user) <= 255 or not 1 <= len(secret) <= 255:
+            raise ProbeError("PROXY_AUTH_REJECTED")
+        connection.sendall(b"\x01" + bytes([len(user)]) + user + bytes([len(secret)]) + secret)
+        auth = _exact(connection, 2)
+        if auth[0] != 1 or auth[1] != 0:
+            raise ProbeError("PROXY_AUTH_REJECTED")
+    domain = host.encode("idna")
+    if len(domain) > 255:
+        raise ProbeError("PROBE_URL_INVALID")
+    connection.sendall(b"\x05\x01\x00\x03" + bytes([len(domain)]) + domain + struct.pack("!H", port))
+    header = _exact(connection, 4)
+    if header[0] != 5:
+        raise ProbeError("PROXY_PROTOCOL_ERROR")
+    if header[1] != 0:
+        raise ProbeError("PROXY_CONNECT_REJECTED")
+    size = {1: 4, 4: 16}.get(header[3])
+    if header[3] == 3:
+        size = _exact(connection, 1)[0]
+    if size is None:
+        raise ProbeError("PROXY_PROTOCOL_ERROR")
+    _exact(connection, size + 2)
+
+
+def _http_connect(connection, host, port, username, password):
+    authority = f"{host.encode('idna').decode('ascii')}:{port}"
+    request = f"CONNECT {authority} HTTP/1.1\r\nHost: {authority}\r\nUser-Agent: browser-platform-proxy-draft-probe/1\r\n"
+    if username is not None:
+        token = base64.b64encode(f"{username}:{password}".encode("utf-8")).decode("ascii")
+        request += f"Proxy-Authorization: Basic {token}\r\n"
+    request += "\r\n"
+    connection.sendall(request.encode("ascii"))
+    status = _status_line(connection)
+    if status in (401, 407):
+        raise ProbeError("PROXY_AUTH_REJECTED")
+    if not 200 <= status < 300:
+        raise ProbeError("PROXY_CONNECT_REJECTED")
+
+
+class _TLSStream:
+    """TLS over an existing (possibly already TLS) stream via memory BIOs."""
+
+    def __init__(self, transport, context, server_hostname):
+        self.transport = transport
+        self.incoming, self.outgoing = ssl.MemoryBIO(), ssl.MemoryBIO()
+        self.tls = context.wrap_bio(self.incoming, self.outgoing, server_side=False, server_hostname=server_hostname)
+        self._drive(self.tls.do_handshake)
+
+    def _flush(self):
+        data = self.outgoing.read()
+        if data:
+            self.transport.sendall(data)
+
+    def _drive(self, operation):
+        while True:
+            try:
+                result = operation()
+            except ssl.SSLWantReadError:
+                self._flush()
+                chunk = self.transport.recv(16384)
+                if not chunk:
+                    self.incoming.write_eof()
+                else:
+                    self.incoming.write(chunk)
+                continue
+            except ssl.SSLWantWriteError:
+                self._flush()
+                continue
+            self._flush()
+            return result
+
+    def sendall(self, data):
+        self._drive(lambda: self.tls.write(data))
+
+    def recv(self, size):
+        try:
+            return self._drive(lambda: self.tls.read(size))
+        except ssl.SSLEOFError:
+            return b""
+
+    def close(self):
+        try:
+            self._drive(self.tls.unwrap)
+        except (ssl.SSLError, OSError):
+            pass
+
+
+def _context(ca_pem):
+    context = ssl.create_default_context()
+    if ca_pem:
+        try:
+            context.load_verify_locations(cadata=ca_pem)
+        except (ssl.SSLError, ValueError):
+            raise ProbeError("PROXY_CA_INVALID") from None
+    return context
+
+
+def run(spec):
+    """Execute one bounded probe; ``spec`` never leaves this function."""
+    protocol, auth = spec["upstream_protocol"], spec["upstream_auth"]
+    username = spec.get("username") if auth != "none" else None
+    password = spec.get("password") if auth != "none" else None
+    if auth != "none" and (username is None or password is None):
+        raise ProbeError("PROXY_CREDENTIALS_MISSING")
+    parsed = urlsplit(spec["probe_url"])
+    if parsed.scheme != "https" or not parsed.hostname or parsed.username or parsed.password:
+        raise ProbeError("PROBE_URL_INVALID")
+    target_host, target_port = parsed.hostname, parsed.port or 443
+    timeout = int(spec["timeout_seconds"])
+    started = time.monotonic()
+    try:
+        connection = socket.create_connection((spec["upstream_ip"], int(spec["upstream_port"])), timeout=timeout)
+    except socket.timeout:
+        raise ProbeError("PROXY_PROBE_TIMEOUT") from None
+    except OSError:
+        raise ProbeError("PROXY_UNREACHABLE") from None
+    try:
+        connection.settimeout(timeout)
+        if protocol == "https":
+            try:
+                connection = _context(spec.get("upstream_tls_ca_pem", "")).wrap_socket(connection, server_hostname=spec["upstream_host"])
+            except ssl.SSLError:
+                raise ProbeError("PROXY_TLS_FAILED") from None
+        if protocol == "socks5":
+            _socks5(connection, target_host, target_port, username, password)
+        else:
+            _http_connect(connection, target_host, target_port, username, password)
+        try:
+            secure = _TLSStream(connection, _context(spec.get("probe_ca_pem", "")), target_host)
+        except ssl.SSLError:
+            raise ProbeError("PROBE_TLS_FAILED") from None
+        path = (parsed.path or "/") + ("?" + parsed.query if parsed.query else "")
+        authority = target_host if target_port == 443 else f"{target_host}:{target_port}"
+        secure.sendall(f"HEAD {path} HTTP/1.1\r\nHost: {authority}\r\nUser-Agent: browser-platform-proxy-draft-probe/1\r\nConnection: close\r\n\r\n".encode("ascii"))
+        status = _status_line(secure)
+        secure.close()
+    except socket.timeout:
+        raise ProbeError("PROXY_PROBE_TIMEOUT") from None
+    except ProbeError:
+        raise
+    except (OSError, ValueError, UnicodeError):
+        raise ProbeError("PROXY_PROBE_FAILED") from None
+    finally:
+        try:
+            connection.close()
+        except OSError:
+            pass
+    if not 200 <= status < 400:
+        raise ProbeError("PROBE_HTTP_STATUS")
+    return {"status": "passed", "code": "PROXY_PROBE_OK", "upstream_ip": spec["upstream_ip"],
+            "http_status": status, "latency_ms": int((time.monotonic() - started) * 1000)}
