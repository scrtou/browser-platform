+GRANT = {"owner": "profile-adapter", "profile": "browser-a", "home": "browser-a-home", "app": "app-a"}
+USER, PASSWORD = "draft user", "draft pässword sentinel"
+IMPORT = {"secret_id": "proxy-browser-a", "secret_version": 1, "grants": [GRANT], "username": USER, "password": PASSWORD}
