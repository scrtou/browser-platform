index 0000000..d2ad05d
--- /dev/null
+++ b/server/app/dynamic_upstream.py
@@ -0,0 +1,315 @@
+"""Hot-refresh proxy endpoints without changing a browser generation.
+
+The controller owns DNS, endpoint validation and nft updates. The long-lived
+Relay stays unprivileged and only reads an atomically replaced endpoint lease.
+Every failed transition is fail-closed: no Worker direct fallback is introduced.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import re
+import socket
+import time
+
+from docker.errors import NotFound
+from fastapi import HTTPException
+
+from . import network_runtime as network
+from .profile_runtime import home_path, lifecycle_lock
+
+logger = logging.getLogger(__name__)
+VERSION = 1
+POLL_SECONDS = 15
+MIN_REFRESH_SECONDS = 15
+MAX_REFRESH_SECONDS = 300
+RUNTIME_MOUNT = "/run/browser-platform-network"
+LEASE_FILE = "upstream-endpoint.json"
+NETWORK_FILE = "relay-network.json"
+
+
+def lease_id(reservation):
+    return network.digest({"kind": "dynamic-upstream", "identity": reservation["identity"],
+                           "policy_sha256": reservation["policy_sha256"]})
+
+
+def lease_value(reservation, address, revision):
+    policy = network.NetworkPolicy(**reservation["policy"])
+    return {"version": VERSION, "lease_id": lease_id(reservation), "revision": revision,
+            "upstream_ip": address, "upstream_port": policy.upstream_port}
+
+
+def endpoint_path(reservation):
+    identity = reservation["identity"]
+    return network.runtime_dir() / (identity["home_hash"] + "-" + identity["operation"]) / LEASE_FILE
+
+
+def relay_network_path(reservation):
+    identity = reservation["identity"]
+    return network.runtime_dir() / (identity["home_hash"] + "-" + identity["operation"]) / NETWORK_FILE
+
+
+def next_refresh(observation):
+    now = time.time()
+    expiry = observation.get("expires_at")
+    if type(expiry) in (int, float) and expiry > now:
+        return min(now + MAX_REFRESH_SECONDS, max(now + MIN_REFRESH_SECONDS, expiry))
+    return now + 60
+
+
+def eligible(reservation):
+    policy = network.NetworkPolicy(**reservation["policy"])
+    allocation = reservation.get("allocation") or {}
+    endpoint = reservation.get("endpoint") or {}
+    if (policy.mode == "direct" or not allocation or allocation.get("dynamic_upstream_version") != VERSION or
+            reservation.get("phase") not in {"ready", "worker_starting", "running"} or
+            endpoint.get("version") != VERSION or endpoint.get("lease_id") != lease_id(reservation)):
+        return False
+    from .network_dns import numeric_endpoint
+    return numeric_endpoint(policy.upstream_host) is None
+
+
+def validate_endpoint_state(reservation):
+    if not eligible(reservation):
+        return
+    allocation = reservation["allocation"]
+    endpoint = reservation["endpoint"]
+    policy = network.NetworkPolicy(**reservation["policy"])
+    if (type(endpoint.get("revision")) is not int or endpoint["revision"] < 1 or
+            endpoint.get("selected_ipv4") not in endpoint.get("addresses", []) or
+            endpoint.get("upstream_port") != policy.upstream_port or
+            not re.fullmatch(network.SHA, allocation.get("endpoint_lease_sha256", "")) or
+            allocation.get("endpoint_lease_id") != endpoint["lease_id"] or
+            allocation.get("endpoint_revision") != endpoint["revision"]):
+        network.reject("NETWORK_DYNAMIC_ENDPOINT_INVALID", 503)
+    expected = lease_value(reservation, endpoint["selected_ipv4"], endpoint["revision"])
+    if network.digest(expected) != allocation["endpoint_lease_sha256"]:
+        network.reject("NETWORK_DYNAMIC_ENDPOINT_INVALID", 503)
+
+
+def _apply_rules(relay, config, expected):
+    network.atomic_json(relay_network_path(config), expected)
+    command = ["python3", "-B", "/usr/local/lib/browser-platform/network-guard.py",
+               "--network-config", RUNTIME_MOUNT + "/" + NETWORK_FILE, "--apply-only"]
+    result = relay.exec_run(command, user="0:0", demux=False)
+    output = result.output.decode("utf-8", "replace") if isinstance(result.output, bytes) else str(result.output)
+    if result.exit_code != 0 or len(output) > 4096:
+        raise RuntimeError("NETWORK_DYNAMIC_GUARD_APPLY_FAILED")
+    try:
+        value = json.loads(output.strip())
+    except ValueError as exc:
+        raise RuntimeError("NETWORK_DYNAMIC_GUARD_APPLY_FAILED") from exc
+    if value != {"network_guard_applied": network.digest(expected)}:
+        raise RuntimeError("NETWORK_DYNAMIC_GUARD_APPLY_FAILED")
+
+
+def _tcp_preflight(address, port, timeout):
+    with socket.create_connection((address, port), timeout=min(timeout, 5)):
+        return True
+
+
+def _network_config(reservation, addresses):
+    policy = network.NetworkPolicy(**reservation["policy"])
+    allocation = reservation["allocation"]
+    return {"version": 1, "role": "relay-v2", "uid": network.settings.puid, "gid": network.settings.pgid,
+            "internal_cidr": allocation["internal_cidr"], "upstream_ipv4": sorted(set(addresses)),
+            "upstream_port": policy.upstream_port}
+
+
+def _record_error(reservation, code):
+    endpoint = reservation.get("endpoint") or {}
+    endpoint["last_error"] = {"code": code, "at": time.time()}
+    endpoint["next_refresh_at"] = time.time() + MIN_REFRESH_SECONDS
+    reservation["endpoint"] = endpoint
+    network.save_reservation(reservation)
+
+
+async def _recover_pending(reservation):
+    """Rollback an interrupted transition before accepting new connections."""
+    endpoint = reservation["endpoint"]
+    if not endpoint.get("pending"):
+        return False
+    allocation = reservation["allocation"]
+    current = endpoint["selected_ipv4"]
+    old_lease = lease_value(reservation, current, endpoint["revision"])
+    client = await asyncio.to_thread(network.get_docker_client)
+    owned_relay = False
+    try:
+        relay = await asyncio.to_thread(client.containers.get, allocation["relay_id"])
+        await asyncio.to_thread(relay.reload)
+        if relay.status != "running":
+            raise RuntimeError("NETWORK_DYNAMIC_RELAY_NOT_RUNNING")
+        labels = relay.attrs.get("Config", {}).get("Labels") or {}
+        if any(labels.get(k) != v for k, v in network.resource_labels(reservation, "relay").items()):
+            network.reject("NETWORK_RESOURCE_OWNERSHIP_UNPROVEN", 503)
+        owned_relay = True
+        network.atomic_json(endpoint_path(reservation), old_lease)
+        await asyncio.to_thread(_apply_rules, relay, reservation, _network_config(reservation, [current]))
+    except Exception:
+        # A restart may leave the lease/rules half-transitioned. Stop the
+        # Relay first, restore the old lease if possible, and keep the
+        # generation explicitly degraded so cleanup remains retryable.
+        try:
+            if owned_relay and relay.status == "running":
+                await asyncio.to_thread(relay.stop, timeout=10)
+        except Exception:
+            logger.error("NETWORK_DYNAMIC_ENDPOINT_FAIL_CLOSED_FAILED")
+        try:
+            network.atomic_json(endpoint_path(reservation), old_lease)
+        except Exception:
+            _record_error(reservation, "NETWORK_DYNAMIC_ENDPOINT_ROLLBACK_FAILED")
+            return True
+        # Keep intent until rules are restored or lifecycle cleanup completes.
+        reservation["endpoint"] = endpoint
+        _record_error(reservation, "NETWORK_DYNAMIC_ENDPOINT_ROLLBACK_FAILED")
+        return True
+    endpoint.pop("pending", None)
+    endpoint.pop("last_error", None)
+    reservation["endpoint"] = endpoint
+    network.save_reservation(reservation)
+    return True
+
+
+async def refresh(reservation):
+    """Refresh one running generation. Return a bounded, non-secret result."""
+    if not eligible(reservation):
+        return {"result": "not_applicable"}
+    endpoint = reservation["endpoint"]
+    if endpoint.get("pending"):
+        await _recover_pending(reservation)
+        if reservation["endpoint"].get("pending"):
+            return {"result": "retained", "reason": "NETWORK_DYNAMIC_ENDPOINT_ROLLBACK_FAILED"}
+        return {"result": "rolled_back"}
+    if time.time() < endpoint.get("next_refresh_at", 0):
+        return {"result": "not_due"}
+    policy = network.NetworkPolicy(**reservation["policy"])
+    try:
+        observed = await asyncio.to_thread(network.resolve_bootstrap, policy, reservation["identity"],
+                                           reservation["policy_sha256"])
+    except Exception as exc:
+        code = getattr(exc, "code", None) or getattr(exc, "detail", None) or "NETWORK_DYNAMIC_DNS_FAILED"
+        _record_error(reservation, str(code) if str(code).startswith("NETWORK_") else "NETWORK_DYNAMIC_DNS_FAILED")
+        return {"result": "retained", "reason": "NETWORK_DYNAMIC_DNS_FAILED"}
+
+    current = endpoint["selected_ipv4"]
+    addresses = observed["addresses"]
+    if current in addresses:
+        endpoint["addresses"] = addresses
+        endpoint["observation"] = observed
+        endpoint["next_refresh_at"] = next_refresh(observed)
+        endpoint.pop("last_error", None)
+        reservation["allocation"]["bootstrap_dns_sha256"] = network.digest(observed)
+        reservation["bootstrap_dns"] = observed
+        reservation["upstream_ipv4"] = addresses
+        reservation["endpoint"] = endpoint
+        network.save_reservation(reservation)
+        return {"result": "unchanged"}
+
+    candidate = observed["selected_ipv4"]
+    try:
+        await asyncio.to_thread(_tcp_preflight, candidate, policy.upstream_port, policy.probe_timeout_seconds)
+    except OSError:
+        _record_error(reservation, "NETWORK_DYNAMIC_ENDPOINT_UNREACHABLE")
+        return {"result": "retained", "reason": "NETWORK_DYNAMIC_ENDPOINT_UNREACHABLE"}
+
+    client = await asyncio.to_thread(network.get_docker_client)
+    allocation = reservation["allocation"]
+    try:
+        relay = await asyncio.to_thread(client.containers.get, allocation["relay_id"])
+        await asyncio.to_thread(relay.reload)
+    except NotFound:
+        _record_error(reservation, "NETWORK_DYNAMIC_RELAY_MISSING")
+        return {"result": "retained", "reason": "NETWORK_DYNAMIC_RELAY_MISSING"}
+    if relay.status != "running":
+        _record_error(reservation, "NETWORK_DYNAMIC_RELAY_NOT_RUNNING")
+        return {"result": "retained", "reason": "NETWORK_DYNAMIC_RELAY_NOT_RUNNING"}
+
+    labels = relay.attrs.get("Config", {}).get("Labels") or {}
+    expected_labels = network.resource_labels(reservation, "relay")
+    if any(labels.get(k) != v for k, v in expected_labels.items()):
+        network.reject("NETWORK_RESOURCE_OWNERSHIP_UNPROVEN", 503)
+
+    old_revision = endpoint["revision"]
+    old_lease = lease_value(reservation, current, old_revision)
+    new_revision = old_revision + 1
+    new_lease = lease_value(reservation, candidate, new_revision)
+    transition = _network_config(reservation, [current, candidate])
+    old_only = _network_config(reservation, [current])
+    new_only = _network_config(reservation, [candidate])
+    endpoint["pending"] = {"revision": new_revision, "selected_ipv4": candidate}
+    reservation["endpoint"] = endpoint
+    network.save_reservation(reservation)
+
+    try:
+        await asyncio.to_thread(_apply_rules, relay, reservation, transition)
+        network.atomic_json(endpoint_path(reservation), new_lease)
+        from .profile_health import upstream_probe
+        probe = await asyncio.to_thread(upstream_probe, allocation["relay_ip"], policy)
+        if probe.get("status") != "pass" or probe.get("code") != "PROXY_OK":
+            raise RuntimeError("NETWORK_DYNAMIC_ENDPOINT_PROBE_FAILED")
+        await asyncio.to_thread(_apply_rules, relay, reservation, new_only)
+    except Exception:
+        try:
+            network.atomic_json(endpoint_path(reservation), old_lease)
+            await asyncio.to_thread(_apply_rules, relay, reservation, old_only)
+        except Exception:
+            # If the privileged nft transaction itself cannot be restored,
+            # stop the Relay. The Worker namespace still has no direct route;
+            # a stopped Relay is the only safe fallback until operator repair.
+            logger.error("NETWORK_DYNAMIC_ENDPOINT_ROLLBACK_FAILED")
+            try:
+                await asyncio.to_thread(relay.stop, timeout=10)
+            except Exception:
+                logger.error("NETWORK_DYNAMIC_ENDPOINT_FAIL_CLOSED_FAILED")
+            _record_error(reservation, "NETWORK_DYNAMIC_ENDPOINT_ROLLBACK_FAILED")
+            return {"result": "retained", "reason": "NETWORK_DYNAMIC_ENDPOINT_ROLLBACK_FAILED"}
+        endpoint.pop("pending", None)
+        reservation["endpoint"] = endpoint
+        _record_error(reservation, "NETWORK_DYNAMIC_ENDPOINT_SWITCH_FAILED")
+        return {"result": "retained", "reason": "NETWORK_DYNAMIC_ENDPOINT_SWITCH_FAILED"}
+
+    endpoint.update({"revision": new_revision, "selected_ipv4": candidate, "addresses": addresses,
+                     "upstream_port": policy.upstream_port, "observation": observed,
+                     "updated_at": time.time(), "next_refresh_at": next_refresh(observed)})
+    endpoint.pop("last_error", None)
+    endpoint.pop("pending", None)
+    allocation["endpoint_revision"] = new_revision
+    allocation["endpoint_lease_sha256"] = network.digest(new_lease)
+    allocation["relay_network_sha256"] = network.digest(new_only)
+    allocation["bootstrap_dns_sha256"] = network.digest(observed)
+    reservation["endpoint"] = endpoint
+    reservation["allocation"] = allocation
+    reservation["bootstrap_dns"] = observed
+    reservation["upstream_ipv4"] = addresses
+    network.save_reservation(reservation)
+    return {"result": "updated"}
+
+
+async def endpoint_monitor():
+    """Continuously refresh supported running proxy generations."""
+    while True:
+        await asyncio.sleep(POLL_SECONDS)
+        root = network.runtime_dir()
+        if not root.exists():
+            continue
+        for path in sorted(root.glob("*.json")):
+            try:
+                raw = network.read_json(path)
+                identity = raw.get("identity")
+                if not isinstance(identity, dict) or not identity.get("home"):
+                    continue
+                reservation = network.read_reservation(identity)
+                if not reservation or not eligible(reservation):
+                    continue
+                async with lifecycle_lock("home:" + home_path(identity["owner"], identity["home"])):
+                    reservation = network.read_reservation(identity)
+                    if reservation:
+                        await refresh(reservation)
+            except asyncio.CancelledError:
+                raise
+            except Exception as exc:
+                code = getattr(exc, "detail", None)
+                logger.warning("Dynamic upstream refresh retained one generation (%s).",
+                               code if isinstance(code, str) and code.startswith("NETWORK_") else type(exc).__name__)
