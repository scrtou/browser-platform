+@pytest.mark.parametrize("managed,deadline,expected", [(True, 150, 30), (False, 150, 60), (True, None, 60)])
+async def test_readiness_uses_remaining_managed_budget(containers, monkeypatch, managed, deadline, expected):
+    clock = [100.0]
+    monkeypatch.setattr(docker_provider, "time", SimpleNamespace(monotonic=lambda: clock[0]))
+    identity = runtime.runtime_identity("qa", "test-home", "firefox", "personal", OPERATION)
+    config = {"provider_config": {"image": "qa-image", "port": 3000}}
+    if managed:
+        config["profile_runtime"] = identity
+    if deadline is not None:
+        config["_profile_readiness_deadline"] = deadline
+    provider = docker_provider.DockerProvider(config)
+    original = containers.run
+    def slow_create(**kwargs):
+        clock[0] += 20
+        return original(**kwargs)
+    monkeypatch.setattr(containers, "run", slow_create)
+    wait = AsyncMock(return_value="127.0.0.1")
+    monkeypatch.setattr(provider, "_wait_for_container_ready", wait)
+    volumes = {identity["home_source"]: {"bind": settings.container_config_path, "mode": "rw"}} if managed else {}
+    await provider.launch(SID, DISPLAY_ENV, volumes)
+    assert wait.await_args.kwargs["timeout"] == expected
+    assert len(containers.values) == 1
+
+
+async def test_exhausted_managed_budget_does_not_create_worker(containers, monkeypatch):
+    monkeypatch.setattr(docker_provider, "time", SimpleNamespace(monotonic=lambda: 151))
+    identity = runtime.runtime_identity("qa", "test-home", "firefox", "personal", OPERATION)
+    provider = docker_provider.DockerProvider({"profile_runtime": identity, "_profile_readiness_deadline": 150,
+        "provider_config": {"image": "qa-image", "port": 3000}})
+    monkeypatch.setattr(provider, "_wait_for_container_ready", AsyncMock(return_value="127.0.0.1"))
+    with pytest.raises(HTTPException) as error:
+        await provider.launch(SID, DISPLAY_ENV, {identity["home_source"]: {"bind": settings.container_config_path}})
+    assert error.value.status_code == 504
+    assert containers.run_kwargs is None
+
