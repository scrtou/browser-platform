+@pytest.mark.parametrize("timeout,passes", [(150, True), (60, False)])
+async def test_slow_readiness_remains_bounded_and_preserves_failed_stop(containers, monkeypatch, timeout, passes):
+    clock = [0.0]
+    monkeypatch.setattr(docker_provider, "time", SimpleNamespace(monotonic=lambda: clock[0]))
+    async def advance(seconds):
+        clock[0] += seconds
+    monkeypatch.setattr(docker_provider.asyncio, "sleep", advance)
+    class HTTP:
+        def __init__(self, **kwargs): pass
+        async def __aenter__(self): return self
+        async def __aexit__(self, *args): pass
+        async def get(self, url): return SimpleNamespace(status_code=200 if clock[0] >= 80 else 503)
+    monkeypatch.setattr(docker_provider.httpx, "AsyncClient", HTTP)
+    worker = SimpleNamespace(id=INSTANCE, short_id=INSTANCE[:12], reload=lambda: None,
+        attrs={"NetworkSettings": {"Networks": {"bridge": {"IPAddress": "127.0.0.1"}}}})
+    provider = docker_provider.DockerProvider({"provider_config": {"port": 3000}})
+    stop = AsyncMock(side_effect=RuntimeError("normal shutdown unconfirmed; Home retained"))
+    monkeypatch.setattr(provider, "stop", stop)
+    if passes:
+        assert await provider._wait_for_container_ready(worker, SID, "/", {}, timeout=timeout) == "127.0.0.1"
+        stop.assert_not_awaited()
+        assert clock[0] == 80
+    else:
+        with pytest.raises(RuntimeError, match="Home retained"):
+            await provider._wait_for_container_ready(worker, SID, "/", {}, timeout=timeout)
+        stop.assert_awaited_once_with(INSTANCE)
+        assert clock[0] == 60
