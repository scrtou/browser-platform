# Component example only. Prefer infra/deployment/install.py for new installs.
# Paths must already contain the generated private state; do not use real Home
# paths for QA. Replace UID/GID with the new dedicated service user's values.
PUID=1000
PGID=1000
TZ=Etc/UTC
SEALSKIN_HOST_URL=session.example.com
SEALSKIN_CONTROLLER_IMAGE=sha256:33a6d2fcd00502f6df7b8e75a2b3eaa70c0e933077919cbdda5dbe77d5fb7b57
BP_INSTANCE_ROOT=/srv/browser-platform
BP_CREDENTIAL_TMPFS=/dev/shm/bp-main-credentials
BP_SESSION_TMPFS=/dev/shm/bp-main-sessions
BP_BACKEND_PORT=18443
BP_API_PORT=18000
