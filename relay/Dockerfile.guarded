FROM alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40

RUN apk add --no-cache python3=3.12.14-r0 nftables=1.1.5-r2 setpriv=2.41.6-r1
RUN test -s /etc/ssl/certs/ca-certificates.crt
COPY build/profile-relay /profile-relay
COPY network-guard.py /usr/local/lib/browser-platform/network-guard.py
COPY internal/proxy/direct-denied-ipv4.json /usr/local/lib/browser-platform/internal/proxy/direct-denied-ipv4.json
LABEL io.browser-platform.network-guard="1"
LABEL io.browser-platform.proxy-upstreams="1"
LABEL io.browser-platform.secret-lease="1"
LABEL io.browser-platform.direct-egress="1"
LABEL io.browser-platform.coherence-gate="1"
ENTRYPOINT ["python3", "-B", "/usr/local/lib/browser-platform/network-guard.py"]
